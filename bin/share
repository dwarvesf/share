#!/bin/bash
# share: publish snapshots of local files or folders at https://<your-host>/<id>/<name>,
#        or proxy a running dev server on localhost:<port>.
#
#   share setup [hostname]    log in to Cloudflare, create the tunnel + DNS, install the service, verify
#   share setup --quick       no domain needed: serve at a random trycloudflare.com URL (changes every start)
#   share add [--ttl 7d|12h|never] [--no-index] <file|dir>   copy it in, print + copy the link, auto-start
#   share add <port|localhost:port|http://localhost:port>    live proxy at https://<host>/<id>/
#   share add ... --host <name>.<zone>                       give the share its own hostname
#   share ls                  list shares: link, size, source, expiry
#   share refresh <id|link>   re-copy from the source path (same link)
#   share rm <id|link>        unpublish (moves the copy to the Trash)
#   share hits <id|link>      requests and unique visitors for one share
#   share prune               unpublish expired shares now (also hourly while serving)
#   share start | stop        start or stop serving (links live while this machine is awake)
#   share service install|uninstall|status   the login service that keeps serving
#   share [status]            server state plus the share list
#   share serve               serve in the foreground until Ctrl-C
#   share skill [--install]   the SKILL.md that teaches an agent to use share
#   share teardown [--yes]    delete the tunnel, DNS record, service, and stored token
#
# Docs: https://github.com/dwarvesf/share
set -euo pipefail

config_dir="${SHARE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/share}"
config="$config_dir/config"
cfg() { [[ -f $config ]] && awk -v k="$1" 'index($0, k "=") == 1 {print substr($0, length(k) + 2); exit}' "$config"; }

root="${SHARE_ROOT:-$HOME/share}"
pub="$root/pub"            # served tree; nothing else is reachable from the tunnel
index="$root/index.tsv"    # id, name, source, added date, expiry epoch (0 = never)
pidfile="$root/serve.pid"
host_name="${SHARE_HOSTNAME:-$(cfg hostname || true)}"
port="${SHARE_PORT:-$(cfg port || true)}"; port="${port:-8787}"
metrics_port=$((port + 1))   # cloudflared /ready, polled so `start` returns once links work
hosts="${SHARE_HOSTS:-$(cfg hosts || true)}"
tunnel="${SHARE_TUNNEL:-1}"  # 0 = local-only (tests)
mode="$(cfg mode || true)"   # "quick" = trycloudflare, no domain; empty = named tunnel
api="https://api.cloudflare.com/client/v4"

die() { echo "share: $*" >&2; exit 1; }
this_host() { local h; h="$(uname -n)"; echo "${h%%.*}"; }
host_ok() { case " $hosts " in *" $(this_host) "*) return 0 ;; esac; return 1; }
running() { [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }
row() { [[ -f $index ]] && awk -F'\t' -v id="$1" '(NF == 5 || NF == 6) && $1 == id' "$index"; }
id_of() { # accept an id or a pasted share link: https://host/<id>/name -> <id>; a bare https://<fqdn>/ resolves to the host row
  case ${1:-} in
    *://*)
      local p="${1#*://}"; local h="${p%%/*}" rest="${p#*/}"
      if [[ $p == "$h" || -z $rest ]] && [[ -f $index ]]; then
        awk -F'\t' -v h="$h" '(NF==5||NF==6){n=split($6,a," "); for(i=1;i<=n;i++) if(a[i]=="host=" h){print $1; exit}}' "$index"
      else
        echo "${rest%%/*}"
      fi ;;
    *) echo "${1:-}" ;;
  esac
}
rand_id_raw() { od -An -N3 -tx1 /dev/urandom | tr -d ' \n'; }   # the real candidate source
rand_id() { # loops past a collision with an existing row or an orphaned pub/<id>
  # SHARE_TEST_IDS (test seam): space-separated candidates consumed in order, then rand_id_raw.
  # Consumed here, not inside rand_id_raw: rand_id_raw's output is captured with $( ), which
  # forks a subshell, so a mutation made inside it would never reach this loop's next pass.
  local id
  while :; do
    if [[ -n ${SHARE_TEST_IDS:-} ]]; then
      id="${SHARE_TEST_IDS%% *}"
      [[ $SHARE_TEST_IDS == "$id" ]] && SHARE_TEST_IDS="" || SHARE_TEST_IDS="${SHARE_TEST_IDS#* }"
    else
      id="$(rand_id_raw)"
    fi
    [[ -z "$(row "$id")" && ! -e $pub/$id ]] && { echo "$id"; return; }
  done
}
has_opt() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
opt_val() { # opt_val <key> <opts>: the value of a key=value token, nothing when absent
  local rest="${2#*"$1"=}"
  [[ $rest == "$2" ]] && return 1
  echo "${rest%% *}"
}
day_of() { date -r "$1" +%F 2>/dev/null || date -d "@$1" +%F; }
to_trash() { # an empty path would make `trash` move the current directory
  [[ -n ${1:-} && -e $1 ]] || return 0
  if command -v trash >/dev/null; then trash "$1"; return; fi
  mkdir -p "$root/trash" && mv -f "$1" "$root/trash/$(basename "$1").$(date +%s)"
}
need_host() { [[ -n $host_name || $mode == quick ]] || die "no setup yet: run 'share setup <hostname>' or 'share setup --quick'"; }

# Locks are symlinks $root/.lock-<name> -> holder pid, so a dead holder's lock can be broken.
# Inside a subshell $$ is the parent's pid (bash 3.2 has no BASHPID); that lock is recovered once the parent exits.
held_locks=""   # names this process holds; the EXIT trap releases them
lock_take() { # lock_take <name> [timeout-secs]
  local l="$root/.lock-$1" s="$root/.lock-$1.stale.$$" i=0 max=$(( ${2:-60} * 5 )) pid
  # a real directory is a pre-symlink lock: ln would link inside it, so it counts as held
  while [[ -d $l && ! -L $l ]] || ! ln -sn "$$" "$l" 2>/dev/null; do
    pid="$(readlink "$l" 2>/dev/null || true)"
    # stale: rename to a private name, re-read, remove only if still dead; a live one goes back
    if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null && mv "$l" "$s" 2>/dev/null; then
      pid="$(readlink "$s" 2>/dev/null || true)"
      if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null; then rm -f "$s"; else mv -f "$s" "$l"; fi
      continue
    fi
    i=$((i + 1)); [[ $i -gt $max ]] && die "another share command holds the $1 lock"
    sleep 0.2
  done
  held_locks="$held_locks $1"
  trap release_locks EXIT   # re-armed on every take: subshells do not inherit EXIT traps
}
lock_release() { # lock_release <name>: only a link that still names this pid is removed
  [[ "$(readlink "$root/.lock-$1" 2>/dev/null)" == "$$" ]] && rm -f "$root/.lock-$1"
  held_locks="${held_locks// $1/}"
}
release_locks() { local n; for n in $held_locks; do lock_release "$n"; done; }

# the public hostname share links use: the configured hostname in named mode,
# the fqdn cloudflared printed in quick mode (empty while not serving)
serving_host() {
  if [[ $mode == quick ]]; then cat "$root/quick.url" 2>/dev/null || true
  else echo "$host_name"; fi
}

share_url() { # share_url <id> <name> [opts]: sets share_url_out; the link depends on the share kind
  local fqdn path shost
  fqdn="$(opt_val host "${3:-}" || true)"
  if [[ -n $fqdn ]]; then
    printf -v share_url_out 'https://%s/' "$fqdn"; return
  fi
  shost="$(serving_host)"
  if [[ -z $shost ]]; then
    if [[ $mode == quick ]]; then shost="<pending>.trycloudflare.com"; else shost="<no-hostname>"; fi
  fi
  if has_opt live "${3:-}"; then
    printf -v share_url_out 'https://%s/%s/' "$shost" "$1"; return
  fi
  path="$2"
  if [[ -d $pub/$1/$2 ]]; then path="$2/"
  elif [[ $2 == *.md && -f $pub/$1/${2%.md}.html ]]; then path="${2%.md}.html"
  fi
  urlenc "$path"
  printf -v share_url_out 'https://%s/%s/%s' "$shost" "$1" "$urlenc_out"
}

ttl_secs() {
  local n="${1%[dh]}"
  case $1 in never|0) echo 0; return ;; esac
  [[ $n =~ ^[0-9]+$ ]] || die "bad --ttl '$1' (use 12h, 7d, or never)"
  case $1 in
    *d) echo $((n * 86400)) ;;
    *h) echo $((n * 3600)) ;;
    *) die "bad --ttl '$1' (use 12h, 7d, or never)" ;;
  esac
}

# --- tunnel token storage: token_cmd in config > macOS Keychain > 0600 file ---

token_file="$config_dir/tunnel-token"
token_read() {
  local cmd; cmd="$(cfg token_cmd || true)"
  if [[ -n $cmd ]]; then eval "$cmd"; return; fi
  if command -v security >/dev/null; then
    security find-generic-password -a share -s "share-tunnel:$host_name" -w 2>/dev/null && return
  fi
  [[ -f $token_file ]] && cat "$token_file"
}
token_store() { # token_store <token>; stdin only, so the token never shows in ps
  if command -v security >/dev/null; then
    printf 'add-generic-password -U -a share -s "share-tunnel:%s" -w "%s"\n' "$host_name" "$1" | security -i >/dev/null
    echo "keychain (service share-tunnel:$host_name)"
  else
    (umask 077 && printf '%s' "$1" >"$token_file")
    echo "$token_file (mode 600)"
  fi
}
token_forget() {
  if command -v security >/dev/null; then
    security delete-generic-password -a share -s "share-tunnel:$host_name" >/dev/null 2>&1 || true
  fi
  [[ -f $token_file ]] && to_trash "$token_file"
  return 0
}

# --- snapshots ---

write_md_style() { # the reading stylesheet, shared by pandoc renders and gen_index
  cat >"$root/md-style.html" <<'CSS'
<style>
/* Spacedown's "paper" reading theme (dwarvesf/spacedown assets/paper-theme.css) on pandoc's default template. */
:root { --paper-bg:#fbfaf7; --paper-fg:#242321; --paper-muted:#6e6c67; --paper-rule:#dcd9d2; --paper-rule-strong:#b9b5ac; --paper-link:#2b5f91; --paper-code-bg:#f0eee9; --paper-mark:#f6e7a8;
  --paper-font-sans:"iA Writer Quattro V", "iA Writer Quattro S", -apple-system, "Helvetica Neue", Arial, sans-serif;
  --paper-font-mono:"iA Writer Mono V", "iA Writer Mono S", ui-monospace, "SF Mono", Menlo, monospace; }
@media (prefers-color-scheme: dark) { :root { --paper-bg:#19191b; --paper-fg:#dedcd6; --paper-muted:#9c9a94; --paper-rule:#34343a; --paper-rule-strong:#55555c; --paper-link:#8bb8e8; --paper-code-bg:#242428; --paper-mark:#5c4f1e; } }
html { background:var(--paper-bg); color:var(--paper-fg); -webkit-text-size-adjust:100%; }
body { max-width:44rem; margin:0 auto; padding:2.2rem 1.6rem 4rem; font:17px/1.62 var(--paper-font-sans); font-kerning:normal; text-rendering:optimizeLegibility; }
h1,h2,h3,h4,h5,h6 { font-weight:650; letter-spacing:-0.005em; margin:2em 0 .6em; }
h1 { font-size:1.6em; line-height:1.25; margin-top:0; } h2 { font-size:1.3em; line-height:1.3; } h3 { font-size:1.1em; line-height:1.4; } h4,h5,h6 { font-size:1em; } h6 { color:var(--paper-muted); }
p, ul, ol, dl, blockquote, pre, table, figure { margin:0 0 1.1em; }
ul, ol { padding-left:1.6em; } li + li { margin-top:.25em; } li > p, li > ul, li > ol { margin:.2em 0; } li::marker { color:var(--paper-muted); }
a { color:var(--paper-link); text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.18em; text-decoration-color:color-mix(in srgb, var(--paper-link) 35%, transparent); overflow-wrap:anywhere; }
a:hover { text-decoration-color:var(--paper-link); }
blockquote { margin-left:0; padding:0 1em; border-left:3px solid var(--paper-rule); color:var(--paper-muted); }
blockquote p:last-child { margin-bottom:0; }
code, kbd, samp, pre { font-family:var(--paper-font-mono); font-size:.9em; }
code { background:var(--paper-code-bg); padding:.1em .3em; border-radius:4px; overflow-wrap:anywhere; }
pre, pre.sourceCode { background:var(--paper-code-bg); padding:.9rem 1rem; border-radius:6px; overflow-x:auto; line-height:1.55; } /* pandoc sets .sourceCode transparent */
div.sourceCode { overflow:visible; margin:0 0 1.1em; }
pre code { background:none; padding:0; font-size:inherit; white-space:pre; }
/* Spacedown sizes table columns with a script; here a wide table scrolls as a block instead. */
table { display:block; width:max-content; max-width:100%; overflow-x:auto; border-collapse:collapse; font-size:.9em; line-height:1.6; font-variant-numeric:tabular-nums; }
th, td { padding:.5em 1em .5em 0; text-align:left; vertical-align:top; }
thead th { font-weight:650; border-bottom:1px solid var(--paper-rule-strong); }
tbody tr + tr td { border-top:1px solid var(--paper-rule); }
img, video, svg { max-width:100%; height:auto; }
p:has(> img:only-child) { margin-bottom:.6em; } p:has(> img:only-child) + p { font-size:.85em; line-height:1.5; color:var(--paper-muted); }
mark { background:var(--paper-mark); color:inherit; }
hr { border:0; border-top:1px solid var(--paper-rule); margin:2em 0; }
</style>
CSS
}

render_md() { # render every .md under <dir> to a sibling .html; .md links become .html
  command -v pandoc >/dev/null || return 0
  local filter="$root/md-links.lua" style="$root/md-style.html" f out katex
  cat >"$filter" <<'LUA'
function Link(el)
  if not el.target:match("^%a+:") then
    el.target = el.target:gsub("%.md$", ".html"):gsub("%.md#", ".html#")
  end
  return el
end
LUA
  write_md_style
  find "$1" -type f -name '*.md' | while IFS= read -r f; do
    out="${f%.md}.html"
    [[ -e $out ]] && continue
    katex=""; grep -q '\$' "$f" && katex="--katex" # KaTeX from the CDN, only for pages with math
    # shellcheck disable=SC2086
    pandoc --quiet -s "$f" -o "$out" --lua-filter "$filter" --include-in-header "$style" \
      --from=markdown-smart-implicit_figures --syntax-highlighting tango --metadata pagetitle="$(basename "$f" .md)" $katex \
      || echo "share: could not render $f" >&2
  done
}

urlenc() { # urlenc <str>: sets urlenc_out; fork-free byte loop, keeps A-Za-z0-9-_.~ and '/', %XX (uppercase) for the rest
  local LC_ALL=C s="$1" out="" c i n
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    case $c in
      [A-Za-z0-9._~/-]) out+="$c" ;;
      *) printf -v c '%d' "'$c"; printf -v c '%%%02X' $((c & 255)); out+="$c" ;;  # masked: bash 3.2 sign-extends bytes above 127
    esac
  done
  urlenc_out="$out"
}

gen_index() { # gen_index <stage>: a folder with no index of its own gets a generated listing
  [[ -f $1/index.html || -f $1/README.html ]] && return 0
  local files f enc label
  files="$(cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"
  write_md_style
  {
    echo '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>index</title>'
    cat "$root/md-style.html"
    echo '</head><body><ul>'
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      if [[ $f == *.md && -f $1/${f%.md}.html ]]; then continue; fi  # listed by its render below
      urlenc "$f"; enc="$urlenc_out"
      label="$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$f")"
      printf '<li><a href="%s">%s</a></li>\n' "$enc" "$label"
    done <<<"$files"
    echo '</ul></body></html>'
  } >"$1/index.html"
}

copy() { # copy <src> <id> [opts]: regular files only, so dotfiles (.git, .env) and symlinks (to ~/.ssh) never ship
  local parent name stage skipped
  parent="$(dirname "$1")"; name="$(basename "$1")"
  mkdir -p "$pub"
  stage="$(mktemp -d "$root/.stage.XXXXXX")"
  (cd "$parent" && find "$name" -name '.*' -prune -o -type f -print | while IFS= read -r f; do
    mkdir -p "$stage/$(dirname "$f")" && cp -p "$f" "$stage/$f"
  done)
  skipped="$(cd "$parent" && find "$name" -name '.*' -prune -o -type l -print | wc -l | tr -d ' ')"
  [[ $skipped -gt 0 ]] && echo "share: skipped $skipped symlink(s)" >&2
  if [[ -z "$(find "$stage" -type f | head -1)" ]]; then
    rm -rf "$stage"; die "nothing to share in $1 (dotfiles and symlinks are skipped)"
  fi
  render_md "$stage"          # a rendered README.md makes README.html, which suppresses gen_index
  local payload="$stage"      # a folder is listed at its own root; a bare file lists under <id>
  [[ -d $stage/$name ]] && payload="$stage/$name"
  has_opt noindex "${3:-}" || gen_index "$payload"
  [[ -d $pub/$2 ]] && mv "$pub/$2" "$stage.old"
  mv "$stage" "$pub/$2"
  rm -rf "$stage.old"
}

warn_private() { # a share out of a private GitHub repo is almost always a mistake
  command -v gh >/dev/null || return 0
  local d="$1" top repo
  [[ -d $d ]] || d="$(dirname "$d")"
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
  repo="$(git -C "$top" remote get-url origin 2>/dev/null)" || return 0
  repo="$(sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##' <<<"$repo")"
  [[ $repo == */* && $repo != *:* ]] || return 0
  if [[ "$(gh repo view "$repo" --json isPrivate -q .isPrivate 2>/dev/null)" == true ]]; then
    echo "share: WARNING: this comes from the PRIVATE repo $repo and is now public to anyone with the link (share rm $2 to undo)" >&2
  fi
}

parse_target() { # parse_target <arg>: "live <port>" for a port/localhost shape, "snapshot" for a path
  local p=""
  case $1 in
    http://localhost:*|http://127.0.0.1:*) p="${1#http://*:}"; p="${p%/}" ;;
    localhost:*|127.0.0.1:*) p="${1#*:}" ;;
    *[!0-9]*|""|?|??????*) [[ -e $1 ]] && { echo snapshot; return 0; }; return 1 ;;
    *) p="$1" ;;   # two to five digits: a bare port, never a path
  esac
  case $p in *[!0-9]*|"") return 1 ;; esac
  echo "live $p"
}

cmd_add() {
  local ttl="${SHARE_TTL:-$(cfg ttl || true)}"; ttl="${ttl:-30d}" noindex="" host_fqdn="" target="" ntargets=0
  local usage="usage: share add [--ttl 7d] [--host <name>.<zone>] [--no-index] <file|dir|port|localhost:port|http://localhost:port>"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --ttl) ttl="${2:-}"; shift 2 || die "$usage" ;;
      --host) host_fqdn="${2:-}"; shift 2 || die "$usage" ;;
      --no-index) noindex=1; shift ;;
      --*) die "$usage" ;;
      *) target="$1"; ntargets=$((ntargets + 1)); shift ;;
    esac
  done
  [[ $ntargets == 1 ]] || die "$usage"
  [[ -z $host_fqdn || $mode != quick ]] || die "--host needs a named tunnel: 'share teardown', then 'share setup <hostname>'"
  local pt kind tport="" src name id exp=0 url opts="" secs
  pt="$(parse_target "$target")" || die "$usage"
  if [[ $pt == snapshot ]]; then
    kind=snapshot
  else
    kind=live; tport="${pt#live }"
    [[ $tport -ge 1024 ]] || die "$tport is below 1024; a share of a system service is never a dev server"
    [[ $tport -le 65535 ]] || die "$tport is above 65535; no such port"
    [[ $tport != "$port" ]] || die "$tport is this share server's own port"
    [[ $tport != "$metrics_port" ]] || die "$tport is the tunnel metrics port"
  fi
  need_host
  secs="$(ttl_secs "$ttl")"
  if [[ $kind == live ]]; then
    name="localhost:$tport"; src="http://127.0.0.1:$tport"; opts="live"
  else
    src="$(realpath "$target")"; name="$(basename "$src")"
    case $name in *$'\t'*|*$'\n'*) die "names with tabs or newlines are not supported" ;; esac
  fi
  [[ -n $noindex ]] && opts="${opts:+$opts }noindex"
  if [[ -n $host_fqdn ]]; then
    host_check "$host_fqdn"
    opts="${opts:+$opts }host=$host_fqdn"
  fi
  id="$(rand_id)"
  [[ $secs -gt 0 ]] && exp=$(($(date +%s) + secs))
  # shellcheck disable=SC2174 # the leaf ($root) is what needs 700: it holds the admin socket
  mkdir -p -m 700 "$root"; mkdir -p "$pub"
  # stage the payload before any Cloudflare write: a copy failure must not orphan DNS or ingress
  if [[ $kind == live ]]; then
    echo "share: live share: anyone with the link reaches 127.0.0.1:$tport while this machine is awake" >&2
    [[ -z $host_fqdn && $mode != quick ]] && echo "share: apps that use absolute asset paths (/static/...) break under a path prefix; use --host <name>.<zone>" >&2
    curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$tport/" || echo "share: nothing answers on 127.0.0.1:$tport yet" >&2
  else
    copy "$src" "$id" "$opts"
    warn_private "$src" "$id"
  fi
  [[ -n $host_fqdn ]] && host_add "$host_fqdn"
  lock_take index   # publish: row, render, reload as one step, so no writer's row or render is lost
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$src" "$(date +%F)" "$exp" "$opts" >>"$index"
  write_caddyfile
  caddy_reload
  lock_release index   # before cmd_start: serve's startup render takes the lock itself
  share_url "$id" "$name" "$opts"
  url="$share_url_out"
  echo "$url"
  if [[ ${SHARE_CLIPBOARD:-1} == 1 ]] && command -v pbcopy >/dev/null; then
    printf '%s' "$url" | pbcopy && echo "  (link copied)"
  fi
  if ! running; then
    if host_ok; then cmd_start; else echo "  (not serving: $(this_host) is not in hosts=$hosts)"; fi
  fi
}

cmd_ls() {
  [[ -s $index ]] || { echo "no shares"; return 0; }
  local id name src date exp opts size until gone
  while IFS=$'\t' read -r id name src date exp opts; do
    until="never"; [[ ${exp:-0} -gt 0 ]] && until="$(day_of "$exp")"
    share_url "$id" "$name" "$opts"
    echo "$share_url_out"
    if has_opt live "$opts"; then
      echo "    id=$id  live -> $src  added=$date  expires=$until"
    else
      size="$(du -sh "$pub/$id" 2>/dev/null | cut -f1 | tr -d ' ')"
      gone=""; [[ -e $src ]] || gone="  (source gone, snapshot still served)"
      echo "    id=$id  size=${size:-?}  added=$date  expires=$until  from=$src$gone"
    fi
  done < <(awk -F'\t' 'NF==5||NF==6' "$index")   # a 5-field row (v0.1.x) reads with opts empty; malformed rows are skipped
}

cmd_refresh() {
  local r src opts
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  if has_opt live "$opts"; then echo "live share, nothing to refresh" >&2; return 0; fi
  src="$(cut -f3 <<<"$r")"
  [[ -e $src ]] || die "source is gone: $src (the snapshot keeps serving; share rm $1 to unpublish)"
  copy "$src" "$1" "$opts"
  lock_take index
  # a concurrent rm may have dropped the row while copy ran outside the lock;
  # recheck it here before trusting the fresh mv into $pub/$1 (see cmd_rm).
  if [[ -z "$(row "$1")" ]]; then
    [[ -d $pub/$1 ]] && to_trash "$pub/$1"
    lock_release index
    die "$1 was removed during refresh"
  fi
  write_caddyfile   # a refresh can add or remove index.html, which flips try_files
  caddy_reload
  lock_release index
  echo "refreshed $1 from $src"
}

cmd_rm() { # cmd_rm <id> [prune]: prune passes through with no credential, so expiry is never blocked (DEC-016)
  local r opts fqdn="" tmp
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  fqdn="$(opt_val host "$opts" || true)"
  if [[ ${SHARE_HOST_DRY:-0} != 1 && -n $fqdn && ${2:-} != prune && -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
    die "no Cloudflare credential for $fqdn; set CLOUDFLARE_API_TOKEN or run share setup --login, then rm again"
  fi
  [[ -n $fqdn ]] && host_rm "$fqdn"
  lock_take index
  tmp="$(mktemp "$root/.index.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$index" >"$tmp" && mv -f "$tmp" "$index"
  [[ -d $pub/$1 ]] && to_trash "$pub/$1"
  write_caddyfile
  caddy_reload
  lock_release index
  echo "unpublished $1"
}

cmd_prune() { # unpublish every share past its expiry
  [[ -s $index ]] || return 0
  local now ids id
  now="$(date +%s)"
  # a for loop, not `| while`: bash 5.3 skips the EXIT trap of a lock taken in a while-loop subshell
  ids="$(awk -F'\t' -v now="$now" '(NF==5||NF==6) && $5 > 0 && $5 < now {print $1}' "$index")"
  for id in $ids; do
    cmd_rm "$id" prune | sed 's/$/ (expired)/'
  done
}

cmd_hits() {
  local r opts fqdn="" log="$root/access.log"
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  fqdn="$(opt_val host "$opts" || true)"
  [[ -s $log ]] || { echo "0 hits"; return 0; }
  jq -rn --arg p "/$1/" --arg h "$fqdn" '
    def n($k; $w): "\($k) \($w)\(if $k == 1 then "" else "s" end)";
    [inputs | select((if $h == "" then (.request.uri | startswith($p)) else .request.host == $h end) and .status < 400)] as $h
    | n($h | length; "hit") + ", "
      + n($h | map(.request.headers["Cf-Connecting-Ip"][0] // .request.remote_ip) | unique | length; "visitor")
      + (if ($h | length) > 0 then ", last \($h[-1].ts | floor | strflocaltime("%F %H:%M"))" else "" end)' "$log"
}

# --- serving ---

write_caddyfile() { # rendered from index.tsv; no-store: Cloudflare must not cache past rm or stop
  local id name src date exp opts fqdn sroot tmp
  tmp="$(mktemp "$root/.Caddyfile.XXXXXX")"   # rendered aside and moved in: caddy never reads half a file
  {
    cat <<EOF
{
	admin unix//$root/admin.sock
	auto_https off
}
http://:$port {
	bind 127.0.0.1
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	log {
		output file "$root/access.log"
		format json
	}
EOF
    if [[ -s $index ]]; then
      while IFS=$'\t' read -r id name src date exp opts; do
        fqdn="$(opt_val host "$opts" || true)"
        if has_opt live "$opts" && [[ -z $fqdn ]]; then
          printf '\thandle_path /%s/* {\n\t\treverse_proxy http://127.0.0.1:%s\n\t}\n' "$id" "${src##*:}"
        fi
      done < <(awk -F'\t' 'NF==5||NF==6' "$index")
    fi
    cat <<EOF
	handle /healthz {
		respond "ok" 200
	}
	handle {
		root * "$pub"
		file_server {
			index index.html README.html
		}
	}
}
EOF
    if [[ -s $index ]]; then
      while IFS=$'\t' read -r id name src date exp opts; do
        fqdn="$(opt_val host "$opts" || true)"
        [[ -n $fqdn ]] || continue
        cat <<EOF
http://$fqdn:$port {
	bind 127.0.0.1
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	log {
		output file "$root/access.log"
		format json
	}
EOF
        if has_opt live "$opts"; then
          printf '\treverse_proxy http://127.0.0.1:%s\n' "${src##*:}"
        else
          # folder payloads sit at pub/<id>/<name>; files sit directly under pub/<id>
          sroot="$pub/$id"
          [[ -d $pub/$id/$name ]] && sroot="$pub/$id/$name"
          printf '\troot * "%s"\n' "$sroot"
          [[ -f $sroot/index.html ]] && printf '\ttry_files {path} /index.html\n'
          printf '\tfile_server {\n\t\tindex index.html README.html\n\t}\n'
        fi
        printf '}\n'
      done < <(awk -F'\t' 'NF==5||NF==6' "$index")
    fi
  } >"$tmp"
  mv -f "$tmp" "$root/Caddyfile"
}

caddy_reload() { # apply Caddyfile changes over the admin socket; a failure warns, never kills
  running || return 0
  local err
  if ! err="$(caddy reload --config "$root/Caddyfile" --adapter caddyfile 2>&1)"; then
    echo "share: caddy reload failed: $err; see $root/caddy.log" >&2
  fi
}

cmd_serve() {
  host_ok || die "$(this_host) is not in hosts=$hosts; serve from one machine only (a second one splits requests)"
  running && die "already serving (pid $(cat "$pidfile"))"
  # shellcheck disable=SC2174 # the leaf ($root) is what needs 700: it holds the admin socket
  mkdir -p -m 700 "$root"; mkdir -p "$pub"
  cmd_prune   # before the render, so the Caddyfile never carries expired rows
  # locks are taken only here, before serve's own EXIT trap replaces release_locks
  lock_take index
  write_caddyfile
  lock_release index
  local token=""
  # pids stay global: the EXIT trap must still see them when cmd_serve returns
  # normally (e.g. cloudflared dies, wait returns) and locals unbind first.
  caddy_pid="" loop_pid="" tunnel_pid=""
  if [[ $tunnel == 1 && $mode != quick ]]; then
    need_host
    token="$(token_read || true)"
    [[ -n $token ]] || die "no tunnel token for $host_name: run 'share setup $host_name'"
  fi
  echo $$ >"$pidfile"
  caddy run --config "$root/Caddyfile" --adapter caddyfile >>"$root/caddy.log" 2>&1 &
  caddy_pid=$!
  # The prune loop redirects to the log: inheriting serve's stdout would let an
  # orphaned sleep hold a caller's $( ) pipe open for an hour after serve dies.
  (while sleep 3600; do bash "$0" prune || true; done) >>"$root/serve.log" 2>&1 &
  loop_pid=$!
  # The trap lands before the tunnel work and reads the pids at run time:
  # a die in the quick-URL parse must still reap caddy and the prune loop.
  # pkill first: the loop's current sleep is a grandchild kill(1) can't reach.
  trap 'release_locks; [[ -n ${loop_pid:-} ]] && pkill -P "$loop_pid" 2>/dev/null; kill ${caddy_pid:-} ${loop_pid:-} ${tunnel_pid:-} 2>/dev/null; wait 2>/dev/null; rm -f "$pidfile" "$root/quick.url"' EXIT
  trap 'exit 0' INT TERM
  if [[ $tunnel == 1 && $mode == quick ]]; then
    # quick tunnel: no token, no DNS; cloudflared prints a random trycloudflare URL.
    # Only lines written after this spawn count: the log can hold a stale URL.
    local loglines=0 qu="" _
    [[ -f $root/cloudflared.log ]] && loglines="$(wc -l <"$root/cloudflared.log")"
    rm -f "$root/quick.url"
    cloudflared tunnel --no-autoupdate --url "http://127.0.0.1:$port" --metrics "127.0.0.1:$metrics_port" >>"$root/cloudflared.log" 2>&1 &
    tunnel_pid=$!
    for _ in $(seq 1 150); do
      qu="$(tail -n "+$((loglines + 1))" "$root/cloudflared.log" 2>/dev/null | grep -oE 'https://[a-z0-9.-]+\.trycloudflare\.com' | head -1 || true)"
      [[ -n $qu ]] && break
      # kill -0 alone lies for an unreaped child (zombie): check the state too
      if ! kill -0 "$tunnel_pid" 2>/dev/null || [[ $(ps -o stat= -p "$tunnel_pid" 2>/dev/null) == Z* ]]; then
        die "cloudflared died before printing a URL; see $root/cloudflared.log"
      fi
      sleep 0.2
    done
    [[ -n $qu ]] || die "cloudflared printed no trycloudflare URL after 30s; see $root/cloudflared.log"
    echo "${qu#https://}" >"$root/quick.url"
  elif [[ $tunnel == 1 ]]; then
    TUNNEL_TOKEN="$token" cloudflared tunnel --no-autoupdate --loglevel warn --grace-period 2s --metrics "127.0.0.1:$metrics_port" run &
    tunnel_pid=$!
  fi
  # Wait for the children, so the next serve never meets a dying cloudflared still answering /ready.
  sleep 1
  kill -0 "$caddy_pid" 2>/dev/null || die "caddy failed to start, see $root/caddy.log"
  local display="${host_name:-127.0.0.1:$port}"
  [[ $mode == quick ]] && display="$(serving_host)"
  echo "serving $pub on $display (pid $$)"
  wait "${tunnel_pid:-$caddy_pid}"
}


# --- background service: launchd on macOS, systemd --user on Linux ---

svc_label="${SHARE_SERVICE_LABEL:-foundation.d.share}"
svc_plist="$HOME/Library/LaunchAgents/$svc_label.plist"
svc_unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$svc_label.service"
svc_installed() { [[ -f $svc_plist || -f $svc_unit ]]; }

self_path() { # the stable path to this script: the PATH entry when it resolves here
  local s; s="$(command -v share 2>/dev/null || true)"
  if [[ -n $s && "$(realpath "$s")" == "$(realpath "$0")" ]]; then echo "$s"; else realpath "$0"; fi
}
svc_unload() { # bootout returns before launchd lets the job go; a bootstrap right after fails with error 5
  launchctl bootout "gui/$(id -u)/$svc_label" 2>/dev/null || true
  local _
  for _ in $(seq 1 20); do launchctl print "gui/$(id -u)/$svc_label" >/dev/null 2>&1 || return 0; sleep 0.5; done
}
svc_load() { launchctl bootstrap "gui/$(id -u)" "$svc_plist" 2>/dev/null || { sleep 1; launchctl bootstrap "gui/$(id -u)" "$svc_plist"; }; }
svc_path() { # PATH for the service: the directories of every tool share calls
  local p="" c d
  for c in caddy cloudflared jq curl pandoc gh trash security; do
    d="$(dirname "$(command -v "$c" 2>/dev/null || echo /usr/bin/x)")"
    case ":$p:" in *":$d:"*) ;; *) p="${p:+$p:}$d" ;; esac
  done
  echo "$p:/usr/bin:/bin:/usr/sbin:/sbin"
}
xml() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }

svc_install() {
  local self; self="$(self_path)"
  running && ! svc_installed && cmd_stop >/dev/null
  mkdir -p "$root"
  if [[ $(uname -s) == Darwin ]]; then
    mkdir -p "$(dirname "$svc_plist")"
    cat >"$svc_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>$svc_label</string>
	<key>ProgramArguments</key><array><string>$(xml "$self")</string><string>serve</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
	<key>ThrottleInterval</key><integer>30</integer>
	<key>EnvironmentVariables</key><dict>
		<key>PATH</key><string>$(xml "$(svc_path)")</string>
		<key>SHARE_CONFIG_DIR</key><string>$(xml "$config_dir")</string>
		<key>SHARE_ROOT</key><string>$(xml "$root")</string>
	</dict>
	<key>StandardOutPath</key><string>$(xml "$root/serve.log")</string>
	<key>StandardErrorPath</key><string>$(xml "$root/serve.log")</string>
</dict>
</plist>
EOF
    svc_unload
    svc_load
  elif command -v systemctl >/dev/null; then
    mkdir -p "$(dirname "$svc_unit")"
    cat >"$svc_unit" <<EOF
[Unit]
Description=share: publish local snapshots through a Cloudflare Tunnel
After=network-online.target

[Service]
ExecStart="$self" serve
Environment="PATH=$(svc_path)" "SHARE_CONFIG_DIR=$config_dir" "SHARE_ROOT=$root"
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now "$svc_label.service" >/dev/null
  else
    die "no launchd or systemd here; use 'share start' instead"
  fi
}

svc_uninstall() {
  if [[ -f $svc_plist ]]; then
    svc_unload
    to_trash "$svc_plist"
  fi
  if [[ -f $svc_unit ]]; then
    systemctl --user disable --now "$svc_label.service" >/dev/null 2>&1 || true
    to_trash "$svc_unit"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
  return 0
}

wait_running() { # wait_running <seconds>: the server is up and, with the tunnel, connected to Cloudflare
  local i
  for ((i = 0; i < $1 * 2; i++)); do
    if running; then
      if [[ $tunnel != 1 ]]; then return 0
      elif [[ $mode == quick ]]; then [[ -s $root/quick.url ]] && return 0
      elif curl -sf -o /dev/null "http://127.0.0.1:$metrics_port/ready"; then return 0; fi
    fi
    sleep 0.5
  done
  return 1
}

cmd_service() {
  case "${1:-status}" in
    install)
      host_ok || die "$(this_host) is not in hosts=$hosts"
      svc_install
      wait_running 10 || die "the service did not start, see $root/serve.log"
      warn_not_live
      echo "service installed ($svc_label): serving now and at every login" ;;
    uninstall)
      svc_uninstall; echo "service removed; links are down until 'share start'" ;;
    status)
      if svc_installed; then echo "service: installed ($svc_label)"; else echo "service: not installed"; fi ;;
    *) die "usage: share service install|uninstall|status" ;;
  esac
}

cmd_start() {
  running && { echo "already serving (pid $(cat "$pidfile"))"; return 0; }
  host_ok || die "$(this_host) is not in hosts=$hosts; serve from one machine only (a second one splits requests)"
  mkdir -p "$root"
  if svc_installed; then
    if [[ -f $svc_plist ]]; then
      svc_load 2>/dev/null || launchctl kickstart "gui/$(id -u)/$svc_label"
    else
      systemctl --user start "$svc_label.service"
    fi
  else
    nohup bash "$0" serve >>"$root/serve.log" 2>&1 &
  fi
  wait_running 10 || die "server did not start, see $root/serve.log"
  warn_not_live
  echo "  serving in the background (pid $(cat "$pidfile")); share stop to end"
}

# The tunnel reports ready before caddy may listen, and the Cloudflare edge keeps routing to an
# old connection for a few seconds after a restart. Only a public fetch proves a link works.
live_check() { # live_check <seconds> [host]: a probe file answers 200 through the public hostname, 3 times in a row
  # One 200 is not enough: during a handover the edge still sends some requests to the old connection.
  local probe code streak=0 _ h
  h="${2:-$(serving_host)}"
  [[ -n $h ]] || return 1
  probe="_probe-$(rand_id).txt"
  mkdir -p "$pub" && echo ok >"$pub/$probe"
  for _ in $(seq 1 "$1"); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 --doh-url https://1.1.1.1/dns-query "https://$h/$probe" 2>/dev/null ||
      curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$h/$probe" || true)"
    if [[ $code == 200 ]]; then streak=$((streak + 1)); else streak=0; fi
    [[ $streak -ge 3 ]] && break
    sleep 1
  done
  rm -f "$pub/$probe"
  [[ $streak -ge 3 ]]
}
warn_not_live() {
  [[ ${SHARE_LIVE_CHECK:-1} == 1 ]] || return 0   # test seam: no public probe in the suite
  local h; h="$(serving_host)"
  [[ $tunnel == 1 && -n $h ]] || return 0
  live_check 20 "$h" || echo "  share: https://$h/ is not answering yet; see $root/serve.log" >&2
}

cmd_stop() {
  running || { echo "not serving"; return 0; }
  local pid; pid="$(cat "$pidfile")"
  if [[ -f $svc_plist ]]; then svc_unload
  elif [[ -f $svc_unit ]]; then systemctl --user stop "$svc_label.service"
  else kill "$pid"; fi
  while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
  rm -f "$root/quick.url"
  if svc_installed; then echo "stopped (all links down; the service starts again at next login)"
  else echo "stopped (all links down)"; fi
}

cmd_status() {
  cmd_prune
  if running; then
    if [[ $mode == quick ]]; then
      echo "serving (pid $(cat "$pidfile")) on https://$(serving_host) (quick tunnel; the URL changes on every start)"
    else
      echo "serving (pid $(cat "$pidfile")) on $host_name: links are live"
    fi
  elif [[ -z $host_name && $mode != quick ]]; then echo "not set up: share setup <hostname>, or share setup --quick"
  else echo "not serving: share start"; fi
  svc_installed && echo "service: installed ($svc_label)"
  cmd_ls
}

# --- Cloudflare setup / teardown ---
#
# Two ways to authorize. With CLOUDFLARE_API_TOKEN set, share uses the API for
# everything. Without it, share runs `cloudflared tunnel login`: the user picks
# the zone in a browser and Cloudflare hands back a cert.pem whose token may
# manage tunnels but not DNS records. That path creates DNS through
# `cloudflared tunnel route dns` and checks the hostname through public DNS.

cf_token="" account="" auth="" zone_name="" zone_id="" tun_id=""
cf() { # cf METHOD PATH [JSON]; the token goes through a header file, never argv
  local out
  out="$(curl -sS --max-time 30 -X "$1" "$api$2" -H @<(printf 'Authorization: Bearer %s\n' "$cf_token") \
    -H 'Content-Type: application/json' ${3:+--data "$3"})" || die "Cloudflare API $1 $2: request failed"
  if [[ "$(jq -r '.success' <<<"$out" 2>/dev/null)" != true ]]; then
    die "Cloudflare API $1 $2 failed: $(jq -c '.errors' <<<"$out" 2>/dev/null || head -c 300 <<<"$out")"
  fi
  printf '%s' "$out"
}
doh() { curl -s --max-time 10 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$1&type=$2"; }
public_zone() { # the zone apex that owns $1, from public DNS
  doh "$1" SOA | jq -r '[(.Answer // [])[], (.Authority // [])[]] | map(select(.type == 6)) | .[0].name // empty' | sed 's/\.$//'
}
resolves() { [[ "$(doh "$1" A | jq '(.Answer // []) | length')" -gt 0 ]]; }

cert="$config_dir/cert.pem"
cert_field() { sed -n '/BEGIN ARGO TUNNEL TOKEN/,/END ARGO TUNNEL TOKEN/p' "$cert" | grep -v 'ARGO TUNNEL TOKEN' | base64 -d | jq -r ".$1 // empty"; }

auth_api() {
  cf_token="$CLOUDFLARE_API_TOKEN"; auth=api
  local status; status="$(cf GET /user/tokens/verify | jq -r .result.status)"
  echo "auth:       API token ($status)"
}
auth_login() { # auth_login <zone>: browser login unless a cert for this zone exists
  auth=login
  if [[ ! -f $cert || "$(cat "$config_dir/cert.zone" 2>/dev/null)" != "$1" ]]; then
    echo "auth:       opening Cloudflare in your browser. Pick $1, then click Authorize."
    local tmp; tmp="$(mktemp -d)"
    HOME="$tmp" cloudflared tunnel login >&2 || die "cloudflared login failed"
    [[ -f $tmp/.cloudflared/cert.pem ]] || die "the login returned no certificate"
    mkdir -p "$config_dir"
    mv -f "$tmp/.cloudflared/cert.pem" "$cert" && chmod 600 "$cert"
    echo "$1" >"$config_dir/cert.zone"
    rm -rf "$tmp"
  fi
  cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"
  [[ -n $cf_token && -n $account ]] || die "cannot read $cert; delete it and rerun setup"
  echo "auth:       browser login ($cert)"
}
cf_token_account() { cert_field accountID; }

cf_zone() { # API mode: prints "<zone_id> <account_id> <zone_name>" for the zone owning $host_name
  local cand="$host_name" r
  while [[ $cand == *.* ]]; do
    r="$(cf GET "/zones?name=$cand")"
    if [[ "$(jq '.result | length' <<<"$r")" -gt 0 ]]; then
      jq -r '.result[0] | "\(.id) \(.account.id) \(.name)"' <<<"$r"; return
    fi
    [[ $cand == *.*.* ]] || break
    cand="${cand#*.}"
  done
  die "no Cloudflare zone for $host_name in this token's accounts"
}

write_config_quick() { # quick mode: a mode flag and the serving facts, nothing Cloudflare
  hosts="${hosts:-$(this_host)}"
  mkdir -p "$config_dir"
  {
    echo "mode=quick"
    echo "hosts=$hosts"
    echo "port=$port"
  } >"$config.tmp"
  mv -f "$config.tmp" "$config"
}

cmd_setup_quick() {
  [[ -z $(cfg tunnel_id || true) ]] || die "already set up with a named tunnel; run 'share teardown' first"
  local missing="" c
  for c in caddy cloudflared jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  write_config_quick
  mode=quick   # the file is written; this process still read it as named at startup
  echo "mode:       quick tunnel (no domain, no login; links get a random trycloudflare.com URL)"
  host_ok || { echo "this host ($(this_host)) is not in hosts=$hosts; skipping the service"; return 0; }
  local service="${1:-1}"
  if [[ $service == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then
    svc_install; echo "service:    runs at login ($svc_label); the URL is new on every start"
  fi
  running || cmd_start >/dev/null 2>&1
  local q; q="$(serving_host)"
  [[ -n $q ]] || die "serving but no trycloudflare URL yet; see $root/cloudflared.log"
  warn_not_live
  echo "ready:      https://$q/ is live. The URL changes on every start. Next: share add <file|dir>"
}

write_config() { # write_config <tunnel_id> <tunnel_name>; keeps a token_cmd line if there was one
  local keep; keep="$(cfg token_cmd || true)"
  hosts="${hosts:-$(this_host)}"
  mkdir -p "$config_dir"
  {
    echo "hostname=$host_name"
    echo "tunnel_id=$1"
    echo "tunnel_name=$2"
    echo "auth=$auth"
    echo "hosts=$hosts"
    echo "port=$port"
    [[ -n $zone_name ]] && echo "zone=$zone_name"
    [[ -n $keep ]] && echo "token_cmd=$keep"
  } >"$config.tmp"
  mv -f "$config.tmp" "$config"
}

# --- own hostnames: one CNAME + one ingress rule per --host share ---
#
# Create order is ingress, DNS, then the index row; delete order is DNS,
# ingress, then the row. SHARE_HOST_DRY=1 skips every Cloudflare call and
# records the intended calls, one per line, in $root/host-calls.log.

host_zone() { # the zone every --host name lives under; learned once, kept in config
  [[ -n $zone_name ]] && return 0
  zone_name="$(cfg zone || true)"
  if [[ -z $zone_name ]]; then
    if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then zone_name="${host_name#*.}"
    else zone_name="$(public_zone "$host_name")"; fi
    [[ -n $zone_name ]] || die "cannot find the DNS zone of $host_name; is the domain on Cloudflare?"
    mkdir -p "$config_dir"; grep -q '^zone=' "$config" 2>/dev/null || echo "zone=$zone_name" >>"$config"
  fi
}

host_check() { # host_check <fqdn>: credential and name are settled before any write
  local fqdn="$1" label
  if [[ ${SHARE_HOST_DRY:-0} != 1 && -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
    die "--host needs CLOUDFLARE_API_TOKEN or a browser login (share setup --login)"
  fi
  host_zone
  case $fqdn in
    *."$zone_name") label="${fqdn%."$zone_name"}" ;;
    *) die "--host must be one label under $zone_name (Universal SSL stops at one level)" ;;
  esac
  case $label in
    ""|*.*|*[!a-z0-9-]*|-*|*-)
      die "--host must be one label under $zone_name (Universal SSL stops at one level)" ;;
  esac
}

host_auth() { # cf_token, account, zone_id, tun_id for Cloudflare-side host work
  [[ -n $cf_token && -n $account && -n $zone_id && -n $tun_id ]] && return 0
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    cf_token="$CLOUDFLARE_API_TOKEN"; auth=api
  elif [[ -f $cert ]]; then
    cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"; auth=login
  else
    die "--host needs CLOUDFLARE_API_TOKEN or a browser login (share setup --login)"
  fi
  [[ -n $cf_token ]] || die "--host needs CLOUDFLARE_API_TOKEN or a browser login (share setup --login)"
  local z; z="$(cf GET "/zones?name=$zone_name")"
  zone_id="$(jq -r '.result[0].id // empty' <<<"$z")"
  account="${account:-$(jq -r '.result[0].account.id // empty' <<<"$z")}"
  [[ -n $zone_id && -n $account ]] || die "the credential cannot see the $zone_name zone"
  tun_id="$(cfg tunnel_id || true)"
  [[ -n $tun_id ]] || die "no tunnel_id in $config; run 'share setup' first"
}

host_lock() { lock_take host "${SHARE_HOST_LOCK_TIMEOUT:-60}"; }   # one Cloudflare-side edit at a time
host_unlock() { lock_release host; }   # as soon as the edit lands; the EXIT trap is the die-path backstop

ingress_get() { # the tunnel config as {"config":{"ingress":[...]}}; dry mode reads a fixture
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    if [[ -f $root/host-fixture.json ]]; then cat "$root/host-fixture.json"
    else printf '{"config":{"ingress":[{"hostname":"%s","service":"http://127.0.0.1:%s"},{"service":"http_status:404"}]}}' "$host_name" "$port"; fi
    return 0
  fi
  cf GET "/accounts/$account/cfd_tunnel/$tun_id/configurations" | jq -c '.result'
}

ingress_check() { # the catch-all stays last and the primary hostname first, else hands off
  jq -e --arg h "$host_name" '
    (.config.ingress | length) >= 2
    and (.config.ingress[-1].service == "http_status:404")
    and (.config.ingress[0].hostname == $h)' <<<"$1" >/dev/null \
    || die "tunnel ingress was edited outside share; fix it in the dashboard or rerun share setup --force"
}

ingress_put() { # ingress_put <config-json> <dry-log-word>
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "PUT ingress $2" >>"$root/host-calls.log"; return 0
  fi
  cf PUT "/accounts/$account/cfd_tunnel/$tun_id/configurations" "$(jq -c '{config:.config}' <<<"$1")" >/dev/null
}

host_add() { # host_add <fqdn>: collision guard, ingress rule, then the CNAME
  local fqdn="$1" rec="" rid="" rtype="" rcontent="" cfg_json new out
  if [[ ${SHARE_HOST_DRY:-0} != 1 ]]; then
    host_auth
    rec="$(cf GET "/zones/$zone_id/dns_records?name=$fqdn")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    rtype="$(jq -r '.result[0].type // empty' <<<"$rec")"
    rcontent="$(jq -r '.result[0].content // empty' <<<"$rec")"
    if [[ -n $rid && $rcontent != "$tun_id.cfargotunnel.com" ]]; then
      die "$fqdn already has a $rtype record ($rcontent); pick another hostname"
    fi
  fi
  host_lock
  cfg_json="$(ingress_get)"
  ingress_check "$cfg_json"
  new="$(jq -c --arg h "$fqdn" --arg s "http://127.0.0.1:$port" \
    '.config.ingress |= (.[:-1] + [{hostname:$h, service:$s, originRequest:{httpHostHeader:$h}}] + [.[-1]])' <<<"$cfg_json")"
  ingress_put "$new" "+1"
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "POST CNAME" >>"$root/host-calls.log"
  elif [[ -z $rid ]]; then
    # DNS comes after ingress; a POST failure puts the ingress back before dying
    if ! out="$(cf POST "/zones/$zone_id/dns_records" \
        "{\"type\":\"CNAME\",\"name\":\"$fqdn\",\"content\":\"$tun_id.cfargotunnel.com\",\"proxied\":true,\"comment\":\"share host\"}" 2>&1)"; then
      (ingress_put "$cfg_json" revert) || true
      if [[ $auth == login ]]; then
        die "the login cert cannot edit DNS records directly: export CLOUDFLARE_API_TOKEN with DNS Edit, or run share setup with the token"
      fi
      die "could not create the DNS record for $fqdn (the ingress change was reverted): $out"
    fi
  fi
  host_unlock
}

host_rm() { # host_rm <fqdn>: delete the CNAME, then the ingress rule; missing counts as done
  local fqdn="$1" cfg_json rec="" rid="" out
  host_lock
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "DELETE CNAME" >>"$root/host-calls.log"
  else
    if [[ -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
      echo "share: no Cloudflare credential; DNS and ingress for $fqdn stay behind" >&2
      host_unlock; return 0
    fi
    host_zone
    host_auth
    rec="$(cf GET "/zones/$zone_id/dns_records?name=$fqdn")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    if [[ -n $rid ]]; then
      if ! out="$(cf DELETE "/zones/$zone_id/dns_records/$rid" 2>&1)"; then
        if [[ $auth == login ]]; then
          die "the login cert cannot edit DNS records directly: export CLOUDFLARE_API_TOKEN with DNS Edit, or run share setup with the token"
        fi
        die "could not delete the DNS record for $fqdn: $out"
      fi
    fi
  fi
  cfg_json="$(ingress_get)"
  ingress_check "$cfg_json"
  cfg_json="$(jq -c --arg h "$fqdn" '.config.ingress |= map(select(.hostname != $h))' <<<"$cfg_json")"
  ingress_put "$cfg_json" "-1"
  host_unlock
}

cmd_setup() {
  local tunnel_name="" force=0 service=1 login=0 quick_setup=0 had_host_arg=0
  [[ -n ${1:-} && ${1:-} != --* ]] && { host_name="$1"; had_host_arg=1; shift; }
  while [[ $# -gt 0 ]]; do
    case $1 in
      --tunnel-name) tunnel_name="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      --no-service) service=0; shift ;;
      --login) login=1; shift ;;
      --quick) quick_setup=1; shift ;;
      *) die "usage: share setup [hostname] [--tunnel-name N] [--force] [--no-service] [--login] | share setup --quick [--no-service]" ;;
    esac
  done
  if [[ $quick_setup == 1 ]]; then
    [[ $had_host_arg == 0 && -z $tunnel_name && $force == 0 && $login == 0 ]] || die "usage: share setup --quick [--no-service]"
    cmd_setup_quick "$service"; return
  fi
  [[ $mode != quick ]] || die "already set up with a quick tunnel; run 'share teardown' first"
  if [[ -z $host_name && -t 0 ]]; then read -rp "Hostname for your links (for example s.example.com): " host_name; fi
  [[ $host_name =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || die "usage: share setup <hostname>, for example s.example.com"
  tunnel_name="${tunnel_name:-share-${host_name//./-}}"

  local missing="" c
  for c in caddy cloudflared jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"

  local zone="" zone_name za
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} && $login == 0 ]]; then
    auth_api
    za="$(cf_zone)"; read -r zone account zone_name <<<"$za"
  else
    zone_name="$(public_zone "$host_name")"
    [[ -n $zone_name ]] || die "cannot find the DNS zone of $host_name; is the domain on Cloudflare?"
    auth_login "$zone_name"
  fi
  echo "zone:       $zone_name"

  local t tid created=0
  t="$(cf GET "/accounts/$account/cfd_tunnel?name=$tunnel_name&is_deleted=false")"
  tid="$(jq -r '.result[0].id // empty' <<<"$t")"

  # Check the hostname before creating anything, so a taken name leaves no orphan tunnel.
  local rec="" rid="" rtype="" rcontent=""
  if [[ $auth == api ]]; then
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    rtype="$(jq -r '.result[0].type // empty' <<<"$rec")"
    rcontent="$(jq -r '.result[0].content // empty' <<<"$rec")"
    if [[ -n $rid && $force == 0 && ( -z $tid || $rcontent != "$tid.cfargotunnel.com" ) ]]; then
      die "$host_name already has a $rtype record ($rcontent); pick another hostname or rerun with --force"
    fi
  elif [[ -z $tid && $force == 0 ]] && resolves "$host_name"; then
    die "$host_name already resolves in public DNS; pick another hostname or rerun with --force"
  fi

  if [[ -n $tid ]]; then
    echo "tunnel:     reusing $tunnel_name"
  else
    tid="$(cf POST "/accounts/$account/cfd_tunnel" "{\"name\":\"$tunnel_name\",\"config_src\":\"cloudflare\"}" | jq -r .result.id)"
    created=1
    echo "tunnel:     created $tunnel_name"
  fi
  cf PUT "/accounts/$account/cfd_tunnel/$tid/configurations" \
    "{\"config\":{\"ingress\":[{\"hostname\":\"$host_name\",\"service\":\"http://127.0.0.1:$port\"},{\"service\":\"http_status:404\"}]}}" >/dev/null
  echo "route:      $host_name -> 127.0.0.1:$port"

  local target="$tid.cfargotunnel.com" body out
  if [[ $auth == api ]]; then
    body="{\"type\":\"CNAME\",\"name\":\"$host_name\",\"content\":\"$target\",\"proxied\":true,\"comment\":\"share tunnel $tunnel_name\"}"
    if [[ -z $rid ]]; then
      cf POST "/zones/$zone/dns_records" "$body" >/dev/null; echo "dns:        created CNAME $host_name"
    elif [[ $rtype == CNAME && $rcontent == "$target" ]]; then
      echo "dns:        CNAME $host_name already points at the tunnel"
    else
      cf PUT "/zones/$zone/dns_records/$rid" "$body" >/dev/null; echo "dns:        replaced $rtype $host_name (--force)"
    fi
  else
    local overwrite=""
    [[ $force == 1 || $created == 0 ]] && overwrite="--overwrite-dns"
    # shellcheck disable=SC2086
    out="$(cloudflared tunnel --origincert "$cert" --loglevel info route dns $overwrite "$tid" "$host_name" 2>&1)" || true
    if ! grep -qE "CNAME $host_name which|$host_name is already configured" <<<"$out"; then
      [[ $created == 1 ]] && cf DELETE "/accounts/$account/cfd_tunnel/$tid" >/dev/null
      rm -f "$config_dir/cert.zone"
      die "DNS route failed (did you pick $zone_name in the browser?): $(grep -E 'ERR|Added' <<<"$out" | tail -2)"
    fi
    echo "dns:        CNAME $host_name -> tunnel"
  fi

  local tok where
  tok="$(cf GET "/accounts/$account/cfd_tunnel/$tid/token" | jq -r .result)"
  if [[ -n $(cfg token_cmd || true) ]]; then
    echo "token:      config has token_cmd; store this tunnel's token there yourself"
  else
    where="$(token_store "$tok")"; echo "token:      stored in $where"
  fi
  tok=""
  write_config "$tid" "$tunnel_name"

  host_ok || { echo "this host ($(this_host)) is not in hosts=$hosts; skipping the service and the live check"; return 0; }
  if [[ $service == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then
    svc_install; echo "service:    runs at login ($svc_label)"
  fi

  local started=0 live=0
  running || { cmd_start >/dev/null 2>&1; [[ $service == 1 ]] || started=1; }
  live_check 60 && live=1
  [[ $started == 1 ]] && cmd_stop >/dev/null
  [[ $live == 1 ]] || die "live check failed: https://$host_name/ does not answer (see $root/serve.log)"
  echo "ready:      https://$host_name/ is live. Next: share add <file|dir>"
}

cmd_teardown() {
  if [[ $mode == quick ]]; then
    if [[ ${1:-} != --yes ]]; then
      [[ -t 0 ]] || die "rerun with --yes to confirm"
      local a; read -rp "Remove the quick-tunnel setup? Nothing lives on Cloudflare; shares in $root stay. [y/N] " a
      [[ $a == y* || $a == Y* ]] || die "aborted"
    fi
    svc_uninstall
    cmd_stop >/dev/null
    rm -f "$root/quick.url"
    to_trash "$config"
    echo "removed the quick setup (no tunnel, DNS, or token existed); shares in $root stay"
    return 0
  fi
  need_host
  local tid; tid="$(cfg tunnel_id || true)"
  [[ -n $tid ]] || die "no tunnel_id in $config"
  if [[ ${1:-} != --yes ]]; then
    [[ -t 0 ]] || die "rerun with --yes to confirm"
    local a; read -rp "Delete the tunnel and DNS record for $host_name? Shares in $root stay. [y/N] " a
    [[ $a == y* || $a == Y* ]] || die "aborted"
  fi
  svc_uninstall
  cmd_stop >/dev/null
  local zone za rec rid _zn
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    auth_api >/dev/null
    za="$(cf_zone)"; read -r zone account _zn <<<"$za"
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r --arg t "$tid.cfargotunnel.com" '.result[] | select(.content == $t) | .id' <<<"$rec" | head -1)"
    if [[ -n $rid ]]; then cf DELETE "/zones/$zone/dns_records/$rid" >/dev/null; echo "dns:     deleted $host_name"
    else echo "dns:     no record for $host_name points at this tunnel, left alone"; fi
    # every host share loses its DNS record and ingress rule before the tunnel goes
    zone_id="$zone"; zone_name="${zone_name:-$_zn}"; tun_id="$tid"; auth=api
    if [[ -s $index ]]; then
      local _hn _hs _hd _he hopts hfqdn
      while IFS=$'\t' read -r _ _hn _hs _hd _he hopts; do
        hfqdn="$(opt_val host "$hopts" || true)"
        [[ -n $hfqdn ]] && host_rm "$hfqdn" && echo "dns:     deleted $hfqdn"
      done <"$index"
    fi
  elif [[ -f $cert ]]; then
    cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"
    echo "dns:     the login token cannot delete DNS records. Delete the CNAME $host_name in the Cloudflare dashboard, or rerun with CLOUDFLARE_API_TOKEN."
    if [[ -s $index ]] && awk -F'\t' '$6 ~ /host=/ {f=1} END {exit !f}' "$index"; then
      echo "dns:     host shares in $index keep their records; remove them in the dashboard or rerun with CLOUDFLARE_API_TOKEN."
    fi
  else
    die "set CLOUDFLARE_API_TOKEN, or run 'share setup $host_name' once to log in again"
  fi
  cf DELETE "/accounts/$account/cfd_tunnel/$tid/connections" >/dev/null 2>&1 || true
  cf DELETE "/accounts/$account/cfd_tunnel/$tid" >/dev/null
  echo "tunnel:  deleted"
  token_forget; echo "token:   removed"
  echo "service: removed"
  [[ -f $cert ]] && to_trash "$cert"
  rm -f "$config_dir/cert.zone"
  to_trash "$config"; echo "config:  moved to the Trash"
}

cmd_skill() { # cmd_skill [--install]: the skill file that makes share agent-native
  local out="/dev/stdout" d=""
  if [[ ${1:-} == --install ]]; then
    d="${SHARE_SKILL_DIR:-$HOME/.claude/skills/share}"
    mkdir -p "$d"; out="$d/SKILL.md"
  fi
  cat >"$out" <<'EOF'
---
name: share
description: Publish a local file, folder, or running dev server at a public link on the user's own domain. Use when the user asks to share, publish, demo, or hand someone a link to something local ("share this file", "let them see my dev server", "publish these notes").
---

# share

Publish snapshots of local files/folders, or proxy a running `localhost` server, at `https://<host>/...`. The host is the user's own domain on Cloudflare; links live while the machine is awake. With `share setup --quick` no domain is needed: links get a random `*.trycloudflare.com` host that changes on every start.

## Before anything

`share status` shows whether setup ran, whether it is serving, and every share. If setup never ran, stop and tell the user: `share setup --quick` needs no account, or `share setup <hostname>` needs a browser login or `CLOUDFLARE_API_TOKEN`.

## Commands

| Command | Effect |
|---|---|
| `share add <file\|dir>` | Snapshot copy; prints the link and copies it to the clipboard |
| `share add <port>` | Live proxy `https://<host>/<id>/` -> `127.0.0.1:<port>` (also `localhost:port`, `http://localhost:port`) |
| `share add ... --host <name>.<zone>` | Own hostname, e.g. `dev.example.com`; needed for apps that emit absolute asset paths, and for SPA deep links |
| `share add <dir> --no-index` | No generated file listing at the folder link |
| `share ls` / `share hits <id>` | List shares / request + unique-visitor counts |
| `share refresh <id>` | Re-copy a snapshot from its source (no-op for live shares) |
| `share rm <id>` | Unpublish; for `--host` shares also deletes the CNAME and tunnel rule |
| `share start` / `share stop` | Serving on or off |

## Rules for agents

- Always surface the printed link to the user; never share something else "to test it".
- Live shares expose whatever answers on that port to anyone with the link. Ports below 1024 and share's own ports are refused; do not try to work around that.
- A shared folder gets a generated file listing unless `--no-index`; check for sensitive names first. Dotfiles and symlinks are never copied.
- A file whose name is 2-5 digits (e.g. `8080`) reads as a port; use `./8080` to share the file.
- Links die when the machine sleeps. If a link 404s or the visitor sees Cloudflare 530, run `share status`.
- In quick mode (`setup --quick`) the `trycloudflare.com` URL is new on every `share start` and every login-service restart: an old link is dead forever, always read the current one from `share status` or the `add` output. `--host` is refused in quick mode.
- `rm`/`hits`/`refresh` accept the pasted link as well as the bare id.
EOF
  [[ -n $d ]] && echo "installed $out"
}

case "${1:-status}" in
  setup) shift; cmd_setup "$@" ;;
  teardown) cmd_teardown "${2:-}" ;;
  service) cmd_service "${2:-}" ;;
  add) shift; cmd_add "$@" ;;
  ls) cmd_prune; cmd_ls ;;
  skill) cmd_skill "${2:-}" ;;
  refresh) cmd_refresh "$(id_of "${2:-}")" ;;
  rm) cmd_rm "$(id_of "${2:-}")" ;;
  hits) cmd_hits "$(id_of "${2:-}")" ;;
  prune) cmd_prune ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  serve) cmd_serve ;;
  -h|--help|help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
