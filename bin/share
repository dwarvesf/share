#!/bin/bash
# share: publish snapshots of local files or folders at https://<your-host>/<id>/<name>,
#        or proxy a running dev server on localhost:<port>.
#
#   share --profile <name> <command>   run it against another setup (or SHARE_PROFILE=<name>); no flag = the default one
#   share setup [hostname]    log in to Cloudflare, create the tunnel + DNS, install the service, verify
#   share setup --quick       no domain needed: serve at a random trycloudflare.com URL (changes every start)
#   share add [--ttl 7d|12h|never] [--no-index] <file|dir>   copy it in, print + copy the link, auto-start
#   share add <port|localhost:port|http://localhost:port>    live proxy at https://<host>/<id>/
#   share add ... --host <name>.<zone>                       give the share its own hostname
#   share add ... --access group:<name>|email:<a>[,<b>...]|domain:<domain>   a login gate (Cloudflare Access) on this link
#   share api-token [--cmd '<command>' | --check]   the Cloudflare API token --access needs: prefilled form + paste, or point at one you have
#   share ls                  list shares: link, size, source, expiry
#   share refresh <id|link>   re-copy from the source path (same link)
#   share rm <id|link>        unpublish (moves the copy to the Trash)
#   share hits <id|link>      requests and unique visitors for one share
#   share prune               unpublish expired shares now (also hourly while serving)
#   share start | stop        start or stop serving (links live while this machine is awake)
#   share service install|uninstall|status   the login service that keeps serving
#   share state               machine-readable JSON snapshot (for the menu bar app)
#   share profiles            every profile with its state and host
#   share [status]            server state plus the share list
#   share serve               serve in the foreground until Ctrl-C
#   share skill [--install]   the SKILL.md that teaches an agent to use share
#   share teardown [--yes]    delete the tunnel, DNS record, service, and stored token
#   share setup <hostname> --backend r2 --bucket <name>   an R2 profile: a private bucket and a Worker
#      serve links from Cloudflare, so they stay up while this machine is off
#
# Docs: https://github.com/dwarvesf/share
set -euo pipefail

die() { echo "share: $*" >&2; exit 1; }

# A profile (--profile <name> before the verb, or SHARE_PROFILE) is a second setup beside the
# default one: its own config dir, root, port, service label, and Keychain item. With no
# profile every value below is what a single-profile install has always used.
profile="${SHARE_PROFILE:-}"
if [[ ${1:-} == --profile ]]; then
  [[ $# -ge 2 && -n $2 ]] || die "usage: share --profile <name> <command>"
  profile="$2"; shift 2
fi
[[ $profile == default ]] && profile=""
[[ -z $profile || $profile =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "bad profile name '$profile' (a-z, 0-9, -; 32 chars max)"
for arg in "$@"; do   # `share teardown --yes --profile x` must not tear down the default
  case $arg in --profile|--profile=*) die "--profile goes before the verb: share --profile <name> ${1:-<command>}" ;; esac
done
export SHARE_PROFILE="$profile"   # start's nohup serve and the hourly prune run as bash "$0"
me="share${profile:+ --profile $profile}"   # how a message names this profile's own command
profiles_dir="${XDG_CONFIG_HOME:-$HOME/.config}/share/profiles"

config_dir="${SHARE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/share${profile:+/profiles/$profile}}"
config="$config_dir/config"
cfg() { [[ -f $config ]] && awk -v k="$1" 'index($0, k "=") == 1 {print substr($0, length(k) + 2); exit}' "$config"; }

root="${SHARE_ROOT:-$HOME/share${profile:+/profiles/$profile}}"
pub="$root/pub"            # served tree; nothing else is reachable from the tunnel
index="$root/index.tsv"    # id, name, source, added date, expiry epoch (0 = never)
r2own="$root/r2-own"       # r2: <id>\t<prefix>\t<source> for shares this install added; refresh trusts only this file
pidfile="$root/serve.pid"
pending="$root/access-pending"   # every Access app not, or no longer, backed by a finished row: id, app or -:<nonce>, owner pid, owner start, created
host_name="${SHARE_HOSTNAME:-$(cfg hostname || true)}"
backend="${SHARE_BACKEND:-$(cfg backend || true)}"   # "r2" serves from Cloudflare; empty or anything else is the tunnel backend
port="${SHARE_PORT:-$(cfg port || true)}"; port="${port:-8787}"
if [[ $backend == r2 ]]; then
  metrics_port=0   # port= holds the "r2" sentinel on purpose; nothing listens on this machine
else
  [[ $port =~ ^[1-9][0-9]*$ ]] || die "port '$port' is not a number (port= in $config, or SHARE_PORT)"   # no leading zero: $(( )) would read octal
  metrics_port=$((port + 1))   # cloudflared /ready, polled so `start` returns once links work
fi
hosts="${SHARE_HOSTS:-$(cfg hosts || true)}"
tunnel="${SHARE_TUNNEL:-1}"  # 0 = local-only (tests)
mode="$(cfg mode || true)"   # "quick" = trycloudflare, no domain; empty = named tunnel
api="https://api.cloudflare.com/client/v4"

this_host() { local h; h="$(uname -n)"; echo "${h%%.*}"; }
host_ok() { case " $hosts " in *" $(this_host) "*) return 0 ;; esac; return 1; }
running() { # the pid must still be a share serve: an unclean exit leaves the file and the OS reuses the pid
  [[ -f $pidfile ]] || return 1
  local pid; pid="$(cat "$pidfile")"
  kill -0 "$pid" 2>/dev/null && [[ $(ps -o command= -p "$pid" 2>/dev/null) == *share*serve* ]]
}
rows() { # the only index reader: a forged row (bad id, main or malformed host=, a bad access= or access_rule=) never reaches a path, Caddyfile, or Cloudflare call
  [[ -f $index ]] || return 0
  # no {n} intervals: mawk lacks them; the host regex is setup's hostname check; the rule grammar is access_parse's
  awk -F'\t' -v main="$host_name" -v be="$backend" '
    function hostname(h) { return h ~ /^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z][a-z]+$/ }
    function uuid(u) { return length(u) == 36 && u !~ /[^0-9a-f-]/ && substr(u, 9, 1) == "-" && substr(u, 14, 1) == "-" && substr(u, 19, 1) == "-" && substr(u, 24, 1) == "-" && gsub(/-/, "-", u) == 4 }
    function rule(r,   k, v, m, e, j, at) {
      if (index(r, ":") < 2) return 0
      k = substr(r, 1, index(r, ":") - 1); v = substr(r, index(r, ":") + 1)
      if (v == "") return 0
      if (k == "group") return length(v) <= 64 && v !~ /[^A-Za-z0-9._-]/
      if (k == "domain") return hostname(v)
      if (k != "email") return 0
      m = split(v, e, ",")
      if (m > 50) return 0
      for (j = 1; j <= m; j++) {
        at = index(e[j], "@")
        if (at < 2 || index(substr(e[j], at + 1), "@") || substr(e[j], 1, at - 1) ~ /[^a-z0-9._%+-]/ || !hostname(substr(e[j], at + 1))) return 0
      }
      return 1
    }
    (NF == 5 || NF == 6) && length($1) == 6 && $1 !~ /[^0-9a-f]/ {
      n = split($6, a, " "); app = 0; rl = 0
      hp = (be != "r2"); hb = (be != "r2")   # r2 rows must carry a sound prefix= and by=
      for (i = 1; i <= n; i++) {
        if (substr(a[i], 1, 5) == "host=") {
          h = substr(a[i], 6)
          if (h == main || !hostname(h)) next
        }
        if (substr(a[i], 1, 7) == "access=") { if (!uuid(substr(a[i], 8))) next; app = 1 }
        if (substr(a[i], 1, 12) == "access_rule=") { if (!rule(substr(a[i], 13))) next; rl = 1 }
        if (substr(a[i], 1, 7) == "prefix=") {
          p = substr(a[i], 8)
          if (!(length(p) == 18 && substr(p, 1, 2) == "o/" && substr(p, 3, 6) == $1 &&
                substr(p, 9, 1) == "." && substr(p, 18, 1) == "/" && substr(p, 10, 8) ~ /^[0-9a-f]+$/)) next
          hp = 1
        }
        if (substr(a[i], 1, 3) == "by=") {
          b = substr(a[i], 4)
          if (b == "" || b ~ /[^a-z0-9.-]/) next
          hb = 1
        }
      }
      if (app != rl || !hp || !hb) next   # a gated row carries both, or it is a hand edit; an r2 row needs its prefix and host
      print
    }' "$index"
}
row() { rows | awk -F'\t' -v id="$1" '$1 == id'; }
id_of() { # accept an id or a pasted share link: https://host/<id>/name -> <id>; a bare https://<fqdn>/ resolves to the host row
  case ${1:-} in
    *://*)
      local p="${1#*://}"; local h="${p%%/*}" rest="${p#*/}"
      if [[ $p == "$h" || -z $rest ]] && [[ -f $index ]]; then
        rows | awk -F'\t' -v h="$h" '{n=split($6,a," "); for(i=1;i<=n;i++) if(a[i]=="host=" h){print $1; exit}}'
      else
        echo "${rest%%/*}"
      fi ;;
    *) echo "${1:-}" ;;
  esac
}
rand_id_raw() { od -An -N3 -tx1 /dev/urandom | tr -d ' \n'; }   # the real candidate source
rand_id() { # loops past a collision with an existing row or an orphaned pub/<id>
  # SHARE_TEST_IDS (test seam): space-separated candidates consumed in order, then rand_id_raw.
  # Consumed here, not inside rand_id_raw: rand_id_raw's output is captured with $( ), which
  # forks a subshell, so a mutation made inside it would never reach this loop's next pass.
  local id
  while :; do
    if [[ -n ${SHARE_TEST_IDS:-} ]]; then
      id="${SHARE_TEST_IDS%% *}"
      [[ $SHARE_TEST_IDS == "$id" ]] && SHARE_TEST_IDS="" || SHARE_TEST_IDS="${SHARE_TEST_IDS#* }"
    else
      id="$(rand_id_raw)"
    fi
    if [[ $backend == r2 ]]; then   # a live GET and a prefix scan; anything but 200/404 or empty fails closed
      r2_call GET "m/$id" || die "the r2 record check needs a publisher token (see above)"
      case $cf_code in
        200) continue ;;
        404) ;;
        *) die "the r2 record check for $id failed (HTTP $cf_code); no id was picked" ;;
      esac
      r2_call LIST "o/$id."
      [[ $cf_code == 200 ]] || die "the r2 prefix check for $id failed (HTTP $cf_code); no id was picked"
      [[ $cf_body == *"<Key>"* ]] && continue   # leftover objects under this id: never hand it out
      ! grep -q "^$id"$'\t' "$pending" 2>/dev/null && { echo "$id"; return; }
      continue
    fi
    # an id named in access-pending has an Access app waiting: a new share must never land behind it
    [[ -z "$(row "$id")" && ! -e $pub/$id ]] && ! grep -q "^$id"$'\t' "$pending" 2>/dev/null && { echo "$id"; return; }
  done
}
has_opt() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
opt_val() { # opt_val <key> <opts>: the value of a key=value token, nothing when absent
  local rest="${2#*"$1"=}"
  [[ $rest == "$2" ]] && return 1
  echo "${rest%% *}"
}
day_of() { date -r "$1" +%F 2>/dev/null || date -d "@$1" +%F; }
to_trash() { # an empty path would make `trash` move the current directory
  [[ -n ${1:-} && -e $1 ]] || return 0
  if command -v trash >/dev/null; then trash "$1"; return; fi
  mkdir -p "$root/trash" && mv -f "$1" "$root/trash/$(basename "$1").$(date +%s)"
}
mk_root() { # the leaf ($root) needs 700: it holds the admin socket; a profile's parents under ~/share get it too
  # shellcheck disable=SC2174 # every directory that matters is named explicitly, so each gets the mode
  [[ $root != "$HOME/share/profiles/"* ]] || mkdir -p -m 700 "$HOME/share" "$HOME/share/profiles"
  # shellcheck disable=SC2174
  mkdir -p -m 700 "$root"
}
need_host() { [[ -n $host_name || $mode == quick ]] || die "no setup yet: run '$me setup <hostname>' or '$me setup --quick'"; }

# Locks are symlinks $root/.lock-<name> -> holder pid, so a dead holder's lock can be broken.
# Inside a subshell $$ is the parent's pid (bash 3.2 has no BASHPID); that lock is recovered once the parent exits.
held_locks=""   # names this process holds; the EXIT trap releases them
lock_take() { # lock_take <name> [timeout-secs]
  local l="$root/.lock-$1" s="$root/.lock-$1.stale.$$" i=0 max=$(( ${2:-60} * 5 )) pid
  # a real directory is a pre-symlink lock: ln would link inside it, so it counts as held
  while [[ -d $l && ! -L $l ]] || ! ln -sn "$$" "$l" 2>/dev/null; do
    pid="$(readlink "$l" 2>/dev/null || true)"
    # stale: rename to a private name, re-read, remove only if still dead; a live one goes back
    if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null && mv "$l" "$s" 2>/dev/null; then
      pid="$(readlink "$s" 2>/dev/null || true)"
      if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null; then rm -f "$s"; else mv -f "$s" "$l"; fi
      continue
    fi
    i=$((i + 1)); [[ $i -gt $max ]] && die "another share command holds the $1 lock"
    sleep 0.2
  done
  held_locks="$held_locks $1"
  trap release_locks EXIT   # re-armed on every take: subshells do not inherit EXIT traps
}
lock_release() { # lock_release <name>: only a link that still names this pid is removed
  [[ "$(readlink "$root/.lock-$1" 2>/dev/null)" == "$$" ]] && rm -f "$root/.lock-$1"
  held_locks="${held_locks// $1/}"
}
held_fqdn=""   # a --host name whose ingress rule and CNAME exist but whose row does not yet; the trap removes them
held_access_id=""   # a gated add inside its wait; on a die the trap says where its app went
release_locks() { # the EXIT trap: every held lock, a stage still outside pub, and a routed fqdn with no row (an add that died in its wait)
  local n f; for n in $held_locks; do lock_release "$n"; done
  [[ -n $stage_out && -d $stage_out ]] && rm -rf "$stage_out"
  stage_out=""
  if [[ -n $held_fqdn ]]; then f="$held_fqdn"; held_fqdn=""; host_rm "$f" || true; fi
  if [[ -n $held_access_id ]]; then echo "share: nothing was published; the Access app of $held_access_id waits in access-pending, the next $me add --access or $me prune with a token removes it" >&2; held_access_id=""; fi
  [[ -n ${r2_snap_file:-} ]] && rm -f "$r2_snap_file"
  if [[ -n ${r2_held_prefix:-} ]]; then f="$r2_held_prefix"; r2_held_prefix=""; r2_release_prefix "$r2_held_id" "$f"; fi
  return 0
}

# the public hostname share links use: the configured hostname in named mode,
# the fqdn cloudflared printed in quick mode (empty while not serving)
serving_host() {
  if [[ $mode == quick ]]; then cat "$root/quick.url" 2>/dev/null || true
  else echo "$host_name"; fi
}

share_url() { # share_url <id> <name> [opts]: sets share_url_out; the link depends on the share kind
  local fqdn path shost
  fqdn="$(opt_val host "${3:-}" || true)"
  if [[ -n $fqdn ]]; then
    printf -v share_url_out 'https://%s/' "$fqdn"; return
  fi
  shost="$(serving_host)"
  if [[ -z $shost ]]; then
    if [[ $mode == quick ]]; then shost="<pending>.trycloudflare.com"; else shost="<no-hostname>"; fi
  fi
  if has_opt live "${3:-}"; then
    printf -v share_url_out 'https://%s/%s/' "$shost" "$1"; return
  fi
  path="$2"
  local base="$pub/$1"
  [[ $backend != r2 ]] || base="${r2_link_base:-}"   # r2: the stage during an add; a listing has none, and the Worker 308s a folder to its slash
  if [[ -z $base ]]; then :
  elif [[ -d $base/$2 ]]; then path="$2/"
  elif [[ $2 == *.md && -f $base/${2%.md}.html ]]; then path="${2%.md}.html"
  fi
  urlenc "$path"
  printf -v share_url_out 'https://%s/%s/%s' "$shost" "$1" "$urlenc_out"
}

ttl_secs() {
  local n="${1%[dh]}"
  case $1 in never|0) echo 0; return ;; esac
  [[ $n =~ ^[0-9]+$ ]] || die "bad --ttl '$1' (use 12h, 7d, or never)"
  case $1 in
    *d) echo $((n * 86400)) ;;
    *h) echo $((n * 3600)) ;;
    *) die "bad --ttl '$1' (use 12h, 7d, or never)" ;;
  esac
}

# --- tunnel token storage: token_cmd in config > macOS Keychain > 0600 file ---

token_file="$config_dir/tunnel-token"
# the Keychain service name, one item per profile and hostname; a function, not a variable:
# on a first setup host_name is empty when the script loads and is assigned inside cmd_setup
token_key() { echo "share-tunnel${profile:+.$profile}:$host_name"; }
token_read() {
  local cmd; cmd="$(cfg token_cmd || true)"
  if [[ -n $cmd ]]; then eval "$cmd"; return; fi
  if command -v security >/dev/null; then
    security find-generic-password -a share -s "$(token_key)" -w 2>/dev/null && return
  fi
  [[ -f $token_file ]] && cat "$token_file"
}
token_store() { # token_store <token>; stdin only, so the token never shows in ps
  if command -v security >/dev/null; then
    printf 'add-generic-password -U -a share -s "%s" -w "%s"\n' "$(token_key)" "$1" | security -i >/dev/null
    echo "keychain (service $(token_key))"
  else
    (umask 077 && printf '%s' "$1" >"$token_file")
    echo "$token_file (mode 600)"
  fi
}
token_forget() {
  if command -v security >/dev/null; then
    security delete-generic-password -a share -s "$(token_key)" >/dev/null 2>&1 || true
  fi
  [[ -f $token_file ]] && to_trash "$token_file"
  return 0
}

# --- snapshots ---

write_md_style() { # the reading stylesheet, shared by pandoc renders and gen_index
  cat >"$root/md-style.html" <<'CSS'
<style>
/* Spacedown's "paper" reading theme (dwarvesf/spacedown assets/paper-theme.css) on pandoc's default template. */
:root { --paper-bg:#fbfaf7; --paper-fg:#242321; --paper-muted:#6e6c67; --paper-rule:#dcd9d2; --paper-rule-strong:#b9b5ac; --paper-link:#2b5f91; --paper-code-bg:#f0eee9; --paper-mark:#f6e7a8;
  --paper-font-sans:"iA Writer Quattro V", "iA Writer Quattro S", -apple-system, "Helvetica Neue", Arial, sans-serif;
  --paper-font-mono:"iA Writer Mono V", "iA Writer Mono S", ui-monospace, "SF Mono", Menlo, monospace; }
@media (prefers-color-scheme: dark) { :root { --paper-bg:#19191b; --paper-fg:#dedcd6; --paper-muted:#9c9a94; --paper-rule:#34343a; --paper-rule-strong:#55555c; --paper-link:#8bb8e8; --paper-code-bg:#242428; --paper-mark:#5c4f1e; } }
html { background:var(--paper-bg); color:var(--paper-fg); -webkit-text-size-adjust:100%; }
body { max-width:44rem; margin:0 auto; padding:2.2rem 1.6rem 4rem; font:17px/1.62 var(--paper-font-sans); font-kerning:normal; text-rendering:optimizeLegibility; }
h1,h2,h3,h4,h5,h6 { font-weight:650; letter-spacing:-0.005em; margin:2em 0 .6em; }
h1 { font-size:1.6em; line-height:1.25; margin-top:0; } h2 { font-size:1.3em; line-height:1.3; } h3 { font-size:1.1em; line-height:1.4; } h4,h5,h6 { font-size:1em; } h6 { color:var(--paper-muted); }
p, ul, ol, dl, blockquote, pre, table, figure { margin:0 0 1.1em; }
ul, ol { padding-left:1.6em; } li + li { margin-top:.25em; } li > p, li > ul, li > ol { margin:.2em 0; } li::marker { color:var(--paper-muted); }
a { color:var(--paper-link); text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.18em; text-decoration-color:color-mix(in srgb, var(--paper-link) 35%, transparent); overflow-wrap:anywhere; }
a:hover { text-decoration-color:var(--paper-link); }
blockquote { margin-left:0; padding:0 1em; border-left:3px solid var(--paper-rule); color:var(--paper-muted); }
blockquote p:last-child { margin-bottom:0; }
code, kbd, samp, pre { font-family:var(--paper-font-mono); font-size:.9em; }
code { background:var(--paper-code-bg); padding:.1em .3em; border-radius:4px; overflow-wrap:anywhere; }
pre, pre.sourceCode { background:var(--paper-code-bg); padding:.9rem 1rem; border-radius:6px; overflow-x:auto; line-height:1.55; } /* pandoc sets .sourceCode transparent */
div.sourceCode { overflow:visible; margin:0 0 1.1em; }
pre code { background:none; padding:0; font-size:inherit; white-space:pre; }
/* Spacedown sizes table columns with a script; here a wide table scrolls as a block instead. */
table { display:block; width:max-content; max-width:100%; overflow-x:auto; border-collapse:collapse; font-size:.9em; line-height:1.6; font-variant-numeric:tabular-nums; }
th, td { padding:.5em 1em .5em 0; text-align:left; vertical-align:top; }
thead th { font-weight:650; border-bottom:1px solid var(--paper-rule-strong); }
tbody tr + tr td { border-top:1px solid var(--paper-rule); }
img, video, svg { max-width:100%; height:auto; }
p:has(> img:only-child) { margin-bottom:.6em; } p:has(> img:only-child) + p { font-size:.85em; line-height:1.5; color:var(--paper-muted); }
mark { background:var(--paper-mark); color:inherit; }
hr { border:0; border-top:1px solid var(--paper-rule); margin:2em 0; }
</style>
CSS
}

render_md() { # render every .md under <dir> to a sibling .html; .md links become .html
  command -v pandoc >/dev/null || return 0
  local filter="$root/md-links.lua" style="$root/md-style.html" f out katex
  cat >"$filter" <<'LUA'
function Link(el)
  if not el.target:match("^%a+:") then
    el.target = el.target:gsub("%.md$", ".html"):gsub("%.md#", ".html#")
  end
  return el
end
LUA
  write_md_style
  find "$1" -type f -name '*.md' | while IFS= read -r f; do
    out="${f%.md}.html"
    [[ -e $out ]] && continue
    katex=""; grep -q '\$' "$f" && katex="--katex" # KaTeX from the CDN, only for pages with math
    # shellcheck disable=SC2086
    pandoc --quiet -s "$f" -o "$out" --lua-filter "$filter" --include-in-header "$style" \
      --from=markdown-smart-implicit_figures --highlight-style=tango --metadata pagetitle="$(basename "$f" .md)" $katex \
      || echo "share: could not render $f" >&2
  done
}

urlenc() { # urlenc <str>: sets urlenc_out; fork-free byte loop, keeps A-Za-z0-9-_.~ and '/', %XX (uppercase) for the rest
  local LC_ALL=C s="$1" out="" c i n
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    case $c in
      [A-Za-z0-9._~/-]) out+="$c" ;;
      *) printf -v c '%d' "'$c"; printf -v c '%%%02X' $((c & 255)); out+="$c" ;;  # masked: bash 3.2 sign-extends bytes above 127
    esac
  done
  urlenc_out="$out"
}

gen_index() { # gen_index <stage>: a folder with no index of its own gets a generated listing
  [[ -f $1/index.html || -f $1/README.html ]] && return 0
  local files f enc label
  files="$(cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"
  write_md_style
  {
    echo '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>index</title>'
    cat "$root/md-style.html"
    echo '</head><body><ul>'
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      if [[ $f == *.md && -f $1/${f%.md}.html ]]; then continue; fi  # listed by its render below
      urlenc "$f"; enc="$urlenc_out"
      label="$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$f")"
      printf '<li><a href="%s">%s</a></li>\n' "$enc" "$label"
    done <<<"$files"
    echo '</ul></body></html>'
  } >"$1/index.html"
}

stage_out=""   # the stage of the share being built, outside pub; release_locks removes it on a die
stage_copy() { # stage_copy <src> [opts]: the copy into a stage, sets stage_out; regular files only, so dotfiles (.git, .env) and symlinks (to ~/.ssh) never ship
  local parent name stage skipped
  parent="$(dirname "$1")"; name="$(basename "$1")"
  [[ $backend == r2 ]] || mkdir -p "$pub"   # an r2 profile never has a pub/ tree
  stage="$(mktemp -d "$root/.stage.XXXXXX")"
  stage_out="$stage"; trap release_locks EXIT
  (cd "$parent" && find "$name" -name '.*' -prune -o -type f -print | while IFS= read -r f; do
    mkdir -p "$stage/$(dirname "$f")" && cp -p "$f" "$stage/$f"
  done)
  skipped="$(cd "$parent" && find "$name" -name '.*' -prune -o -type l -print | wc -l | tr -d ' ')"
  [[ $skipped -gt 0 ]] && echo "share: skipped $skipped symlink(s)" >&2
  if [[ -z "$(find "$stage" -type f | head -1)" ]]; then
    rm -rf "$stage"; stage_out=""; die "nothing to share in $1 (dotfiles and symlinks are skipped)"
  fi
  render_md "$stage"          # a rendered README.md makes README.html, which suppresses gen_index
  local payload="$stage"      # a folder is listed at its own root; a bare file lists under <id>
  [[ -d $stage/$name ]] && payload="$stage/$name"
  has_opt noindex "${2:-}" || gen_index "$payload"
}
stage_publish() { # stage_publish <id>: the atomic swap of stage_out into pub/<id>; from here the bytes are reachable
  dry_log "PUBLISH $1"   # before the mv, so a watcher can never see pub/ change ahead of this line
  [[ -d $pub/$1 ]] && mv "$pub/$1" "$stage_out.old"
  mv "$stage_out" "$pub/$1"
  rm -rf "$stage_out.old"
  stage_out=""
}

warn_private() { # a share out of a private GitHub repo is almost always a mistake
  command -v gh >/dev/null || return 0
  local d="$1" top repo
  [[ -d $d ]] || d="$(dirname "$d")"
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
  repo="$(git -C "$top" remote get-url origin 2>/dev/null)" || return 0
  repo="$(sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##' <<<"$repo")"
  [[ $repo == */* && $repo != *:* ]] || return 0
  if [[ "$(gh repo view "$repo" --json isPrivate -q .isPrivate 2>/dev/null)" == true ]]; then
    echo "share: WARNING: this comes from the PRIVATE repo $repo and is now public to anyone with the link ($me rm $2 to undo)" >&2
  fi
}

parse_target() { # parse_target <arg>: "live <port>" for a port/localhost shape, "snapshot" for a path
  local p=""
  case $1 in
    http://localhost:*|http://127.0.0.1:*) p="${1#http://*:}"; p="${p%/}" ;;
    localhost:*|127.0.0.1:*) p="${1#*:}" ;;
    *[!0-9]*|""|?|??????*) [[ -e $1 ]] && { echo snapshot; return 0; }; return 1 ;;
    *) p="$1" ;;   # two to five digits: a bare port, never a path
  esac
  case $p in *[!0-9]*|"") return 1 ;; esac
  echo "live $p"
}

cmd_add() {
  local ttl="${SHARE_TTL:-$(cfg ttl || true)}"; ttl="${ttl:-30d}" noindex="" host_fqdn="" target="" ntargets=0 access=""
  local usage="usage: share add [--ttl 7d] [--host <name>.<zone>] [--no-index] [--access <rule>] <file|dir|port|localhost:port|http://localhost:port>"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --ttl) ttl="${2:-}"; shift 2 || die "$usage" ;;
      --host) host_fqdn="${2:-}"; shift 2 || die "$usage" ;;
      --access) access="${2:-}"; shift 2 || die "$usage"; [[ -n $access ]] || die "$access_usage" ;;
      --no-index) noindex=1; shift ;;
      --*) die "$usage" ;;
      *) target="$1"; ntargets=$((ntargets + 1)); shift ;;
    esac
  done
  [[ $ntargets == 1 ]] || die "$usage"
  [[ -z $host_fqdn || $mode != quick ]] || die "--host needs a named tunnel: '$me teardown', then '$me setup <hostname>'"
  if [[ -n $access ]]; then   # every refusal before any write
    access_parse "$access"
    [[ $mode != quick ]] || access_named_only
    [[ ${SHARE_ACCESS_DRY:-0} != 1 || $tunnel == 0 ]] || die "SHARE_ACCESS_DRY=1 is a test seam for SHARE_TUNNEL=0 only; nothing was published"
  fi
  local pt kind tport="" src name id exp=0 url opts="" secs
  pt="$(parse_target "$target")" || die "$usage"
  if [[ $backend == r2 ]]; then   # every r2 refusal before any write
    [[ $pt == snapshot && -z $host_fqdn ]] || die "live shares and --host need a tunnel profile; this profile serves from R2"
    [[ -z $access ]] || die "gated r2 adds are not built yet; this profile publishes ungated links only"
    need_host
    cmd_add_r2 "$(ttl_secs "$ttl")" "$noindex" "$target"
    return
  fi
  if [[ $pt == snapshot ]]; then
    kind=snapshot
  else
    kind=live; tport="${pt#live }"
    [[ $tport -ge 1024 ]] || die "$tport is below 1024; a share of a system service is never a dev server"
    [[ $tport -le 65535 ]] || die "$tport is above 65535; no such port"
    [[ $tport != "$port" ]] || die "$tport is this share server's own port"
    [[ $tport != "$metrics_port" ]] || die "$tport is the tunnel metrics port"
    ! port_claimed "$tport" || die "$tport belongs to another share profile (share profiles)"
  fi
  need_host
  secs="$(ttl_secs "$ttl")"
  if [[ $kind == live ]]; then
    name="localhost:$tport"; src="http://127.0.0.1:$tport"; opts="live"
  else
    src="$(realpath "$target")"; name="$(basename "$src")"
    case $src in *$'\t'*|*$'\n'*) die "paths with tabs or newlines are not supported" ;; esac
    case $name in *[{}\"\\]*) die "names with { } \" or \\ are not supported" ;; esac
  fi
  [[ -n $noindex ]] && opts="${opts:+$opts }noindex"
  if [[ -n $access ]]; then   # token, scopes, group: all settled before the copy, before host_check, and before any Cloudflare write
    mk_root
    access_prepare
  fi
  if [[ -n $host_fqdn ]]; then
    host_check "$host_fqdn"
    opts="${opts:+$opts }host=$host_fqdn"
  fi
  id="$(rand_id)"
  [[ $secs -gt 0 ]] && exp=$(($(date +%s) + secs))
  mk_root; mkdir -p "$pub"
  # stage the payload before any Cloudflare write: a copy failure must not orphan DNS, ingress, or an Access app
  if [[ $kind == live ]]; then
    echo "share: live share: anyone with the link reaches 127.0.0.1:$tport while this machine is awake" >&2
    [[ -z $host_fqdn && $mode != quick ]] && echo "share: apps that use absolute asset paths (/static/...) break under a path prefix; use --host <name>.<zone>" >&2
    curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$tport/" || echo "share: nothing answers on 127.0.0.1:$tport yet" >&2
  else
    stage_copy "$src" "$opts"
    # a gated copy stays outside pub until the gate is observed; warn_private says "public to anyone with the link", which a gated link is not
    if [[ -z $access ]]; then stage_publish "$id"; warn_private "$src" "$id"; fi
  fi
  if [[ -n $access ]]; then
    access_create "$id" "$host_fqdn"   # intent line, the app, its id into the line, read-back
    opts="${opts:+$opts }access=$access_app access_rule=$access_rule"
  fi
  [[ -n $host_fqdn ]] && { host_add "$host_fqdn"; held_fqdn="$host_fqdn"; }
  if [[ -n $access ]] && ! access_gate "$id" "$access_aud" "$host_fqdn"; then
    local left=""
    [[ -n $host_fqdn ]] && { held_fqdn=""; host_rm "$host_fqdn"; }
    if access_delete "$access_app" "$id"; then lock_take index; pending_drop "$id" "$access_app"; lock_release index; held_access_id=""
    else left="; the app stays in access-pending for the next '$me prune' with the token"; fi
    die "Cloudflare Access did not enforce on $host_name/$id within ${access_wait}s; nothing was published$left; rerun the same $me add (Access can take several minutes on a new app)"
  fi
  lock_take index   # publish: row, render, reload as one step, so no writer's row or render is lost
  if [[ -n $access ]]; then
    # only while this process's exact pending line is still there: a sweep that claimed it may have deleted the app
    pending_has "$id" "$access_app" || { lock_release index; die "the Access app of $id was claimed by a sweep during the wait; nothing was published; rerun the same $me add"; }
    [[ $kind == snapshot ]] && stage_publish "$id"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$src" "$(date +%F)" "$exp" "$opts" >>"$index"
  write_caddyfile
  caddy_reload || true   # the row stays: the next reload or serve restart renders it
  [[ -n $access ]] && pending_drop "$id" "$access_app"
  held_fqdn="" held_access_id=""
  lock_release index   # before cmd_start: serve's startup render takes the lock itself
  share_url "$id" "$name" "$opts"
  url="$share_url_out"
  echo "$url"
  if [[ ${SHARE_CLIPBOARD:-1} == 1 ]] && command -v pbcopy >/dev/null; then
    printf '%s' "$url" | pbcopy && echo "  (link copied)"
  fi
  if ! running; then
    if host_ok; then cmd_start; else echo "  (not serving: $(this_host) is not in hosts=$hosts)"; fi
  fi
}

cmd_ls() {
  access_pending_note
  [[ -s $index ]] || { echo "no shares"; return 0; }
  local id name src date exp opts size until gone by
  while IFS=$'\t' read -r id name src date exp opts; do
    until="never"; [[ ${exp:-0} -gt 0 ]] && until="$(day_of "$exp")"
    share_url "$id" "$name" "$opts"
    echo "$share_url_out"
    if [[ $backend == r2 ]]; then
      by="$(opt_val by "$opts" || true)"
      echo "    id=$id  added=$date  expires=$until$(access_col "$opts")  by=${by:-?}  from=$src"
    elif has_opt live "$opts"; then
      echo "    id=$id  live -> $src  added=$date  expires=$until$(access_col "$opts")"
    else
      size="$(du -sh "$pub/$id" 2>/dev/null | cut -f1 | tr -d ' ')"
      gone=""; [[ -e $src ]] || gone="  (source gone, snapshot still served)"
      echo "    id=$id  size=${size:-?}  added=$date  expires=$until$(access_col "$opts")  from=$src$gone"
    fi
  done < <(rows)   # a 5-field row (v0.1.x) reads with opts empty; malformed rows are skipped
  access_ls_check
}
access_col() { local r; r="$(opt_val access_rule "$1" || true)"; [[ -n $r ]] && printf '  access=%s' "$r"; return 0; }

cmd_refresh() {
  [[ $backend != r2 ]] || { cmd_refresh_r2 "$@"; return; }
  local r src opts
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  if has_opt live "$opts"; then echo "live share, nothing to refresh" >&2; return 0; fi
  src="$(cut -f3 <<<"$r")"
  [[ -e $src ]] || die "source is gone: $src (the snapshot keeps serving; $me rm $1 to unpublish)"
  stage_copy "$src" "$opts"   # the slow copy runs outside the lock; the swap into pub waits for it
  lock_take index
  # a concurrent rm may have dropped the row while the copy ran; the trap trashes the stage on this die
  [[ -n "$(row "$1")" ]] || { lock_release index; die "$1 was removed during refresh"; }
  stage_publish "$1"
  write_caddyfile   # a refresh can add or remove index.html, which flips try_files
  caddy_reload || true
  lock_release index
  echo "refreshed $1 from $src"
}

cmd_rm() { # cmd_rm <id> [prune]: prune passes through with no credential, so expiry is never blocked (DEC-016)
  [[ $backend != r2 ]] || { cmd_rm_r2 "$@"; return; }
  local r opts fqdn="" app="" tmp reloaded=1
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  fqdn="$(opt_val host "$opts" || true)"
  app="$(opt_val access "$opts" || true)"
  if [[ ${SHARE_HOST_DRY:-0} != 1 && -n $fqdn && ${2:-} != prune && -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
    die "no Cloudflare credential for $fqdn; set CLOUDFLARE_API_TOKEN or run $me setup --login, then rm again"
  fi
  if [[ -n $app ]]; then
    # the gate goes last: bytes first, row, then the app. rm needs the token before any change; prune defers the app
    [[ ${2:-} == prune ]] || { api_token_resolve; [[ -n $api_token ]] || { access_no_token >&2; exit 1; }; }
    if [[ -n $api_token ]]; then   # prune never dies on a token for another account: the app waits for a later prune
      if [[ ${2:-} == prune ]]; then access_account soft || api_token=""; else access_account; fi
      [[ -z $api_token ]] || access_sweep
    fi
    lock_take index; pending_has_id "$1" || pending_add "$1" "$app" "" "${api_token:+$$}"; lock_release index
  fi
  [[ -n $fqdn ]] && host_rm "$fqdn"
  lock_take index
  # the copy goes first: a killed rm leaves a row with nothing served, never content with no row
  [[ -d $pub/$1 ]] && to_trash "$pub/$1"
  tmp="$(mktemp "$root/.index.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$index" >"$tmp" && mv -f "$tmp" "$index"
  write_caddyfile
  caddy_reload || reloaded=0
  lock_release index
  echo "unpublished $1"
  [[ -n $app ]] || return 0
  if [[ $reloaded == 0 ]] && has_opt live "$opts"; then   # the running Caddy still proxies /<id>/*: the app is the only gate left
    die "Caddy did not reload, so the live route for $1 may still answer; its Access app stays in access-pending; fix Caddy (see $root/caddy.log), then: $me prune"
  elif [[ -z $api_token ]]; then
    echo "share: Access app for $1 awaits deletion; run '$me prune' with a token (the stored one, or CLOUDFLARE_API_TOKEN)" >&2
  elif access_delete "$app" "$1"; then
    lock_take index; pending_drop_id "$1" "$app"; lock_release index
  else
    die "could not delete the Access app for $1 (HTTP $cf_code, or the app is not this share's, see above); it stays in access-pending for the next '$me prune' with the token"
  fi
}

cmd_prune() { # cmd_prune [quiet|listing]: unpublish every share past its expiry; sweep waiting Access apps when a token resolves
  if [[ $backend == r2 ]]; then r2_prune "${1:-}"; return 0; fi
  # quiet (serve, status): no token from any source, so neither touches Access; an expired gated share defers its
  # app. listing (ls): only an exported CLOUDFLARE_API_TOKEN, never api_token_cmd or the Keychain, so a listing
  # never runs `op read`. bare (the prune verb): the full resolver, soft on a failing api_token_cmd. A token for another
  # account warns and skips the sweep in every mode: expiry is never blocked.
  case ${1:-} in
    quiet) api_token="" ;;
    listing) api_token_resolve env ;;
    *) api_token_resolve soft ;;
  esac
  if [[ -n $api_token && -s $pending && -n $host_name ]]; then
    access_account soft && access_sweep
  fi
  [[ -s $index ]] || return 0
  local now ids id
  now="$(date +%s)"
  # a for loop, not `| while`: bash 5.3 skips the EXIT trap of a lock taken in a while-loop subshell
  ids="$(rows | awk -F'\t' -v now="$now" '$5 > 0 && $5 < now {print $1}')"
  for id in $ids; do
    cmd_rm "$id" prune | sed 's/$/ (expired)/' || true   # a listing never dies on one row
  done
}

cmd_hits() {
  local r opts fqdn="" log="$root/access.log"
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  fqdn="$(opt_val host "$opts" || true)"
  [[ -s $log ]] || { echo "0 hits"; return 0; }
  jq -rn --arg p "/$1/" --arg h "$fqdn" '
    def n($k; $w): "\($k) \($w)\(if $k == 1 then "" else "s" end)";
    [inputs | select((if $h == "" then (.request.uri | startswith($p)) else .request.host == $h end) and .status < 400)] as $h
    | n($h | length; "hit") + ", "
      + n($h | map(.request.headers["Cf-Connecting-Ip"][0] // .request.remote_ip) | unique | length; "visitor")
      + (if ($h | length) > 0 then ", last \($h[-1].ts | floor | strflocaltime("%F %H:%M"))" else "" end)' "$log"
}

# --- serving ---

write_caddyfile() { # rendered from index.tsv; no-store: Cloudflare must not cache past rm or stop
  local id name src date exp opts fqdn sroot tmp main_site="http://:$port"
  # named mode: the main site answers its own hostname (and loopback, for local probes) and nothing else;
  # a --host fqdn routed here before its own block exists, or any foreign Host, gets the 404 catch-all
  # instead of the whole pub tree. Quick mode keeps the any-host site: its hostname is unknown at render time.
  [[ $mode == quick || -z $host_name ]] || main_site="http://$host_name:$port, http://127.0.0.1:$port, http://localhost:$port"
  tmp="$(mktemp "$root/.Caddyfile.XXXXXX")"   # rendered aside and moved in: caddy never reads half a file
  {
    cat <<EOF
{
	admin unix//$root/admin.sock
	auto_https off
}
$main_site {
	bind 127.0.0.1
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	log {
		output file "$root/access.log"
		format json
	}
	@encsep expression {http.request.uri}.matches("^[^?]*(?i:%2f|%5c|%2e)")
	handle @encsep {
		respond 400
	}
EOF
    # the encoded-separator reject: the Access edge matches a path app after normalizing, but does not decode %2F or %5C;
    # Caddy would, so /x/..%2F<id>/f reaches pub/<id>/f past the gate. A handle block, because a bare respond sorts after handle.
    if [[ -s $index ]]; then
      while IFS=$'\t' read -r id name src date exp opts; do
        fqdn="$(opt_val host "$opts" || true)"
        if has_opt live "$opts" && [[ -z $fqdn ]]; then
          printf '\thandle_path /%s/* {\n\t\treverse_proxy http://127.0.0.1:%s\n\t}\n' "$id" "${src##*:}"
        fi
      done < <(rows)
    fi
    cat <<EOF
	handle /healthz {
		respond "ok" 200
	}
	handle {
		root * "$pub"
		file_server {
			index index.html README.html
		}
	}
}
EOF
    if [[ -s $index ]]; then
      while IFS=$'\t' read -r id name src date exp opts; do
        fqdn="$(opt_val host "$opts" || true)"
        [[ -n $fqdn ]] || continue
        cat <<EOF
http://$fqdn:$port {
	bind 127.0.0.1
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	log {
		output file "$root/access.log"
		format json
	}
EOF
        if has_opt live "$opts"; then
          printf '\treverse_proxy http://127.0.0.1:%s\n' "${src##*:}"
        else
          # folder payloads sit at pub/<id>/<name>; files sit directly under pub/<id>
          sroot="$pub/$id"
          [[ -d $pub/$id/$name ]] && sroot="$pub/$id/$name"
          printf '\troot * "%s"\n' "$sroot"
          [[ -f $sroot/index.html ]] && printf '\ttry_files {path} /index.html\n'
          printf '\tfile_server {\n\t\tindex index.html README.html\n\t}\n'
        fi
        printf '}\n'
      done < <(rows)
    fi
    [[ $main_site == "http://:$port" ]] || printf 'http://:%s {\n\tbind 127.0.0.1\n\trespond 404\n}\n' "$port"
  } >"$tmp"
  mv -f "$tmp" "$root/Caddyfile"
}

caddy_reload() { # apply Caddyfile changes over the admin socket; a failure warns and returns 1, never kills
  dry_log RELOAD
  running || return 0
  local err
  if ! err="$(caddy reload --config "$root/Caddyfile" --adapter caddyfile 2>&1)"; then
    echo "share: caddy reload failed: $err; see $root/caddy.log" >&2
    return 1
  fi
}

cmd_serve() {
  r2_no_local
  host_ok || die "$(this_host) is not in hosts=$hosts; serve from one machine only (a second one splits requests)"
  running && die "already serving (pid $(cat "$pidfile"))"
  export SHARE_API_TOKEN_OFF=1   # the daemon and its hourly prune never make an Access call, from any token source
  mk_root; mkdir -p "$pub"
  cmd_prune quiet   # before the render, so the Caddyfile never carries expired rows
  # locks are taken only here, before serve's own EXIT trap replaces release_locks
  lock_take index
  write_caddyfile
  lock_release index
  local token=""
  # pids stay global: the EXIT trap must still see them when cmd_serve returns
  # normally (e.g. cloudflared dies, wait returns) and locals unbind first.
  caddy_pid="" loop_pid="" tunnel_pid=""
  if [[ $tunnel == 1 && $mode != quick ]]; then
    need_host
    token="$(token_read || true)"
    [[ -n $token ]] || die "no tunnel token for $host_name: run '$me setup $host_name'"
  fi
  # caddy binds with SO_REUSEPORT, so a second server on the same port would start and split requests silently
  local busy="an orphaned server, or another share profile (share profiles)? free it, or change port= in $config and rerun $me setup"
  ! listening "$port" || die "127.0.0.1:$port is already in use: $busy"
  [[ $tunnel != 1 ]] || ! listening "$metrics_port" || die "127.0.0.1:$metrics_port (metrics) is already in use: $busy"
  echo $$ >"$pidfile"
  caddy run --config "$root/Caddyfile" --adapter caddyfile >>"$root/caddy.log" 2>&1 &
  caddy_pid=$!
  # The prune loop redirects to the log: inheriting serve's stdout would let an
  # orphaned sleep hold a caller's $( ) pipe open for an hour after serve dies.
  (while sleep 3600; do bash "$0" prune || true; done) >>"$root/serve.log" 2>&1 &
  loop_pid=$!
  # The trap lands before the tunnel work and reads the pids at run time:
  # a die in the quick-URL parse must still reap caddy and the prune loop.
  # pkill first: the loop's current sleep is a grandchild kill(1) can't reach.
  trap 'release_locks; [[ -n ${loop_pid:-} ]] && pkill -P "$loop_pid" 2>/dev/null; kill ${caddy_pid:-} ${loop_pid:-} ${tunnel_pid:-} 2>/dev/null; wait 2>/dev/null; rm -f "$pidfile" "$root/quick.url"' EXIT
  trap 'exit 0' INT TERM
  if [[ $tunnel == 1 && $mode == quick ]]; then
    # quick tunnel: no token, no DNS; cloudflared prints a random trycloudflare URL.
    # Only lines written after this spawn count: the log can hold a stale URL.
    local loglines=0 qu="" _
    [[ -f $root/cloudflared.log ]] && loglines="$(wc -l <"$root/cloudflared.log")"
    rm -f "$root/quick.url"
    cloudflared tunnel --no-autoupdate --url "http://127.0.0.1:$port" --metrics "127.0.0.1:$metrics_port" >>"$root/cloudflared.log" 2>&1 &
    tunnel_pid=$!
    for _ in $(seq 1 150); do
      qu="$(tail -n "+$((loglines + 1))" "$root/cloudflared.log" 2>/dev/null | grep -oE 'https://[a-z0-9.-]+\.trycloudflare\.com' | head -1 || true)"
      [[ -n $qu ]] && break
      # kill -0 alone lies for an unreaped child (zombie): check the state too
      if ! kill -0 "$tunnel_pid" 2>/dev/null || [[ $(ps -o stat= -p "$tunnel_pid" 2>/dev/null) == Z* ]]; then
        die "cloudflared died before printing a URL; see $root/cloudflared.log"
      fi
      sleep 0.2
    done
    [[ -n $qu ]] || die "cloudflared printed no trycloudflare URL after 30s; see $root/cloudflared.log"
    echo "${qu#https://}" >"$root/quick.url"
  elif [[ $tunnel == 1 ]]; then
    TUNNEL_TOKEN="$token" cloudflared tunnel --no-autoupdate --loglevel warn --grace-period 2s --metrics "127.0.0.1:$metrics_port" run &
    tunnel_pid=$!
  fi
  # Wait for the children, so the next serve never meets a dying cloudflared still answering /ready.
  sleep 1
  kill -0 "$caddy_pid" 2>/dev/null || die "caddy failed to start, see $root/caddy.log"
  local display="${host_name:-127.0.0.1:$port}"
  [[ $mode == quick ]] && display="$(serving_host)"
  echo "serving $pub on $display (pid $$)"
  wait "${tunnel_pid:-$caddy_pid}"
}


# --- background service: launchd on macOS, systemd --user on Linux ---

svc_label="${SHARE_SERVICE_LABEL:-foundation.d.share${profile:+.$profile}}"
svc_plist="$HOME/Library/LaunchAgents/$svc_label.plist"
svc_unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$svc_label.service"
svc_installed() { [[ -f $svc_plist || -f $svc_unit ]]; }

self_path() { # the stable path to this script: the PATH entry when it resolves here
  local s; s="$(command -v share 2>/dev/null || true)"
  if [[ -n $s && "$(realpath "$s")" == "$(realpath "$0")" ]]; then echo "$s"; else realpath "$0"; fi
}
svc_unload() { # bootout returns before launchd lets the job go; a bootstrap right after fails with error 5
  launchctl bootout "gui/$(id -u)/$svc_label" 2>/dev/null || true
  local _
  for _ in $(seq 1 20); do launchctl print "gui/$(id -u)/$svc_label" >/dev/null 2>&1 || return 0; sleep 0.5; done
}
svc_load() { launchctl bootstrap "gui/$(id -u)" "$svc_plist" 2>/dev/null || { sleep 1; launchctl bootstrap "gui/$(id -u)" "$svc_plist"; }; }
svc_path() { # PATH for the service: the directories of every tool share calls
  local p="" c d
  for c in caddy cloudflared jq curl pandoc gh trash security; do
    d="$(dirname "$(command -v "$c" 2>/dev/null || echo /usr/bin/x)")"
    case ":$p:" in *":$d:"*) ;; *) p="${p:+$p:}$d" ;; esac
  done
  echo "$p:/usr/bin:/bin:/usr/sbin:/sbin"
}
xml() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }

svc_install() {
  local self plist_env="" unit_env=""; self="$(self_path)"
  running && ! svc_installed && cmd_stop >/dev/null
  mk_root
  if [[ -n $profile ]]; then   # the daemon reads the profile's Keychain item; the default's files stay byte-identical
    plist_env=$'\n\t\t<key>SHARE_PROFILE</key><string>'"$profile"'</string>'
    unit_env=" \"SHARE_PROFILE=$profile\""
  fi
  if [[ $(uname -s) == Darwin ]]; then
    mkdir -p "$(dirname "$svc_plist")"
    cat >"$svc_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>$svc_label</string>
	<key>ProgramArguments</key><array><string>$(xml "$self")</string><string>serve</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
	<key>ThrottleInterval</key><integer>30</integer>
	<key>EnvironmentVariables</key><dict>
		<key>PATH</key><string>$(xml "$(svc_path)")</string>
		<key>SHARE_CONFIG_DIR</key><string>$(xml "$config_dir")</string>
		<key>SHARE_ROOT</key><string>$(xml "$root")</string>$plist_env
	</dict>
	<key>StandardOutPath</key><string>$(xml "$root/serve.log")</string>
	<key>StandardErrorPath</key><string>$(xml "$root/serve.log")</string>
</dict>
</plist>
EOF
    svc_unload
    svc_load
  elif command -v systemctl >/dev/null; then
    mkdir -p "$(dirname "$svc_unit")"
    cat >"$svc_unit" <<EOF
[Unit]
Description=share: publish local snapshots through a Cloudflare Tunnel
After=network-online.target

[Service]
ExecStart="$self" serve
Environment="PATH=$(svc_path)" "SHARE_CONFIG_DIR=$config_dir" "SHARE_ROOT=$root"$unit_env
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now "$svc_label.service" >/dev/null
  else
    die "no launchd or systemd here; use '$me start' instead"
  fi
}

svc_uninstall() {
  if [[ -f $svc_plist ]]; then
    svc_unload
    to_trash "$svc_plist"
  fi
  if [[ -f $svc_unit ]]; then
    systemctl --user disable --now "$svc_label.service" >/dev/null 2>&1 || true
    to_trash "$svc_unit"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
  return 0
}

wait_running() { # wait_running <seconds>: the server is up and, with the tunnel, connected to Cloudflare
  local i
  for ((i = 0; i < $1 * 2; i++)); do
    if running; then
      if [[ $tunnel != 1 ]]; then return 0
      elif [[ $mode == quick ]]; then [[ -s $root/quick.url ]] && return 0
      elif curl -sf -o /dev/null "http://127.0.0.1:$metrics_port/ready"; then return 0; fi
    fi
    sleep 0.5
  done
  return 1
}

cmd_service() {
  r2_no_local
  case "${1:-status}" in
    install)
      host_ok || die "$(this_host) is not in hosts=$hosts"
      svc_install
      wait_running 10 || die "the service did not start, see $root/serve.log"
      warn_not_live
      echo "service installed ($svc_label): serving now and at every login" ;;
    uninstall)
      svc_uninstall; echo "service removed; links are down until '$me start'" ;;
    status)
      if svc_installed; then echo "service: installed ($svc_label)"; else echo "service: not installed"; fi ;;
    *) die "usage: share service install|uninstall|status" ;;
  esac
}

cmd_start() {
  r2_no_local
  running && { echo "already serving (pid $(cat "$pidfile"))"; return 0; }
  host_ok || die "$(this_host) is not in hosts=$hosts; serve from one machine only (a second one splits requests)"
  mk_root
  if svc_installed; then
    if [[ -f $svc_plist ]]; then
      svc_load 2>/dev/null || launchctl kickstart "gui/$(id -u)/$svc_label"
    else
      systemctl --user start "$svc_label.service"
    fi
  else
    nohup bash "$0" serve >>"$root/serve.log" 2>&1 &   # serve exports SHARE_API_TOKEN_OFF: an inherited token serves --host cleanup only, never Access
  fi
  wait_running 10 || die "server did not start, see $root/serve.log"
  warn_not_live
  echo "  serving in the background (pid $(cat "$pidfile")); $me stop to end"
}

# The tunnel reports ready before caddy may listen, and the Cloudflare edge keeps routing to an
# old connection for a few seconds after a restart. Only a public fetch proves a link works.
live_check() { # live_check <seconds> [host]: a probe file answers 200 through the public hostname, 3 times in a row
  # One 200 is not enough: during a handover the edge still sends some requests to the old connection.
  local probe code streak=0 _ h
  h="${2:-$(serving_host)}"
  [[ -n $h ]] || return 1
  probe="_probe-$(rand_id).txt"
  mkdir -p "$pub" && echo ok >"$pub/$probe"
  for _ in $(seq 1 "$1"); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 --doh-url https://1.1.1.1/dns-query "https://$h/$probe" 2>/dev/null ||
      curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$h/$probe" || true)"
    if [[ $code == 200 ]]; then streak=$((streak + 1)); else streak=0; fi
    [[ $streak -ge 3 ]] && break
    sleep 1
  done
  rm -f "$pub/$probe"
  [[ $streak -ge 3 ]]
}
warn_not_live() {
  [[ ${SHARE_LIVE_CHECK:-1} == 1 ]] || return 0   # test seam: no public probe in the suite
  local h; h="$(serving_host)"
  [[ $tunnel == 1 && -n $h ]] || return 0
  live_check 20 "$h" || echo "  share: https://$h/ is not answering yet; see $root/serve.log" >&2
}

cmd_stop() {
  r2_no_local
  running || { echo "not serving"; return 0; }
  local pid; pid="$(cat "$pidfile")"
  if [[ -f $svc_plist ]]; then svc_unload
  elif [[ -f $svc_unit ]]; then systemctl --user stop "$svc_label.service"
  else kill "$pid"; fi
  while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
  rm -f "$root/quick.url"
  if svc_installed; then echo "stopped (all links down; the service starts again at next login)"
  else echo "stopped (all links down)"; fi
}

cmd_status() {
  cmd_prune quiet
  if running; then
    if [[ $mode == quick ]]; then
      echo "serving (pid $(cat "$pidfile")) on https://$(serving_host) (quick tunnel; the URL changes on every start)"
    else
      echo "serving (pid $(cat "$pidfile")) on $host_name: links are live"
    fi
  elif [[ -z $host_name && $mode != quick ]]; then echo "not set up: $me setup <hostname>, or $me setup --quick"
  else echo "not serving: $me start"; fi
  svc_installed && echo "service: installed ($svc_label)"
  cmd_ls
}

cmd_state() { # read-only JSON snapshot for the menu bar app: never prunes, writes, needs a TTY, or touches the clipboard
  local mode_val="named" host_val="" state_val ready_val="false" serves_val="false" service_val="false" skipped_n=0
  [[ $mode == quick ]] && mode_val="quick"
  if running; then state_val="serving"
  elif [[ -n $host_name || $mode == quick ]]; then state_val="stopped"
  else state_val="not_setup"; fi
  if [[ $state_val != serving ]]; then ready_val="false"
  elif [[ $tunnel != 1 ]]; then ready_val="true"
  elif [[ $mode_val == quick ]]; then
    [[ -s $root/quick.url ]] && ready_val="true" || ready_val="false"
  else
    curl -sf -m 1 -o /dev/null "http://127.0.0.1:$metrics_port/ready" 2>/dev/null && ready_val="true" || ready_val="false"
  fi
  if [[ $mode_val == named ]]; then host_val="$host_name"
  elif [[ $state_val == serving ]]; then host_val="$(cat "$root/quick.url" 2>/dev/null || true)"; fi
  host_ok && serves_val="true"
  svc_installed && service_val="true"
  # skipped_n is computed here, not inside the pipeline below: a `{ } | jq` pipeline
  # forks the left side, so an assignment made there never reaches this shell's copy
  # of the variable, and jq's --argjson would see only the local's initial "0".
  [[ -s $index ]] && skipped_n=$(($(awk 'length {c++} END {print c+0}' "$index") - $(rows | awk 'END {print NR}')))
  {
    if [[ -s $index ]]; then
      local id name src date exp opts kind own_host rule line rows=() i
      while IFS=$'\t' read -r id name src date exp opts; do
        kind="snapshot"; has_opt live "$opts" && kind="live"
        own_host="${opts#*host=}"
        [[ $own_host == "$opts" ]] && own_host="" || own_host="${own_host%% *}"
        rule="${opts#*access_rule=}"
        [[ $rule == "$opts" ]] && rule="" || rule="${rule%% *}"
        share_url "$id" "$name" "$opts"
        printf -v line '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$name" "$share_url_out" "$kind" "$own_host" "${exp:-0}" "$rule"
        rows+=("$line")
      done < <(rows)
      for ((i = ${#rows[@]} - 1; i >= 0; i--)); do printf '%s\n' "${rows[i]}"; done
    fi
  } | jq -nR \
    --arg state "$state_val" --argjson ready "$ready_val" --arg mode "$mode_val" \
    --arg host "$host_val" --arg hosts "$hosts" --argjson serves_here "$serves_val" \
    --argjson service "$service_val" --argjson skipped "$skipped_n" --argjson access_pending "$(pending_count)" '
    def row: split("\t") | {id: .[0], name: .[1], url: .[2], kind: .[3],
      own_host: (if .[4] == "" then null else .[4] end), expires: (.[5] | tonumber),
      access: (if .[6] == "" then null else .[6] end)};
    {schema: 1, state: $state, ready: $ready, mode: $mode,
     host: (if $host == "" then null else $host end), hosts: $hosts,
     serves_here: $serves_here, service: $service, access_pending: $access_pending,
     shares: [inputs | select(length > 0) | row]}
    + (if $skipped > 0 then {skipped: $skipped} else {} end)'
}

# --- Cloudflare setup / teardown ---
#
# Two ways to authorize. With CLOUDFLARE_API_TOKEN set, share uses the API for
# everything. Without it, share runs `cloudflared tunnel login`: the user picks
# the zone in a browser and Cloudflare hands back a cert.pem whose token may
# manage tunnels but not DNS records. That path creates DNS through
# `cloudflared tunnel route dns` and checks the hostname through public DNS.

cf_token="" account="" auth="" zone_name="" zone_id="" tun_id=""
cf() { # cf METHOD PATH [JSON]; the token goes through a header file, never argv
  local out
  out="$(curl -sS --max-time 30 -X "$1" "$api$2" -H @<(printf 'Authorization: Bearer %s\n' "$cf_token") \
    -H 'Content-Type: application/json' ${3:+--data "$3"})" || die "Cloudflare API $1 $2: request failed"
  if [[ "$(jq -r '.success' <<<"$out" 2>/dev/null)" != true ]]; then
    die "Cloudflare API $1 $2 failed: $(jq -c '.errors' <<<"$out" 2>/dev/null || head -c 300 <<<"$out")"
  fi
  printf '%s' "$out"
}
doh() { curl -s --max-time 10 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$1&type=$2"; }
public_zone() { # the zone apex that owns $1, from public DNS
  doh "$1" SOA | jq -r '[(.Answer // [])[], (.Authority // [])[]] | map(select(.type == 6)) | .[0].name // empty' | sed 's/\.$//'
}
resolves() { [[ "$(doh "$1" A | jq '(.Answer // []) | length')" -gt 0 ]]; }

cert="$config_dir/cert.pem"
cert_field() { sed -n '/BEGIN ARGO TUNNEL TOKEN/,/END ARGO TUNNEL TOKEN/p' "$cert" | grep -v 'ARGO TUNNEL TOKEN' | base64 -d | jq -r ".$1 // empty"; }

auth_api() {
  cf_token="$CLOUDFLARE_API_TOKEN"; auth=api
  local status; status="$(cf GET /user/tokens/verify | jq -r .result.status)"
  echo "auth:       API token ($status)"
}
auth_login() { # auth_login <zone>: browser login unless a cert for this zone exists
  auth=login
  if [[ ! -f $cert || "$(cat "$config_dir/cert.zone" 2>/dev/null)" != "$1" ]]; then
    echo "auth:       opening Cloudflare in your browser. Pick $1, then click Authorize."
    local tmp; tmp="$(mktemp -d)"
    HOME="$tmp" cloudflared tunnel login >&2 || die "cloudflared login failed"
    [[ -f $tmp/.cloudflared/cert.pem ]] || die "the login returned no certificate"
    mkdir -p "$config_dir"
    mv -f "$tmp/.cloudflared/cert.pem" "$cert" && chmod 600 "$cert"
    echo "$1" >"$config_dir/cert.zone"
    rm -rf "$tmp"
  fi
  cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"
  [[ -n $cf_token && -n $account ]] || die "cannot read $cert; delete it and rerun setup"
  echo "auth:       browser login ($cert)"
}
cf_token_account() { cert_field accountID; }

cf_zone() { # API mode: prints "<zone_id> <account_id> <zone_name>" for the zone owning $host_name
  local cand="$host_name" r
  while [[ $cand == *.* ]]; do
    r="$(cf GET "/zones?name=$cand")"
    if [[ "$(jq '.result | length' <<<"$r")" -gt 0 ]]; then
      jq -r '.result[0] | "\(.id) \(.account.id) \(.name)"' <<<"$r"; return
    fi
    [[ $cand == *.*.* ]] || break
    cand="${cand#*.}"
  done
  die "no Cloudflare zone for $host_name in this token's accounts"
}

listening() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
other_cfg() { # other_cfg <key>: that key from every OTHER profile's config; the default claims port 8787 even with no config
  local c v dflt="${XDG_CONFIG_HOME:-$HOME/.config}/share/config"
  for c in "$dflt" "$profiles_dir"/*/config; do
    [[ $c != "$config" ]] || continue
    v=""; [[ -f $c ]] && v="$(awk -v k="$1" 'index($0, k "=") == 1 {print substr($0, length(k) + 2); exit}' "$c")"
    [[ $1 == port && $c == "$dflt" ]] && v="${v:-8787}"
    [[ -n $v ]] && echo "$v"
  done
  return 0
}
port_claimed() { # port_claimed <p>: p is another profile's port or metrics port
  local q
  for q in $(other_cfg port); do
    [[ $q =~ ^[1-9][0-9]*$ ]] || continue   # another profile's corrupt port= is its own problem, never this command's
    [[ $1 == "$q" || $1 == "$((q + 1))" ]] && return 0
  done
  return 1
}
live_shared() { # live_shared <p>: p is a live share's port in any profile's index (its dev server may be down right now)
  local f
  for f in "$HOME/share/index.tsv" "$HOME/share/profiles"/*/index.tsv; do
    [[ -f $f ]] && awk -F'\t' -v p="$1" '$6 ~ /(^| )live( |$)/ {sub(/.*:/, "", $3); if ($3 == p) f = 1} END {exit !f}' "$f" && return 0
  done
  return 1
}
free_port() { # the lowest odd port from 8789 (SHARE_TEST_PORT_BASE test seam) whose pair (port, metrics) no other profile claims or live-shares and nothing listens on
  local p base=${SHARE_TEST_PORT_BASE:-8789}
  for ((p = base; p < 65000; p += 2)); do
    port_claimed "$p" || port_claimed "$((p + 1))" || live_shared "$p" || live_shared "$((p + 1))" ||
      listening "$p" || listening "$((p + 1))" || { echo "$p"; return 0; }
  done
  die "no free port pair from $base up"
}
profile_port() { # a named profile's first setup picks its own port pair, before any Cloudflare call; the config keeps it from then on
  [[ -n $profile && -z ${SHARE_PORT:-} && -z "$(cfg port || true)" ]] || return 0
  port="$(free_port)"; metrics_port=$((port + 1))
  echo "port:       $port (metrics $metrics_port)"
}

cmd_profiles() { # the default, then every directory under profiles/; state and host from each one's own `share state`
  local n d line
  for n in default "$profiles_dir"/*/; do
    [[ $n == default || -d $n ]] || continue
    d="${n%/}"; d="${d##*/}"
    # the overrides are unset for the children: an inherited SHARE_ROOT or SHARE_HOSTNAME would make every row read one setup
    line="$(env -u SHARE_ROOT -u SHARE_CONFIG_DIR -u SHARE_PORT -u SHARE_HOSTNAME -u SHARE_HOSTS -u SHARE_SERVICE_LABEL \
      SHARE_PROFILE="$d" bash "$0" state 2>/dev/null | jq -r '[.state, (.host // "-")] | @tsv' 2>/dev/null)" || line=""
    printf '%s\t%s\n' "$d" "${line:-error	-}"
  done
}

write_config_quick() { # quick mode: a mode flag and the serving facts, nothing Cloudflare
  hosts="${hosts:-$(this_host)}"
  mkdir -p "$config_dir"
  {
    echo "mode=quick"
    echo "hosts=$hosts"
    echo "port=$port"
  } >"$config.tmp"
  mv -f "$config.tmp" "$config"
}

cmd_setup_quick() {
  [[ -z $(cfg tunnel_id || true) ]] || die "already set up with a named tunnel; run '$me teardown' first"
  local missing="" c
  for c in caddy cloudflared jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  profile_port
  write_config_quick
  mode=quick   # the file is written; this process still read it as named at startup
  echo "mode:       quick tunnel (no domain, no login; links get a random trycloudflare.com URL)"
  host_ok || { echo "this host ($(this_host)) is not in hosts=$hosts; skipping the service"; return 0; }
  local service="${1:-1}"
  if [[ $service == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then
    svc_install; echo "service:    runs at login ($svc_label); the URL is new on every start"
  fi
  running || cmd_start >/dev/null 2>&1
  local q; q="$(serving_host)"
  [[ -n $q ]] || die "serving but no trycloudflare URL yet; see $root/cloudflared.log"
  warn_not_live
  echo "ready:      https://$q/ is live. The URL changes on every start. Next: $me add <file|dir>"
}

write_config() { # write_config <tunnel_id> <tunnel_name>; keeps a token_cmd and an api_token_cmd line if there was one
  local keep keep_api; keep="$(cfg token_cmd || true)"; keep_api="$(cfg api_token_cmd || true)"
  hosts="${hosts:-$(this_host)}"
  mkdir -p "$config_dir"
  {
    echo "hostname=$host_name"
    echo "tunnel_id=$1"
    echo "tunnel_name=$2"
    echo "auth=$auth"
    echo "hosts=$hosts"
    echo "port=$port"
    [[ -n $zone_name ]] && echo "zone=$zone_name"
    [[ -n $keep ]] && echo "token_cmd=$keep"
    [[ -n $keep_api ]] && echo "api_token_cmd=$keep_api"
  } >"$config.tmp"
  mv -f "$config.tmp" "$config"
}

# --- own hostnames: one CNAME + one ingress rule per --host share ---
#
# Create order is ingress, DNS, then the index row; delete order is DNS,
# ingress, then the row. SHARE_HOST_DRY=1 skips every Cloudflare call and
# records the intended calls, one per line, in $root/host-calls.log.

host_zone() { # the zone every --host name lives under; learned once, kept in config
  [[ -n $zone_name ]] && return 0
  zone_name="$(cfg zone || true)"
  if [[ -z $zone_name ]]; then
    if [[ ${SHARE_HOST_DRY:-0} == 1 || ${SHARE_ACCESS_DRY:-0} == 1 ]]; then zone_name="${host_name#*.}"
    else zone_name="$(public_zone "$host_name")"; fi
    [[ -n $zone_name ]] || die "cannot find the DNS zone of $host_name; is the domain on Cloudflare?"
    mkdir -p "$config_dir"; grep -q '^zone=' "$config" 2>/dev/null || echo "zone=$zone_name" >>"$config"
  fi
}

host_check() { # host_check <fqdn>: credential and name are settled before any write
  local fqdn="$1" label
  if [[ ${SHARE_HOST_DRY:-0} != 1 && -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
    die "--host needs CLOUDFLARE_API_TOKEN or a browser login ($me setup --login)"
  fi
  [[ $fqdn != "$host_name" ]] || die "--host cannot be the main hostname"
  host_zone
  case $fqdn in
    *."$zone_name") label="${fqdn%."$zone_name"}" ;;
    *) die "--host must be one label under $zone_name (Universal SSL stops at one level)" ;;
  esac
  case $label in
    ""|*.*|*[!a-z0-9-]*|-*|*-)
      die "--host must be one label under $zone_name (Universal SSL stops at one level)" ;;
  esac
}

host_auth() { # cf_token, account, zone_id, tun_id for Cloudflare-side host work
  [[ -n $cf_token && -n $account && -n $zone_id && -n $tun_id ]] && return 0
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    cf_token="$CLOUDFLARE_API_TOKEN"; auth=api
  elif [[ -f $cert ]]; then
    cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"; auth=login
  else
    die "--host needs CLOUDFLARE_API_TOKEN or a browser login ($me setup --login)"
  fi
  [[ -n $cf_token ]] || die "--host needs CLOUDFLARE_API_TOKEN or a browser login ($me setup --login)"
  local z; z="$(cf GET "/zones?name=$zone_name")"
  zone_id="$(jq -r '.result[0].id // empty' <<<"$z")"
  account="${account:-$(jq -r '.result[0].account.id // empty' <<<"$z")}"
  [[ -n $zone_id && -n $account ]] || die "the credential cannot see the $zone_name zone"
  tun_id="$(cfg tunnel_id || true)"
  [[ -n $tun_id ]] || die "no tunnel_id in $config; run '$me setup' first"
}

host_lock() { lock_take host "${SHARE_HOST_LOCK_TIMEOUT:-60}"; }   # one Cloudflare-side edit at a time
host_unlock() { lock_release host; }   # as soon as the edit lands; the EXIT trap is the die-path backstop

ingress_get() { # the tunnel config as {"config":{"ingress":[...]}}; dry mode reads a fixture
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    if [[ -f $root/host-fixture.json ]]; then cat "$root/host-fixture.json"
    else printf '{"config":{"ingress":[{"hostname":"%s","service":"http://127.0.0.1:%s"},{"service":"http_status:404"}]}}' "$host_name" "$port"; fi
    return 0
  fi
  cf GET "/accounts/$account/cfd_tunnel/$tun_id/configurations" | jq -c '.result'
}

ingress_check() { # the catch-all stays last and the primary hostname first, else hands off
  jq -e --arg h "$host_name" '
    (.config.ingress | length) >= 2
    and (.config.ingress[-1].service == "http_status:404")
    and (.config.ingress[0].hostname == $h)' <<<"$1" >/dev/null \
    || die "tunnel ingress was edited outside share; fix it in the dashboard or rerun $me setup --force"
}

ingress_put() { # ingress_put <config-json> <dry-log-word>
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "PUT ingress $2" >>"$root/host-calls.log"; return 0
  fi
  cf PUT "/accounts/$account/cfd_tunnel/$tun_id/configurations" "$(jq -c '{config:.config}' <<<"$1")" >/dev/null
}

host_add() { # host_add <fqdn>: collision guard, ingress rule, then the CNAME
  local fqdn="$1" rec="" rid="" rtype="" rcontent="" cfg_json new out
  if [[ ${SHARE_HOST_DRY:-0} != 1 ]]; then
    host_auth
    rec="$(cf GET "/zones/$zone_id/dns_records?name=$fqdn")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    rtype="$(jq -r '.result[0].type // empty' <<<"$rec")"
    rcontent="$(jq -r '.result[0].content // empty' <<<"$rec")"
    if [[ -n $rid && $rcontent != "$tun_id.cfargotunnel.com" ]]; then
      die "$fqdn already has a $rtype record ($rcontent); pick another hostname"
    fi
  fi
  host_lock
  cfg_json="$(ingress_get)"
  ingress_check "$cfg_json"
  new="$(jq -c --arg h "$fqdn" --arg s "http://127.0.0.1:$port" \
    '.config.ingress |= (.[:-1] + [{hostname:$h, service:$s, originRequest:{httpHostHeader:$h}}] + [.[-1]])' <<<"$cfg_json")"
  ingress_put "$new" "+1"
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "POST CNAME" >>"$root/host-calls.log"
  elif [[ -z $rid ]]; then
    # DNS comes after ingress; a POST failure puts the ingress back before dying
    if ! out="$(cf POST "/zones/$zone_id/dns_records" \
        "{\"type\":\"CNAME\",\"name\":\"$fqdn\",\"content\":\"$tun_id.cfargotunnel.com\",\"proxied\":true,\"comment\":\"share host\"}" 2>&1)"; then
      (ingress_put "$cfg_json" revert) || true
      if [[ $auth == login ]]; then
        die "the login cert cannot edit DNS records directly: export CLOUDFLARE_API_TOKEN with DNS Edit, or run $me setup with the token"
      fi
      die "could not create the DNS record for $fqdn (the ingress change was reverted): $out"
    fi
  fi
  host_unlock
}

host_rm() { # host_rm <fqdn>: delete the CNAME, then the ingress rule; missing counts as done
  local fqdn="$1" cfg_json rec="" rid="" out
  [[ $fqdn != "$host_name" ]] || die "$fqdn is the main hostname; host_rm never touches it"
  host_lock
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "DELETE CNAME" >>"$root/host-calls.log"
  else
    if [[ -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
      echo "share: no Cloudflare credential; DNS and ingress for $fqdn stay behind" >&2
      host_unlock; return 0
    fi
    host_zone
    host_auth
    rec="$(cf GET "/zones/$zone_id/dns_records?name=$fqdn")"
    # only a record pointing at this tunnel is ours to delete, as host_add checks before it creates one
    rid="$(jq -r --arg t "$tun_id.cfargotunnel.com" 'first(.result[] | select(.content == $t) | .id) // empty' <<<"$rec")"
    if [[ -z $rid ]] && jq -e '.result | length > 0' <<<"$rec" >/dev/null; then
      echo "share: $fqdn has a DNS record that does not point at this tunnel; left alone" >&2
    fi
    if [[ -n $rid ]]; then
      if ! out="$(cf DELETE "/zones/$zone_id/dns_records/$rid" 2>&1)"; then
        if [[ $auth == login ]]; then
          die "the login cert cannot edit DNS records directly: export CLOUDFLARE_API_TOKEN with DNS Edit, or run $me setup with the token"
        fi
        die "could not delete the DNS record for $fqdn: $out"
      fi
    fi
  fi
  cfg_json="$(ingress_get)"
  ingress_check "$cfg_json"
  cfg_json="$(jq -c --arg h "$fqdn" '.config.ingress |= map(select(.hostname != $h))' <<<"$cfg_json")"
  ingress_put "$cfg_json" "-1"
  host_unlock
}

# --- login gate: one Cloudflare Access app per share (ADR-0006) ---
#
# The bytes go public only after the gate is observed at the edge, and the gate goes
# only after the bytes are gone. Every app is tracked in $pending from the intent line
# before the POST until the line is dropped after the DELETE. SHARE_ACCESS_DRY=1 (with
# SHARE_TUNNEL=0 only) answers every Access call from fixtures and logs each one, one
# per line, in $root/access-calls.log.

access_usage="usage: --access group:<name> | email:<a>[,<b>...] | domain:<domain>"
access_rule="" access_include="" access_app="" access_aud="" access_group_out="" access_found="" acct=""
api_token="" api_token_src="" own_start_v="" probe_round=0
access_wait="${SHARE_ACCESS_WAIT:-900}"
access_named_only() { die "--access needs a named tunnel on a Cloudflare account with Access: '$me teardown', then '$me setup <hostname>'"; }
api_token_file="$config_dir/api-token"
api_token_key() { echo "share-api${profile:+.$profile}:$host_name"; }
dry_log() { [[ ${SHARE_ACCESS_DRY:-0} == 1 ]] && echo "$*" >>"$root/access-calls.log"; return 0; }
hostname_ok() { [[ $1 =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z][a-z]+$ ]]; }

access_parse() { # access_parse <rule>: validates and normalizes into access_rule; the include JSON waits for the account (group: is resolved by name)
  local kind="${1%%:*}" v="${1#*:}" e lp dom out="" list=()
  case $1 in *[[:space:]]*) die "$access_usage" ;; esac
  [[ $1 == *:* && -n $kind && -n $v ]] || die "$access_usage"
  case $kind in
    group)
      [[ ${#v} -le 64 ]] || die "$access_usage"
      case $v in *[!A-Za-z0-9._-]*) die "$access_usage" ;; esac
      access_rule="group:$v" ;;
    email)
      v="$(tr '[:upper:]' '[:lower:]' <<<"$v")"
      IFS=, read -ra list <<<"$v"
      [[ ${#list[@]} -ge 1 && ${#list[@]} -le 50 ]] || die "$access_usage"
      for e in "${list[@]}"; do
        lp="${e%%@*}"; dom="${e#*@}"
        [[ $e == *@* && -n $lp && $dom != *@* ]] || die "$access_usage"
        case $lp in *[!a-z0-9._%+-]*) die "$access_usage" ;; esac
        hostname_ok "$dom" || die "$access_usage"
        out="${out:+$out,}$e"
      done
      access_rule="email:$out" ;;
    domain)
      v="$(tr '[:upper:]' '[:lower:]' <<<"$v")"
      hostname_ok "$v" || die "$access_usage"
      echo "share: --access domain:$v admits every address at $v, contractors included; use group: to narrow it" >&2
      access_rule="domain:$v" ;;
    *) die "$access_usage" ;;
  esac
}
access_include_json() { # the policy include for access_rule; group: from access_group_out
  local kind="${access_rule%%:*}" v="${access_rule#*:}"
  case $kind in
    group) access_include="$(jq -nc --arg id "$access_group_out" '[{group:{id:$id}}]')" ;;
    email) access_include="$(jq -nc --arg v "$v" '[$v | split(",")[] | {email:{email:.}}]')" ;;
    domain) access_include="$(jq -nc --arg v "$v" '[{email_domain:{domain:$v}}]')" ;;
  esac
}

# the API token, one resolver for every Access path: the stored source wins over the shell,
# so a broad token exported in a shell never silently replaces the profile's own
api_token_resolve() { # api_token_resolve [env|soft]: sets api_token and api_token_src; api_token_cmd, then the Keychain item or 600 file, then CLOUDFLARE_API_TOKEN.
  # `env`: the environment only (a listing never runs op read or prompts). `soft` (the prune verb): a failing api_token_cmd warns and
  # resolves nothing, so expiry is never blocked. Nothing from any source under SHARE_API_TOKEN_OFF (share serve). Never exported.
  local cmd rc=0
  api_token="" api_token_src=""
  [[ ${SHARE_API_TOKEN_OFF:-0} == 1 ]] && return 0
  if [[ ${1:-} != env ]]; then
    cmd="$(cfg api_token_cmd || true)"
    if [[ -n $cmd ]]; then
      api_token="$(eval "$cmd" 2>/dev/null)" || rc=$?
      if [[ $rc != 0 || -z $api_token ]]; then
        api_token=""
        [[ ${1:-} == soft ]] || die "api_token_cmd failed (exit $rc); run it by hand to see why, or replace it: $me api-token --cmd '<command>'"
        echo "share: api_token_cmd failed (exit $rc); expired shares are still unpublished and their Access apps wait; run it by hand to see why, then: $me prune" >&2
        return 0
      fi
      api_token_src="api_token_cmd"; return 0
    fi
    if command -v security >/dev/null; then
      api_token="$(security find-generic-password -a share -s "$(api_token_key)" -w 2>/dev/null || true)"
      [[ -n $api_token ]] && { api_token_src="keychain $(api_token_key)"; return 0; }
    fi
    if [[ -f $api_token_file ]]; then
      api_token="$(cat "$api_token_file")"
      [[ -n $api_token ]] && { api_token_src="$api_token_file"; return 0; }
    fi
  fi
  [[ -n ${CLOUDFLARE_API_TOKEN:-} ]] && { api_token="$CLOUDFLARE_API_TOKEN"; api_token_src="CLOUDFLARE_API_TOKEN"; }
  return 0
}
api_token_store() { # api_token_store <token>: through stdin into the Keychain, or a 600 file; never argv. Called direct, never in $( ): a die must kill this process.
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "that does not look like a Cloudflare API token (letters, digits, - and _ only); rerun: $me api-token"
  if command -v security >/dev/null; then
    printf 'add-generic-password -U -a share -s "%s" -w "%s"\n' "$(api_token_key)" "$1" | security -i >/dev/null
    api_token_store_out="stored in the keychain (service $(api_token_key))"
  else
    (umask 077 && printf '%s' "$1" >"$api_token_file.$$") && mv -f "$api_token_file.$$" "$api_token_file"   # a fresh 600 file replaces any wider one; the token never sits in a readable file
    api_token_store_out="stored in $api_token_file (mode 600)"
  fi
}
api_token_forget() {
  if command -v security >/dev/null; then security delete-generic-password -a share -s "$(api_token_key)" >/dev/null 2>&1 || true; fi
  [[ -f $api_token_file ]] && to_trash "$api_token_file"
  return 0
}
access_token_url() { # the account-token template URL (Cloudflare docs, "API token template URLs"): the three permission keys, named for the profile
  printf 'https://dash.cloudflare.com/?to=/:account/api-tokens&permissionGroupKeys=%s&name=share%%20access%%20%%28%s%%29' \
    '%5B%7B%22key%22%3A%22access%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22access_acct%22%2C%22type%22%3A%22read%22%7D%2C%7B%22key%22%3A%22zone%22%2C%22type%22%3A%22read%22%7D%5D' \
    "${profile:-default}"
}
access_no_token() { # the guided block when no token source resolves; callers send it to stderr
  local z; z="$(cfg zone || true)"; z="${z:-${host_name#*.}}"
  cat <<EOF
share: --access needs a Cloudflare API token for $host_name${profile:+ (profile $profile)}; none is set.
  New token (opens the prefilled form, then paste):  $me api-token
  Already have a token with Access scopes:          $me api-token --cmd 'op read "op://<vault>/<item>/credential"'
  Form link, pick the account that owns $z:
     $(access_token_url)
EOF
}
access_scope_line() { echo "the token lacks '$1'; add it at https://dash.cloudflare.com/?to=/:account/api-tokens (account API tokens), then: $me api-token --check"; }
access_enable_line() { echo "Cloudflare Access is not enabled on the account that owns $zone_name; enable Zero Trust for this account in the Cloudflare dashboard, then: $me api-token --check"; }

cf_try() { # cf_try METHOD PATH [JSON]: like cf() but never dies; sets cf_body, cf_code (HTTP status, 000 on transport failure), cf_err (first errors[].code).
  # Call it directly, never inside $( ): globals set in a command substitution are lost. The token goes through a header file, never argv.
  local out
  cf_body="" cf_code=000 cf_err=""
  if [[ ${SHARE_ACCESS_DRY:-0} == 1 ]]; then   # the seam answers only with SHARE_TUNNEL=0; on a real install it refuses (000), never fakes a delete
    [[ $tunnel == 0 ]] || { echo "share: SHARE_ACCESS_DRY=1 is a test seam for SHARE_TUNNEL=0 only; the Cloudflare call was refused; unset it" >&2; return 0; }
    cf_dry "$@"; return 0
  fi
  out="$(curl -sS --max-time 30 -w '\n%{http_code}' -X "$1" "$api$2" -H @<(printf 'Authorization: Bearer %s\n' "$api_token") \
    -H 'Content-Type: application/json' ${3:+--data "$3"} 2>/dev/null)" || return 0
  cf_code="${out##*$'\n'}"; cf_body="${out%$'\n'*}"
  cf_err="$(jq -r '.errors[0].code // empty' <<<"$cf_body" 2>/dev/null || true)"
}
cf_dry() { # the SHARE_ACCESS_DRY answers: fixtures and knobs in, one log line per call; created apps live in $root/.access-dry
  local d="$root/.access-dry" name id nonce uuid page
  mkdir -p "$d"
  cf_code=200 cf_err="" cf_body='{"success":true,"result":[]}'
  case "$1 $2" in
    "GET /zones?"*)
      dry_log "GET zones"
      case ${SHARE_ACCESS_DRY_ZONES:-1} in
        0) cf_body='{"success":true,"result":[]}' ;;
        1) cf_body='{"success":true,"result":[{"id":"zone-dry","account":{"id":"acct-dry"}}]}' ;;
        *) cf_body='{"success":true,"result":[{"id":"zone-dry","account":{"id":"acct-dry"}},{"id":"zone-dry2","account":{"id":"acct-dry2"}}]}' ;;
      esac ;;
    "GET "*/access/organizations)
      dry_log "GET orgs"
      case ${SHARE_ACCESS_DRY_ORGS:-ok} in
        deny) cf_code=403 cf_err=10000 cf_body='{"success":false,"errors":[{"code":10000}]}' ;;
        off) cf_code=403 cf_err=9999 cf_body='{"success":false,"errors":[{"code":9999}]}' ;;
      esac ;;
    "GET "*/access/groups?*)
      dry_log "GET groups"
      page="${2#*&page=}"; page="${page%%&*}"
      # the name filter is ignored on purpose: the client-side exact match over every page is what gets exercised
      [[ -f $root/access-groups-fixture.json ]] && cf_body="$(jq -c --argjson p "$page" \
        '{success:true, result: .[($p - 1) * 100:$p * 100], result_info:{total_pages: (((length + 99) / 100 | floor) | if . < 1 then 1 else . end)}}' "$root/access-groups-fixture.json")" ;;
    "POST "*/access/apps)
      if [[ ${3:-} == '{}' ]]; then
        dry_log "POST app {}"
        case ${SHARE_ACCESS_DRY_APPS:-ok} in
          deny) cf_code=403 cf_err=10000 cf_body='{"success":false,"errors":[{"code":10000}]}' ;;
          off) cf_code=403 cf_err=9999 cf_body='{"success":false,"errors":[{"code":9999}]}' ;;
          *) cf_code=400 cf_err=12130 cf_body='{"success":false,"errors":[{"code":12130,"message":"access.api.error.invalid_request: app type is missing or invalid"}]}' ;;
        esac
      elif [[ ${SHARE_ACCESS_DRY_POST:-} == lost ]]; then
        dry_log "POST app (lost) $3"; printf '%s' "$3" >"$d/lost.json"; cf_code=000 cf_body=""
      else
        name="$(jq -r .name <<<"$3")"; id="$(awk '{print $2}' <<<"$name")"; nonce="${name##* }"
        uuid="00000000-0000-4000-8000-000000$id"
        jq -c --arg id "$uuid" --arg aud "aud-$nonce" '. + {id:$id, aud:$aud}' <<<"$3" >"$d/$uuid.json"
        cf_code=201 cf_body="{\"success\":true,\"result\":$(cat "$d/$uuid.json")}"
        dry_log "POST app"
      fi ;;
    "GET "*/access/apps/*)
      uuid="${2##*/}"; dry_log "GET app $uuid"
      if [[ -f $d/$uuid.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/$uuid.json")}"
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":12103}]}' cf_err=12103; fi ;;
    "GET "*"/access/apps?"*)
      dry_log "GET apps"
      if [[ -f $d/lost.json ]]; then
        jq -c '{id:"00000000-0000-4000-8000-000000001057", name:.name}' "$d/lost.json" >"$d/00000000-0000-4000-8000-000000001057.json"
        cf_body="$(jq -c '{success:true, result:[.], result_info:{total_pages:1}}' "$d/00000000-0000-4000-8000-000000001057.json")"
      fi ;;
    "DELETE "*/access/apps/*)
      uuid="${2##*/}"
      if [[ ${SHARE_ACCESS_DRY_DELETE:-} == lost ]]; then dry_log "DELETE app $uuid (lost)"; cf_code=000 cf_body=""
      else dry_log "DELETE app $uuid"; rm -f "$d/$uuid.json"; [[ $uuid == *001057 ]] && rm -f "$d/lost.json"; fi ;;
    *) dry_log "$1 $2" ;;
  esac
  return 0
}

access_account() { # access_account [soft]: acct, the account of the ONE active zone that owns the main hostname; needs the resolved token.
  # soft (a listing): a token for another account warns in one line and returns 1, so ls and status never die on it
  [[ -n $acct ]] && return 0
  [[ ${1:-} == soft && -n ${access_soft_warned:-} ]] && return 1   # a soft miss already warned once this run
  [[ -n $api_token ]] || { access_no_token >&2; exit 1; }
  local n why=""
  if [[ ${1:-} == soft ]]; then zone_name="${zone_name:-$(cfg zone || true)}"; zone_name="${zone_name:-${host_name#*.}}"; else host_zone; fi
  cf_try GET "/zones?name=$zone_name&status=active"
  n="$(jq -r '.result | length' <<<"$cf_body" 2>/dev/null || echo 0)"
  if [[ $cf_code != 200 ]]; then why="$(access_scope_line 'Zone: Read')"
  elif [[ $n != 1 ]]; then why="the token sees $n active zones named $zone_name; use a token scoped to the account that owns $host_name"; fi
  if [[ -n $why ]]; then
    [[ ${1:-} == soft ]] || die "$why"
    [[ -z ${access_soft_warned:-} ]] && echo "share: $why; skipping the Access check" >&2
    access_soft_warned=1; return 1
  fi
  acct="$(jq -r '.result[0].account.id' <<<"$cf_body")"
}
access_read_proven=0
access_proof() { # once per process: a token without the Access read scope answers 404 to any app id, so a 404 proves nothing until this passes
  [[ $access_read_proven == 1 ]] && return 0
  cf_try GET "/accounts/$acct/access/organizations"
  [[ $cf_code == 200 ]] || return 1
  access_read_proven=1
}
access_preflight() { # read-only, safe to rerun: the token source, then one call per scope, one line each on stderr; 0 only when every line is ok.
  # The Apps Edit probe is an invalid body ({}): a 400 with code 12130 proves the scope without creating anything (measured on a live account).
  local fails=0 n z
  api_token_resolve
  z="$(cfg zone || true)"; z="${z:-${host_name#*.}}"
  echo "share: checking the API token for profile ${profile:-default} (zone $z)" >&2
  if [[ -z $api_token ]]; then   # before any lookup: the guided block needs no network
    printf '  %-8s token found\n' MISSING >&2
    access_no_token >&2
    return 1
  fi
  printf '  %-8s token found (%s)\n' ok "$api_token_src" >&2
  host_zone
  cf_try GET "/zones?name=$zone_name&status=active"
  n="$(jq -r '.result | length' <<<"$cf_body" 2>/dev/null || echo 0)"
  if [[ $cf_code == 200 && $n == 1 ]]; then
    acct="$(jq -r '.result[0].account.id' <<<"$cf_body")"
    printf '  %-8s %-62s GET /zones?name=%s -> 1 zone\n' ok "Zone: Read" "$zone_name" >&2
  elif [[ $cf_code == 200 && $n -gt 1 ]]; then
    printf '  %-8s ambiguous: %s active zones named %s; use a token scoped to the account that owns %s\n' MISSING "$n" "$zone_name" "$host_name" >&2; fails=1
  else
    printf '  %-8s %-62s GET /zones?name=%s -> %s\n' MISSING "Zone: Read" "$zone_name" "$cf_code" >&2; fails=1
  fi
  if [[ -n $acct ]]; then
    cf_try GET "/accounts/$acct/access/organizations"
    if [[ $cf_code == 200 ]]; then
      printf '  %-8s %-62s GET /accounts/<acct>/access/organizations -> 200\n' ok "Access: Organizations, Identity Providers, and Groups Read" >&2
    elif [[ $cf_err == 9999 ]]; then
      printf '  %-8s %s\n' MISSING "$(access_enable_line)" >&2; fails=1
    else
      printf '  %-8s %-62s GET /accounts/<acct>/access/organizations -> %s\n' MISSING "Access: Organizations, Identity Providers, and Groups Read" "${cf_err:-$cf_code}" >&2; fails=1
    fi
    cf_try POST "/accounts/$acct/access/apps" '{}'
    if [[ $cf_code == 400 && $cf_err == 12130 ]]; then
      printf '  %-8s %-62s POST /accounts/<acct>/access/apps {} -> 400 (12130, nothing created)\n' ok "Access: Apps and Policies Edit" >&2
    elif [[ $cf_err == 9999 ]]; then
      printf '  %-8s %s\n' MISSING "$(access_enable_line)" >&2; fails=1
    elif [[ $cf_err == 10000 ]]; then
      printf '  %-8s %-62s POST /accounts/<acct>/access/apps {} -> 10000\n' MISSING "Access: Apps and Policies Edit" >&2; fails=1
    else
      printf '  could not check  Access: Apps and Policies Edit (%s); rerun: %s api-token --check\n' "$cf_code${cf_err:+/$cf_err}" "$me" >&2; fails=1
    fi
  fi
  [[ $fails == 0 ]] && return 0
  echo "  fix: add the missing permission to this token at https://dash.cloudflare.com/?to=/:account/api-tokens (account API tokens), then run: $me api-token --check" >&2
  return 1
}
access_prepare() { # for add --access, before any write: the preflight (the guided block or a scope line), the sweep, then the include JSON
  access_preflight || exit 1
  access_sweep
  [[ ${access_rule%%:*} == group ]] && access_group_id "${access_rule#*:}"
  access_include_json
}
access_group_id() { # access_group_id <name>: sets access_group_out from an exact name match over every page; none or two is a refusal
  local page=1 pages=1 ids="" n
  while :; do
    cf_try GET "/accounts/$acct/access/groups?name=$1&page=$page&per_page=100"
    [[ $cf_code == 200 ]] || die "$(access_scope_line 'Access: Organizations, Identity Providers, and Groups Read')"
    ids="$ids $(jq -r --arg n "$1" '.result[] | select(.name == $n) | .id' <<<"$cf_body" | tr '\n' ' ')"
    pages="$(jq -r '.result_info.total_pages // 1' <<<"$cf_body")"
    [[ $page -lt $pages ]] || break
    page=$((page + 1))
  done
  n="$(wc -w <<<"$ids" | tr -d ' ')"
  case $n in
    0) access_group_missing "$1" >&2; exit 1 ;;
    1) access_group_out="${ids// /}" ;;
    *) die "two Access groups are named '$1'; rename one" ;;
  esac
}
access_group_missing() { # the dashboard path is quoted from Cloudflare docs, "Rule groups"
  cat <<EOF
share: no Access group named '$1' on the account that owns $zone_name.
  Create it once (share never creates groups):
  Cloudflare dashboard > Zero Trust > Access controls > Policies > Rule groups tab > Add a group
    Name: $1
    Include > Selector: Emails > Value: each address (one per entry)
    Save
  then rerun the same $me add.
EOF
}

# the pending file: <share id>\t<app uuid or -:<nonce>>\t<owner pid>\t<owner start>\t<created epoch>; every read and write under the index lock
proc_start() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//'; }
own_start() { [[ -n $own_start_v ]] || own_start_v="$(proc_start $$)"; echo "$own_start_v"; }
pending_add() { # pending_add <id> <app> [created] [owner pid]: an owner of 0 (a deferred delete) is dead by definition, so the next sweep claims it
  local o="${4-$$}" st="-"; o="${o:-0}"   # an empty fourth argument means "no owner", never this pid
  [[ $o == 0 ]] || st="$(own_start)"
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$o" "$st" "${3:-$(date +%s)}" >>"$pending"
}
pending_has() { grep -qF "$(printf '%s\t%s\t%s\t%s\t' "$1" "$2" "$$" "$(own_start)")" "$pending" 2>/dev/null; }
pending_has_id() { grep -q "^$1"$'\t' "$pending" 2>/dev/null; }
pending_drop() { # pending_drop <id> <app>: this process's exact line only
  [[ -f $pending ]] || return 0
  local tmp; tmp="$(mktemp "$root/.pending.XXXXXX")"
  grep -vF "$(printf '%s\t%s\t%s\t%s\t' "$1" "$2" "$$" "$(own_start)")" "$pending" >"$tmp" || true
  mv -f "$tmp" "$pending"
}
pending_drop_id() { # pending_drop_id <id> <app>: every line for that app, whoever owns it; the app is gone
  [[ -f $pending ]] || return 0
  local tmp; tmp="$(mktemp "$root/.pending.XXXXXX")"
  awk -F'\t' -v id="$1" -v app="$2" '!($1 == id && $2 == app)' "$pending" >"$tmp"
  mv -f "$tmp" "$pending"
}
pending_set_app() { # pending_set_app <id> <old> <new>: rewrite this process's exact line; 1 when a sweep claimed or removed it
  pending_has "$1" "$2" || return 1
  local tmp; tmp="$(mktemp "$root/.pending.XXXXXX")"
  awk -F'\t' -v OFS='\t' -v id="$1" -v old="$2" -v new="$3" -v pid="$$" -v st="$(own_start)" \
    '$1 == id && $2 == old && $3 == pid && $4 == st {$2 = new} {print}' "$pending" >"$tmp"
  mv -f "$tmp" "$pending"
}
pending_line_ok() { [[ $1 =~ ^[0-9a-f]{6}$ ]] && [[ $2 =~ ^[0-9a-f-]{36}$ || $2 =~ ^-:[0-9a-f]{8}$ ]] && [[ $3 =~ ^[0-9]+$ ]]; }
pending_count() { # pending_count [live|bad]: every non-empty line; `live` the well-formed ones a sweep can act on; `bad` the hand-edited rest
  local id app pid st created n=0 bad=0
  [[ -f $pending ]] || { echo 0; return 0; }
  while IFS=$'\t' read -r id app pid st created; do
    [[ -n $id ]] || continue
    n=$((n + 1)); pending_line_ok "$id" "$app" "$created" || bad=$((bad + 1))
  done <"$pending"
  case ${1:-} in live) echo $((n - bad)) ;; bad) echo "$bad" ;; *) echo "$n" ;; esac
}
owner_live() { # owner_live <pid> <start>: alive, a share process, and the same start time (pid reuse, share serve included)
  [[ $1 != 0 ]] || return 1   # kill -0 0 would signal the process group and answer yes
  kill -0 "$1" 2>/dev/null && [[ $(ps -o command= -p "$1" 2>/dev/null) == *share* && "$(proc_start "$1")" == "$2" ]]
}

access_create() { # access_create <id> [fqdn]: the intent line, the app, its uuid into the line, then a read-back; sets access_app and access_aud
  local nonce name dests body
  nonce="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  name="share $1 $host_name $nonce"   # the nonce is the last word: a lookup by name can never match an older app for the same id
  lock_take index; pending_add "$1" "-:$nonce"; lock_release index
  dests="[{\"type\":\"public\",\"uri\":\"$host_name/$1\"},{\"type\":\"public\",\"uri\":\"$host_name/$1/*\"}]"
  [[ -n ${2:-} ]] && dests="$(jq -c --arg u "$2" '. + [{type:"public", uri:$u}]' <<<"$dests")"
  body="$(jq -nc --arg name "$name" --arg pname "share $1" --argjson d "$dests" --argjson inc "$access_include" \
    '{name:$name, type:"self_hosted", destinations:$d, app_launcher_visible:false, session_duration:"24h",
      policies:[{name:$pname, decision:"allow", include:$inc, precedence:1}]}')"
  cf_try POST "/accounts/$acct/access/apps" "$body"
  [[ $cf_code != 000 ]] || die "the Cloudflare API did not answer the Access app create for $1; nothing was published (the next '$me prune' with the token finds or forgets it); rerun the same $me add"
  [[ $cf_err != 9999 ]] || die "$(access_enable_line)"
  [[ $cf_err != 10000 ]] || die "$(access_scope_line 'Access: Apps and Policies Edit')"
  [[ $cf_code == 2* ]] || die "Cloudflare API POST access/apps failed ($cf_code): $(jq -c '.errors' <<<"$cf_body" 2>/dev/null || head -c 300 <<<"$cf_body"); rerun the same $me add"
  access_app="$(jq -r '.result.id // empty' <<<"$cf_body")"; access_aud="$(jq -r '.result.aud // empty' <<<"$cf_body")"
  [[ $access_app =~ ^[0-9a-f-]{36}$ && -n $access_aud ]] || die "the Access app create for $1 answered without an id or aud; see '$me prune' with the token to clean up; rerun the same $me add"
  lock_take index
  if ! pending_set_app "$1" "-:$nonce" "$access_app"; then
    lock_release index; access_delete "$access_app" "$1" || true
    die "a sweep claimed the Access app of $1 while it was created; nothing was published; rerun the same $me add"
  fi
  lock_release index
  cf_try GET "/accounts/$acct/access/apps/$access_app"   # a stored app is checked, not assumed
  if ! jq -e --argjson d "$dests" '([.result.destinations[].uri] | sort) == ([$d[].uri] | sort) and ((.result.policies // []) | length) > 0' <<<"$cf_body" >/dev/null 2>&1; then
    if access_delete "$access_app" "$1"; then lock_take index; pending_drop "$1" "$access_app"; lock_release index; fi
    die "the Access app for $1 did not read back as sent (destinations or policy); it was deleted, nothing was published; rerun the same $me add"
  fi
}
access_delete() { # access_delete <uuid> <share id>: only an app whose name says it is this share's; 404 is done; anything else (000 included) is not
  local name
  cf_try GET "/accounts/$acct/access/apps/$1"
  if [[ $cf_code == 404 ]]; then access_proof; return; fi   # done only once Access read is proven: a scope-less token 404s on every id
  [[ $cf_code == 200 ]] || return 1
  name="$(jq -r '.result.name // empty' <<<"$cf_body")"
  if [[ $name != "share $2 $host_name "* ]]; then   # a forged row or line must never delete a foreign app with an account-wide token
    echo "share: Access app $1 is not the app of share $2 (its name is '$name'); left alone" >&2
    return 1
  fi
  cf_try DELETE "/accounts/$acct/access/apps/$1"
  [[ $cf_code == 2* || $cf_code == 404 ]]
}
access_find_by_nonce() { # access_find_by_nonce <nonce>: sets access_found to the app whose name ends in " <nonce>", over every page; 1 when the list could not be read
  local page=1 pages
  access_found=""
  while :; do
    cf_try GET "/accounts/$acct/access/apps?page=$page&per_page=100"
    [[ $cf_code == 200 ]] || return 1
    access_found="$(jq -r --arg s " $1" 'first(.result[] | select(.name | endswith($s)) | .id) // empty' <<<"$cf_body")"
    [[ -n $access_found ]] && return 0
    pages="$(jq -r '.result_info.total_pages // 1' <<<"$cf_body")"
    [[ $page -lt $pages ]] || return 0
    page=$((page + 1))
  done
}

access_probe_round() { # access_probe_round <aud> <url>...: one probe per url; 0 when every one redirects to Access with kid == aud
  local aud="$1" u out code redir host rest kid ok=1 result; shift
  probe_round=$((probe_round + 1))
  if [[ ${SHARE_ACCESS_DRY:-0} == 1 ]]; then   # the fixture's next line, the last one repeating; nothing there is a pass
    result="$(sed -n "${probe_round}p" "$root/access-probe-fixture" 2>/dev/null || true)"
    [[ -n $result ]] || result="$(tail -1 "$root/access-probe-fixture" 2>/dev/null || true)"
    result="${result:-pass}"
    dry_log "PROBE $result"
    [[ $result == pass ]]; return
  fi
  for u in "$@"; do
    host="${u#https://}"; host="${host%%/*}"
    # a failed curl still prints its -w line ("000 "), so the fallback replaces the output instead of appending to it
    out="$(curl -s -o /dev/null --max-time 10 --doh-url https://1.1.1.1/dns-query -w '%{http_code} %{redirect_url}' "$u?share_gate=$(rand_id_raw)" 2>/dev/null)" ||
      out="$(curl -s -o /dev/null --max-time 10 -w '%{http_code} %{redirect_url}' "$u?share_gate=$(rand_id_raw)" 2>/dev/null)" || out=""
    code="${out%% *}"; redir="${out#* }"
    [[ $code == 30? && $redir =~ ^https://[a-z0-9-]+\.cloudflareaccess\.com/cdn-cgi/access/login/ ]] || { ok=0; continue; }
    rest="${redir#*/cdn-cgi/access/login/}"
    [[ ${rest%%[/?]*} == "$host" ]] || ok=0
    kid="$(sed -n 's/.*[?&]kid=\([^&]*\).*/\1/p' <<<"$redir")"
    [[ $kid == "$aud" ]] || ok=0
  done
  [[ $ok == 1 ]]
}
access_gate() { # access_gate <id> <aud> [fqdn]: every gated URL must pass three rounds in a row; 1 when SHARE_ACCESS_WAIT runs out
  local wait="$access_wait" poll="${SHARE_ACCESS_POLL:-10}" start now streak=0 last_msg=0 urls s
  urls="https://$host_name/$1/ https://$host_name/$1"
  [[ -n ${3:-} ]] && urls="$urls https://$3/"
  start="$(date +%s)"; last_msg="$start"   # the next notice comes after 60 s of waiting
  echo "share: waiting up to ${wait}s for Cloudflare Access to enforce on $host_name/$1 (a new app can take minutes; Ctrl-C is safe: nothing is published, the next add or prune removes the app)" >&2
  held_access_id="$1"
  while :; do
    # shellcheck disable=SC2086 # the url list is space-separated on purpose
    if access_probe_round "$2" $urls; then
      streak=$((streak + 1)); [[ $streak -ge 3 ]] && return 0
    else
      streak=0
    fi
    now="$(date +%s)"
    [[ $((now - start)) -lt $wait ]] || return 1
    if [[ $((now - last_msg)) -ge 60 ]]; then
      echo "share: waiting for Cloudflare Access to enforce on $host_name/$1 (new apps can take several minutes)" >&2; last_msg="$now"
    fi
    s=5; [[ $streak == 0 || ${SHARE_ACCESS_DRY:-0} == 1 ]] && s="$poll"   # confirmation rounds 5 s apart; the poll interval until the first pass
    sleep "$s"
  done
}

access_sweep() { # every pending line: a live owner is skipped, a finished add's stale line dropped, the rest claimed under the lock
  # (orphaned bytes trashed first), then each app deleted with no lock held. A line that is not done stays claimed by
  # this process; once it exits, the next sweep sees a dead owner and retries.
  [[ -s $pending ]] || return 0
  local id app pid st created tmp reload=0 claimed="" uuid
  lock_take index
  tmp="$(mktemp "$root/.pending.XXXXXX")"
  while IFS=$'\t' read -r id app pid st created; do
    [[ -n $id && -n $app ]] || continue
    # a hand-edited line is kept but never acted on: its id would become a path, its app a DELETE
    if ! pending_line_ok "$id" "$app" "$created"; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$app" "$pid" "$st" "$created" >>"$tmp"; continue
    fi
    if owner_live "$pid" "$st"; then printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$app" "$pid" "$st" "$created" >>"$tmp"; continue; fi
    [[ "$(opt_val access "$(row "$id" | cut -f6)" || true)" == "$app" ]] && continue   # the add finished: a stale line
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$app" "$$" "$(own_start)" "$created" >>"$tmp"
    claimed="$claimed$id $app $created"$'\n'
    if [[ -z "$(row "$id")" ]]; then   # orphaned bytes, or a live route an rm whose reload failed left in the running Caddy
      [[ -e $pub/$id ]] && { to_trash "$pub/$id"; dry_log "TRASH $id"; }
      reload=1
    fi
  done <"$pending"
  mv -f "$tmp" "$pending"
  if [[ $reload == 1 ]]; then
    write_caddyfile
    caddy_reload || { lock_release index; echo "share: the waiting Access apps stay until Caddy reloads (see $root/caddy.log), then: $me prune" >&2; return 0; }
  fi
  lock_release index
  while read -r id app created; do
    [[ -n $id ]] || continue
    uuid="$app"
    if [[ $app == -:* ]]; then
      access_proof || continue   # an app list read without the scope is empty and proves nothing
      access_find_by_nonce "${app#-:}" || continue
      uuid="$access_found"
      if [[ -z $uuid ]]; then   # a POST can still commit after the client timeout: only an old line is forgotten
        [[ $(( $(date +%s) - created )) -gt 600 ]] || continue
        lock_take index; pending_drop "$id" "$app"; lock_release index
        continue
      fi
    fi
    if access_delete "$uuid" "$id"; then lock_take index; pending_drop "$id" "$app"; lock_release index; fi
  done <<<"$claimed"
}

access_pending_note() { # ls and status: apps waiting for a token, and lines no sweep will ever touch
  local n b; n="$(pending_count live)"; b="$(pending_count bad)"
  [[ $n -gt 0 ]] && echo "share: $n Access app(s) await deletion; run '$me prune' with a token (the stored one, or CLOUDFLARE_API_TOKEN)" >&2
  [[ $b -gt 0 ]] && echo "share: $b malformed line(s) in $pending; a sweep never acts on them; remove them by hand" >&2
  return 0
}
access_ls_check() { # with an exported CLOUDFLARE_API_TOKEN only (never op read or a prompt from a listing): a gated row whose app is gone is PUBLIC
  [[ $backend == r2 ]] && return 0   # on r2 a missing app leaves the link closed: the Worker checks the JWT itself
  local pairs id app
  api_token_resolve env
  [[ -n $api_token && -n $host_name ]] || return 0
  pairs="$(rows | awk -F'\t' '{n = split($6, a, " "); for (i = 1; i <= n; i++) if (substr(a[i], 1, 7) == "access=") print $1, substr(a[i], 8)}')"
  [[ -n $pairs ]] || return 0
  access_account soft || return 0
  access_proof || return 0   # a 404 from a token without the Access read scope would call every gated link PUBLIC
  while read -r id app; do
    [[ -n $id ]] || continue
    cf_try GET "/accounts/$acct/access/apps/$app"
    [[ $cf_code == 404 ]] && echo "share: Access app for $id is gone; the link is PUBLIC; $me rm $id" >&2
  done <<<"$pairs"
  return 0
}

cmd_api_token() { # cmd_api_token [--cmd '<command>' | --check]: store a token command, a hidden paste, or stdin; then the read-only preflight
  need_host
  [[ $mode != quick ]] || access_named_only
  local usage="usage: share api-token [--cmd '<command>' | --check]" tok="" url
  case ${1:-} in
    --check) [[ $# -eq 1 ]] || die "$usage" ;;
    --cmd)
      [[ $# -eq 2 && -n $2 ]] || die "$usage"
      case $2 in *$'\n'*|*$'\r'*) die "$usage" ;; esac   # a line break would inject a second config line
      mkdir -p "$config_dir"
      { [[ -f $config ]] && { grep -v '^api_token_cmd=' "$config" || true; }; echo "api_token_cmd=$2"; } >"$config.tmp"
      mv -f "$config.tmp" "$config"
      echo "token:      api_token_cmd stored in $config (no secret written)" ;;
    "")
      url="$(access_token_url)"
      if [[ -t 0 ]]; then
        echo "Create the token in the Cloudflare dashboard: the form is prefilled, pick the account that owns $host_name, click Create."
        echo "  $url"
        access_open_url "$url"
        read -rs -p "Paste the new token (input hidden): " tok; echo
      else
        IFS= read -r tok || true
      fi
      [[ -n $tok ]] || die "no token entered; rerun: $me api-token"
      api_token_store "$tok"   # direct call: a bad token dies here, never reaches the preflight
      echo "token:      $api_token_store_out"
      tok="" ;;
    *) die "$usage" ;;
  esac
  access_preflight
}
access_open_url() { # the platform opener, backgrounded; skipped over ssh or with no display, so a text browser never fights the hidden prompt
  local opener
  [[ -z ${SSH_CONNECTION:-} ]] || return 0
  if [[ $(uname -s) == Darwin ]]; then opener=open
  else [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || return 0; opener=xdg-open; fi
  command -v "$opener" >/dev/null || return 0
  ( trap "" HUP; nohup "$opener" "$1" >/dev/null 2>&1 & )   # survives the terminal closing mid-run
  return 0
}

# --- r2 backend ---
# A profile with backend=r2 publishes snapshots to a private R2 bucket; a Worker
# serves them on the profile's hostname. The config holds backend=r2 and the
# port=r2 sentinel: an older share dies on that port at load, so it can never
# write pub/ or an Access app against an r2 profile.

WORKER_VERSION=1            # bump on every Worker source change; deploys refuse a downgrade without --force
WORKER_SHA=f8e97175987b     # first 12 hex of the emitted source's sha256; the suite fails when it drifts
WORKER_COMPAT_DATE=2026-09-30   # moves only with a WORKER_VERSION bump
WORKER_RECORD_V=1           # the record schema this source understands; a newer record answers 404
worker_meta() { printf '%s\n' "$WORKER_VERSION" "$WORKER_SHA" "$WORKER_COMPAT_DATE" "$WORKER_RECORD_V"; }   # one line, four fields, for the deploy and sweep paths

worker_js() { # worker_js <path>: the Worker source to $1; never a heredoc inside $( ) (macOS /bin/bash 3.2)
  cat >"$1" <<'SHARE_WORKER_JS'
// share Worker: serves R2-backed snapshots on one hostname, a gated record only
// inside a valid Cloudflare Access session for that record's app.
const RECV = 1;
const TYPES = {
  html: "text/html", css: "text/css", js: "text/javascript", mjs: "text/javascript",
  json: "application/json", txt: "text/plain", md: "text/markdown", csv: "text/csv",
  xml: "application/xml", svg: "image/svg+xml", png: "image/png", jpg: "image/jpeg",
  jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp", ico: "image/x-icon",
  pdf: "application/pdf", mp4: "video/mp4", webm: "video/webm", mp3: "audio/mpeg",
  wav: "audio/wav", woff: "font/woff", woff2: "font/woff2", zip: "application/zip",
  wasm: "application/wasm",
};

let jwks = { ts: 0, keys: null };   // isolate-global cert cache, one hour
let jwksFetch = 0;                  // a refetch at most once a minute, failures never cached

const b64u = (s) => {
  s = s.replace(/-/g, "+").replace(/_/g, "/");
  while (s.length % 4) s += "=";
  const bin = atob(s);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
};
const b64json = (s) => JSON.parse(new TextDecoder().decode(b64u(s)));

async function certs(env, kid) {
  const now = Date.now();
  const want = !jwks.keys || now - jwks.ts > 3600e3 || !jwks.keys.some((k) => k.kid === kid);
  if (want && now - jwksFetch >= 60e3) {
    jwksFetch = now;
    try {
      const r = await fetch("https://" + env.TEAM + "/cdn-cgi/access/certs");
      if (r.ok) {
        const j = await r.json();
        if (Array.isArray(j.keys) && j.keys.length) jwks = { ts: now, keys: j.keys };
      }
    } catch { /* a failed fetch is never cached */ }
  }
  return jwks.keys || [];
}

async function gatedOk(request, env, rec) {
  if (!env.TEAM) return false;
  if (typeof rec.aud !== "string" || !/^[0-9a-f]{64}$/.test(rec.aud)) return false;
  const jwt = request.headers.get("cf-access-jwt-assertion");
  if (!jwt) return false;
  const p = jwt.split(".");
  if (p.length !== 3) return false;
  const head = b64json(p[0]);
  if (head.alg !== "RS256" || typeof head.kid !== "string" || !head.kid) return false;
  const body = b64json(p[1]);
  if (body.iss !== "https://" + env.TEAM) return false;
  const auds = Array.isArray(body.aud) ? body.aud : [body.aud];
  if (!auds.includes(rec.aud)) return false;
  if (typeof body.exp !== "number" || body.exp * 1000 <= Date.now()) return false;
  const jwk = (await certs(env, head.kid)).find((k) => k.kid === head.kid && k.kty === "RSA");
  if (!jwk) return false;
  const key = await crypto.subtle.importKey("jwk",
    { kty: "RSA", n: jwk.n, e: jwk.e, ext: jwk.ext },
    { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" }, false, ["verify"]);
  return crypto.subtle.verify({ name: "RSASSA-PKCS1-v1_5" }, key, b64u(p[2]),
    new TextEncoder().encode(p[0] + "." + p[1]));
}

const isGated = (rec) =>
  (typeof rec.aud === "string" && rec.aud !== "") ||
  (typeof rec.opts === "string" && rec.opts.split(/\s+/).some((o) => o.startsWith("access=")));

const hex = async (s) => {
  const d = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s)));
  return [...d].map((b) => b.toString(16).padStart(2, "0")).join("");
};

async function handle(request, env) {
  const u = new URL(request.url);
  if (u.hostname !== env.HOST) return new Response(null, { status: 404 });
  if (request.method !== "GET" && request.method !== "HEAD") return new Response(null, { status: 405 });
  const raw = request.url.slice(request.url.indexOf(u.hostname) + u.hostname.length).replace(/^:\d+/, "").split(/[?#]/)[0] || "/";
  if (/%2f|%5c|%2e|%0[0-9a-f]|%1[0-9a-f]/i.test(raw) || raw.includes("//")) {
    return new Response(null, { status: 400 });
  }
  if (raw === "/healthz") {
    return new Response("ok", {
      status: 200,
      headers: {
        "X-Share-Worker": (env.VERSION || "") + " " + (env.SHA || ""),
        "X-Share-Gate": env.TEAM ? "1" : "0",
      },
    });
  }
  const segs = u.pathname.split("/");
  const id = segs[1];
  if (!/^[0-9a-f]{6}$/.test(id)) return new Response(null, { status: 404 });
  const mo = await env.BUCKET.get("m/" + id);
  if (mo === null) return new Response(null, { status: 404 });
  let rec;
  try { rec = await mo.json(); } catch { return new Response(null, { status: 404 }); }
  if (!rec || rec.v > RECV || rec.id !== id || typeof rec.prefix !== "string" ||
    !new RegExp("^o/" + id + "\\.[0-9a-f]{8}/$").test(rec.prefix) ||
    (rec.expires > 0 && Date.now() / 1000 > rec.expires)) {
    return new Response(null, { status: 404 });
  }
  if (isGated(rec)) {
    let ok = false;
    try { ok = await gatedOk(request, env, rec); } catch { ok = false; }
    if (!ok) return new Response(null, { status: 404 });
  }
  const rest = segs.slice(2);
  if (rest.length === 0) return new Response(null, { status: 308, headers: { Location: u.origin + "/" + id + "/" } });
  const cond = { range: request.headers, onlyIf: request.headers };
  let rel, redir = false;
  if (raw.endsWith("/")) {
    rel = rest.join("/") + "index.html";
  } else {
    try { rel = rest.map(decodeURIComponent).join("/"); }
    catch { return new Response(null, { status: 400 }); }
    redir = true;
  }
  let obj = await env.BUCKET.get(rec.prefix + rel, cond);
  if (obj === null && raw.endsWith("/")) {
    obj = await env.BUCKET.get(rec.prefix + rest.join("/") + "README.html", cond);
    if (obj !== null) rel = rest.join("/") + "README.html";
  }
  if (obj === null && redir &&
    (await env.BUCKET.head(rec.prefix + rel + "/index.html") !== null ||
      await env.BUCKET.head(rec.prefix + rel + "/README.html") !== null)) {
    return new Response(null, { status: 308, headers: { Location: u.origin + u.pathname + "/" + u.search } });
  }
  if (obj === null) return new Response(null, { status: 404 });
  if (obj.body === null) return new Response(null, { status: 412 });
  const h = new Headers();
  if (obj.writeHttpMetadata) obj.writeHttpMetadata(h);
  const ext = rel.split(".").pop().toLowerCase();
  h.set("Content-Type", TYPES[ext] || "application/octet-stream");
  return new Response(request.method === "HEAD" ? null : obj.body,
    { status: obj.range ? 206 : 200, headers: h });
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const id = (url.pathname.split("/")[1] || "");
    let resp;
    try { resp = await handle(request, env); }
    catch { resp = new Response(null, { status: 404 }); }
    resp.headers.set("Cache-Control", "no-store");
    resp.headers.set("X-Robots-Tag", "noindex, nofollow");
    if (resp.status < 400 && url.pathname !== "/healthz" &&
      env.HITS && env.SALT && /^[0-9a-f]{6}$/.test(id)) {
      const pseudo = (await hex(env.SALT + (request.headers.get("cf-connecting-ip") || ""))).slice(0, 16);
      ctx.waitUntil(Promise.resolve(env.HITS.writeDataPoint({ indexes: [id], blobs: [id, pseudo] })).catch(() => {}));
    }
    return resp;
  },
};
SHARE_WORKER_JS
}


r2_no_local() { # an r2 profile has no local server to run or manage
  [[ $backend != r2 ]] || die "an r2 profile serves from Cloudflare; nothing runs on this machine ('$me rm <id>' unpublishes a link)"
}

r2_token_check() { # every r2 publisher verb, before its first call: a token source resolves; the dry seam checks the source only
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    [[ -n ${SHARE_R2_TOKEN:-} || -n "$(cfg r2_token_cmd || true)" ]] && return 0
    api_token_resolve; [[ -n $api_token ]] && return 0
  else
    r2_creds && return 0
  fi
  cat >&2 <<EOF
share: this r2 profile needs a publisher token for $host_name; none resolved.
  Store one (Workers R2 Storage Bucket Item Write on bucket $(cfg bucket || true) only):  $me api-token
  Or point at one you have:  $me api-token --cmd 'op read "op://<vault>/<item>/credential"'
EOF
  exit 1
}

r2_stage_check() { # r2_stage_check <stage>: the file cap, the per-file size cap, and no control byte in a name, before the first PUT
  local LC_ALL=C f n=0 big max_files="${SHARE_R2_MAX_FILES:-500}" max_bytes="${SHARE_R2_MAX_BYTES:-314572800}"
  while IFS= read -r -d '' f; do
    n=$((n + 1))
    case $f in *[[:cntrl:]]*) die "a file name holds a control character ($(printf '%q' "${f#./}")); rename it; nothing was uploaded" ;; esac
  done < <(cd "$1" && find . -type f -print0)
  [[ $n -le $max_files ]] || die "$n files is over the r2 cap of $max_files per add (SHARE_R2_MAX_FILES); nothing was uploaded"
  big="$(cd "$1" && find . -type f -size +"${max_bytes}"c | head -1)"
  [[ -z $big ]] || die "${big#./} is over the r2 cap of $max_bytes bytes per file (SHARE_R2_MAX_BYTES); nothing was uploaded"
}

r2_prefix_matches() { # r2_prefix_matches <stage> <prefix>: the prefix listing equals the stage's file list, name for name
  local want got="" k
  want="$(cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"
  r2_list "$2"
  while IFS= read -r k; do [[ -n $k ]] && got+="${k#"$2"}"$'\n'; done <<<"$r2_list_out"
  [[ "$(printf '%s' "$got" | LC_ALL=C sort)" == "$want" ]]
}

r2_by() { local b; b="$(this_host | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9.-')"; echo "${b:-unknown}"; }   # the record's by=: rows() takes a-z 0-9 . - only

r2_nonce() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }   # 8 hex: one upload's prefix, o/<id>.<nonce>/

r2_release_prefix() { # r2_release_prefix <id> <prefix>: the EXIT trap's r2 part; an upload no record names is deleted, one a record names or an unread one stays
  r2_call GET "m/$1" || return 0
  case $cf_code in
    404) ;;
    200) [[ "$(jq -r '.prefix // empty' <<<"$cf_body" 2>/dev/null || true)" != "$2" ]] || return 0 ;;
    *) echo "share: m/$1 answered HTTP $cf_code; the upload under $2 stays until a $me prune removes it after 24 h" >&2; return 0 ;;
  esac
  ( r2_delete_prefix "$2" ) >/dev/null 2>&1 || echo "share: some objects under $2 remain; a $me prune removes them after 24 h" >&2
  return 0
}

cmd_add_r2() { # cmd_add_r2 <secs> <noindex> <target>: stage, upload to a fresh prefix, then PUT m/<id> with If-None-Match: * is the publish
  local secs=$1 opts="" src name id exp=0 prefix rec url
  src="$(realpath "$3")"; name="$(basename "$src")"
  case $src in *$'\t'*|*$'\n'*) die "paths with tabs or newlines are not supported" ;; esac
  case $name in *[{}\"\\]*) die "names with { } \" or \\ are not supported" ;; esac
  [[ -n $2 ]] && opts="noindex"
  r2_token_check
  mk_root
  id="$(rand_id)"
  [[ $secs -gt 0 ]] && exp=$(($(date +%s) + secs))
  stage_copy "$src" "$opts"
  r2_stage_check "$stage_out"
  prefix="o/$id.$(r2_nonce)/"
  r2_held_id=$id r2_held_prefix=$prefix   # from the first PUT on, the EXIT trap owns this prefix
  r2_put_tree "$stage_out" "$prefix" || die "uploading $name failed (HTTP $cf_code); nothing was published"
  r2_prefix_matches "$stage_out" "$prefix" || die "the objects under $prefix do not match the stage; nothing was published"
  rec="$(mktemp "$root/.r2rec.XXXXXX")"
  jq -nc --arg id "$id" --arg name "$name" --arg src "$src" --arg added "$(date +%F)" --argjson exp "$exp" \
    --arg opts "$opts" --arg prefix "$prefix" --arg by "$(r2_by)" \
    '{v: 1, id: $id, name: $name, src: $src, added: $added, expires: $exp, opts: $opts, prefix: $prefix, by: $by}' >"$rec"
  r2_call PUT "m/$id" "$rec" -H 'If-None-Match: *'
  rm -f "$rec"
  case $cf_code in
    200) ;;
    412) die "another publisher took id $id during the upload; nothing was published; rerun the same $me add" ;;   # the trap sees their prefix and deletes ours
    *) die "publishing m/$id answered HTTP $cf_code${cf_err:+ ($cf_err)}; rerun the same $me add" ;;   # a lost-but-committed PUT: the trap keeps the prefix the record names
  esac
  r2_held_prefix="" r2_held_id=""
  r2_own_put "$id" "$prefix" "$src"
  r2_link_base="$stage_out"; share_url "$id" "$name" "$opts"; r2_link_base=""
  rm -rf "$stage_out"; stage_out=""
  url="$share_url_out"
  echo "$url"
  if [[ ${SHARE_CLIPBOARD:-1} == 1 ]] && command -v pbcopy >/dev/null; then
    printf '%s' "$url" | pbcopy && echo "  (link copied)"
  fi
  warn_private "$src" "$id"
}

r2_md5() { # r2_md5 <file>: an etag-shaped lowercase hex
  if command -v md5sum >/dev/null; then md5sum "$1" | cut -d' ' -f1; else md5 -q "$1"; fi
}

r2_url() { # r2_url <key>: sets r2_url_out; the key through urlenc, only / stays literal
  urlenc "$1"
  printf -v r2_url_out '%s/%s/%s' "${r2_endpoint:-$(cfg r2_endpoint || true)}" "${r2_bucket:-$(cfg bucket || true)}" "$urlenc_out"
}

urldec() { # urldec <str>: sets urldec_out; %XX back to bytes, a malformed tail stays literal
  local LC_ALL=C s="$1" out="" c i n
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    if [[ $c == % && $((i + 2)) -lt $n && ${s:i+1:2} =~ ^[0-9A-Fa-f][0-9A-Fa-f]$ ]]; then
      printf -v c '%b' "\\x${s:i+1:2}"   # one raw byte; UTF-8 sequences arrive as consecutive %XX
      i=$((i + 2))
    fi
    out+="$c"
  done
  urldec_out="$out"
}

r2_list() { # r2_list <prefix>: every key under it into r2_list_out (decoded, newline-joined) and "<key>\t<LastModified>" into r2_list_mods; dies on a bad page
  local prefix=$1 tok="" k m
  r2_list_out="" r2_list_mods=""
  while :; do
    r2_call LIST "$prefix" ${tok:+"$tok"}
    [[ $cf_code == 200 ]] || die "r2 list of '$prefix' failed (HTTP $cf_code${cf_err:+, $cf_err})"
    while IFS=$'\t' read -r k m; do   # the raw key is url-encoded, so it holds no tab
      [[ -n $k ]] || continue
      urldec "$k"
      [[ $urldec_out != *[[:cntrl:]]* ]] || continue   # share never writes such a key; a decoded newline must never become a key of its own
      r2_list_out+="$urldec_out"$'\n'; r2_list_mods+="$urldec_out"$'\t'"$m"$'\n'
    done < <(grep -oE '<Key>[^<]*</Key>|<LastModified>[^<]*</LastModified>' <<<"$cf_body" |
      awk '/^<Key>/ {if (k != "") print k "\t" m; k = substr($0, 6, length($0) - 11); m = ""; next} {m = substr($0, 15, length($0) - 29)} END {if (k != "") print k "\t" m}')
    tok="$(grep -o '<NextContinuationToken>[^<]*' <<<"$cf_body" | sed 's/.*>//' || true)"   # pipefail: an absent token must not kill the run
    [[ $cf_body == *'<IsTruncated>true</IsTruncated>'* && -n $tok ]] || break
  done
}

r2_put_tree() { # r2_put_tree <dir> <prefix>: every file under dir to prefix<relpath>; parallel up to 8 live; a failed transfer is retried alone through r2_call
  local dir=$1 prefix=$2 f rel files=()
  while IFS= read -r f; do files+=("$f"); done < <(cd "$dir" && find . -type f | LC_ALL=C sort)
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    for f in ${files[@]+"${files[@]}"}; do
      rel="${f#./}"
      r2_call PUT "$prefix$rel" "$dir/$rel"
      [[ $cf_code == 2?? ]] || { r2_call PUT "$prefix$rel" "$dir/$rel"; [[ $cf_code == 2?? ]]; } || return 1
    done
    return 0
  fi
  [[ ${#files[@]} -gt 0 ]] || return 0
  local wd kf mapf out code url retries
  wd="$(mktemp -d "${TMPDIR:-/tmp}/share-r2put.XXXXXX")"
  kf="$wd/transfers"; mapf="$wd/map"; : >"$kf"; : >"$mapf"
  r2_creds || { rm -rf "$wd"; return 1; }
  for f in "${files[@]}"; do
    rel="${f#./}"
    r2_url "$prefix$rel"
    printf 'url = "%s"\nupload-file = "%s"\noutput = "/dev/null"\n' "$r2_url_out" "$dir/$rel" >>"$kf"
    printf '%s\t%s\n' "$r2_url_out" "$dir/$rel" >>"$mapf"
  done
  out="$(curl -sS --parallel --parallel-max 8 --max-time 300 -w '%{http_code} %{url_effective}\n' \
    -K "$kf" -K <(printf 'user = "%s:%s"\n' "$r2_key_id" "$r2_secret") \
    --aws-sigv4 'aws:amz:auto:s3' 2>/dev/null)" || true
  retries=""
  while IFS=' ' read -r code url; do
    [[ -n $code && $code != 2?? ]] || continue
    f="$(awk -F'\t' -v u="$url" '$1 == u {print $2; exit}' "$mapf")"
    [[ -n $f ]] || { rm -rf "$wd"; echo "share: a failed r2 transfer did not map back to a file ($url)" >&2; return 1; }
    retries+="$f"$'\n'
  done <<<"$out"
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    rel="${f#"$dir"/}"
    r2_call PUT "$prefix$rel" "$f"
    [[ $cf_code == 2?? ]] || { rm -rf "$wd"; return 1; }
  done <<<"$retries"
  rm -rf "$wd"
}

r2_delete_prefix() { # r2_delete_prefix <prefix>: every key under it deleted; a surviving key fails the call
  local prefix=$1 k fails=0
  r2_list "$prefix"
  while IFS= read -r k; do
    [[ -n $k ]] || continue
    r2_call DELETE "$k"
    [[ $cf_code == 204 || $cf_code == 200 || $cf_code == 404 ]] || fails=1
  done <<<"$r2_list_out"
  [[ $fails == 0 ]] || return 1
  r2_list "$prefix"
  [[ -z $r2_list_out ]]
}

r2_record_row() { # r2_record_row <m/ key> <json>: the index.tsv row for a sound record, nothing for a forged or newer one
  local id=${1#m/}
  jq -r --arg id "$id" '
    def clean: type == "string" and (explode | all(. >= 32 and . != 127));   # a control byte in a field drops the record
    select(.v == 1
      and .id == $id
      and (.name | clean) and (.src | clean) and (.opts | clean)
      and (.added | clean)
      and (.expires | type == "number" and . >= 0 and . < 1e11)   # epoch seconds; 1e300 would break bash arithmetic
      and (.opts | test("(^| )(prefix|by)=") | not)   # the row gains its own prefix= and by=; a record never supplies them
      and (.prefix | type == "string" and test("^o/" + $id + "\\.[0-9a-f]{8}/$"))
      and (.by | type == "string" and test("^[a-z0-9.-]+$"))
      and ((.aud // "") | test("^[0-9a-f]{64}$|^$")))
    | [.id, .name, .src, .added, (.expires | floor | tostring),
       (if .opts == "" then "" else .opts + " " end) + "prefix=" + .prefix + " by=" + .by]
    | @tsv' <<<"$2" 2>/dev/null || true   # a corrupt or forged record is dropped, never fatal
}

r2_fetch_records() { # r2_fetch_records <snap>: parallel-GET every key in r2_list_out, each answer appended to $1 through r2_record_row; a non-200/404 dies
  local snap=$1 wd i=0 k f key code
  wd="$(mktemp -d "${TMPDIR:-/tmp}/share-r2get.XXXXXX")"
  : >"$wd/transfers"; : >"$wd/map"
  while IFS= read -r k; do
    [[ $k == m/* ]] || continue
    i=$((i + 1))
    r2_url "$k"
    printf 'url = "%s"\noutput = "%s"\n' "$r2_url_out" "$wd/$i" >>"$wd/transfers"
    printf '%s\t%s\n' "$wd/$i" "$k" >>"$wd/map"
  done <<<"$r2_list_out"
  [[ $i -gt 0 ]] || { rm -rf "$wd"; return 0; }
  r2_creds || { rm -rf "$wd"; return 1; }
  curl -sS --parallel --parallel-max 8 --max-time 60 -w '%{http_code} %{filename_effective}\n' \
    -K "$wd/transfers" -K <(printf 'user = "%s:%s"\n' "$r2_key_id" "$r2_secret") \
    --aws-sigv4 'aws:amz:auto:s3' >"$wd/codes" 2>/dev/null || true
  # walk the map, not curl's output: a key curl printed no line for counts as failed, never as absent
  while IFS=$'\t' read -r f key; do
    code="$(awk -v f="$f" 'substr($0, index($0, " ") + 1) == f {print $1; exit}' "$wd/codes")"
    if [[ $code != 200 && $code != 404 ]]; then   # a failed or missing transfer is retried alone through r2_call
      r2_call GET "$key"
      code=$cf_code
      [[ $code == 200 ]] && printf '%s' "$cf_body" >"$f"
    fi
    case $code in
      200) r2_record_row "$key" "$(cat "$f")" >>"$snap"; r2_record_raw "$key" "$(cat "$f")" ;;
      404) ;;
      *) rm -rf "$wd"; die "r2 snapshot: GET $key answered HTTP $code" ;;
    esac
  done <"$wd/map"
  rm -rf "$wd"
}

r2_snapshot() { # r2_snapshot: every m/ record into a mktemp file that $index then names, so rows() stays the only reader
  local snap k
  mkdir -p "$root"
  snap="$(mktemp "$root/.r2-index.XXXXXX")"
  r2_snap_file="$snap"; trap release_locks EXIT
  r2_refs="" r2_sweep_block=""
  r2_list "m/"
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    while IFS= read -r k; do
      [[ $k == m/* ]] || continue
      r2_call GET "$k"
      case $cf_code in
        200) r2_record_row "$k" "$cf_body" >>"$snap"; r2_record_raw "$k" "$cf_body" ;;
        404) ;;
        *) die "r2 snapshot: GET $k answered HTTP $cf_code" ;;
      esac
    done <<<"$r2_list_out"
  else
    r2_fetch_records "$snap" || die "r2 snapshot: a record fetch failed; nothing was listed"
  fi
  index="$snap"
}

r2_record_raw() { # r2_record_raw <m/ key> <json>: the orphan sweep's own view; the prefix into r2_refs, or the first key this CLI cannot read into r2_sweep_block
  local p
  p="$(jq -r --argjson v "$WORKER_RECORD_V" 'if type == "object" and (.prefix | type == "string") and (.v | type == "number") and .v <= $v then .prefix else error("unreadable") end' <<<"$2" 2>/dev/null)" ||
    { r2_sweep_block="${r2_sweep_block:-$1}"; return 0; }
  r2_refs+="$p"$'\n'
}

r2_ago() { date -u -r "$1" +%Y-%m-%dT%H:%M:%S 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%S; }   # epoch -> the ISO form S3's LastModified starts with

r2_sweep_orphans() { # bare prune: every o/<id>.<nonce>/ no record names, whose newest object is over 24 h old, is deleted; one unreadable record skips it all
  if [[ -n ${r2_sweep_block:-} ]]; then
    echo "share: orphan sweep skipped: $r2_sweep_block is unreadable or newer than this share; no upload was deleted" >&2
    return 0
  fi
  local cutoff p
  cutoff="$(r2_ago $(($(date +%s) - 86400)))"   # the local clock; 24 h absorbs any sane skew against R2's LastModified
  r2_list "o/"
  # no {n} intervals: mawk lacks them. An object with no LastModified counts as fresh, so its prefix stays
  for p in $(printf '%s' "$r2_list_mods" | R2_REFS="$r2_refs" awk -F'\t' -v cut="$cutoff" '
    BEGIN { n = split(ENVIRON["R2_REFS"], r, "\n"); for (i = 1; i <= n; i++) if (r[i] != "") ref[r[i]] = 1 }   # -v cannot carry a newline in every awk
    length($1) > 18 && substr($1, 1, 2) == "o/" && substr($1, 3, 6) !~ /[^0-9a-f]/ && substr($1, 9, 1) == "." &&
      substr($1, 10, 8) !~ /[^0-9a-f]/ && substr($1, 18, 1) == "/" {
      k = substr($1, 1, 18)
      if (k in ref) next
      seen[k] = 1
      if ($2 == "" || substr($2, 1, 19) >= cut) fresh[k] = 1
    }
    END { for (k in seen) if (!(k in fresh)) print k }'); do
    if (r2_delete_prefix "$p") >/dev/null 2>&1; then echo "removed orphan upload $p"
    else echo "share: could not delete every object under $p; the next $me prune retries" >&2; fi
  done
}

r2_prune() { # r2_prune [quiet|listing]: the snapshot; unless quiet, every expired ungated row through rm; a bare prune then sweeps orphan uploads
  r2_snapshot
  [[ ${1:-} != quiet ]] || return 0
  local now id opts
  now="$(date +%s)"
  while IFS=$'\t' read -r id opts; do
    [[ -n $id ]] || continue
    if [[ -n "$(opt_val access "$opts" || true)" ]]; then   # the Worker already answers 404; the app needs an Access-capable token
      echo "share: expired gated share $id waits for a publisher with the Access token" >&2
      continue
    fi
    cmd_rm "$id" prune | sed 's/$/ (expired)/' || true   # a listing never dies on one row
  done < <(rows | awk -F'\t' -v now="$now" '$5 > 0 && $5 < now {print $1 "\t" $6}')
  [[ -n ${1:-} ]] || r2_sweep_orphans
}

cmd_rm_r2() { # cmd_rm_r2 <id> [prune]: the record, a fresh read proving it gone, then every nonce's objects; any publisher may rm any ungated share
  local r opts tmp
  [[ -n ${r2_snap_file:-} ]] || r2_snapshot
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  [[ -z "$(opt_val access "$opts" || true)" ]] || die "$1 is gated; removing a gated r2 share is not built yet, and its link already needs the Access login"
  local dcode
  r2_call DELETE "m/$1"; dcode=$cf_code   # any answer, 000 included: the fresh read below decides
  r2_call GET "m/$1"   # a lost DELETE must not look done
  [[ $cf_code == 404 ]] || die "m/$1 still answers HTTP $cf_code after its delete (HTTP $dcode); its objects were kept; rerun $me rm $1"
  tmp="$(mktemp "$root/.r2-index.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$index" >"$tmp" && mv -f "$tmp" "$index"   # this process's listing drops the row too
  r2_own_drop "$1"
  (r2_delete_prefix "o/$1.") || echo "share: some objects under o/$1. remain; nothing serves them, and a $me prune removes them after 24 h" >&2
  echo "unpublished $1"
}

cmd_refresh_r2() { # cmd_refresh_r2 <id>: this install's own share only; a new prefix, the record swap under If-Match, then the old prefix goes
  local body etag own oprefix src opts new rec
  [[ ${1:-} =~ ^[0-9a-f]{6}$ ]] || die "no share with id '${1:-}'"
  r2_token_check
  mk_root
  r2_call GET "m/$1"
  case $cf_code in
    200) ;;
    404) die "no share with id '$1'" ;;
    *) die "reading m/$1 answered HTTP $cf_code; nothing was changed" ;;
  esac
  body=$cf_body etag=$r2_etag
  [[ -n "$(r2_record_row "m/$1" "$body")" && -n $etag ]] || die "no share with id '$1'"
  oprefix="$(jq -r '.prefix' <<<"$body")"
  own="$(r2_own_get "$1" || true)"
  [[ -n $own && "$(cut -f2 <<<"$own")" == "$oprefix" ]] || die "$1 was added from another install; refresh it there"
  src="$(cut -f3 <<<"$own")"   # never the record's src: another publisher could forge it
  [[ -e $src ]] || die "source is gone: $src (the snapshot keeps serving; $me rm $1 to unpublish)"
  opts="$(jq -r '.opts' <<<"$body")"
  stage_copy "$src" "$opts"
  r2_stage_check "$stage_out"
  new="o/$1.$(r2_nonce)/"
  r2_held_id=$1 r2_held_prefix=$new
  r2_put_tree "$stage_out" "$new" || die "uploading $src failed (HTTP $cf_code); $1 still serves its old copy"
  r2_prefix_matches "$stage_out" "$new" || die "the objects under $new do not match the stage; $1 still serves its old copy"
  rec="$(mktemp "$root/.r2rec.XXXXXX")"
  jq -c --arg p "$new" --arg src "$src" '.prefix = $p | .src = $src' <<<"$body" >"$rec"
  r2_call PUT "m/$1" "$rec" -H "If-Match: \"$etag\""
  rm -f "$rec"
  case $cf_code in
    200) ;;
    412|404) die "$1 changed during the refresh (a concurrent rm or refresh won); nothing was published" ;;   # the trap deletes the new prefix no record names
    *) die "swapping m/$1 answered HTTP $cf_code${cf_err:+ ($cf_err)}; rerun $me refresh $1" ;;
  esac
  r2_held_prefix="" r2_held_id=""
  r2_own_put "$1" "$new" "$src"
  rm -rf "$stage_out"; stage_out=""
  (r2_delete_prefix "$oprefix") || echo "share: some objects under $oprefix remain; nothing serves them, and a $me prune removes them after 24 h" >&2
  echo "refreshed $1 from $src"
}

r2_own_get() { # r2_own_get <id>: the "<id>\t<prefix>\t<source>" line for one of this install's own adds
  # no {n} intervals: mawk lacks them
  [[ -f $r2own ]] && awk -F'\t' -v id="$1" 'NF == 3 && $1 == id && substr($2, 3, 6) == id && $2 ~ /^o\/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\/$/' "$r2own"
}

r2_own_put() { # r2_own_put <id> <prefix> <src>: remember the share this install added, replacing any older line
  mkdir -p "$root"
  local tmp
  tmp="$(mktemp "$root/.r2own.XXXXXX")"
  { [[ -f $r2own ]] && awk -F'\t' -v id="$1" '$1 != id' "$r2own"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } >"$tmp"
  mv -f "$tmp" "$r2own"
}

r2_own_drop() { # r2_own_drop <id>: forget the line, missing counts as dropped
  [[ -f $r2own ]] || return 0
  local tmp
  tmp="$(mktemp "$root/.r2own.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$r2own" >"$tmp" && mv -f "$tmp" "$r2own"
}

r2_creds() { # r2_creds: the publisher pair into r2_key_id/r2_secret; the token never reaches argv, a file, or output
  [[ -n ${r2_key_id:-} && -n ${r2_secret:-} ]] && return 0   # setup presets them; one resolve per process
  r2_key_id="${SHARE_R2_KEY_ID:-$(cfg r2_key_id || true)}"
  local tok="${SHARE_R2_TOKEN:-}" c out
  [[ -z $tok ]] && { c="$(cfg r2_token_cmd || true)"; [[ -n $c ]] && tok="$(eval "$c" 2>/dev/null)"; }
  if [[ -z $tok ]]; then api_token_resolve; tok="$api_token"; fi
  [[ -n $tok ]] || return 1
  if [[ -z $r2_key_id ]]; then   # the S3 access key is the token's own id
    out="$(curl -sS --max-time 30 "$api/user/tokens/verify" -H @<(printf 'Authorization: Bearer %s\n' "$tok") 2>/dev/null || true)"
    r2_key_id="$(jq -r '.result.id // empty' <<<"$out" 2>/dev/null)"
    [[ -n $r2_key_id ]] || return 1
  fi
  r2_secret="$(printf '%s' "$tok" | shasum -a 256 | cut -d' ' -f1)"
}

r2_call() { # r2_call METHOD KEY [ARG] [curl args...]: one S3 call on cf_try's globals; LIST takes <prefix> [continuation]; 429 and 5xx retried, Retry-After capped at 30s
  cf_body="" cf_code=000 cf_err="" r2_etag=""
  [[ $backend == r2 ]] || { cf_err=backend; return 1; }
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    if [[ $tunnel != 0 || $host_name != *.test ]]; then
      echo "share: SHARE_R2_DRY=1 is a test seam for SHARE_TUNNEL=0 and a .test hostname only; the r2 call was refused; unset it" >&2
      return 1
    fi
    r2_dry "$@"; return $?
  fi
  local meth=$1 key=$2 arg3=${3:-} url hdrs i ra xmeth=$1
  r2_creds || { echo "share: no r2 publisher token for $host_name (needs r2_key_id and a token source in the profile config)" >&2; return 1; }
  hdrs="$(mktemp "${TMPDIR:-/tmp}/share-r2h.XXXXXX")"
  local args=()
  case $meth in
    LIST) urlenc "$key"; url="${r2_endpoint:-$(cfg r2_endpoint)}/${r2_bucket:-$(cfg bucket)}?list-type=2&prefix=$urlenc_out&encoding-type=url&max-keys=1000"; xmeth=GET
      [[ -n $arg3 ]] && { urlenc "$arg3"; url+="&continuation-token=$urlenc_out"; } ;;
    *) r2_url "$key"; url=$r2_url_out; [[ -n $arg3 ]] && args+=(--upload-file "$arg3") ;;
  esac
  for i in 1 2 3; do
    cf_body="$(curl -sS --max-time 60 -D "$hdrs" -w '\n%{http_code}' -X "$xmeth" "$url" \
      --aws-sigv4 'aws:amz:auto:s3' -K <(printf 'user = "%s:%s"\n' "$r2_key_id" "$r2_secret") \
      "${args[@]+"${args[@]}"}" "${@:4}" 2>/dev/null)" || true
    cf_code="${cf_body##*$'\n'}"; cf_body="${cf_body%$'\n'*}"
    [[ $cf_code == 429 || $cf_code == 5?? ]] || break
    [[ $i -lt 3 ]] || break
    ra="$(awk 'tolower($1)=="retry-after:"{gsub(/\r/,"",$2); print $2; exit}' "$hdrs")"
    [[ $ra =~ ^[0-9]+$ ]] || ra=0; (( ra > 30 )) && ra=30
    sleep "$ra"
  done
  r2_etag="$(sed -n 's/^[Ee][Tt][Aa][Gg]: //p' "$hdrs" | tr -d '"\r' | head -1)"
  rm -f "$hdrs"
  cf_err="$(sed -n 's:.*<Code>\([^<]*\)</Code>.*:\1:p' <<<"$cf_body" | head -1)"
}

r2_dry() { # r2_dry METHOD KEY [ARG]: a directory-backed bucket for tests; one "METHOD key" line per call; etags and conditional headers honored
  local meth=$1 key=$2 arg3=${3:-} d="${SHARE_R2_DRY_DIR:-$root/r2-dry}" f h k rest
  mkdir -p "$d" "$root"
  if [[ ${SHARE_R2_DRY_PAUSE:-} == "$meth $key" ]]; then
    local w=0
    while [[ ! -f $d/.resume && $w -lt 600 ]]; do sleep 0.05; w=$((w + 1)); done
  fi
  printf '%s %s\n' "$meth" "$key" >>"$root/r2-calls.log"
  cf_body="" cf_code=200 cf_err="" r2_etag=""
  f="$d/$key"
  case $meth in
    PUT)
      for h in "${@:4}"; do
        case "$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')" in
          -h) ;;
          if-none-match:\ \*) [[ -e $f ]] && { cf_code=412 cf_err=PreconditionFailed; return 0; } ;;
          if-match:*) [[ -e $f && $h == *"$(r2_md5 "$f")"* ]] || { cf_code=412 cf_err=PreconditionFailed; return 0; } ;;
        esac
      done
      if [[ ${SHARE_R2_DRY_PUT:-} == 500-once && ! -f $d/.fx/p500.done ]]; then
        mkdir -p "$d/.fx"; : >"$d/.fx/p500.done"; cf_code=500 cf_err=InternalError; return 0
      fi
      mkdir -p "${f%/*}"
      [[ -n $arg3 && -f $arg3 ]] && cp "$arg3" "$f" || : >"$f"
      [[ ${SHARE_R2_DRY_PUT:-} == lost ]] && { cf_code=000; return 0; }
      r2_etag="$(r2_md5 "$f")" ;;
    GET) [[ -e $f ]] || { cf_code=404 cf_err=NoSuchKey; return 0; }
      cf_body="$(cat "$f")"; r2_etag="$(r2_md5 "$f")" ;;
    HEAD) [[ -e $f ]] || { cf_code=404 cf_err=NoSuchKey; return 0; }
      r2_etag="$(r2_md5 "$f")" ;;
    DELETE) [[ ${SHARE_R2_DRY_DELETE:-} == lost ]] && { cf_code=000; return 0; }
      rm -f "$f"; cf_code=204 ;;
    LIST)
      [[ ${SHARE_R2_DRY_LIST:-} == 500 ]] && { cf_code=500 cf_err=InternalError; return 0; }
      local all="" count=0 last="" want=""
      [[ -n $arg3 ]] && { urldec "$arg3"; want="$urldec_out"; }   # the continuation token arrives url-encoded, as S3 serves it
      while IFS= read -r k; do
        [[ $k == "$key"* ]] && [[ -z $want || $k > $want ]] && all+="$k"$'\n'
      done < <(cd "$d" && find . -type f ! -name '.*' ! -path './.*' ! -name 'r2-calls.log' | sed 's|^\./||' | LC_ALL=C sort)
      cf_body='<?xml version="1.0" encoding="UTF-8"?><ListBucketResult><Name>dry</Name><Prefix>'"$key"'</Prefix><MaxKeys>1000</MaxKeys><EncodingType>url</EncodingType>'
      while IFS= read -r k; do
        [[ -n $k ]] || continue
        if [[ $count -ge 1000 ]]; then urlenc "$last"; cf_body+='<IsTruncated>true</IsTruncated><NextContinuationToken>'"$urlenc_out"'</NextContinuationToken>'; break; fi
        urlenc "$k"; cf_body+='<Contents><Key>'"$urlenc_out"'</Key><LastModified>'"$(date -u -r "$d/$k" +%Y-%m-%dT%H:%M:%S.000Z)"'</LastModified><ETag>"'"$(r2_md5 "$d/$k")"'"</ETag><Size>'"$(wc -c <"$d/$k" | tr -d ' ')"'</Size></Contents>'
        last="$k"; count=$((count + 1))
      done <<<"$all"
      [[ $count -lt 1000 ]] && cf_body+='<IsTruncated>false</IsTruncated>'
      cf_body+="<KeyCount>$count</KeyCount></ListBucketResult>" ;;
    *) cf_code=400 cf_err=NotImplemented ;;
  esac
}

r2_api() { # r2_api METHOD PATH [JSON]: cf_try, or the dry account under SHARE_R2_DRY; call directly, never in $( )
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    cf_body="" cf_code=000 cf_err=""
    if [[ $tunnel != 0 || $host_name != *.test ]]; then
      echo "share: SHARE_R2_DRY=1 is a test seam for SHARE_TUNNEL=0 and a .test hostname only; the Cloudflare call was refused; unset it" >&2
      return 0
    fi
    r2_api_dry "$@"; return 0
  fi
  cf_try "$@"
}

r2_api_dry() { # the account API under SHARE_R2_DRY: state files in $SHARE_R2_DRY_DIR/.cf, one "API METHOD path" line per call
  local d="${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf" p=$2 n deny='{"success":false,"errors":[{"code":10000}]}'
  mkdir -p "$d" "$root"
  printf 'API %s %s\n' "$1" "$p" >>"$root/r2-calls.log"
  cf_code=200 cf_err="" cf_body='{"success":true,"result":[]}'
  case "$1 $p" in
    "GET /user/tokens/verify") cf_body='{"success":true,"result":{"id":"dry-token-id","status":"active"}}' ;;
    "GET /zones?name="*)
      n="${p#*name=}"; n="${n%%&*}"
      [[ $n == "${host_name#*.}" ]] && cf_body="{\"success\":true,\"result\":[{\"id\":\"zone-dry\",\"name\":\"$n\",\"account\":{\"id\":\"acct-dry\"}}]}" ;;
    "GET "*/workers/scripts/*/settings)
      if [[ ${SHARE_R2_DRY_ROLE:-} == deny ]]; then cf_code=403 cf_body=$deny
      elif [[ -f $d/script.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/script.json")}"
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":10007}]}'; fi ;;
    "PUT "*/workers/scripts/*) cf_body='{"success":true,"result":{}}' ;;   # r2_deploy writes script.json itself
    "POST "*/subdomain) [[ ${SHARE_R2_DRY_SUBDOMAIN:-} == stuck ]] || printf '%s' "$3" >"$d/subdomain.json"; cf_body='{"success":true,"result":{}}' ;;
    "GET "*/subdomain) cf_body="{\"success\":true,\"result\":$(cat "$d/subdomain.json" 2>/dev/null || echo '{"enabled":true,"previews_enabled":true}')}" ;;
    "GET "*/domains/managed)
      if [[ ${SHARE_R2_DRY_BUCKETDOM:-} == deny ]]; then cf_code=403 cf_body=$deny
      else cf_body="{\"success\":true,\"result\":{\"enabled\":$([[ -f $d/r2dev ]] && echo true || echo false)}}"; fi ;;
    "GET "*/domains/custom)
      if [[ ${SHARE_R2_DRY_BUCKETDOM:-} == deny ]]; then cf_code=403 cf_body=$deny
      elif [[ -f $d/bucket-domain ]]; then cf_body='{"success":true,"result":{"domains":[{"domain":"cdn.example.test"}]}}'
      else cf_body='{"success":true,"result":{"domains":[]}}'; fi ;;
    "GET "*/r2/buckets/*)
      if [[ ${SHARE_R2_DRY_BUCKETDOM:-} == deny ]]; then cf_code=403 cf_body=$deny   # a bucket-scoped token reads no bucket settings
      elif [[ ! -f $d/bucket ]]; then cf_code=404 cf_body='{"success":false,"errors":[{"code":10006}]}'; fi ;;
    "POST "*/r2/buckets) : >"$d/bucket"; cf_body='{"success":true,"result":{}}' ;;
    "GET /zones/"*/dns_records*) [[ -f $d/dns ]] && cf_body="{\"success\":true,\"result\":$(cat "$d/dns")}" ;;
    "GET "*/workers/domains*)
      if [[ ${SHARE_R2_DRY_DOMAINS:-} == 500 ]]; then cf_code=500 cf_body='{"success":false,"errors":[{"code":10013}]}'
      elif [[ -f $d/domain.json ]]; then cf_body="{\"success\":true,\"result\":[$(cat "$d/domain.json")]}"; fi ;;
    "PUT "*/workers/domains) jq -c '{hostname, service}' <<<"$3" >"$d/domain.json"; cf_body='{"success":true,"result":{}}' ;;
    "GET "*/access/organizations)
      if [[ -f $d/team ]]; then cf_body="{\"success\":true,\"result\":{\"auth_domain\":\"$(cat "$d/team")\"}}"
      else cf_code=403 cf_body=$deny; fi ;;
    *) cf_code=400 cf_body='{"success":false,"errors":[{"code":7003}]}' ;;
  esac
  cf_err="$(jq -r '.errors[0].code // empty' <<<"$cf_body" 2>/dev/null || true)"
}

r2_healthz() { # r2_healthz: hz_code (200 only for a "200 ok" body) and hz_pair (the X-Share-Worker header) from https://<host>/healthz
  hz_code=000 hz_pair=""
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    local d="${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf"
    printf 'HEALTHZ\n' >>"$root/r2-calls.log"
    [[ ${SHARE_R2_DRY_HEALTHZ:-} != down && -f $d/domain.json && -f $d/script.json ]] || return 0
    hz_code=200
    hz_pair="$(jq -r '[(.bindings[] | select(.name == "VERSION") | .text), (.bindings[] | select(.name == "SHA") | .text)] | join(" ")' "$d/script.json")"
    return 0
  fi
  local h b
  h="$(mktemp "${TMPDIR:-/tmp}/share-hz.XXXXXX")"
  b="$(curl -sS --max-time 5 -D "$h" "https://$host_name/healthz" 2>/dev/null)" || true
  hz_code="$(awk 'NR == 1 {print $2}' "$h")"; hz_code="${hz_code:-000}"
  [[ $hz_code != 200 || $b == ok ]] || hz_code=000
  hz_pair="$(awk 'tolower($1) == "x-share-worker:" {sub(/\r$/, ""); print $2 " " $3; exit}' "$h")"
  rm -f "$h"
}

r2_wait_healthz() { # r2_wait_healthz admin|join: three 200s in a row within SHARE_R2_WAIT; admin also needs this CLI's pair; a new name waits for its certificate
  local wait="${SHARE_R2_WAIT:-300}" start=$SECONDS streak=0 poll=2
  [[ ${SHARE_R2_DRY:-0} == 1 ]] && poll=0
  while :; do
    r2_healthz
    if [[ $hz_code == 200 && ( $1 == join || $hz_pair == "$WORKER_VERSION $WORKER_SHA" ) ]]; then
      streak=$((streak + 1)); [[ $streak -ge 3 ]] && return 0
    else
      streak=0
    fi
    [[ $((SECONDS - start)) -lt $wait ]] ||
      die "https://$host_name/healthz did not answer 200 ok three times in a row within ${wait}s (last: $hz_code ${hz_pair:-no pair}); the config was not written; rerun setup once the certificate is issued"
    sleep "$poll"
  done
}

r2_deploy_meta() { # r2_deploy_meta <team> <dataset> [salt]: the multipart metadata; printf only, so the salt never reaches an argv
  local salt=""
  [[ -n ${3:-} ]] && salt=',{"type":"secret_text","name":"SALT","text":"'"$3"'"}'
  printf '{"main_module":"share.js","compatibility_date":"%s","bindings":[{"type":"r2_bucket","name":"BUCKET","bucket_name":"%s"},{"type":"analytics_engine","name":"HITS","dataset":"%s"},{"type":"plain_text","name":"HOST","text":"%s"},{"type":"plain_text","name":"TEAM","text":"%s"},{"type":"plain_text","name":"VERSION","text":"%s"},{"type":"plain_text","name":"SHA","text":"%s"}%s],"keep_bindings":["secret_text"]}\n' \
    "$WORKER_COMPAT_DATE" "$r2_bucket" "$2" "$host_name" "$1" "$WORKER_VERSION" "$WORKER_SHA" "$salt"
}

r2_deploy() { # r2_deploy <worker> <team> <dataset> <first>: one multipart PUT; the first deploy adds the SALT secret, later ones keep it
  local worker=$1 team=$2 dataset=$3 salt="" out
  [[ $4 == 1 ]] && salt="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    r2_api PUT "/accounts/$acct/workers/scripts/$worker"
    # the settings a real GET answers: every binding, the secret without its value
    r2_deploy_meta "$team" "$dataset" "$salt" | jq -c '{bindings: ([.bindings[] | select(.type != "secret_text")] + [{type: "secret_text", name: "SALT"}])}' \
      >"${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf/script.json"
    return 0
  fi
  worker_js "$root/worker.js"
  out="$(curl -sS --max-time 120 -w '\n%{http_code}' -X PUT "$api/accounts/$acct/workers/scripts/$worker" \
    -H @<(printf 'Authorization: Bearer %s\n' "$api_token") \
    -F 'metadata=<-;type=application/json' -F "share.js=@$root/worker.js;type=application/javascript+module" \
    < <(r2_deploy_meta "$team" "$dataset" "$salt") 2>/dev/null)" || true
  rm -f "$root/worker.js"
  cf_code="${out##*$'\n'}"
  [[ $cf_code == 200 ]] || die "deploying Worker $worker answered HTTP $cf_code; the bucket and marker stay, rerun setup"
}

r2_no_token() { # the admin/publisher token block; callers send it to stderr
  cat <<EOF
share: setup --backend r2 reads its token from CLOUDFLARE_API_TOKEN only; none is set.
  Admin (creates the bucket, deploys the Worker, once per hostname): an account API token with
     Workers Scripts: Edit and Workers R2 Storage: Edit (account), Zone: Read and DNS: Read (zone),
     Access: Organizations Read (optional, for gated links)
  Publisher (joins a hostname an admin set up): Workers R2 Storage Bucket Item Write on bucket $1 only, and Zone: Read
  Then: CLOUDFLARE_API_TOKEN=<token> $me setup $host_name --backend r2 --bucket $1
EOF
}

r2_setup_zone() { # r2_setup_zone: zone_name, zone_id, acct for the zone owning $host_name, walking up its labels
  local cand="$host_name"
  while [[ $cand == *.* ]]; do
    r2_api GET "/zones?name=$cand&status=active"
    [[ $cf_code == 200 ]] || die "reading zones answered HTTP $cf_code (the token needs Zone: Read); nothing was changed"
    if [[ "$(jq '.result | length' <<<"$cf_body")" == 1 ]]; then
      zone_id="$(jq -r '.result[0].id' <<<"$cf_body")"; acct="$(jq -r '.result[0].account.id' <<<"$cf_body")"; zone_name="$cand"
      return 0
    fi
    [[ $cand == *.*.* ]] || break
    cand="${cand#*.}"
  done
  die "no active Cloudflare zone for $host_name in this token's accounts; nothing was changed"
}

write_config_r2() { # write_config_r2 <bucket>: the r2 profile config; keeps api_token_cmd and r2_token_cmd; never a tunnel key
  local keep_api keep_r2; keep_api="$(cfg api_token_cmd || true)"; keep_r2="$(cfg r2_token_cmd || true)"
  mkdir -p "$config_dir"
  {
    echo "backend=r2"
    echo "hostname=$host_name"
    echo "zone=$zone_name"
    echo "bucket=$1"
    echo "port=r2"
    echo "r2_endpoint=$r2_endpoint"
    [[ -n $keep_api ]] && echo "api_token_cmd=$keep_api"
    [[ -n $keep_r2 ]] && echo "r2_token_cmd=$keep_r2"
  } >"$config.tmp"
  mv -f "$config.tmp" "$config"
}

cmd_setup_r2() { # cmd_setup_r2 <force> <bucket> <tname> <login> <service> <quick>: every refusal before the first write
  local force=$1 bucket=$2 tname=$3 login=$4 service=$5 quick=$6
  local rusage="usage: share setup <hostname> --backend r2 --bucket <name> [--force]"
  [[ $quick == 0 && -z $tname && $login == 0 && $service == 1 && -n $bucket ]] || die "$rusage"
  [[ $bucket =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || die "bad bucket name '$bucket' (3-63 chars of a-z 0-9 -; no leading or trailing -)"
  [[ -n $host_name ]] || die "$rusage"
  [[ $host_name =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || die "bad hostname '$host_name' ($rusage)"
  [[ -z $(cfg tunnel_id || true) && $(cfg mode || true) != quick ]] || die "already set up with a tunnel; run '$me teardown' first"
  local o
  for o in $(other_cfg hostname); do
    [[ $o != "$host_name" ]] || die "$host_name is already the hostname of another profile (share profiles)"
  done
  local worker="share-${host_name//./-}" dataset="share_${host_name//[.-]/_}" c missing=""
  [[ $dataset =~ ^[a-z0-9_]+$ ]] || die "bad hostname '$host_name' for a dataset name"
  for c in jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  backend=r2 r2_bucket=$bucket

  # steps 1 to 7 only read; every refusal happens here, before the first write
  api_token="${CLOUDFLARE_API_TOKEN:-}"
  [[ -n $api_token ]] || { r2_no_token "$bucket" >&2; exit 1; }
  r2_setup_zone
  r2_endpoint="https://$acct.r2.cloudflarestorage.com"
  r2_api GET /user/tokens/verify   # the S3 access key is the token's own id; the secret its sha256, from stdin
  r2_key_id="$(jq -r '.result.id // empty' <<<"$cf_body" 2>/dev/null || true)"
  [[ $cf_code == 200 && -n $r2_key_id ]] || die "the token did not verify (HTTP $cf_code); nothing was changed"
  r2_secret="$(printf '%s' "$api_token" | shasum -a 256 | cut -d' ' -f1)"

  local role first=0 dep_v=0 dep_sha="" dep_team=""
  r2_api GET "/accounts/$acct/workers/scripts/$worker/settings"
  case $cf_code in
    200) role="admin" ;;
    404) role="admin" first=1 ;;
    401|403) role="join" ;;
    *) die "reading Worker $worker answered HTTP $cf_code; nothing was changed" ;;
  esac
  [[ $role == admin ]] && echo "deploying as admin" || echo "joining as publisher"
  if [[ $role == admin && $first == 0 ]]; then
    jq -e --arg h "$host_name" --arg b "$bucket" '.result.bindings as $bs
      | ($bs | any(.name == "HOST" and .text == $h)) and ($bs | any(.name == "BUCKET" and .bucket_name == $b))
        and ($bs | any(.name == "VERSION" and (.text | test("^[0-9]+$"))))' <<<"$cf_body" >/dev/null ||
      die "Worker $worker exists but is not share's Worker for $host_name on bucket $bucket (its bindings differ); refused, nothing was changed"
    dep_v="$(jq -r '.result.bindings[] | select(.name == "VERSION") | .text' <<<"$cf_body")"
    dep_sha="$(jq -r '[.result.bindings[] | select(.name == "SHA") | .text] | first // ""' <<<"$cf_body")"
    dep_team="$(jq -r '[.result.bindings[] | select(.name == "TEAM") | .text] | first // ""' <<<"$cf_body")"
    [[ $dep_v -le $WORKER_VERSION || $force == 1 ]] ||
      die "Worker $worker runs version $dep_v, newer than this share's $WORKER_VERSION; upgrade share, or pass --force to downgrade it; nothing was changed"
  fi

  local bucket_new=0 marker="" skipped=0
  r2_api GET "/accounts/$acct/r2/buckets/$bucket"
  case "$role $cf_code" in
    "admin 404") bucket_new=1 ;;
    "join 404") die "bucket $bucket does not exist; whoever holds the admin token runs '$me setup $host_name --backend r2 --bucket $bucket' first" ;;
    "admin 200"|"join 200"|"join 403")   # a bucket-scoped token cannot read bucket settings; the S3 reads below prove the bucket
      r2_api GET "/accounts/$acct/r2/buckets/$bucket/domains/managed"
      if [[ $role == join && $cf_code == 403 ]]; then skipped=1
      else
        [[ $cf_code == 200 ]] || die "reading bucket $bucket's r2.dev setting answered HTTP $cf_code; nothing was changed"
        [[ "$(jq -r '.result.enabled' <<<"$cf_body")" == false ]] || die "bucket $bucket has its public r2.dev URL on; a share bucket must be private; refused, nothing was changed"
      fi
      r2_api GET "/accounts/$acct/r2/buckets/$bucket/domains/custom"
      if [[ $role == join && $cf_code == 403 ]]; then skipped=1
      else
        [[ $cf_code == 200 ]] || die "reading bucket $bucket's custom domains answered HTTP $cf_code; nothing was changed"
        [[ "$(jq '.result.domains | length' <<<"$cf_body")" == 0 ]] || die "bucket $bucket has a public custom domain; a share bucket must be private; refused, nothing was changed"
      fi
      [[ $skipped == 1 ]] && echo "public-route check skipped (publisher token)"
      r2_call LIST ""
      [[ $cf_code == 200 ]] || die "listing bucket $bucket answered HTTP $cf_code; nothing was changed"
      local has_objects=0; [[ $cf_body == *"<Key>"* ]] && has_objects=1
      r2_call GET share.json
      case $cf_code in
        200) marker="$cf_body"
          jq -e --arg h "$host_name" '.v == 1 and .host == $h' <<<"$marker" >/dev/null 2>&1 ||
            die "bucket $bucket's share.json names another hostname; refused, nothing was changed" ;;
        404) [[ $role == admin ]] || die "bucket $bucket has no share.json; whoever holds the admin token runs '$me setup $host_name --backend r2 --bucket $bucket' first"
          [[ $has_objects == 0 ]] || die "bucket $bucket holds objects and no share.json; it is not a share bucket; refused, nothing was changed" ;;
        *) die "reading $bucket/share.json answered HTTP $cf_code; nothing was changed" ;;
      esac ;;
    *) die "reading bucket $bucket answered HTTP $cf_code (the token needs Workers R2 Storage: Edit); nothing was changed" ;;
  esac

  if [[ $role == join ]]; then   # join writes nothing on Cloudflare: the live check, then the local config
    r2_wait_healthz join
    [[ $hz_pair == "$WORKER_VERSION $WORKER_SHA" ]] ||
      echo "the Worker at $host_name runs $hz_pair; this share ships $WORKER_VERSION $WORKER_SHA; whoever holds the admin token reruns '$me setup $host_name --backend r2 --bucket $bucket'"
    write_config_r2 "$bucket"
    echo "ready:      https://$host_name/ serves from bucket $bucket. Store your publisher token: $me api-token; then: $me add <file|dir>"
    return 0
  fi

  r2_api GET "/zones/$zone_id/dns_records?name=$host_name"
  [[ $cf_code == 200 ]] || die "reading DNS for $host_name answered HTTP $cf_code (the token needs DNS: Read); nothing was changed"
  local ndns ours theirs
  ndns="$(jq '.result | length' <<<"$cf_body")"
  r2_api GET "/accounts/$acct/workers/domains?hostname=$host_name"
  [[ $cf_code == 200 ]] || die "reading Worker custom domains answered HTTP $cf_code; nothing was changed"
  ours="$(jq --arg h "$host_name" --arg w "$worker" '[.result[] | select(.hostname == $h and .service == $w)] | length' <<<"$cf_body")"
  theirs="$(jq --arg h "$host_name" --arg w "$worker" '[.result[] | select(.hostname == $h and .service != $w)] | length' <<<"$cf_body")"
  [[ $theirs == 0 ]] || die "$host_name is the custom domain of another Worker; refused even with --force, nothing was changed"
  [[ $ndns == 0 || $ours != 0 || $force == 1 ]] || die "$host_name already has a DNS record that is not this Worker's custom domain; refused (--force replaces it), nothing was changed"

  local team=""
  r2_api GET "/accounts/$acct/access/organizations"
  if [[ $cf_code == 200 ]]; then
    team="$(jq -r '.result.auth_domain // empty' <<<"$cf_body")"
    [[ $team =~ ^[a-z0-9-]+\.cloudflareaccess\.com$ ]] || team=""
  else
    team="$dep_team"   # a token without Access: Organizations Read keeps the deployed TEAM rather than blanking every gated link
  fi

  # steps 8 to 11 write
  mkdir -p "$root"
  if [[ $bucket_new == 1 ]]; then
    r2_api POST "/accounts/$acct/r2/buckets" "{\"name\":\"$bucket\"}"
    [[ $cf_code == 200 ]] || die "creating bucket $bucket answered HTTP $cf_code"
  fi
  if [[ -z $marker ]]; then
    local mf; mf="$(mktemp "$root/.marker.XXXXXX")"
    printf '{"v":1,"host":"%s"}\n' "$host_name" >"$mf"
    r2_call PUT share.json "$mf" -H 'If-None-Match: *'
    rm -f "$mf"
    [[ $cf_code == 200 || $cf_code == 412 ]] || die "writing $bucket/share.json answered HTTP $cf_code"
    if [[ $cf_code == 412 ]]; then   # another admin wrote it first: it must name this hostname
      r2_call GET share.json
      jq -e --arg h "$host_name" '.v == 1 and .host == $h' <<<"$cf_body" >/dev/null 2>&1 || die "bucket $bucket's share.json names another hostname"
    fi
  fi
  if [[ $first == 1 || $dep_v != "$WORKER_VERSION" || $dep_sha != "$WORKER_SHA" || $dep_team != "$team" ]]; then
    [[ $first == 0 && $dep_team != "$team" ]] && echo "Access team: '${dep_team:-none}' -> '${team:-none}'"
    r2_deploy "$worker" "$team" "$dataset" "$first"
    echo "worker:     $worker $WORKER_VERSION $WORKER_SHA deployed"
  else
    echo "worker:     $worker $WORKER_VERSION $WORKER_SHA already deployed"
  fi
  r2_api POST "/accounts/$acct/workers/scripts/$worker/subdomain" '{"enabled":false,"previews_enabled":false}'
  [[ $cf_code == 200 ]] || die "turning off $worker's workers.dev route answered HTTP $cf_code; no custom domain exists yet, nothing is exposed"
  r2_api GET "/accounts/$acct/workers/scripts/$worker/subdomain"
  [[ $cf_code == 200 && "$(jq -r '"\(.result.enabled),\(.result.previews_enabled)"' <<<"$cf_body")" == false,false ]] ||
    die "$worker's workers.dev route still reads on; no custom domain exists yet, nothing is exposed; rerun setup"
  if [[ $ours == 0 ]]; then
    r2_api PUT "/accounts/$acct/workers/domains" "{\"hostname\":\"$host_name\",\"service\":\"$worker\",\"zone_id\":\"$zone_id\",\"environment\":\"production\"$([[ $force == 1 ]] && echo ',"override_existing_dns_record":true')}"
    [[ $cf_code == 200 ]] || die "adding $host_name as $worker's custom domain answered HTTP $cf_code"
  fi

  r2_wait_healthz admin

  write_config_r2 "$bucket"
  echo "ready:      https://$host_name/ serves from bucket $bucket. Next: $me add <file|dir>"
}

cmd_setup() {
  local tunnel_name="" force=0 service=1 login=0 quick_setup=0 had_host_arg=0 backend_arg="" bucket=""
  [[ -n ${1:-} && ${1:-} != --* ]] && { host_name="$1"; had_host_arg=1; shift; }
  while [[ $# -gt 0 ]]; do
    case $1 in
      --tunnel-name) tunnel_name="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      --no-service) service=0; shift ;;
      --login) login=1; shift ;;
      --quick) quick_setup=1; shift ;;
      --backend) backend_arg="${2:-}"; shift 2 ;;
      --bucket) bucket="${2:-}"; shift 2 ;;
      *) die "usage: share setup [hostname] [--tunnel-name N] [--force] [--no-service] [--login] [--backend tunnel|r2 --bucket <name>] | share setup --quick [--no-service]" ;;
    esac
  done
  [[ -z $backend_arg || $backend_arg == tunnel || $backend_arg == r2 ]] || die "--backend must be 'tunnel' or 'r2'"
  [[ -z $bucket || $backend_arg == r2 ]] || die "--bucket needs --backend r2"
  if [[ $backend_arg == r2 ]]; then
    cmd_setup_r2 "$force" "$bucket" "$tunnel_name" "$login" "$service" "$quick_setup"
    return
  fi
  [[ $backend != r2 ]] || die "this profile is set up with the r2 backend; run '$me teardown' first"
  if [[ $quick_setup == 1 ]]; then
    [[ $had_host_arg == 0 && -z $tunnel_name && $force == 0 && $login == 0 ]] || die "usage: share setup --quick [--no-service]"
    cmd_setup_quick "$service"; return
  fi
  [[ $mode != quick ]] || die "already set up with a quick tunnel; run '$me teardown' first"
  if [[ -z $host_name && -t 0 ]]; then read -rp "Hostname for your links (for example s.example.com): " host_name; fi
  [[ $host_name =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || die "usage: share setup <hostname>, for example s.example.com"
  local old_host; old_host="$(cfg hostname || true)"
  if [[ -n $old_host && $old_host != "$host_name" ]]; then   # the main site would answer the new name for the whole pub tree; the apps cover only the old one
    [[ -z "$(host_name="$old_host" rows | awk -F'\t' '$6 ~ /(^| )access=/')" && $(pending_count) == 0 ]] ||
      die "$old_host has gated shares or Access apps awaiting deletion; under $host_name they would be served with no gate; remove them first ('$me rm <id>', see '$me ls', then '$me prune' with the token; a line prune reports as malformed is yours to delete from $pending) or run '$me teardown'"
  fi
  tunnel_name="${tunnel_name:-share-${host_name//./-}}"
  local other   # two profiles on one hostname or one tunnel name would reuse, then delete, one tunnel
  for other in $(other_cfg hostname); do
    [[ $other != "$host_name" ]] || die "$host_name is already the hostname of another profile (share profiles)"
  done
  for other in $(other_cfg tunnel_name); do
    [[ $other != "$tunnel_name" ]] || die "tunnel $tunnel_name already belongs to another profile (share profiles); pass --tunnel-name"
  done

  local missing="" c
  for c in caddy cloudflared jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  profile_port

  local zone="" zone_name za
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} && $login == 0 ]]; then
    auth_api
    za="$(cf_zone)"; read -r zone account zone_name <<<"$za"
  else
    zone_name="$(public_zone "$host_name")"
    [[ -n $zone_name ]] || die "cannot find the DNS zone of $host_name; is the domain on Cloudflare?"
    auth_login "$zone_name"
  fi
  echo "zone:       $zone_name"

  local t tid created=0
  t="$(cf GET "/accounts/$account/cfd_tunnel?name=$tunnel_name&is_deleted=false")"
  tid="$(jq -r '.result[0].id // empty' <<<"$t")"

  # Check the hostname before creating anything, so a taken name leaves no orphan tunnel.
  local rec="" rid="" rtype="" rcontent=""
  if [[ $auth == api ]]; then
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    rtype="$(jq -r '.result[0].type // empty' <<<"$rec")"
    rcontent="$(jq -r '.result[0].content // empty' <<<"$rec")"
    if [[ -n $rid && $force == 0 && ( -z $tid || $rcontent != "$tid.cfargotunnel.com" ) ]]; then
      die "$host_name already has a $rtype record ($rcontent); pick another hostname or rerun with --force"
    fi
  elif [[ -z $tid && $force == 0 ]] && resolves "$host_name"; then
    die "$host_name already resolves in public DNS; pick another hostname or rerun with --force"
  fi

  if [[ -n $tid ]]; then
    echo "tunnel:     reusing $tunnel_name"
  else
    tid="$(cf POST "/accounts/$account/cfd_tunnel" "{\"name\":\"$tunnel_name\",\"config_src\":\"cloudflare\"}" | jq -r .result.id)"
    created=1
    echo "tunnel:     created $tunnel_name"
  fi
  cf PUT "/accounts/$account/cfd_tunnel/$tid/configurations" \
    "{\"config\":{\"ingress\":[{\"hostname\":\"$host_name\",\"service\":\"http://127.0.0.1:$port\"},{\"service\":\"http_status:404\"}]}}" >/dev/null
  echo "route:      $host_name -> 127.0.0.1:$port"

  local target="$tid.cfargotunnel.com" body out
  if [[ $auth == api ]]; then
    body="{\"type\":\"CNAME\",\"name\":\"$host_name\",\"content\":\"$target\",\"proxied\":true,\"comment\":\"share tunnel $tunnel_name\"}"
    if [[ -z $rid ]]; then
      cf POST "/zones/$zone/dns_records" "$body" >/dev/null; echo "dns:        created CNAME $host_name"
    elif [[ $rtype == CNAME && $rcontent == "$target" ]]; then
      echo "dns:        CNAME $host_name already points at the tunnel"
    else
      cf PUT "/zones/$zone/dns_records/$rid" "$body" >/dev/null; echo "dns:        replaced $rtype $host_name (--force)"
    fi
  else
    local overwrite=""
    [[ $force == 1 || $created == 0 ]] && overwrite="--overwrite-dns"
    # shellcheck disable=SC2086
    out="$(cloudflared tunnel --origincert "$cert" --loglevel info route dns $overwrite "$tid" "$host_name" 2>&1)" || true
    if ! grep -qE "CNAME $host_name which|$host_name is already configured" <<<"$out"; then
      [[ $created == 1 ]] && cf DELETE "/accounts/$account/cfd_tunnel/$tid" >/dev/null
      rm -f "$config_dir/cert.zone"
      die "DNS route failed (did you pick $zone_name in the browser?): $(grep -E 'ERR|Added' <<<"$out" | tail -2)"
    fi
    echo "dns:        CNAME $host_name -> tunnel"
  fi

  local tok where
  tok="$(cf GET "/accounts/$account/cfd_tunnel/$tid/token" | jq -r .result)"
  if [[ -n $(cfg token_cmd || true) ]]; then
    echo "token:      config has token_cmd; store this tunnel's token there yourself"
  else
    where="$(token_store "$tok")"; echo "token:      stored in $where"
  fi
  tok=""
  write_config "$tid" "$tunnel_name"

  host_ok || { echo "this host ($(this_host)) is not in hosts=$hosts; skipping the service and the live check"; return 0; }
  if [[ $service == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then
    svc_install; echo "service:    runs at login ($svc_label)"
  fi

  local started=0 live=0
  running || { cmd_start >/dev/null 2>&1; [[ $service == 1 ]] || started=1; }
  live_check 60 && live=1
  [[ $started == 1 ]] && cmd_stop >/dev/null
  [[ $live == 1 ]] || die "live check failed: https://$host_name/ does not answer (see $root/serve.log)"
  echo "ready:      https://$host_name/ is live. Next: $me add <file|dir>"
}

cmd_teardown() {
  [[ $backend != r2 ]] || die "r2 teardown is not implemented yet"
  if [[ $mode == quick ]]; then
    if [[ ${1:-} != --yes ]]; then
      [[ -t 0 ]] || die "rerun '$me teardown --yes' to confirm"
      local a; read -rp "Remove the quick-tunnel setup? Nothing lives on Cloudflare; shares in $root stay. [y/N] " a
      [[ $a == y* || $a == Y* ]] || die "aborted"
    fi
    svc_uninstall
    cmd_stop >/dev/null
    rm -f "$root/quick.url"
    to_trash "$config"
    [[ -z $profile ]] || rmdir "$config_dir" 2>/dev/null || true   # a torn-down profile leaves no empty dir in `share profiles`
    echo "removed the quick setup (no tunnel, DNS, or token existed); shares in $root stay"
    return 0
  fi
  need_host
  local tid; tid="$(cfg tunnel_id || true)"
  [[ -n $tid ]] || die "no tunnel_id in $config"
  if [[ ${1:-} != --yes ]]; then
    [[ -t 0 ]] || die "rerun '$me teardown --yes' to confirm"
    local a; read -rp "Delete the tunnel and DNS record for $host_name? Shares in $root stay. [y/N] " a
    [[ $a == y* || $a == Y* ]] || die "aborted"
  fi
  # a gated share never survives teardown: pub/ and the index stay, so a later setup would serve it with no app
  local gated n_apps
  gated="$(rows | awk -F'\t' '$6 ~ /(^| )access=/ {print $1}')"
  n_apps=$(( $(wc -w <<<"$gated") + $(pending_count) ))
  if [[ $n_apps -gt 0 ]]; then
    api_token_resolve
    [[ -n $api_token ]] || { access_no_token >&2; die "teardown would orphan $n_apps Access app(s); rerun with CLOUDFLARE_API_TOKEN"; }
    local gid
    for gid in $gated; do cmd_rm "$gid" | sed 's/$/ (gated: unpublished before the tunnel goes)/'; done
    access_account; access_sweep
    n_apps="$(pending_count live)"
    [[ $n_apps == 0 ]] || die "$n_apps Access app(s) could not be deleted (see above); teardown stops before the tunnel goes; fix the cause, then rerun $me teardown"
  fi
  # a hand-edited gated row that rows() rejects keeps its bytes in pub; a later setup would serve them ungated
  if [[ -s $index ]]; then
    local raw raws; raws="$(awk -F'\t' 'index($6, "access=") {print $1}' "$index")"
    for raw in $raws; do
      [[ $raw =~ ^[0-9a-f]{6}$ && -z "$(row "$raw")" && -d $pub/$raw ]] || continue
      to_trash "$pub/$raw"; echo "gated:   trashed pub/$raw (malformed index row; its Access app, if any, stays in the dashboard)"
    done
  fi
  svc_uninstall
  cmd_stop >/dev/null
  local zone za rec rid _zn
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    auth_api >/dev/null
    za="$(cf_zone)"; read -r zone account _zn <<<"$za"
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r --arg t "$tid.cfargotunnel.com" '.result[] | select(.content == $t) | .id' <<<"$rec" | head -1)"
    if [[ -n $rid ]]; then cf DELETE "/zones/$zone/dns_records/$rid" >/dev/null; echo "dns:     deleted $host_name"
    else echo "dns:     no record for $host_name points at this tunnel, left alone"; fi
    # every host share loses its DNS record and ingress rule before the tunnel goes
    zone_id="$zone"; zone_name="${zone_name:-$_zn}"; tun_id="$tid"; auth=api
    if [[ -s $index ]]; then
      local _hn _hs _hd _he hopts hfqdn
      while IFS=$'\t' read -r _ _hn _hs _hd _he hopts; do
        hfqdn="$(opt_val host "$hopts" || true)"
        [[ -n $hfqdn ]] && host_rm "$hfqdn" && echo "dns:     deleted $hfqdn"
      done < <(rows)
    fi
  elif [[ -f $cert ]]; then
    cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"
    echo "dns:     the login token cannot delete DNS records. Delete the CNAME $host_name in the Cloudflare dashboard, or rerun with CLOUDFLARE_API_TOKEN."
    if [[ -s $index ]] && rows | awk -F'\t' '$6 ~ /host=/ {f=1} END {exit !f}'; then
      echo "dns:     host shares in $index keep their records; remove them in the dashboard or rerun with CLOUDFLARE_API_TOKEN."
    fi
  else
    die "set CLOUDFLARE_API_TOKEN, or run '$me setup $host_name' once to log in again"
  fi
  cf DELETE "/accounts/$account/cfd_tunnel/$tid/connections" >/dev/null 2>&1 || true
  cf DELETE "/accounts/$account/cfd_tunnel/$tid" >/dev/null
  echo "tunnel:  deleted"
  token_forget; api_token_forget; echo "token:   removed"
  echo "service: removed"
  [[ -f $cert ]] && to_trash "$cert"
  rm -f "$config_dir/cert.zone"
  to_trash "$config"; echo "config:  moved to the Trash"
  [[ -z $profile ]] || rmdir "$config_dir" 2>/dev/null || true
}

cmd_skill() { # cmd_skill [--install]: the skill file that makes share agent-native
  local out="/dev/stdout" d=""
  if [[ ${1:-} == --install ]]; then
    d="${SHARE_SKILL_DIR:-$HOME/.claude/skills/share}"
    mkdir -p "$d"; out="$d/SKILL.md"
  fi
  cat >"$out" <<'EOF'
---
name: share
description: Publish a local file, folder, or running dev server at a public link on the user's own domain. Use when the user asks to share, publish, demo, or hand someone a link to something local ("share this file", "let them see my dev server", "publish these notes").
---

# share

Publish snapshots of local files/folders, or proxy a running `localhost` server, at `https://<host>/...`. The host is the user's own domain on Cloudflare; links live while the machine is awake. With `share setup --quick` no domain is needed: links get a random `*.trycloudflare.com` host that changes on every start.

## Before anything

`share status` shows whether setup ran, whether it is serving, and every share. If setup never ran, stop and tell the user: `share setup --quick` needs no account, or `share setup <hostname>` needs a browser login or `CLOUDFLARE_API_TOKEN`.

## Commands

| Command | Effect |
|---|---|
| `share add <file\|dir>` | Snapshot copy; prints the link and copies it to the clipboard |
| `share add <port>` | Live proxy `https://<host>/<id>/` -> `127.0.0.1:<port>` (also `localhost:port`, `http://localhost:port`) |
| `share add ... --host <name>.<zone>` | Own hostname, e.g. `dev.example.com`; needed for apps that emit absolute asset paths, and for SPA deep links |
| `share add <dir> --no-index` | No generated file listing at the folder link |
| `share add ... --access email:<a>,<b>` / `--access domain:<d>` / `--access group:<name>` | A login gate (Cloudflare Access, one-time PIN by email): only those addresses, everyone at that domain, or the members of an Access rule group can open the link. The link prints once the edge enforces it (minutes on a first app). Named setup only, never quick mode |
| `share api-token [--cmd '<command>' \| --check]` | The Cloudflare API token `--access` needs, once per profile: with no argument it opens the prefilled token form and reads a hidden paste; `--cmd` points share at a command that prints a token you already have (`op read ...`); `--check` reruns the scope preflight |
| `share ls` / `share hits <id>` | List shares / request + unique-visitor counts |
| `share refresh <id>` | Re-copy a snapshot from its source (no-op for live shares) |
| `share rm <id>` | Unpublish; for `--host` shares also deletes the CNAME and tunnel rule |
| `share start` / `share stop` | Serving on or off |
| `share --profile <name> <command>` | Run any command against another setup (a second account or hostname); `share profiles` lists them. No flag is the default setup |

## Rules for agents

- Always surface the printed link to the user; never share something else "to test it".
- Live shares expose whatever answers on that port to anyone with the link. Ports below 1024 and share's own ports are refused; do not try to work around that.
- A shared folder gets a generated file listing unless `--no-index`; check for sensitive names first. Dotfiles and symlinks are never copied.
- A file whose name is 2-5 digits (e.g. `8080`) reads as a port; use `./8080` to share the file.
- Links die when the machine sleeps. If a link 404s or the visitor sees Cloudflare 530, run `share status`.
- In quick mode (`setup --quick`) the `trycloudflare.com` URL is new on every `share start` and every login-service restart: an old link is dead forever, always read the current one from `share status` or the `add` output. `--host` is refused in quick mode.
- `rm`/`hits`/`refresh` accept the pasted link as well as the bare id.
- A gated link (`--access`) needs the API token first; if `share add --access` prints a "needs a Cloudflare API token" block, run the `share api-token` command it names (or `--cmd` with a token the user already has) and rerun the add. `share rm` of a gated share needs the same token; `share status` shows Access apps waiting for deletion.
EOF
  [[ -n $d ]] && echo "installed $out"
}

case "${1:-status}" in
  setup) shift; cmd_setup "$@" ;;
  teardown) cmd_teardown "${2:-}" ;;
  service) cmd_service "${2:-}" ;;
  add) shift; cmd_add "$@" ;;
  api-token) shift; cmd_api_token "$@" ;;
  ls) cmd_prune listing; cmd_ls ;;
  skill) cmd_skill "${2:-}" ;;
  refresh) cmd_refresh "$(id_of "${2:-}")" ;;
  rm) cmd_rm "$(id_of "${2:-}")" ;;
  hits) cmd_hits "$(id_of "${2:-}")" ;;
  prune) cmd_prune ;;
  r2-call) shift; rc=0; r2_call "$@" || rc=$?; printf 'code=%s etag=%s\n' "$cf_code" "$r2_etag"; [[ -n $cf_body ]] && printf '%s\n' "$cf_body"; exit "$rc" ;;
  r2-list) r2_list "${2:-}"; printf '%s' "$r2_list_out" ;;
  r2-put-tree) shift; r2_put_tree "$@" ;;
  r2-delete-prefix) shift; r2_delete_prefix "$@" ;;
  r2-rows) r2_snapshot; printf 'index=%s\n' "$index"; rows ;;
  r2-id) rand_id ;;
  r2-own) case ${2:-} in get|put|drop) f="r2_own_$2"; shift 2; "$f" "$@" ;; *) exit 1 ;; esac ;;
  worker-src) worker_js /dev/stdout ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  state) cmd_state ;;
  profiles) cmd_profiles ;;
  serve) cmd_serve ;;
  -h|--help|help) sed -n '2,/^# Docs:/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) sed -n '2,/^# Docs:/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
