#!/bin/bash
# share: publish snapshots of local files or folders at https://<your-host>/<id>/<name>,
#        or proxy a running dev server on localhost:<port>.
#
#   share --profile <name> <command>   run it against another setup (or SHARE_PROFILE=<name>); no flag = the default one
#   share setup [hostname]    log in to Cloudflare, create the tunnel + DNS, install the service, verify
#   share setup --quick       no domain needed: serve at a random trycloudflare.com URL (changes every start)
#   share add [--ttl 7d|12h|never] [--no-index] <file|dir>   copy it in, print + copy the link, auto-start
#   share add <port|localhost:port|http://localhost:port>    live proxy at https://<host>/<id>/
#   share add ... --host <name>.<zone>                       give the share its own hostname
#   share add ... --access group:<name>|email:<a>[,<b>...]|domain:<domain>   a login gate (Cloudflare Access) on this link
#   share add --cloud|--local <file|dir>   R2 on: this link in the bucket, or on this machine (default: storage_default)
#   share api-token [--cmd '<command>' | --check]   the Cloudflare API token --access needs: prefilled form + paste, or point at one you have
#   share admin-token --cmd '<command>' | --clear | --test [--json]   the command that prints the admin token (setup --r2, --no-r2, --purge)
#   share minter-token --cmd '<command>' | --clear | --test [--json]  the command that prints the minter token (member tokens)
#   share config ttl|storage_default [<value> | --unset]   the CLI defaults the Share Bar's General tab writes; with no value, print it
#   share ls                  list shares: link, size, source, expiry
#   share refresh <id|link>   re-copy from the source path (same link)
#   share rm <id|link>        unpublish (moves the copy to the Trash)
#   share hits <id|link>      requests and unique visitors for one share
#   share prune               unpublish expired shares now (also hourly while serving)
#   share start | stop        start or stop serving (links live while this machine is awake)
#   share service install|uninstall|status   the login service that keeps serving
#   share state               machine-readable JSON snapshot (for the menu bar app)
#   share profiles [--json]   every profile with its state and host (--json: full state objects, for the menu bar app)
#   share [status]            server state plus the share list
#   share serve               serve in the foreground until Ctrl-C
#   share skill [--install]   the SKILL.md that teaches an agent to use share
#   share version             the CLI version (X.Y.Z)
#   share teardown [--yes]    delete the tunnel, DNS record, service, and stored token
#   share import ...          used by migrate over ssh
#   share migrate --to <ssh-target>   move this tenant's origin to another machine (snapshots only, R2 off)
#   share setup <hostname> --r2 --bucket <name> [--storage-default local|cloud] [--alias <old-host>]   on the origin: R2 on, per-link storage
#   share setup <hostname> --no-r2   on the origin: R2 off again (refuses while an alias is set)
#   share setup <hostname> --backend r2 --bucket <name>   an R2 profile: a private bucket and a Worker
#      serve links while this machine is off; teardown --yes --purge (admin token) deletes it all
#
# Docs: https://github.com/dwarvesf/share
set -euo pipefail

SHARE_VERSION=0.9.0   # bin/release rewrites it in the release commit; the suite checks it against CHANGELOG.md's newest heading

die() { echo "share: $*" >&2; exit 1; }

# Stable refusal and serve-exit codes, one "code|meaning|next" line each; {me} in a next stands for the profile's own command. A new code adds a line here and a
# line in the skill; a renamed or removed code bumps codes_v (state's schema never moves for it).
codes_v=1
code_table='not_in_hosts|this machine is not in hosts=, so it does not serve this profile|{me} status (serve from a machine in hosts=)
already_serving|a server already runs for this profile|{me} status
no_tunnel_token|the tunnel token is missing from the Keychain or the 600 file|{me} setup <hostname>
port_busy|the share port is taken by another process or profile|{me} profiles
metrics_port_busy|the tunnel metrics port (port + 1) is taken|{me} profiles
server_not_started|the server did not answer within 10 s; serve.log says why|{me} status
profile_migrated|this profile moved to another machine (share migrate); nothing serves here|{me} teardown --yes (destructive: ask the user first)
op_running|another run of the same multi-step verb is still alive|wait for it, then {me} state
quick_has_named_tunnel|setup --quick on a profile that already has a named tunnel|{me} teardown, then {me} setup --quick
tenant_rollback|setup --r2 died after its config write; the message names the rollback|rerun the same setup, or the rollback it names
config_value_bad|a config value holds a line break, or is not a value the key takes; nothing was written|fix the value, then rerun
cloud_token_missing|the menu reads cloud links only with a stored publisher token|{me} api-token
admin_token_missing|an admin path found neither CLOUDFLARE_API_TOKEN nor admin_token_cmd|{me} admin-token --cmd '"'"'<command>'"'"'
admin_token_cmd_failed|admin_token_cmd exited non-zero or printed no token|{me} admin-token --test
admin_token_not_admin|the token cannot read the Worker settings: it is not an admin token|{me} admin-token --cmd '"'"'<command>'"'"'
minter_token_missing|a minter path found neither SHARE_MINTER_TOKEN nor minter_token_cmd|{me} minter-token --cmd '"'"'<command>'"'"'
minter_token_cmd_failed|minter_token_cmd exited non-zero or printed no token|{me} minter-token --test
members_present|a teardown, migrate, --no-r2 or --no-members refused while the tenant has members|{me} member ls
config_key_unknown|share config sets only ttl and storage_default; nothing was written|{me} config ttl
ok|serve.reason of a serving profile: nothing is wrong|{me} state
tunnel_down|serve runs but the tunnel does not answer yet (starting, or cloudflared lost the edge)|{me} status
worker_down|the Worker at the hostname does not answer /healthz|{me} status
token_missing|token.status: no publisher or Access token resolves on this profile|{me} api-token
token_expired|token.status: the stored token is past its expires_on; every add fails|{me} api-token
token_invalid|token.status: Cloudflare rejected the stored token|{me} api-token
cli_below_min|compat.status: this share is older than the tenant requires (min_cli)|upgrade share
worker_older|compat.status: the Worker at the hostname is older than this share ships|{me} status
stopped|serve exit record: the stop verb ended serving|{me} start
cloudflared_died|serve exit record: the cloudflared child exited|{me} status; see serve.log
caddy_failed|serve exit record: caddy failed to start or exited|{me} status; see caddy.log
member_no_tenant|an admin verb ran with no --tenant on a machine with no profile for one|{me} member ls --tenant <host>
members_off|the tenant has members off (no Worker, no share.json, or no members:true in it)|{me} setup <host> --r2 --bucket <bucket> --members
admin_token_scope|the admin token lacks a scope a member verb needs (named in the message)|{me} admin-token --test
minter_token_scope|the minter token lacks API Tokens Read or API Tokens Write|{me} minter-token --test
token_limit|the minting user holds 50 tokens, the Cloudflare limit per user|use a dedicated Cloudflare user as the minter
member_name_bad|a member name is not 2 to 24 of a-z, 0-9 and -|{me} member add <name>
member_name_taken|a member of that name exists and is not removed|{me} member ls
member_cap|the tenant has 20 machine members, the cap|{me} member ls
member_unknown|no member of that name on the tenant|{me} member ls
member_busy|the member is mid another verb; the message names the rerun|the rerun the message names
member_not_allowed|the status of the member does not allow this verb|{me} member ls
member_changed|the member record changed under this verb (the admin changed it during a join, or two writes lost)|{me} member ls
record_invalid|a u/ record fails validation (forged, or written by a newer share); it is never used|{me} member ls
lease_held|another admin verb holds the tenant lease (lock/admin); this one waited 60 s|wait for it, then rerun
lease_lost|another admin verb took the lease over while this one held it|rerun the same verb
worker_mismatch|the deployed Worker is not the version this share ships; a member verb never changes its code|{me} setup <host> --r2 --bucket <bucket>
invite_ttl_bad|--invite-ttl is not a duration of at most 30 days|{me} member add <name> --invite-ttl 7d
config_drift|drift: config members=on and the marker members:true disagree|{me} setup <host> --r2 --bucket <bucket> --members
deploy_paused_record_active|drift: the deploy pauses the member, its record reads active|{me} member sync
deploy_bound_record_removed|drift: the member is bound in the deploy, its record reads removed or left|{me} member rm <name>
deploy_unpaused_record_paused|drift: the record reads paused, the deploy does not pause it|{me} member sync
deploy_unbound_record_live|drift: the record reads active or paused, the deploy has no binding for it|{me} member sync --rebind
extra_connector|drift: the tunnel of the member has more than one connector (a leaked connector token)|share member rotate <name>
token_unreachable|the current minter cannot find the token of the member; it stays live until its expires_on|share member rotate <name>
invite_unknown_or_used|join: the redeem answered 404 (the code was used or never existed)|ask the admin: share member rotate <name>
invite_expired|join: the redeem answered 410 (the invite expired)|ask the admin: share member invite <name>
invite_unavailable|join: the redeem answered neither 200, 404 nor 410 within 30 s|ask the admin: share member invite <name>
invite_tampered|join: the sealed invite fails its MAC|ask the tenant admin for a new invite
member_needs_keychain|join: members need the macOS Keychain (no security command)|join from a Mac
profile_not_empty|join: the profile is set up for something else|{me} profiles (join with --profile <new name>)'
code_text() { # code_text <code>: "<meaning>\t<next>"; returns 1 for an unknown code
  printf '%s\n' "$code_table" | awk -F'|' -v c="$1" '$1 == c {print $2 "\t" $3; f = 1; exit} END {exit !f}'
}
serve_exit_write() { # serve_exit_write <code>: {"code":..,"at":..} into $root/.serve-exit, tmp + mv; a failed write is ignored
  local c=$1; [[ $c =~ ^[a-z_]+$ ]] || c=unknown   # a seam can pass any string; the record stays valid JSON
  { printf '{"code":"%s","at":%s}\n' "$c" "$(date +%s)" >"$root/.serve-exit.tmp" && mv -f "$root/.serve-exit.tmp" "$root/.serve-exit"; } 2>/dev/null
  return 0
}
die_code() { # die_code <code> <message> [next]: die's own line; SHARE_ERROR_JSON=1 adds one unprefixed JSON line, last; serve records its code
  echo "share: $2" >&2
  if [[ ${SHARE_ERROR_JSON:-} == 1 ]]; then
    jq -nc --arg c "$1" --arg m "$2" --arg n "${3:-}" '{error: {code: $c, message: $m, next: $n}}' >&2 2>/dev/null || true
  fi
  [[ -z ${SHARE_EXIT_FILE:-} || $SHARE_EXIT_FILE != "${root:-}/.serve-exit" ]] || serve_exit_write "$1"   # only serve's own file, never a path from the env
  exit 1
}

# A profile (--profile <name> before the verb, or SHARE_PROFILE) is a second setup beside the
# default one: its own config dir, root, port, service label, and Keychain item. With no
# profile every value below is what a single-profile install has always used.
profile="${SHARE_PROFILE:-}"
if [[ ${1:-} == --profile ]]; then
  [[ $# -ge 2 && -n $2 ]] || die "usage: share --profile <name> <command>"
  profile="$2"; shift 2
fi
[[ $profile == default ]] && profile=""
[[ -z $profile || $profile =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "bad profile name '$profile' (a-z, 0-9, -; 32 chars max)"
for arg in "$@"; do   # `share teardown --yes --profile x` must not tear down the default
  case $arg in --profile|--profile=*) die "--profile goes before the verb: share --profile <name> ${1:-<command>}" ;; esac
done
export SHARE_PROFILE="$profile"   # start's nohup serve and the hourly prune run as bash "$0"
me="share${profile:+ --profile $profile}"   # how a message names this profile's own command
profiles_dir="${XDG_CONFIG_HOME:-$HOME/.config}/share/profiles"

config_dir="${SHARE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/share${profile:+/profiles/$profile}}"
config="$config_dir/config"
cfg() { [[ -f $config ]] && awk -v k="$1" 'index($0, k "=") == 1 {print substr($0, length(k) + 2); exit}' "$config"; }

# Each config writer owns the keys it writes plus the keys it drops; every other line is kept byte for byte.
own_write_config="hostname tunnel_id tunnel_name auth hosts port zone mode migrated"
own_write_config_r2="backend hostname zone bucket port r2_endpoint aliases tunnel_id tunnel_name auth hosts mode migrated"
own_write_config_quick="mode hosts port hostname tunnel_id tunnel_name auth zone migrated"
own_tenant_config="bucket r2_endpoint storage_default aliases migrated"
config_put() { # config_put "<owned keys>" key=value...: owned keys rewritten at their first line (later duplicates dropped), owned keys not given dropped, every other line kept in order; tmp + mv
  local owned=$1 kv k tmp pairs="" src=/dev/null; shift
  for kv in "$@"; do   # every refusal before the lock and before any write
    k="${kv%%=*}"
    case $kv in *$'\n'*|*$'\r'*) die_code config_value_bad "the value of $k holds a line break; nothing was written" "fix the value, then rerun" ;; esac
    case " $owned " in *" $k "*) ;; *) die "config_put: $k is not a key this writer owns" ;; esac
    pairs="$pairs$kv"$'\n'
  done
  mk_root
  mkdir -p "$config_dir" 2>/dev/null || die "cannot create $config_dir; the config was not written"
  lock_take config
  tmp="$(mktemp "$config_dir/.config.XXXXXX" 2>/dev/null)" || { lock_release config; die "cannot write in $config_dir; the config was not written"; }
  if [[ -f $config ]]; then src=$config; cp -p "$config" "$tmp" 2>/dev/null || true; else chmod 644 "$tmp"; fi   # cp -p carries the config's own mode to the tmp
  # values reach awk through the environment, never -v (which would read backslash escapes)
  if ! CONFIG_PUT_PAIRS="$pairs" awk -v owned=" $owned " '
      BEGIN { n = split(ENVIRON["CONFIG_PUT_PAIRS"], p, "\n")
              for (i = 1; i <= n; i++) if (p[i] != "") { k = substr(p[i], 1, index(p[i], "=") - 1); val[k] = p[i]; ord[++m] = k } }
      { e = index($0, "="); k = e ? substr($0, 1, e - 1) : ""
        if (e > 1 && index(owned, " " k " ")) { if ((k in val) && !(k in done)) { print val[k]; done[k] = 1 }; next }
        print }
      END { for (i = 1; i <= m; i++) if (!(ord[i] in done)) { print val[ord[i]]; done[ord[i]] = 1 } }' \
      "$src" >"$tmp" || ! mv -f "$tmp" "$config"; then
    rm -f "$tmp"; lock_release config; die "writing $config failed; the config was not changed"
  fi
  lock_release config
  profile_role   # a guard later in this process reads the config just written
}

# The one kind a profile is (first match wins), and an origin's tier. Reads the config and file existence only:
# never a secret, never token_cmd, never the network, so state can call it on every poll.
role="" tier="" migrated_to="" tier_drift=0
profile_role() {
  local c_role="" c_mid="" c_mig="" c_tid="" c_bucket="" c_members="" c_tcmd="" stored=0
  if [[ -f $config ]]; then
    IFS=$'\037' read -r c_role c_mid c_mig c_tid c_bucket c_members c_tcmd < <(awk -v keys="role member_id migrated tunnel_id bucket members token_cmd" '
      BEGIN { n = split(keys, K, " ") }
      { for (i = 1; i <= n; i++) if (!(K[i] in v) && index($0, K[i] "=") == 1) v[K[i]] = substr($0, length(K[i]) + 2) }
      END { for (i = 1; i <= n; i++) printf "%s%s", v[K[i]], (i < n ? "\037" : "\n") }' "$config") || true
  fi
  role=none tier="" migrated_to="$c_mig"
  if [[ -z $c_mig && -f $root/index.migrated && -n $c_tid && -z $c_tcmd ]]; then   # moved before the migrated= key existed: no stored tunnel token is the sign
    [[ -f $config_dir/tunnel-token ]] && stored=1
    if [[ $stored == 0 ]] && command -v security >/dev/null; then   # no -w: the item's existence, never its secret
      security find-generic-password -a share -s "share-tunnel${profile:+.$profile}:$host_name" >/dev/null 2>&1 && stored=1
    fi
  fi
  if [[ $c_role == member && -n $c_mid ]]; then role=member
  elif [[ -n $c_mig ]] || [[ -f $root/index.migrated && -n $c_tid && -z $c_tcmd && $stored == 0 ]]; then role=migrated
  elif [[ $backend == r2 ]]; then role=r2_profile
  elif [[ $mode == quick ]]; then role=quick
  elif [[ -n $c_tid && -n $c_bucket ]]; then role=tenant_origin
  elif [[ -n $c_tid ]]; then role=origin
  fi
  tier_drift=0
  case $role in origin|tenant_origin)
    tier=t0; [[ -z $c_bucket ]] || tier=t1; [[ -z $c_bucket || $c_members != on ]] || tier=t2
    if [[ -n $c_bucket && -f $config_dir/.health ]]; then   # the marker as the last verb that read share.json saw it (DEC-33): T2 is config OR marker
      local mk; mk="$(jq -r '(.marker // {}) | if has("members") then (.members | tostring) else "" end' "$config_dir/.health" 2>/dev/null || true)"
      [[ $mk != true ]] || tier=t2
      if [[ $mk == true && $c_members != on ]] || [[ $mk == false && $c_members == on ]]; then tier_drift=1; fi
    fi ;;
  esac
  return 0
}
migrated_guard() { # a profile that moved away refuses start, serve, service install, add, --r2 and --no-r2 before any write
  [[ $role == migrated ]] || return 0
  local t; t="$(printf '%s' "$migrated_to" | tr -d '[:cntrl:]')"
  die_code profile_migrated "this profile moved${t:+ to $t} (rows in index.migrated); nothing serves here" "$me teardown --yes"
}

root="${SHARE_ROOT:-$HOME/share${profile:+/profiles/$profile}}"
pub="$root/pub"            # served tree; nothing else is reachable from the tunnel
index="$root/index.tsv"    # id, name, source, added date, expiry epoch (0 = never)
r2own="$root/r2-own"       # r2: <id>\t<prefix>\t<source> for shares this install added; refresh trusts only this file
pidfile="$root/serve.pid"
pending="$root/access-pending"   # every Access app not, or no longer, backed by a finished row: id, app or -:<nonce>, owner pid, owner start, created
host_name="${SHARE_HOSTNAME:-$(cfg hostname || true)}"
backend="${SHARE_BACKEND:-$(cfg backend || true)}"   # "r2" serves from Cloudflare; empty or anything else is the tunnel backend
port="${SHARE_PORT:-$(cfg port || true)}"; port="${port:-8787}"
if [[ $backend == r2 ]]; then
  metrics_port=0   # port= holds the "r2" sentinel on purpose; nothing listens on this machine
else
  [[ $port =~ ^[1-9][0-9]*$ ]] || die "port '$port' is not a number (port= in $config, or SHARE_PORT)"   # no leading zero: $(( )) would read octal
  metrics_port=$((port + 1))   # cloudflared /ready, polled so `start` returns once links work
fi
hosts="${SHARE_HOSTS:-$(cfg hosts || true)}"
tunnel="${SHARE_TUNNEL:-1}"  # 0 = local-only (tests)
mode="$(cfg mode || true)"   # "quick" = trycloudflare, no domain; empty = named tunnel
r2on=0   # a tunnel profile with bucket= is a tenant origin with R2 on: local links get pointer records, --cloud adds go to the bucket
[[ $backend != r2 && -n "$(cfg bucket || true)" ]] && r2on=1
profile_role
api="https://api.cloudflare.com/client/v4"

this_host() { local h; h="$(uname -n)"; echo "${h%%.*}"; }
host_ok() { case " $hosts " in *" $(this_host) "*) return 0 ;; esac; return 1; }
running() { # the pid must still be a share serve: an unclean exit leaves the file and the OS reuses the pid
  [[ -f $pidfile ]] || return 1
  local pid; pid="$(cat "$pidfile")"
  kill -0 "$pid" 2>/dev/null && [[ $(ps -o command= -p "$pid" 2>/dev/null) == *share*serve* ]]
}
rows() { rows_in "$index" "$backend"; }   # the only index reader
rows_in() { # rows_in <file> <backend>: a forged row (bad id, main or malformed host=, a bad access= or access_rule=) never reaches a path, Caddyfile, or Cloudflare call; a bad revoked_by= reads unknown
  [[ -f $1 ]] || return 0
  # no {n} intervals: mawk lacks them; the host regex is setup's hostname check; the rule grammar is access_parse's
  awk -F'\t' -v OFS='\t' -v main="$host_name" -v be="$2" '
    function hostname(h) { return h ~ /^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z][a-z]+$/ }
    function uuid(u) { return length(u) == 36 && u !~ /[^0-9a-f-]/ && substr(u, 9, 1) == "-" && substr(u, 14, 1) == "-" && substr(u, 19, 1) == "-" && substr(u, 24, 1) == "-" && gsub(/-/, "-", u) == 4 }
    function rule(r,   k, v, m, e, j, at) {
      if (index(r, ":") < 2) return 0
      k = substr(r, 1, index(r, ":") - 1); v = substr(r, index(r, ":") + 1)
      if (v == "") return 0
      if (k == "group") return length(v) <= 64 && v !~ /[^A-Za-z0-9._-]/
      if (k == "domain") return hostname(v)
      if (k != "email") return 0
      m = split(v, e, ",")
      if (m > 50) return 0
      for (j = 1; j <= m; j++) {
        at = index(e[j], "@")
        if (at < 2 || index(substr(e[j], at + 1), "@") || substr(e[j], 1, at - 1) ~ /[^a-z0-9._%+-]/ || !hostname(substr(e[j], at + 1))) return 0
      }
      return 1
    }
    (NF == 5 || NF == 6) && length($1) == 6 && $1 !~ /[^0-9a-f]/ {
      n = split($6, a, " "); app = 0; rl = 0; fix = 0
      hp = (be != "r2"); hb = (be != "r2")   # r2 rows must carry a sound prefix= and by=
      for (i = 1; i <= n; i++) {
        if (substr(a[i], 1, 5) == "host=") {
          h = substr(a[i], 6)
          if (h == main || !hostname(h)) next
        }
        if (substr(a[i], 1, 7) == "access=") { if (!uuid(substr(a[i], 8))) next; app = 1 }
        if (substr(a[i], 1, 12) == "access_rule=") { if (!rule(substr(a[i], 13))) next; rl = 1 }
        if (substr(a[i], 1, 7) == "prefix=") {
          p = substr(a[i], 8)
          if (!(length(p) == 18 && substr(p, 1, 2) == "o/" && substr(p, 3, 6) == $1 &&
                substr(p, 9, 1) == "." && substr(p, 18, 1) == "/" && substr(p, 10, 8) ~ /^[0-9a-f]+$/)) next
          hp = 1
        }
        if (substr(a[i], 1, 11) == "revoked_by=") {   # display only, from a t/ record any publisher can forge: anything odd reads unknown
          b = substr(a[i], 12)
          if (b == "" || length(b) > 64 || b ~ /[^A-Za-z0-9._@:-]/) { a[i] = "revoked_by=unknown"; fix = 1 }
        }
        if (substr(a[i], 1, 3) == "by=") {
          b = substr(a[i], 4)
          if (b == "" || b ~ /[^a-z0-9.-]/) next
          hb = 1
        }
      }
      if (app != rl || !hp || !hb) next   # a gated row carries both, or it is a hand edit; an r2 row needs its prefix and host
      if (fix) { o = a[1]; for (i = 2; i <= n; i++) o = o " " a[i]; $6 = o }
      print
    }' "$1"
}
row() { rows | awk -F'\t' -v id="$1" '$1 == id'; }
crows() { rows_in "${r2_snap_file:-/dev/null}" r2; }   # the cloud rows of this process's bucket read; on an origin its own file, never $index
crow() { crows | awk -F'\t' -v id="$1" '$1 == id'; }
id_of() { # accept an id or a pasted share link: https://host/<id>/name -> <id>; a bare https://<fqdn>/ resolves to the host row
  case ${1:-} in
    *://*)
      local p="${1#*://}"; local h="${p%%/*}" rest="${p#*/}"
      if [[ $p == "$h" || -z $rest ]] && [[ -f $index ]]; then
        rows | awk -F'\t' -v h="$h" '{n=split($6,a," "); for(i=1;i<=n;i++) if(a[i]=="host=" h){print $1; exit}}'
      else
        echo "${rest%%/*}"
      fi ;;
    *) echo "${1:-}" ;;
  esac
}
rand_id_raw() { od -An -N3 -tx1 /dev/urandom | tr -d ' \n'; }   # the real candidate source
rand_id() { # loops past a collision with an existing row or an orphaned pub/<id>
  # SHARE_TEST_IDS (test seam): space-separated candidates consumed in order, then rand_id_raw.
  # Consumed here, not inside rand_id_raw: rand_id_raw's output is captured with $( ), which
  # forks a subshell, so a mutation made inside it would never reach this loop's next pass.
  local id
  while :; do
    if [[ -n ${SHARE_TEST_IDS:-} ]]; then
      id="${SHARE_TEST_IDS%% *}"
      [[ $SHARE_TEST_IDS == "$id" ]] && SHARE_TEST_IDS="" || SHARE_TEST_IDS="${SHARE_TEST_IDS#* }"
    else
      id="$(rand_id_raw)"
    fi
    if [[ $backend == r2 ]]; then
      r2_id_taken "$id" && continue
      ! grep -q "^$id"$'\t' "$pending" 2>/dev/null && { echo "$id"; return; }
      continue
    fi
    # an id named in access-pending has an Access app waiting: a new share must never land behind it
    if [[ -n "$(row "$id")" || -e $pub/$id ]] || grep -q "^$id"$'\t' "$pending" 2>/dev/null; then continue; fi
    [[ $r2on == 1 ]] && r2_id_taken "$id" && continue   # an origin with R2 on: one namespace with the bucket
    echo "$id"; return
  done
}
r2_id_taken() { # r2_id_taken <id>: a live GET of m/ and t/, and a prefix scan; anything but 200/404 or empty fails closed
  r2_call GET "m/$1" || die "the r2 record check needs a publisher token (see above)"
  case $cf_code in
    200) return 0 ;;
    404) ;;
    *) die "the r2 record check for $1 failed (HTTP $cf_code); no id was picked" ;;
  esac
  r2_call GET "t/$1" || die "the r2 tombstone check needs a publisher token (see above)"   # a removed member link's id is never handed out again
  case $cf_code in
    200) return 0 ;;
    404) ;;
    *) die "the r2 tombstone check for $1 failed (HTTP $cf_code); no id was picked" ;;
  esac
  r2_call LIST "o/$1."
  [[ $cf_code == 200 ]] || die "the r2 prefix check for $1 failed (HTTP $cf_code); no id was picked"
  [[ $cf_body == *"<Key>"* ]]   # leftover objects under this id: never hand it out
}
has_opt() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
opt_val() { # opt_val <key> <opts>: the value of a key=value token, nothing when absent
  local rest="${2#*"$1"=}"
  [[ $rest == "$2" ]] && return 1
  echo "${rest%% *}"
}
day_of() { date -r "$1" +%F 2>/dev/null || date -d "@$1" +%F; }
to_trash() { # an empty path would make `trash` move the current directory
  [[ -n ${1:-} && -e $1 ]] || return 0
  if command -v trash >/dev/null; then trash "$1"; return; fi
  mkdir -p "$root/trash" && mv -f "$1" "$root/trash/$(basename "$1").$(date +%s)"
}
mk_root() { # the leaf ($root) needs 700: it holds the admin socket; a profile's parents under ~/share get it too
  # shellcheck disable=SC2174 # every directory that matters is named explicitly, so each gets the mode
  [[ $root != "$HOME/share/profiles/"* ]] || mkdir -p -m 700 "$HOME/share" "$HOME/share/profiles"
  # shellcheck disable=SC2174
  mkdir -p -m 700 "$root"
}
need_host() { [[ -n $host_name || $mode == quick ]] || die "no setup yet: run '$me setup <hostname>' or '$me setup --quick'"; }

# Locks are symlinks $root/.lock-<name> -> holder pid, so a dead holder's lock can be broken.
# Inside a subshell $$ is the parent's pid (bash 3.2 has no BASHPID); that lock is recovered once the parent exits.
held_locks=""   # names this process holds; the EXIT trap releases them
lock_take() { # lock_take <name> [timeout-secs]
  local l="$root/.lock-$1" s="$root/.lock-$1.stale.$$" i=0 max=$(( ${2:-60} * 5 )) pid
  # a real directory is a pre-symlink lock: ln would link inside it, so it counts as held
  while [[ -d $l && ! -L $l ]] || ! ln -sn "$$" "$l" 2>/dev/null; do
    pid="$(readlink "$l" 2>/dev/null || true)"
    # stale: rename to a private name, re-read, remove only if still dead; a live one goes back
    if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null && mv "$l" "$s" 2>/dev/null; then
      pid="$(readlink "$s" 2>/dev/null || true)"
      if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null; then rm -f "$s"; else mv -f "$s" "$l"; fi
      continue
    fi
    i=$((i + 1)); [[ $i -gt $max ]] && die "another share command holds the $1 lock"
    sleep 0.2
  done
  held_locks="$held_locks $1"
  trap release_locks EXIT   # re-armed on every take: subshells do not inherit EXIT traps
}
lock_release() { # lock_release <name>: only a link that still names this pid is removed
  [[ "$(readlink "$root/.lock-$1" 2>/dev/null)" == "$$" ]] && rm -f "$root/.lock-$1"
  held_locks="${held_locks// $1/}"
}
held_fqdn=""   # a --host name whose ingress rule and CNAME exist but whose row does not yet; the trap removes them
held_access_id=""   # a gated add inside its wait; on a die the trap says where its app went
release_locks() { # the EXIT trap: every held lock, a stage still outside pub, and a routed fqdn with no row (an add that died in its wait)
  local n f; for n in $held_locks; do lock_release "$n"; done
  [[ -n $stage_out && -d $stage_out ]] && rm -rf "$stage_out"
  stage_out=""
  if [[ -n $held_fqdn ]]; then f="$held_fqdn"; held_fqdn=""; host_rm "$f" || true; fi
  if [[ -n $held_access_id ]]; then echo "share: nothing was published; the Access app of $held_access_id waits in access-pending, the next $me add --access or $me prune with a token removes it" >&2; held_access_id=""; fi
  [[ -n ${r2_snap_file:-} ]] && rm -f "$r2_snap_file"
  [[ -n ${import_spool:-} ]] && rm -f "$import_spool"
  if [[ -n ${r2_held_prefix:-} ]]; then f="$r2_held_prefix"; r2_held_prefix=""; r2_release_prefix "$r2_held_id" "$f"; fi
  [[ ${lease_held:-0} != 1 ]] || lease_release || true   # a died member verb gives lock/admin back; a killed one leaves it for a same-host takeover
  return 0
}

# the public hostname share links use: the configured hostname in named mode,
# the fqdn cloudflared printed in quick mode (empty while not serving)
serving_host() {
  if [[ $mode == quick ]]; then cat "$root/quick.url" 2>/dev/null || true
  else echo "$host_name"; fi
}

share_url() { # share_url <id> <name> [opts]: sets share_url_out; the link depends on the share kind
  local fqdn path shost
  fqdn="$(opt_val host "${3:-}" || true)"
  if [[ -n $fqdn ]]; then
    printf -v share_url_out 'https://%s/' "$fqdn"; return
  fi
  shost="$(serving_host)"
  if [[ -z $shost ]]; then
    if [[ $mode == quick ]]; then shost="<pending>.trycloudflare.com"; else shost="<no-hostname>"; fi
  fi
  if has_opt live "${3:-}"; then
    printf -v share_url_out 'https://%s/%s/' "$shost" "$1"; return
  fi
  path="$2"
  local base="$pub/$1"
  [[ $backend != r2 && -z ${r2_link_base:-} ]] || base="${r2_link_base:-}"   # r2 or a cloud add on an origin: the stage during an add; a listing has none, and the Worker 308s a folder to its slash
  if [[ -z $base ]]; then :
  elif [[ -d $base/$2 ]]; then path="$2/"
  elif [[ $2 == *.md && -f $base/${2%.md}.html ]]; then path="${2%.md}.html"
  fi
  urlenc "$path"
  printf -v share_url_out 'https://%s/%s/%s' "$shost" "$1" "$urlenc_out"
}

ttl_secs() {
  local n="${1%[dh]}"
  case $1 in never|0) echo 0; return ;; esac
  [[ $n =~ ^[0-9]+$ ]] || die "bad --ttl '$1' (use 12h, 7d, or never)"
  case $1 in
    *d) echo $((n * 86400)) ;;
    *h) echo $((n * 3600)) ;;
    *) die "bad --ttl '$1' (use 12h, 7d, or never)" ;;
  esac
}

# --- tunnel token storage: token_cmd in config > macOS Keychain > 0600 file ---

token_file="$config_dir/tunnel-token"
# the Keychain service name, one item per profile and hostname; a function, not a variable:
# on a first setup host_name is empty when the script loads and is assigned inside cmd_setup
token_key() { echo "share-tunnel${profile:+.$profile}:$host_name"; }
token_read() {
  local cmd; cmd="$(cfg token_cmd || true)"
  if [[ -n $cmd ]]; then eval "$cmd"; return; fi
  if command -v security >/dev/null; then
    security find-generic-password -a share -s "$(token_key)" -w 2>/dev/null && return
  fi
  [[ -f $token_file ]] && cat "$token_file"
}
token_store() { # token_store <token>; stdin only, so the token never shows in ps
  if command -v security >/dev/null; then
    printf 'add-generic-password -U -a share -s "%s" -w "%s"\n' "$(token_key)" "$1" | security -i >/dev/null
    echo "keychain (service $(token_key))"
  else
    (umask 077 && printf '%s' "$1" >"$token_file")
    echo "$token_file (mode 600)"
  fi
}
token_forget() {
  if command -v security >/dev/null; then
    security delete-generic-password -a share -s "$(token_key)" >/dev/null 2>&1 || true
  fi
  [[ -f $token_file ]] && to_trash "$token_file"
  return 0
}

# --- snapshots ---

write_md_style() { # the reading stylesheet, shared by pandoc renders and gen_index
  cat >"$root/md-style.html" <<'CSS'
<style>
/* Spacedown's "paper" reading theme (dwarvesf/spacedown assets/paper-theme.css) on pandoc's default template. */
:root { --paper-bg:#fbfaf7; --paper-fg:#242321; --paper-muted:#6e6c67; --paper-rule:#dcd9d2; --paper-rule-strong:#b9b5ac; --paper-link:#2b5f91; --paper-code-bg:#f0eee9; --paper-mark:#f6e7a8;
  --paper-font-sans:"iA Writer Quattro V", "iA Writer Quattro S", -apple-system, "Helvetica Neue", Arial, sans-serif;
  --paper-font-mono:"iA Writer Mono V", "iA Writer Mono S", ui-monospace, "SF Mono", Menlo, monospace; }
@media (prefers-color-scheme: dark) { :root { --paper-bg:#19191b; --paper-fg:#dedcd6; --paper-muted:#9c9a94; --paper-rule:#34343a; --paper-rule-strong:#55555c; --paper-link:#8bb8e8; --paper-code-bg:#242428; --paper-mark:#5c4f1e; } }
html { background:var(--paper-bg); color:var(--paper-fg); -webkit-text-size-adjust:100%; }
body { max-width:44rem; margin:0 auto; padding:2.2rem 1.6rem 4rem; font:17px/1.62 var(--paper-font-sans); font-kerning:normal; text-rendering:optimizeLegibility; }
h1,h2,h3,h4,h5,h6 { font-weight:650; letter-spacing:-0.005em; margin:2em 0 .6em; }
h1 { font-size:1.6em; line-height:1.25; margin-top:0; } h2 { font-size:1.3em; line-height:1.3; } h3 { font-size:1.1em; line-height:1.4; } h4,h5,h6 { font-size:1em; } h6 { color:var(--paper-muted); }
p, ul, ol, dl, blockquote, pre, table, figure { margin:0 0 1.1em; }
ul, ol { padding-left:1.6em; } li + li { margin-top:.25em; } li > p, li > ul, li > ol { margin:.2em 0; } li::marker { color:var(--paper-muted); }
a { color:var(--paper-link); text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.18em; text-decoration-color:color-mix(in srgb, var(--paper-link) 35%, transparent); overflow-wrap:anywhere; }
a:hover { text-decoration-color:var(--paper-link); }
blockquote { margin-left:0; padding:0 1em; border-left:3px solid var(--paper-rule); color:var(--paper-muted); }
blockquote p:last-child { margin-bottom:0; }
code, kbd, samp, pre { font-family:var(--paper-font-mono); font-size:.9em; }
code { background:var(--paper-code-bg); padding:.1em .3em; border-radius:4px; overflow-wrap:anywhere; }
pre, pre.sourceCode { background:var(--paper-code-bg); padding:.9rem 1rem; border-radius:6px; overflow-x:auto; line-height:1.55; } /* pandoc sets .sourceCode transparent */
div.sourceCode { overflow:visible; margin:0 0 1.1em; }
pre code { background:none; padding:0; font-size:inherit; white-space:pre; }
/* Spacedown sizes table columns with a script; here a wide table scrolls as a block instead. */
table { display:block; width:max-content; max-width:100%; overflow-x:auto; border-collapse:collapse; font-size:.9em; line-height:1.6; font-variant-numeric:tabular-nums; }
th, td { padding:.5em 1em .5em 0; text-align:left; vertical-align:top; }
thead th { font-weight:650; border-bottom:1px solid var(--paper-rule-strong); }
tbody tr + tr td { border-top:1px solid var(--paper-rule); }
img, video, svg { max-width:100%; height:auto; }
p:has(> img:only-child) { margin-bottom:.6em; } p:has(> img:only-child) + p { font-size:.85em; line-height:1.5; color:var(--paper-muted); }
mark { background:var(--paper-mark); color:inherit; }
hr { border:0; border-top:1px solid var(--paper-rule); margin:2em 0; }
</style>
CSS
}

render_md() { # render every .md under <dir> to a sibling .html; .md links become .html
  command -v pandoc >/dev/null || return 0
  local filter="$root/md-links.lua" style="$root/md-style.html" f out katex
  cat >"$filter" <<'LUA'
function Link(el)
  if not el.target:match("^%a+:") then
    el.target = el.target:gsub("%.md$", ".html"):gsub("%.md#", ".html#")
  end
  return el
end
LUA
  write_md_style
  find "$1" -type f -name '*.md' | while IFS= read -r f; do
    out="${f%.md}.html"
    [[ -e $out ]] && continue
    katex=""; grep -q '\$' "$f" && katex="--katex" # KaTeX from the CDN, only for pages with math
    # shellcheck disable=SC2086
    pandoc --quiet -s "$f" -o "$out" --lua-filter "$filter" --include-in-header "$style" \
      --from=markdown-smart-implicit_figures --highlight-style=tango --metadata pagetitle="$(basename "$f" .md)" $katex \
      || echo "share: could not render $f" >&2
  done
}

urlenc() { # urlenc <str>: sets urlenc_out; fork-free byte loop, keeps A-Za-z0-9-_.~ and '/', %XX (uppercase) for the rest
  local LC_ALL=C s="$1" out="" c i n
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    case $c in
      [A-Za-z0-9._~/-]) out+="$c" ;;
      *) printf -v c '%d' "'$c"; printf -v c '%%%02X' $((c & 255)); out+="$c" ;;  # masked: bash 3.2 sign-extends bytes above 127
    esac
  done
  urlenc_out="$out"
}

gen_index() { # gen_index <stage>: a folder with no index of its own gets a generated listing
  [[ -f $1/index.html || -f $1/README.html ]] && return 0
  local files f enc label
  files="$(cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"
  write_md_style
  {
    echo '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>index</title>'
    cat "$root/md-style.html"
    echo '</head><body><ul>'
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      if [[ $f == *.md && -f $1/${f%.md}.html ]]; then continue; fi  # listed by its render below
      urlenc "$f"; enc="$urlenc_out"
      label="$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$f")"
      printf '<li><a href="%s">%s</a></li>\n' "$enc" "$label"
    done <<<"$files"
    echo '</ul></body></html>'
  } >"$1/index.html"
}

stage_out=""   # the stage of the share being built, outside pub; release_locks removes it on a die
stage_copy() { # stage_copy <src> [opts]: the copy into a stage, sets stage_out; regular files only, so dotfiles (.git, .env) and symlinks (to ~/.ssh) never ship
  local parent name stage skipped
  parent="$(dirname "$1")"; name="$(basename "$1")"
  [[ $backend == r2 ]] || mkdir -p "$pub"   # an r2 profile never has a pub/ tree
  stage="$(mktemp -d "$root/.stage.XXXXXX")"
  stage_out="$stage"; trap release_locks EXIT
  (cd "$parent" && find "$name" -name '.*' -prune -o -type f -print | while IFS= read -r f; do
    mkdir -p "$stage/$(dirname "$f")" && cp -p "$f" "$stage/$f"
  done)
  skipped="$(cd "$parent" && find "$name" -name '.*' -prune -o -type l -print | wc -l | tr -d ' ')"
  [[ $skipped -gt 0 ]] && echo "share: skipped $skipped symlink(s)" >&2
  if [[ -z "$(find "$stage" -type f | head -1)" ]]; then
    rm -rf "$stage"; stage_out=""; die "nothing to share in $1 (dotfiles and symlinks are skipped)"
  fi
  render_md "$stage"          # a rendered README.md makes README.html, which suppresses gen_index
  local payload="$stage"      # a folder is listed at its own root; a bare file lists under <id>
  [[ -d $stage/$name ]] && payload="$stage/$name"
  has_opt noindex "${2:-}" || gen_index "$payload"
}
stage_publish() { # stage_publish <id>: the atomic swap of stage_out into pub/<id>; from here the bytes are reachable
  dry_log "PUBLISH $1"   # before the mv, so a watcher can never see pub/ change ahead of this line
  [[ -d $pub/$1 ]] && mv "$pub/$1" "$stage_out.old"
  mv "$stage_out" "$pub/$1"
  rm -rf "$stage_out.old"
  stage_out=""
}

warn_private() { # a share out of a private GitHub repo is almost always a mistake
  command -v gh >/dev/null || return 0
  local d="$1" top repo
  [[ -d $d ]] || d="$(dirname "$d")"
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
  repo="$(git -C "$top" remote get-url origin 2>/dev/null)" || return 0
  repo="$(sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##' <<<"$repo")"
  [[ $repo == */* && $repo != *:* ]] || return 0
  if [[ "$(gh repo view "$repo" --json isPrivate -q .isPrivate 2>/dev/null)" == true ]]; then
    echo "share: WARNING: this comes from the PRIVATE repo $repo and is now public to anyone with the link ($me rm $2 to undo)" >&2
  fi
}

parse_target() { # parse_target <arg>: "live <port>" for a port/localhost shape, "snapshot" for a path
  local p=""
  case $1 in
    http://localhost:*|http://127.0.0.1:*) p="${1#http://*:}"; p="${p%/}" ;;
    localhost:*|127.0.0.1:*) p="${1#*:}" ;;
    *[!0-9]*|""|?|??????*) [[ -e $1 ]] && { echo snapshot; return 0; }; return 1 ;;
    *) p="$1" ;;   # two to five digits: a bare port, never a path
  esac
  case $p in *[!0-9]*|"") return 1 ;; esac
  echo "live $p"
}

cmd_add() {
  migrated_guard
  local add_argv=("$@")   # the journal's rerun line
  local ttl="${SHARE_TTL:-$(cfg ttl || true)}"; ttl="${ttl:-30d}" noindex="" host_fqdn="" target="" ntargets=0 access="" storage=""
  local usage="usage: share add [--ttl 7d] [--host <name>.<zone>] [--no-index] [--access <rule>] [--cloud|--local] <file|dir|port|localhost:port|http://localhost:port>"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --ttl) ttl="${2:-}"; shift 2 || die "$usage" ;;
      --host) host_fqdn="${2:-}"; shift 2 || die "$usage" ;;
      --access) access="${2:-}"; shift 2 || die "$usage"; [[ -n $access ]] || die "$access_usage" ;;
      --no-index) noindex=1; shift ;;
      --cloud|--local) [[ -z $storage || $storage == "${1#--}" ]] || die "$usage"; storage="${1#--}"; shift ;;
      --*) die "$usage" ;;
      *) target="$1"; ntargets=$((ntargets + 1)); shift ;;
    esac
  done
  [[ $ntargets == 1 ]] || die "$usage"
  if [[ $role == member ]]; then   # a member machine (R7): snapshots on this machine (v:3) or --cloud; every refusal before any write
    [[ -z $access ]] || die "gated links are added by the admin of $host_name; nothing was published"
    [[ -z $host_fqdn ]] || die "--host needs DNS and an ingress rule, which members do not hold; nothing was published"
    [[ "$(parse_target "$target" 2>/dev/null || true)" == snapshot ]] || die "a member shares files and folders; live port shares stay on the origin; nothing was published"
    [[ -n $storage ]] || storage=local   # storage_default is the origin's knob, never a member's
    member_add_check
  fi
  if [[ $backend != r2 && ( $r2on == 1 || -n $storage ) ]]; then   # the storage of this link, settled before any write
    local pt0; pt0="$(parse_target "$target")" || die "$usage"
    if [[ $storage == cloud ]]; then
      [[ -z $host_fqdn && $pt0 == snapshot ]] || die "--cloud: live links and --host stay on the origin's tunnel"
      [[ $r2on == 1 ]] || die "R2 is off for ${host_name:-this profile}; the tenant admin enables it with '$me setup ${host_name:-<hostname>} --r2 --bucket <name>'"
    elif [[ $role == member && $storage == local ]]; then :
    elif [[ -z $storage && $r2on == 1 && -z $host_fqdn && $pt0 == snapshot ]]; then
      storage="$(cfg storage_default || true)"; storage="${storage:-local}"
      [[ $storage == local || $storage == cloud ]] || die "storage_default=$storage in $config is not local or cloud"
    fi
  elif [[ $backend == r2 && $storage == local ]]; then
    die "$host_name serves local links from its origin; this machine publishes cloud links only"
  fi
  [[ -z $host_fqdn || $mode != quick ]] || die "--host needs a named tunnel: '$me teardown', then '$me setup <hostname>'"
  if [[ -n $access ]]; then   # every refusal before any write
    access_parse "$access"
    [[ $mode != quick ]] || access_named_only
    [[ ${SHARE_ACCESS_DRY:-0} != 1 || $tunnel == 0 ]] || die "SHARE_ACCESS_DRY=1 is a test seam for SHARE_TUNNEL=0 only; nothing was published"
  fi
  local pt kind tport="" src name id exp=0 url opts="" secs
  pt="$(parse_target "$target")" || die "$usage"
  if [[ $backend == r2 || $storage == cloud ]]; then   # every r2 refusal before any write; a cloud add on an origin runs the same path
    [[ $pt == snapshot && -z $host_fqdn ]] || die "live shares and --host need a tunnel profile; this profile serves from R2"
    need_host
    cmd_add_r2 "$(ttl_secs "$ttl")" "$noindex" "$target" "$access"
    return
  fi
  if [[ $pt == snapshot ]]; then
    kind=snapshot
  else
    kind=live; tport="${pt#live }"
    [[ $tport -ge 1024 ]] || die "$tport is below 1024; a share of a system service is never a dev server"
    [[ $tport -le 65535 ]] || die "$tport is above 65535; no such port"
    [[ $tport != "$port" ]] || die "$tport is this share server's own port"
    [[ $tport != "$metrics_port" ]] || die "$tport is the tunnel metrics port"
    ! port_claimed "$tport" || die "$tport belongs to another share profile (share profiles)"
  fi
  need_host
  secs="$(ttl_secs "$ttl")"
  if [[ $kind == live ]]; then
    name="localhost:$tport"; src="http://127.0.0.1:$tport"; opts="live"
  else
    src="$(realpath "$target")"; name="$(basename "$src")"
    case $src in *$'\t'*|*$'\n'*) die "paths with tabs or newlines are not supported" ;; esac
    case $name in *[{}\"\\]*) die "names with { } \" or \\ are not supported" ;; esac
  fi
  [[ -n $noindex ]] && opts="${opts:+$opts }noindex"
  if [[ -n $access ]]; then   # token, scopes, group: all settled before the copy, before host_check, and before any Cloudflare write
    mk_root
    access_prepare
  fi
  if [[ -n $host_fqdn ]]; then
    host_check "$host_fqdn"
    opts="${opts:+$opts }host=$host_fqdn"
  fi
  if [[ $r2on == 1 ]]; then r2_token_check; fi   # R2 on: a local link needs its pointer, so no token means nothing is written
  id="$(rand_id)"
  [[ $secs -gt 0 ]] && exp=$(($(date +%s) + secs))
  mk_root; mkdir -p "$pub"
  # stage the payload before any Cloudflare write: a copy failure must not orphan DNS, ingress, or an Access app
  if [[ $kind == live ]]; then
    echo "share: live share: anyone with the link reaches 127.0.0.1:$tport while this machine is awake" >&2
    [[ -z $host_fqdn && $mode != quick ]] && echo "share: apps that use absolute asset paths (/static/...) break under a path prefix; use --host <name>.<zone>" >&2
    curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$tport/" || echo "share: nothing answers on 127.0.0.1:$tport yet" >&2
  else
    stage_copy "$src" "$opts"
  fi
  # the add journals with --concurrent (two adds may overlap): a dead one is finished or rolled back by the next bare prune (G9)
  op_id_json="$(jq -nc --arg i "$id" '$i')"
  op_begin add --concurrent add ${add_argv[@]+"${add_argv[@]}"}
  op_step 1
  # R2 on: the pointer reserves the id in the bucket before any byte is served and before the Access app; a 412 takes a fresh id
  if [[ $r2on == 1 ]]; then
    r2_pointer_put "$kind" "$name" "$src" "$exp" "$opts" "$access"
    op_id_json="$(jq -nc --arg i "$id" '$i')"; op_write   # a 412 moved the id
  fi
  op_step 2
  # a gated copy stays outside pub until the gate is observed; warn_private says "public to anyone with the link", which a gated link is not
  if [[ $kind == snapshot && -z $access ]]; then stage_publish "$id"; warn_private "$src" "$id"; fi
  op_step 3
  if [[ -n $access ]]; then
    access_create "$id" "$host_fqdn"   # intent line, the app, its id into the line, read-back
    opts="${opts:+$opts }access=$access_app access_rule=$access_rule"
  fi
  op_step 4
  [[ -n $host_fqdn ]] && { host_add "$host_fqdn"; held_fqdn="$host_fqdn"; }
  op_step 5
  if [[ -n $access ]] && ! access_gate "$id" "$access_aud" "$host_fqdn"; then
    local left=""
    [[ -n $host_fqdn ]] && { held_fqdn=""; host_rm "$host_fqdn"; }
    if access_delete "$access_app" "$id"; then lock_take index; pending_drop "$id" "$access_app"; lock_release index; held_access_id=""
    else left="; the app stays in access-pending for the next '$me prune' with the token"; fi
    op_done   # the add undid what it made: nothing is left for a prune to finish
    die "Cloudflare Access did not enforce on $host_name/$id within ${access_wait}s; nothing was published$left; rerun the same $me add (Access can take several minutes on a new app)"
  fi
  op_step 6
  lock_take index   # publish: row, render, reload as one step, so no writer's row or render is lost
  if [[ -n $access ]]; then
    # only while this process's exact pending line is still there: a sweep that claimed it may have deleted the app
    pending_has "$id" "$access_app" || { lock_release index; die "the Access app of $id was claimed by a sweep during the wait; nothing was published; rerun the same $me add"; }
    [[ $kind == snapshot ]] && stage_publish "$id"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$src" "$(date +%F)" "$exp" "$opts" >>"$index"
  write_caddyfile
  caddy_reload || true   # the row stays: the next reload or serve restart renders it
  [[ -n $access ]] && pending_drop "$id" "$access_app"
  held_fqdn="" held_access_id=""
  lock_release index   # before cmd_start: serve's startup render takes the lock itself
  [[ $r2on == 0 ]] || lock_release "add-$id"
  op_done   # the row is in: nothing for a prune to finish
  share_url "$id" "$name" "$opts"
  url="$share_url_out"
  [[ -z $access ]] || access_link_check "$url" || access_link_die "$id" "$url"   # Access answers at the edge, so a stopped origin does not matter here
  echo "$url"
  if [[ ${SHARE_CLIPBOARD:-1} == 1 ]] && command -v pbcopy >/dev/null; then
    printf '%s' "$url" | pbcopy && echo "  (link copied)"
  fi
  if ! running; then
    if host_ok; then cmd_start; else echo "  (not serving: $(this_host) is not in hosts=$hosts)"; fi
  fi
}

cmd_ls() {
  access_pending_note
  [[ -s $index || $backend == r2 || $r2on == 1 ]] || { echo "no shares"; return 0; }
  local id name src date exp opts storage t by origin lstate lwhy size until gone tag acc stcol us=$'\x1f'
  list_rows ls
  if [[ -z $list_out && ( $backend == r2 || $r2on == 1 ) ]]; then
    [[ -z $list_cloud_error ]] || echo "share: cloud links not listed: $list_cloud_error" >&2
    echo "no shares"; return 0
  fi
  while IFS=$us read -r id name src date exp opts storage t by origin lstate lwhy; do
    [[ -n $id ]] || continue
    stcol=""; [[ ${lstate:-live} == live ]] || stcol="  state=$lstate${lwhy:+ ($lwhy)}"   # a STATE column only when the row is not live
    until="never"; [[ ${exp:-0} -gt 0 ]] && until="$(day_of "$exp")"
    share_url "$id" "$name" "$opts"
    tag=$storage; [[ $storage == machine ]] && has_opt live "$opts" && tag=live
    printf '%-7s  %-8s  by=%s  %s\n' "$tag" "$t" "$by" "$share_url_out"
    if [[ $storage == cloud ]]; then
      echo "    id=$id  added=$date  expires=$until$(access_col "$opts")  by=$by  from=$src$stcol"
    elif [[ -n $origin ]]; then   # a member's machine link (v:3), read from its pointer
      origin="${origin#m-}"; origin="${origin%-*}"
      echo "    id=$id  added=$date  expires=$until  origin=$origin  served by $origin's machine$stcol"
    elif [[ $backend == r2 ]]; then   # a member: the origin's link, read from its pointer
      acc=""; has_opt gated "$opts" && acc="  access=gated"
      echo "    id=$id  added=$date  expires=$until$acc  served by the tenant's origin$stcol"
    elif has_opt live "$opts"; then
      echo "    id=$id  live -> $src  added=$date  expires=$until$(access_col "$opts")$stcol"
    else
      size="$(du -sh "$pub/$id" 2>/dev/null | cut -f1 | tr -d ' ')"
      gone=""; [[ -e $src ]] || gone="  (source gone, snapshot still served)"
      echo "    id=$id  size=${size:-?}  added=$date  expires=$until$(access_col "$opts")  from=$src$gone$stcol"
    fi
  done <<<"$list_out"   # a 5-field row (v0.1.x) reads with opts empty; malformed rows and records are skipped
  [[ -z $list_cloud_error ]] || echo "share: cloud links not listed: $list_cloud_error" >&2
  access_ls_check
}
state_lines() { # state_lines: list_out as the tab lines cmd_state's jq reads (id name url kind own_host expires access storage type by origin), this machine's rows newest first, then the bucket's
  local id name src date exp opts storage t by origin lstate lwhy kind oh rule line mine=() rest=() i us=$'\x1f'
  while IFS=$us read -r id name src date exp opts storage t by origin lstate lwhy; do
    [[ -n $id ]] || continue
    kind="snapshot"; has_opt live "$opts" && [[ $storage == machine ]] && kind="live"
    optv host "$opts"; oh=$optv_out
    [[ $storage == cloud ]] && oh=""
    optv access_rule "$opts"; rule=$optv_out
    [[ $storage == machine && $backend == r2 ]] && { rule=""; has_opt gated "$opts" && rule="gated"; }   # a pointer carries the flag, never the rule
    share_url "$id" "$name" "$opts"
    printf -v line '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$name" "$share_url_out" "$kind" "$oh" "${exp:-0}" "$rule" "$storage" "$t" "$by" "$origin" "${lstate:-live}" "$lwhy"
    if [[ $storage == machine && $backend != r2 && -z $origin ]]; then mine+=("$line"); else rest+=("$line"); fi
  done <<<"$list_out"
  for ((i = ${#mine[@]} - 1; i >= 0; i--)); do printf '%s\n' "${mine[i]}"; done
  [[ ${#rest[@]} == 0 ]] || printf '%s\n' "${rest[@]}"
}
access_col() { local r; r="$(opt_val access_rule "$1" || true)"; [[ -n $r ]] && printf '  access=%s' "$r"; return 0; }

cmd_refresh() {
  [[ $backend != r2 ]] || { cmd_refresh_r2 "$@"; return; }
  if [[ $r2on == 1 && -z "$(row "${1:-}")" ]]; then cmd_refresh_r2 "$@"; return; fi   # an origin with R2 on: an id with no local row is a cloud link
  local r src opts
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  if has_opt live "$opts"; then echo "live share, nothing to refresh" >&2; return 0; fi
  src="$(cut -f3 <<<"$r")"
  optv by "$opts"   # a row import moved here keeps <by>:<src>; that path is on the old origin
  [[ -z $optv_out || $optv_out == "$(r2_by)" || $src != "$optv_out:"* ]] || die "$1 was moved from $optv_out; re-add it from a source on this machine"
  [[ -e $src ]] || die "source is gone: $src (the snapshot keeps serving; $me rm $1 to unpublish)"
  stage_copy "$src" "$opts"   # the slow copy runs outside the lock; the swap into pub waits for it
  lock_take index
  # a concurrent rm may have dropped the row while the copy ran; the trap trashes the stage on this die
  [[ -n "$(row "$1")" ]] || { lock_release index; die "$1 was removed during refresh"; }
  stage_publish "$1"
  write_caddyfile   # a refresh can add or remove index.html, which flips try_files
  caddy_reload || true
  lock_release index
  echo "refreshed $1 from $src"
}

cmd_rm() { # cmd_rm <id> [prune]: prune passes through with no credential, so expiry is never blocked (DEC-016)
  [[ $backend != r2 ]] || { cmd_rm_r2 "$@"; return; }
  if [[ $r2on == 1 && -z "$(row "${1:-}")" ]]; then cmd_rm_r2 "$@"; return; fi   # an origin with R2 on: an id with no local row is a cloud link
  local r opts fqdn="" app="" tmp reloaded=1
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  fqdn="$(opt_val host "$opts" || true)"
  app="$(opt_val access "$opts" || true)"
  if [[ ${SHARE_HOST_DRY:-0} != 1 && -n $fqdn && ${2:-} != prune && -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
    die "no Cloudflare credential for $fqdn; set CLOUDFLARE_API_TOKEN or run $me setup --login, then rm again"
  fi
  if [[ -n $app ]]; then
    # the gate goes last: bytes first, row, then the app. rm needs the token before any change; prune defers the app
    [[ ${2:-} == prune ]] || { api_token_resolve; [[ -n $api_token ]] || { access_no_token >&2; exit 1; }; }
    if [[ -n $api_token ]]; then   # prune never dies on a token for another account: the app waits for a later prune
      if [[ ${2:-} == prune ]]; then access_account soft || api_token=""; else access_account; fi
      [[ -z $api_token ]] || access_sweep
    fi
    lock_take index; pending_has_id "$1" || pending_add "$1" "$app" "" "${api_token:+$$}"; lock_release index
  fi
  [[ -n $fqdn ]] && host_rm "$fqdn"
  lock_take index
  # the copy goes first: a killed rm leaves a row with nothing served, never content with no row
  [[ -d $pub/$1 ]] && to_trash "$pub/$1"
  tmp="$(mktemp "$root/.index.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$index" >"$tmp" && mv -f "$tmp" "$index"
  write_caddyfile
  caddy_reload || reloaded=0
  lock_release index
  echo "unpublished $1"
  if [[ ${2:-} == prune ]]; then r2_pointer_drop "$1" "${prune_mode:-soft}"; else r2_pointer_drop "$1" soft; fi
  [[ -n $app ]] || return 0
  if [[ $reloaded == 0 ]] && has_opt live "$opts"; then   # the running Caddy still proxies /<id>/*: the app is the only gate left
    die "Caddy did not reload, so the live route for $1 may still answer; its Access app stays in access-pending; fix Caddy (see $root/caddy.log), then: $me prune"
  elif [[ -z $api_token ]]; then
    echo "share: Access app for $1 awaits deletion; run '$me prune' with a token (the stored one, or CLOUDFLARE_API_TOKEN)" >&2
  elif access_delete "$app" "$1"; then
    lock_take index; pending_drop_id "$1" "$app"; lock_release index
  else
    die "could not delete the Access app for $1 (HTTP $cf_code, or the app is not this share's, see above); it stays in access-pending for the next '$me prune' with the token"
  fi
}

cmd_prune() { # cmd_prune [quiet|listing]: unpublish every share past its expiry; sweep waiting Access apps when a token resolves
  [[ -n ${1:-} || -z ${SHARE_PRUNE_DIE_CODE:-} ]] || die_code "$SHARE_PRUNE_DIE_CODE" "prune died (the SHARE_PRUNE_DIE_CODE test seam; bare prune only, as serve's hourly loop runs it)"
  if [[ $backend == r2 ]]; then r2_prune "${1:-}"; return 0; fi
  if [[ $r2on == 1 && ${1:-} != quiet ]]; then   # an origin with R2 on, interactive: cloud expiry, the sweep, and the reconcile through its own reader
    local pm=soft; [[ ${1:-} != listing ]] || pm="env"
    if r2_token_ok "$pm"; then ( r2_prune "${1:-}"; r2_reconcile ) || echo "share: the cloud links of $host_name were not checked (see above); local links were" >&2
    elif [[ -z ${1:-} ]]; then echo "share: the cloud links and pointers of $host_name were not checked: no publisher token ($me api-token)" >&2; fi
  fi
  # quiet (serve, status): no token from any source, so neither touches Access; an expired gated share defers its
  # app. listing (ls): only an exported CLOUDFLARE_API_TOKEN, never api_token_cmd or the Keychain, so a listing
  # never runs `op read`. bare (the prune verb): the full resolver, soft on a failing api_token_cmd. A token for another
  # account warns and skips the sweep in every mode: expiry is never blocked.
  case ${1:-} in
    quiet) api_token="" prune_mode="off" ;;
    listing) api_token_resolve env; prune_mode="env" ;;
    *) api_token_resolve soft; prune_mode="soft" ;;
  esac
  if [[ -n $api_token && -s $pending && -n $host_name ]]; then
    access_account soft && access_sweep
  fi
  [[ -n ${1:-} ]] || add_sweep   # the prune verb and serve's hourly loop: a dead add is finished or rolled back
  [[ -s $index ]] || return 0
  local now ids id
  now="$(date +%s)"
  # a for loop, not `| while`: bash 5.3 skips the EXIT trap of a lock taken in a while-loop subshell
  ids="$(rows | awk -F'\t' -v now="$now" '$5 > 0 && $5 < now {print $1}')"
  for id in $ids; do
    cmd_rm "$id" prune | sed 's/$/ (expired)/' || true   # a listing never dies on one row
  done
}

add_sweep() { # a dead add's journal: with its row in the index the add finished (the file goes); with no row the add stopped part way (its copy goes to the Trash, its pointer is dropped; Access lines stay for access_sweep)
  local f id
  for f in "$root/ops/add."*.json; do
    [[ -e $f ]] || continue
    if op_read "$f"; then owner_live "$op_r_pid" "$op_r_start" && continue   # a live add is still working
    elif jq -e '(.v // 0) > 1' "$f" >/dev/null 2>&1; then continue; fi   # a newer CLI's journal is its own to read
    id=""
    lock_take ops
    if [[ -e $f ]]; then   # still there: no other prune took it
      id="$(jq -r '.id // empty' "$f" 2>/dev/null || true)"
      rm -f "$f"
    fi
    lock_release ops
    [[ $id =~ ^[0-9a-f]{6}$ ]] || continue
    [[ -z "$(row "$id")" ]] || continue
    if [[ -e $pub/$id ]]; then to_trash "$pub/$id"; echo "rolled back the add of $id that stopped part way (its copy is in the Trash)"; fi
    [[ $r2on == 0 ]] || r2_pointer_drop "$id" "${prune_mode:-soft}"
  done
  return 0
}

cmd_hits() {
  [[ $backend != r2 ]] || { cmd_hits_r2 "$@"; return; }
  if [[ $r2on == 1 && -z "$(row "${1:-}")" ]]; then cmd_hits_r2 "$@"; return; fi   # an origin with R2 on: an id with no local row is a cloud link
  local r opts fqdn="" log="$root/access.log"
  r="$(row "${1:-}")"; [[ -n $r ]] || die "no share with id '${1:-}'"
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  fqdn="$(opt_val host "$opts" || true)"
  [[ -s $log ]] || { echo "0 hits"; return 0; }
  jq -rn --arg p "/$1/" --arg h "$fqdn" '
    def n($k; $w): "\($k) \($w)\(if $k == 1 then "" else "s" end)";
    [inputs | select((if $h == "" then (.request.uri | startswith($p)) else .request.host == $h end) and .status < 400)] as $h
    | n($h | length; "hit") + ", "
      + n($h | map(.request.headers["Cf-Connecting-Ip"][0] // .request.remote_ip) | unique | length; "visitor")
      + (if ($h | length) > 0 then ", last \($h[-1].ts | floor | strflocaltime("%F %H:%M"))" else "" end)' "$log"
}

# --- import (the receiving side of migrate) ---

iusage="usage: share import --probe | share import <id> <expires> <by> <added> <b64 name> <b64 src> <b64 opts> [<files>:<sha256>]   (a tar on stdin)"
b64dec() { # b64dec <b64>: the bytes into b64_out; 1 on a non-base64 string. A decoded control byte is refused by the caller
  [[ $1 =~ ^[A-Za-z0-9+/]*={0,2}$ ]] || return 1
  b64_out="$(printf '%s' "$1" | base64 -d 2>/dev/null || printf '%s' "$1" | base64 -D 2>/dev/null)" || return 1
}
import_manifest() { # import_manifest <dir>: "<file count>:<sha256 of each file's sha256 and path, sorted>"; migrate sends the same digest of pub/<id>
  local n sum
  n="$( (cd "$1" && find . -type f) | grep -c . || true)"
  sum="$(cd "$1" && find . -type f -print | LC_ALL=C sort | while IFS= read -r f; do shasum -a 256 "$f"; done | shasum -a 256 | cut -d' ' -f1)"
  echo "$n:$sum"
}
import_scan() { # import_scan <tar>: every member a plain file or directory under a relative path with no .. and no dotfile; measured on bsdtar 3.5 and GNU tar 1.35
  local names modes nn nm line p seg
  names="$(tar -tf "$1" 2>/dev/null)" || die "import: stdin is not a tar archive; nothing was published"
  modes="$(tar -tvf "$1" 2>/dev/null)" || die "import: stdin is not a tar archive; nothing was published"
  nn="$(grep -c . <<<"$names" || true)"; nm="$(grep -c . <<<"$modes" || true)"
  [[ $nn -gt 0 && $nn == "$nm" ]] || die "import: the archive listing does not parse (a name with a newline?); nothing was published"
  while IFS= read -r line; do   # -tv: the type is the first mode character; a hardlink shows "link to", a symlink "->"
    case $line in [-d]*) ;; *) die "import: the archive holds a member that is not a file or a directory ($line); nothing was published" ;; esac
    case $line in *" link to "*|*" -> "*) die "import: the archive holds a link ($line); nothing was published" ;; esac
  done <<<"$modes"
  while IFS= read -r p; do
    [[ $p != /* ]] || die "import: the archive holds an absolute path ($p); nothing was published"
    p="${p#./}"; p="${p%/}"
    [[ -n $p && $p != . ]] || continue
    while IFS= read -r -d / seg || [[ -n $seg ]]; do
      [[ $seg != .. ]] || die "import: the archive holds a .. path ($p); nothing was published"
      [[ $seg != .* ]] || die "import: the archive holds a dotfile ($p); share never publishes one; nothing was published"
    done < <(printf '%s' "$p")
  done <<<"$names"
}
cmd_import() { # cmd_import --probe | <args> (iusage): one share moved here by migrate, its tar on stdin; validates, stages, publishes; never creates an Access app
  if [[ ${1:-} == --probe ]]; then [[ $# == 1 ]] || die "$iusage"; echo "share-import 1"; return 0; fi
  [[ $# == 7 || $# == 8 ]] || die "$iusage"
  local id=$1 exp=$2 by=$3 added=$4 man=${8:-} name src opts w max="${SHARE_IMPORT_MAX_BYTES:-2147483648}" size stage got xflags
  [[ $backend != r2 && $r2on == 0 ]] || die "import moves links into a tunnel profile with R2 off; $me reads a bucket"
  [[ $id =~ ^[0-9a-f]{6}$ ]] || die "import: bad id '$id'"
  [[ $exp =~ ^[0-9]{1,11}$ ]] || die "import: bad expiry for $id"
  [[ $added =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "import: bad added date for $id"
  [[ $by =~ ^[a-z0-9.-]+$ ]] || die "import: bad by for $id"
  [[ -z $man || $man =~ ^[0-9]+:[0-9a-f]{64}$ ]] || die "import: bad manifest for $id"
  b64dec "$5" || die "import: the name of $id is not base64"; name=$b64_out
  b64dec "$6" || die "import: the source of $id is not base64"; src=$b64_out
  b64dec "$7" || die "import: the opts of $id are not base64"; opts=$b64_out
  [[ -n $name && $name != .* && $name != */* && $name != *[[:cntrl:]]* ]] || die "import: bad name for $id (empty, a dotfile, a /, or a control byte)"
  [[ $src != *[[:cntrl:]]* ]] || die "import: the source path of $id holds a control byte"
  for w in $opts; do   # a live or host= row never arrives: migrate moves snapshots only
    case $w in noindex|access=*|access_rule=*) ;; *) die "import: opt '$w' of $id is not one import takes (noindex, access=, access_rule=)" ;; esac
  done
  opts="${opts:+$opts }by=$by"
  mk_root; mkdir -p "$pub"
  local rowf; rowf="$(mktemp "$root/.import-row.XXXXXX")"   # rows_in reads a regular file only
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$by:$src" "$added" "$exp" "$opts" >"$rowf"
  [[ -n "$(rows_in "$rowf" "$backend")" ]] || { rm -f "$rowf"; die "import: the row for $id does not pass the index check (an access= without its rule?)"; }
  rm -f "$rowf"
  if [[ -n "$(awk -F'\t' -v id="$id" '$1 == id' "$index" 2>/dev/null)" || -e $pub/$id ]] || pending_has_id "$id"; then die "import: $id is already here; nothing was published"; fi
  import_spool="$(mktemp "$root/.import.XXXXXX")"; trap release_locks EXIT
  head -c $((max + 1)) >"$import_spool"
  size="$(wc -c <"$import_spool" | tr -d ' ')"
  [[ $size -le $max ]] || die "import: $id is over $max bytes (SHARE_IMPORT_MAX_BYTES); nothing was published"
  import_scan "$import_spool"
  # no owner, mode bits, xattrs, ACLs, or file flags from the archive
  if tar --version 2>/dev/null | grep -q 'GNU tar'; then xflags=(--no-same-owner --no-same-permissions --no-xattrs --no-acls --no-selinux)
  else xflags=(--no-same-owner --no-same-permissions --no-xattrs --no-acls --no-fflags --no-mac-metadata); fi
  stage="$(mktemp -d "$root/.stage.XXXXXX")"; stage_out=$stage
  tar -x "${xflags[@]}" -C "$stage" -f "$import_spool" 2>/dev/null || die "import: extracting $id failed; nothing was published"
  rm -f "$import_spool"; import_spool=""
  [[ -z "$(find "$stage" ! -type f ! -type d)" && -z "$(find "$stage" -type f -links +1)" ]] || die "import: $id extracted something besides plain files and directories; nothing was published"
  [[ -e $stage/$name ]] || die "import: the archive of $id does not hold $name at its root; nothing was published"
  if [[ -n $man ]]; then
    got="$(import_manifest "$stage")"
    [[ $got == "$man" ]] || die "import: $id arrived as $got, not $man (a truncated copy?); nothing was published"
  fi
  lock_take index
  [[ -z "$(awk -F'\t' -v id="$id" '$1 == id' "$index" 2>/dev/null)" && ! -e $pub/$id ]] || { lock_release index; die "import: $id appeared during the import; nothing was published"; }
  stage_publish "$id"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$by:$src" "$added" "$exp" "$opts" >>"$index"
  if running; then write_caddyfile; caddy_reload || true; fi   # a stopped or not set up profile renders at its next start
  lock_release index
  echo "imported $id"
}

# --- migrate (the sending side; import above is the receiving side) ---

musage="usage: share migrate --to <ssh-target> [--remote-profile <name>] [--remote-bin <path>] [--max-bytes <n>] [--yes]"
b64enc() { printf '%s' "$1" | base64 | tr -d '\n'; }   # the counterpart of b64dec: never the multi-line default GNU base64 gives
migrate_target=""   # the --to value; read by migrate_remote_run, never by anything else

migrate_script() { # migrate_script <bindir> <maxbytes>: the fixed remote wrapper source; no quote or backslash, so the base64 round trip loses nothing
  local bindir="${1:-}" max="${2:-}"
  printf 'export PATH=%s/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin\n' "${bindir:+$bindir:}"
  [[ -n $max ]] && printf 'export SHARE_IMPORT_MAX_BYTES=%s\n' "$max"
  # ssh joins argv with spaces for the remote shell to reparse, so a zero-length argument (base64 of empty opts)
  # would vanish and shift every argument after it; the sender replaces "" with this sentinel, undone here.
  # shellcheck disable=SC2016 # literal source for the decoded remote script, not this shell's own expansion
  printf 'a=(); for x in "$@"; do [ "$x" = "__share_empty_arg__" ] && x=""; a+=("$x"); done\n'
  # shellcheck disable=SC2016
  printf 'exec share "${a[@]}"\n'
}
mr_out="" mr_code=0
migrate_remote_run() { # migrate_remote_run <bindir> <maxbytes> <rprofile> <arg>...: the fixed base64 template over ssh, or SHARE_MIGRATE_SSH; forwards this call's own stdin
  local bindir="$1" max="$2" rprofile="$3" b64 sshcmd a; shift 3
  b64="$(migrate_script "$bindir" "$max" | base64 | tr -d '\n')"
  local rargs=()
  [[ -z $rprofile || $rprofile == default ]] || rargs=(--profile "$rprofile")
  for a in "$@"; do rargs+=("${a:-__share_empty_arg__}"); done
  if [[ -n ${SHARE_MIGRATE_SSH:-} ]]; then sshcmd="$SHARE_MIGRATE_SSH"; else sshcmd="ssh -o BatchMode=yes $migrate_target"; fi
  # shellcheck disable=SC2086 # sshcmd is a fixed word list (ssh plus its flags), never a single string needing quotes
  # the argv element below must CONTAIN literal " characters around $(...): ssh joins argv with spaces and the remote
  # login shell reparses the joined string, so an unquoted $(...) would word-split the decoded script on its own newlines
  mr_out="$($sshcmd /bin/bash -c "\"\$(printf %s $b64 | base64 -D 2>/dev/null || printf %s $b64 | base64 -d)\"" share-migrate "${rargs[@]}")"
  mr_code=$?
  return "$mr_code"   # the line above is an assignment, always 0 on its own; every caller of "|| rc=$?" needs this function's OWN exit status to be the real one
}
migrate_remote() { migrate_remote_run "$@" </dev/null; }   # every call except the tar copy and the token switch: no stdin to forward

migrate_keychain_check() { # a throwaway Keychain round trip (a random probe value, never a real secret, so plain argv is fine here, unlike token_store); synchronous, same as every other Keychain call in this file (token_store, api_token): a locked Keychain's GUI prompt is the operator's to answer, in the GUI session migrate runs in
  command -v security >/dev/null || { echo 1; return; }
  local k="share-migrate-check.$$" v="probe-$RANDOM-$RANDOM" got=""
  security add-generic-password -U -a share -s "$k" -w "$v" >/dev/null 2>&1 || { echo 0; return; }
  got="$(security find-generic-password -a share -s "$k" -w 2>/dev/null)"
  security delete-generic-password -a share -s "$k" >/dev/null 2>&1
  [[ $got == "$v" ]] && echo 1 || echo 0
}
cmd_migrate_probe() { # one line for the sender's preflight: state, host, pub emptiness, port freedom, Keychain and launchctl
  local st pempty=1 pfree=1 kok lok=1
  if running; then st=serving; elif [[ -n $host_name || $mode == quick ]]; then st=stopped; else st=not_setup; fi
  [[ -z "$(find "$pub" -mindepth 1 -print -quit 2>/dev/null)" ]] || pempty=0
  listening "$port" && pfree=0
  [[ $tunnel == 0 ]] || { listening "$metrics_port" && pfree=0; }
  kok="$(migrate_keychain_check </dev/null)"
  [[ $(uname -s) != Darwin ]] || { launchctl print "gui/$(id -u)" </dev/null >/dev/null 2>&1 || lok=0; }
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$st" "${host_name:--}" "$pempty" "$pfree" "$kok" "$lok"
}
cmd_migrate_index() { [[ -f $index ]] && awk -F'\t' '{print $1"\t"$2"\t"$4}' "$index"; return 0; }
cmd_migrate_tunnel_id() { cfg tunnel_id; }   # read back after the switch, so the sender can refuse to delete a tunnel the new origin now depends on
cmd_migrate_nonce() { # a throwaway probe file only the target holds; the sender polls its URL
  mk_root; mkdir -p "$pub"
  local n; n="_migrate-probe-$(rand_id_raw).txt"
  echo ok >"$pub/$n"
  echo "$n"
}

migrate_row_bytes() { find "$pub/$1" -type f -exec wc -c {} \; 2>/dev/null | awk '{s+=$1} END{print s+0}'; }   # portable: no stat flag differs GNU/BSD
migrate_tar() { # migrate_tar <id>: the whole pub/<id> tree on stdout (a bare file's generated index.html sits beside it at the id root, so the tree is more than <name>); bsdtar (macOS) must drop AppleDouble members or the target's dotfile check refuses them
  if tar --version 2>/dev/null | grep -q 'GNU tar'; then tar -C "$pub/$1" -cf - -- .
  else COPYFILE_DISABLE=1 tar -C "$pub/$1" -cf - --no-mac-metadata --no-xattrs -- .; fi
}

migrate_retire() { # migrate_retire <target_tid> <id>...: index.migrated and migrated/ (nothing deleted), then the teardown path with no Access-app delete and no DNS delete unless it still points here; target_tid is the new origin's own tunnel id, so a collision with this machine's refuses the tunnel and DNS deletes (DEC-010: the new origin always gets its own tunnel, never this one)
  local target_tid="$1"; shift
  local mids=("$@") id midlist=" " line keep
  for id in ${mids[@]+"${mids[@]}"}; do midlist="$midlist$id "; done   # a rerun after the rows moved has no ids: bash 3.2 aborts on a bare empty "${mids[@]}" under set -u
  lock_take index
  mkdir -p "$root/migrated"
  for id in ${mids[@]+"${mids[@]}"}; do
    line="$(awk -F'\t' -v id="$id" '$1 == id' "$index")"
    [[ -n $line ]] || continue
    printf '%s\n' "$line" >>"$root/index.migrated"
    [[ -e $pub/$id ]] && mv "$pub/$id" "$root/migrated/$id"
  done
  keep=""; [[ -s $index ]] && keep="$(awk -F'\t' -v ids="$midlist" '{if (index(ids, " " $1 " ") == 0) print}' "$index")"
  printf '%s\n' "$keep" | sed '/^$/d' >"$index.tmp"; mv -f "$index.tmp" "$index"
  write_caddyfile; caddy_reload || true
  lock_release index
  config_put migrated "migrated=$migrate_target"   # role migrated: state reads not_setup, start and add refuse (DEC-19)
  svc_uninstall
  cmd_stop >/dev/null 2>&1 || true
  op_step 5
  local tid; tid="$(cfg tunnel_id)"
  if [[ -z $target_tid ]]; then   # without the new origin's own tunnel id there is no proof the two tunnels differ
    echo "dns:        left alone; could not read $migrate_target's tunnel id, so deleting the DNS record or this tunnel might take down the new origin"
    echo "tunnel:     not deleted, for the same reason; once $migrate_target is confirmed on its own tunnel, run '$me teardown --yes' here to remove this tunnel"
  elif [[ $target_tid == "$tid" ]]; then
    echo "dns:        left alone; $migrate_target's tunnel id matches this machine's, deleting it would take down the new origin"
    echo "tunnel:     not deleted, for the same reason; clean it up by hand once $migrate_target is confirmed on its own tunnel"
  else
    local rec rid
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r --arg t "$tid.cfargotunnel.com" '.result[] | select(.content == $t) | .id' <<<"$rec" | head -1)"
    if [[ -n $rid ]]; then cf DELETE "/zones/$zone/dns_records/$rid" >/dev/null; echo "dns:        deleted (still pointed at this tunnel)"
    else echo "dns:        $host_name no longer points at this tunnel, left alone"; fi
    op_step 6
    if tunnel_delete "$account" "$tid"; then echo "tunnel:     deleted"; else echo "tunnel:     already deleted"; fi
  fi
  op_step 7
  token_forget; api_token_forget
  rm -f "$config_dir/cert.zone"
  [[ -f $cert ]] && to_trash "$cert"
  return 0   # the line above is a bare test && action; under set -e its own false result must not become this function's (and so cmd_migrate's) exit status
}

cmd_migrate() {
  local to="" rprofile="" rbin="" maxbytes="" yes=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --to) to="${2:-}"; shift 2 ;;
      --remote-profile) rprofile="${2:-}"; shift 2 ;;
      --remote-bin) rbin="${2:-}"; shift 2 ;;
      --max-bytes) maxbytes="${2:-}"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "$musage" ;;
    esac
  done
  [[ -n $to ]] || die "$musage"
  [[ $to != -* ]] || die "migrate: the target must not start with -"
  [[ $to =~ ^[A-Za-z0-9_.@:-]+$ ]] || die "migrate: bad --to target '$to'"
  [[ -z $rprofile || $rprofile == default || $rprofile =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "migrate: bad --remote-profile '$rprofile'"
  [[ -z $rbin || $rbin =~ ^[A-Za-z0-9/_.-]+$ ]] || die "migrate: bad --remote-bin '$rbin'"
  [[ -z $maxbytes || $maxbytes =~ ^[0-9]+$ ]] || die "migrate: bad --max-bytes '$maxbytes'"
  migrate_target="$to"

  need_host
  [[ $mode != quick ]] || die "migrate needs a named tunnel; quick mode has no hostname to move to another machine"
  [[ $role != member ]] || die "a member machine moves by share leave and a new join, never by migrate"
  [[ $tier != t2 ]] || die_code members_present "$host_name has members; migrate is refused; nothing was changed" "$me member ls"
  [[ $backend != r2 && $r2on == 0 ]] || die "R2 is on for $host_name; moving its origin also moves the pointers and the publisher token, which this version does not do"
  host_ok || die "$(this_host) is not $host_name's serving host ($hosts); migrate runs on the origin"
  local hostrow; hostrow="$(rows | awk -F'\t' '$6 ~ /(^| )host=/ {print $1; exit}')"
  if [[ -n $hostrow ]]; then
    local hfqdn; hfqdn="$(opt_val host "$(row "$hostrow" | cut -f6)")"
    die "$hfqdn has its own hostname on this tunnel; remove it first: $me rm $hostrow"
  fi
  admin_token_resolve optional
  [[ -n ${CLOUDFLARE_API_TOKEN:-} ]] || die "migrate needs CLOUDFLARE_API_TOKEN (Cloudflare Tunnel Edit, DNS Edit, Zone Read on $host_name's zone)"
  auth_api
  local zone account _zn; read -r zone account _zn <<<"$(cf_zone)"

  # split the rows: a live link is reported, never moved; everything else (the --host check above already refused) is a snapshot
  local mids=() names=() srcs=() addeds=() exps=() optss=() live_lines="" i
  while IFS=$'\t' read -r id name src added exp opts; do
    if has_opt live "$opts"; then live_lines="$live_lines$id ${src##*:}"$'\n'; continue; fi
    mids+=("$id"); names+=("$name"); srcs+=("$src"); addeds+=("$added"); exps+=("$exp"); optss+=("$opts")
  done < <(rows)
  local max="${maxbytes:-2147483648}" over=""
  for i in "${!mids[@]}"; do [[ $(migrate_row_bytes "${mids[$i]}") -le $max ]] || over="$over ${mids[$i]}"; done
  [[ -z $over ]] || die "migrate: over --max-bytes ($max):$over; pass --max-bytes <n>, or move them by hand first"

  migrate_remote "$rbin" "" "$rprofile" import --probe || true   # a nonzero exit is a refusal to report below, never a reason for set -e to abort here
  [[ $mr_code == 0 && $mr_out == "share-import 1" ]] || die "migrate: $to's share import --probe did not answer 'share-import 1' (got '$mr_out'); check --remote-bin, or upgrade share there"
  migrate_remote "$rbin" "" "$rprofile" migrate-probe || true
  [[ $mr_code == 0 ]] || die "migrate: the preflight check on $to failed"
  local rstate rhost rpempty rpfree rkok rlok
  IFS=$'\t' read -r rstate rhost rpempty rpfree rkok rlok <<<"$mr_out"
  migrate_remote "$rbin" "" "$rprofile" migrate-index || true
  local target_index="$mr_out"
  case $rstate in
    not_setup)
      if [[ $rpempty != 1 ]]; then   # a bare row is a stranger; one matching this run's own ids is a rerun resuming a prior partial copy
        local foreign=""; foreign="$(awk -F'\t' -v ids=" $(printf '%s ' ${mids[@]+"${mids[@]}"})" '{if (index(ids, " " $1 " ") == 0) print $1}' <<<"$target_index")"
        [[ -z $foreign ]] || die "migrate: $to's profile is not_setup but already has shares not in this move ($foreign); pick another --remote-profile"
      fi ;;
    stopped|serving) [[ $rhost == "$host_name" ]] || die "migrate: $to's profile is already set up for $rhost, not $host_name; pick another --remote-profile" ;;
    *) die "migrate: unexpected state '$rstate' on $to" ;;
  esac
  [[ $rpfree == 1 || $rstate == serving ]] || die "migrate: $to's port for this profile is already in use"   # a profile already serving this hostname (an earlier switch that failed) holds its own ports
  [[ $rkok == 1 ]] || die "migrate: $to cannot write and read back a Keychain item for share"
  [[ $rlok == 1 ]] || die "migrate: launchctl print gui/<uid> on $to did not answer; share's login service needs a GUI session there"

  if [[ $yes != 1 ]]; then
    [[ -t 0 ]] || die "rerun '$me migrate --to $to --yes' to confirm"
    local a; read -rp "Move ${#mids[@]} link(s) of $host_name to $to and retire this machine as its origin? [y/N] " a
    [[ $a == y* || $a == Y* ]] || die "aborted"
  fi
  local rerun=(migrate --to "$to")
  [[ -z $rprofile ]] || rerun+=(--remote-profile "$rprofile")
  [[ -z $rbin ]] || rerun+=(--remote-bin "$rbin")
  [[ -z $maxbytes ]] || rerun+=(--max-bytes "$maxbytes")
  op_begin migrate "${rerun[@]}" --yes
  echo "preflight:  ok ($to, $rstate)"

  op_step 1
  for i in "${!mids[@]}"; do
    local id=${mids[$i]} name=${names[$i]} src=${srcs[$i]} added=${addeds[$i]} exp=${exps[$i]} opts=${optss[$i]} rc man by srcbare sendopts tarfile
    if grep -qE "^$id	$name	$added\$" <<<"$target_index"; then echo "copy:       $id already on $to, skipping"; continue; fi
    man="$(import_manifest "$pub/$id")"
    # a row already carried here by an earlier import keeps its true publisher and bare source (by=<x> in opts,
    # src stored as "<x>:<original src>"); import appends its own by=, so that token never rides along a second time
    by="$(opt_val by "$opts" 2>/dev/null || true)"
    if [[ -n $by ]]; then
      srcbare="${src#"$by":}"
      sendopts="$(sed -E 's/(^| )by=[^ ]*//' <<<"$opts")"
    else
      by="$(r2_by)"; srcbare="$src"; sendopts="$opts"
    fi
    # a plain redirect, never a pipe: migrate_remote_run's own mr_out/mr_code would be lost in a pipeline's trailing subshell.
    # "cmd || rc=$?", never a bare statement: a nonzero exit here is this loop's to report, not set -e's to abort on
    tarfile="$(mktemp "$root/.migrate-tar.XXXXXX")"
    migrate_tar "$id" >"$tarfile"
    rc=0
    migrate_remote_run "$rbin" "$maxbytes" "$rprofile" import "$id" "$exp" "$by" "$added" \
      "$(b64enc "$name")" "$(b64enc "$srcbare")" "$(b64enc "$sendopts")" "$man" <"$tarfile" || rc=$?
    rm -f "$tarfile"
    [[ $rc == 0 ]] || die "migrate: copying $id to $to failed: $mr_out"
    echo "copy:       $id -> $to ($mr_out)"
  done
  if [[ -n $live_lines ]]; then
    local lid lport
    while IFS=' ' read -r lid lport; do
      [[ -n $lid ]] && echo "not moved:  live link $lid (port $lport); after the move run '$me add $lport' on the new origin"
    done <<<"$live_lines"
  fi

  local old_tunnel_name; old_tunnel_name="$(cfg tunnel_name)"
  if [[ -z $old_tunnel_name ]]; then   # an older share, or a hand-edited config, can hold tunnel_id with no tunnel_name; read it back by id so the rollback line below is never printed with an empty --tunnel-name
    local old_tunnel_id; old_tunnel_id="$(cfg tunnel_id)"
    [[ -n $old_tunnel_id ]] && old_tunnel_name="$(cf GET "/accounts/$account/cfd_tunnel/$old_tunnel_id" | jq -r '.result.name // empty')"
  fi
  [[ -n $old_tunnel_name ]] || die "migrate: this profile's config has neither tunnel_name nor a tunnel_id the API still knows; run '$me setup $host_name --tunnel-name <name> --force' by hand first"
  local new_tunnel_name="${old_tunnel_name}-m"   # DEC-010: the new origin always gets its own tunnel; a name this machine already holds would reuse its tunnel id, and migrate_retire would later delete the new origin's only tunnel
  local switch_rc=0
  op_step 2
  printf '%s\n' "$CLOUDFLARE_API_TOKEN" | migrate_remote_run "$rbin" "$maxbytes" "$rprofile" setup "$host_name" --tunnel-name "$new_tunnel_name" --force --token-stdin >/dev/null || switch_rc=$?
  if [[ $switch_rc != 0 ]]; then
    die "migrate: the switch on $to failed; this machine may still be serving, or the DNS record may already point at the new tunnel. Rollback if $host_name is down: $me setup $host_name --tunnel-name $old_tunnel_name --force"
  fi
  echo "switch:     $to is the new origin for $host_name"
  op_step 3

  migrate_remote "$rbin" "" "$rprofile" migrate-tunnel-id || true
  local target_tid="$mr_out"
  migrate_remote "$rbin" "" "$rprofile" migrate-nonce || true
  local probe="$mr_out" streak=0 code _
  for _ in $(seq 1 60); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 --doh-url https://1.1.1.1/dns-query "https://$host_name/$probe" 2>/dev/null || \
      curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$host_name/$probe" 2>/dev/null || true)"
    [[ $code == 200 ]] && streak=$((streak + 1)) || streak=0
    [[ $streak -ge 3 ]] && break
    sleep 1
  done
  [[ $streak -ge 3 ]] || die "migrate: verify failed: $to did not answer https://$host_name/$probe three times in a row; nothing moved aside. Rollback if $host_name is down: $me setup $host_name --tunnel-name $old_tunnel_name --force"
  for i in "${!mids[@]}"; do
    local id=${mids[$i]} name=${names[$i]} opts=${optss[$i]} uuid aud
    share_url "$id" "$name" "$opts"
    uuid="$(opt_val access "$opts" || true)"
    if [[ -n $uuid ]]; then
      aud="$(cf GET "/accounts/$account/access/apps/$uuid" | jq -r .result.aud)"
      access_probe_round "$aud" "$share_url_out" || die "migrate: verify failed: the gated link $id does not answer 302 with its app's aud; nothing moved aside"
    else
      code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 --doh-url https://1.1.1.1/dns-query "$share_url_out" 2>/dev/null || \
        curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$share_url_out" 2>/dev/null || true)"
      [[ $code == 200 ]] || die "migrate: verify failed: $id does not answer at $share_url_out (got $code); nothing moved aside"
    fi
  done
  echo "verify:     every moved link answers from $to"

  op_step 4
  migrate_retire "$target_tid" ${mids[@]+"${mids[@]}"}
  op_done
  echo "retire:     $host_name no longer serves from this machine; moved rows in index.migrated, trees in migrated/"
}

# --- serving ---

write_caddyfile() { # rendered from index.tsv; no-store: Cloudflare must not cache past rm or stop
  # only listed rows are served: an unexpired, unrevoked snapshot row gets a handle on /<id> and /<id>/*; every other path answers 404.
  # A revoked row renders nothing; live and --host rows keep today's rule (served until prune drops them)
  local id name src date exp opts fqdn sroot tmp main_site="http://:$port" now
  now="$(date +%s)"
  # named mode: the main site answers its own hostname (and loopback, for local probes) and nothing else;
  # a --host fqdn routed here before its own block exists, or any foreign Host, gets the 404 catch-all
  # instead of the whole pub tree. Quick mode keeps the any-host site: its hostname is unknown at render time.
  [[ $mode == quick || -z $host_name ]] || main_site="http://$host_name:$port, http://127.0.0.1:$port, http://localhost:$port"
  tmp="$(mktemp "$root/.Caddyfile.XXXXXX")"   # rendered aside and moved in: caddy never reads half a file
  {
    cat <<EOF
{
	admin unix//$root/admin.sock
	auto_https off
}
$main_site {
	bind 127.0.0.1
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	header X-Share-Served "caddy"
	log {
		output file "$root/access.log"
		format json
	}
	@encsep expression {http.request.uri}.matches("^[^?]*(?i:%2f|%5c|%2e)")
	handle @encsep {
		respond 400
	}
EOF
    # the encoded-separator reject: the Access edge matches a path app after normalizing, but does not decode %2F or %5C;
    # Caddy would, so /x/..%2F<id>/f reaches pub/<id>/f past the gate. A handle block, because a bare respond sorts after handle.
    if [[ -s $index ]]; then
      while IFS=$'\t' read -r id name src date exp opts; do
        has_opt revoked "$opts" && continue   # revoked by an admin: the bytes stay, nothing serves them
        fqdn="$(opt_val host "$opts" || true)"
        if has_opt live "$opts"; then
          [[ -n $fqdn ]] || printf '\thandle_path /%s/* {\n\t\treverse_proxy http://127.0.0.1:%s\n\t}\n' "$id" "${src##*:}"
        elif [[ ${exp:-0} == 0 ]] || { [[ $exp =~ ^[0-9]+$ ]] && (( 10#$exp > now )); }; then   # a --host snapshot keeps its /<id> path here too, as the whole tree gave it
          printf '\t@s%s path /%s /%s/*\n\thandle @s%s {\n\t\troot * "%s"\n\t\tfile_server {\n\t\t\tindex index.html README.html\n\t\t}\n\t}\n' "$id" "$id" "$id" "$id" "$pub"
        fi
      done < <(rows)
    fi
    # the CLI's own probe files (live_check, migrate's verify) sit at the root of pub/ with no row
    cat <<EOF
	@probe path /_probe-* /_migrate-probe-*
	handle @probe {
		root * "$pub"
		file_server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond "no such link (it may have expired or been removed)" 404
	}
}
EOF
    if [[ -s $index ]]; then
      while IFS=$'\t' read -r id name src date exp opts; do
        has_opt revoked "$opts" && continue
        fqdn="$(opt_val host "$opts" || true)"
        [[ -n $fqdn ]] || continue
        cat <<EOF
http://$fqdn:$port {
	bind 127.0.0.1
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	header X-Share-Served "caddy"
	log {
		output file "$root/access.log"
		format json
	}
EOF
        if has_opt live "$opts"; then
          printf '\treverse_proxy http://127.0.0.1:%s\n' "${src##*:}"
        else
          # folder payloads sit at pub/<id>/<name>; files sit directly under pub/<id>
          sroot="$pub/$id"
          [[ -d $pub/$id/$name ]] && sroot="$pub/$id/$name"
          printf '\troot * "%s"\n' "$sroot"
          [[ -f $sroot/index.html ]] && printf '\ttry_files {path} /index.html\n'
          printf '\tfile_server {\n\t\tindex index.html README.html\n\t}\n'
        fi
        printf '}\n'
      done < <(rows)
    fi
    [[ $main_site == "http://:$port" ]] || printf 'http://:%s {\n\tbind 127.0.0.1\n\theader X-Share-Served "caddy"\n\trespond 404\n}\n' "$port"
  } >"$tmp"
  mv -f "$tmp" "$root/Caddyfile"
}

caddy_reload() { # apply Caddyfile changes over the admin socket; a failure warns and returns 1, never kills
  dry_log RELOAD
  running || return 0
  local err
  if ! err="$(caddy reload --config "$root/Caddyfile" --adapter caddyfile 2>&1)"; then
    echo "share: caddy reload failed: $err; see $root/caddy.log" >&2
    return 1
  fi
}

serve_child_alive() { kill -0 "$1" 2>/dev/null && [[ $(ps -o stat= -p "$1" 2>/dev/null) != Z* ]]; }   # kill -0 alone answers yes for an unreaped child
serve_ready() { # serve_ready: the links answer: /ready with the tunnel, the quick URL in quick mode, caddy alone without a tunnel
  [[ $tunnel == 1 ]] || return 0
  if [[ $mode == quick ]]; then [[ -s $root/quick.url ]]; return; fi
  curl -sf -m 1 -o /dev/null "http://127.0.0.1:$metrics_port/ready" 2>/dev/null
}
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }   # GNU first: BSD stat rejects -c, GNU stat takes -f as a different verb
serve_exit_code() { # the code $root/.serve-exit holds; nothing when it is absent, unreadable or not a code
  local c; [[ -f $root/.serve-exit ]] || return 0
  c="$(jq -r '.code // empty' "$root/.serve-exit" 2>/dev/null)" || return 0
  [[ $c =~ ^[a-z_]+$ ]] && printf '%s' "$c"
  return 0
}
# The one classifier behind status, state and the Share Bar (G6). Sets serve_phase, serve_reason, and the old pair it maps onto:
# serve_state_val (state.state) and serve_ready_val (state.ready), computed exactly as state always did. Reads only; the one
# network call is the /ready probe (or the Worker's healthz) state already made. SHARE_STATE_NOW (a hidden clock seam) stands for the time.
serve_phase="" serve_reason="" serve_state_val="" serve_ready_val=""
serve_state() { # serve_state [healthz seconds]
  local now m code
  serve_ready_val=false serve_reason=""
  if [[ $backend == r2 ]]; then   # nothing runs here: the Worker serves while the account does
    if [[ -z $host_name ]]; then serve_phase=not_setup serve_state_val=not_setup
    else
      serve_state_val=serving
      r2_healthz "${1:-2}"
      if [[ $hz_code == 200 ]]; then serve_phase=serving serve_ready_val=true; else serve_phase=worker_down; fi
    fi
  elif running; then
    serve_state_val=serving
    if serve_ready; then serve_phase=serving serve_ready_val=true
    else   # a pid younger than 30 s is still connecting; an older one lost the tunnel
      now="${SHARE_STATE_NOW:-$(date +%s)}"; m="$(file_mtime "$pidfile" || true)"
      if [[ $m =~ ^[0-9]+$ && $((now - m)) -lt 30 ]]; then serve_phase=starting; else serve_phase=tunnel_down; fi
    fi
  elif [[ $role == migrated ]] || [[ -z $host_name && $mode != quick ]]; then   # a moved profile reads not_setup: an old Share Bar renders it neutral with Set Up (DEC-3)
    serve_phase=not_setup serve_state_val=not_setup
  else
    serve_state_val=stopped
    code="$(serve_exit_code)"
    if ! host_ok; then serve_phase=elsewhere
    elif [[ -n $code && $code != stopped ]] && svc_installed; then serve_phase=failed serve_reason=$code
    else serve_phase=stopped; fi
  fi
  [[ -n $serve_reason ]] || { serve_reason=$serve_phase; [[ $serve_phase != serving ]] || serve_reason=ok; }
  return 0
}

cmd_serve() {
  # serve's own dies record their code in $root/.serve-exit, so a crash loop under launchd keeps its reason (DEC-7, DEC-26);
  # a shell variable, never exported: caddy, cloudflared and the hourly prune never write it
  SHARE_EXIT_FILE="$root/.serve-exit"
  r2_no_local
  migrated_guard
  host_ok || die_code not_in_hosts "$(this_host) is not in hosts=$hosts; serve from one machine only (a second one splits requests)" "$me status"
  running && SHARE_EXIT_FILE="" die_code already_serving "already serving (pid $(cat "$pidfile"))" "$me status"   # the running serve's own record stays
  export SHARE_API_TOKEN_OFF=1   # the daemon and its hourly prune never make an Access call, from any token source
  mk_root; mkdir -p "$pub"
  cmd_prune quiet   # before the render, so the Caddyfile never carries expired rows
  # locks are taken only here, before serve's own EXIT trap replaces release_locks
  lock_take index
  write_caddyfile
  lock_release index
  local token=""
  # pids stay global: the EXIT trap must still see them when cmd_serve returns
  # normally (e.g. cloudflared dies, wait returns) and locals unbind first.
  caddy_pid="" loop_pid="" tunnel_pid=""
  if [[ $tunnel == 1 && $mode != quick ]]; then
    need_host
    token="$(token_read || true)"
    [[ -n $token ]] || die_code no_tunnel_token "no tunnel token for $host_name: run '$me setup $host_name'" "$me setup $host_name"
  fi
  # caddy binds with SO_REUSEPORT, so a second server on the same port would start and split requests silently
  local busy="an orphaned server, or another share profile (share profiles)? free it, or change port= in $config and rerun $me setup"
  ! listening "$port" || die_code port_busy "127.0.0.1:$port is already in use: $busy" "share profiles"
  [[ $tunnel != 1 ]] || ! listening "$metrics_port" || die_code metrics_port_busy "127.0.0.1:$metrics_port (metrics) is already in use: $busy" "share profiles"
  echo $$ >"$pidfile"
  caddy run --config "$root/Caddyfile" --adapter caddyfile >>"$root/caddy.log" 2>&1 &
  caddy_pid=$!
  # The prune loop redirects to the log: inheriting serve's stdout would let an
  # orphaned sleep hold a caller's $( ) pipe open for an hour after serve dies.
  # The loop unsets SHARE_EXIT_FILE: a prune that dies must never overwrite serve's own exit record (CD-05).
  (unset SHARE_EXIT_FILE; while sleep "${SHARE_PRUNE_EVERY:-3600}"; do bash "$0" prune || true; done) >>"$root/serve.log" 2>&1 &
  loop_pid=$!
  # The trap lands before the tunnel work and reads the pids at run time:
  # a die in the quick-URL parse must still reap caddy and the prune loop.
  # pkill first: the loop's current sleep is a grandchild kill(1) can't reach.
  # every step is non-fatal: the trap runs under set -e, and a pkill that finds no child (the loop between two
  # prunes) would otherwise end it before caddy is killed and the pidfile removed
  trap 'release_locks; [[ -z ${loop_pid:-} ]] || pkill -P "$loop_pid" 2>/dev/null || true; kill ${caddy_pid:-} ${loop_pid:-} ${tunnel_pid:-} 2>/dev/null || true; wait 2>/dev/null; rm -f "$pidfile" "$root/quick.url"' EXIT
  trap 'exit 0' INT TERM
  if [[ $tunnel == 1 && $mode == quick ]]; then
    # quick tunnel: no token, no DNS; cloudflared prints a random trycloudflare URL.
    # Only lines written after this spawn count: the log can hold a stale URL.
    local loglines=0 qu="" _
    [[ -f $root/cloudflared.log ]] && loglines="$(wc -l <"$root/cloudflared.log")"
    rm -f "$root/quick.url"
    cloudflared tunnel --no-autoupdate --url "http://127.0.0.1:$port" --metrics "127.0.0.1:$metrics_port" >>"$root/cloudflared.log" 2>&1 &
    tunnel_pid=$!
    for _ in $(seq 1 150); do
      qu="$(tail -n "+$((loglines + 1))" "$root/cloudflared.log" 2>/dev/null | grep -oE 'https://[a-z0-9.-]+\.trycloudflare\.com' | head -1 || true)"
      [[ -n $qu ]] && break
      # kill -0 alone lies for an unreaped child (zombie): check the state too
      if ! kill -0 "$tunnel_pid" 2>/dev/null || [[ $(ps -o stat= -p "$tunnel_pid" 2>/dev/null) == Z* ]]; then
        die_code cloudflared_died "cloudflared died before printing a URL; see $root/cloudflared.log" "$me status"
      fi
      sleep 0.2
    done
    [[ -n $qu ]] || die "cloudflared printed no trycloudflare URL after 30s; see $root/cloudflared.log"
    echo "${qu#https://}" >"$root/quick.url"
  elif [[ $tunnel == 1 ]]; then
    TUNNEL_TOKEN="$token" cloudflared tunnel --no-autoupdate --loglevel warn --grace-period 2s --metrics "127.0.0.1:$metrics_port" run &
    tunnel_pid=$!
  fi
  # Wait for the children, so the next serve never meets a dying cloudflared still answering /ready.
  sleep 1
  kill -0 "$caddy_pid" 2>/dev/null || die_code caddy_failed "caddy failed to start, see $root/caddy.log" "$me status"
  local display="${host_name:-127.0.0.1:$port}" wrc=0
  [[ $mode == quick ]] && display="$(serving_host)"
  echo "serving $pub on $display (pid $$)"
  if [[ -f $root/.serve-exit ]]; then   # a stale record goes only once this serve really answers, never at start (DEC-26)
    local polls=0
    while serve_child_alive "${tunnel_pid:-$caddy_pid}"; do
      if serve_ready; then rm -f "$root/.serve-exit"; break; fi
      polls=$((polls + 1)); if [[ $polls -lt 20 ]]; then sleep 0.5; else sleep 5; fi   # a tunnel still down after 10 s is polled less often
    done
  fi
  wait "${tunnel_pid:-$caddy_pid}" || wrc=$?
  # a child's death is not a die: record which one went (stop's TERM exits through the trap and never reaches here)
  if serve_child_alive "$caddy_pid"; then serve_exit_write cloudflared_died; else serve_exit_write caddy_failed; fi
  return "$wrc"
}


# --- background service: launchd on macOS, systemd --user on Linux ---

svc_label="${SHARE_SERVICE_LABEL:-foundation.d.share${profile:+.$profile}}"
svc_plist="$HOME/Library/LaunchAgents/$svc_label.plist"
svc_unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$svc_label.service"
svc_installed() { [[ -f $svc_plist || -f $svc_unit ]]; }

self_path() { # the stable path to this script: the PATH entry when it resolves here
  local s; s="$(command -v share 2>/dev/null || true)"
  if [[ -n $s && "$(realpath "$s")" == "$(realpath "$0")" ]]; then echo "$s"; else realpath "$0"; fi
}
svc_unload() { # bootout returns before launchd lets the job go; a bootstrap right after fails with error 5
  launchctl bootout "gui/$(id -u)/$svc_label" 2>/dev/null || true
  local _
  for _ in $(seq 1 20); do launchctl print "gui/$(id -u)/$svc_label" >/dev/null 2>&1 || return 0; sleep 0.5; done
}
svc_load() { launchctl bootstrap "gui/$(id -u)" "$svc_plist" 2>/dev/null || { sleep 1; launchctl bootstrap "gui/$(id -u)" "$svc_plist"; }; }
svc_path() { # PATH for the service: every PATH directory that holds a tool share calls, kept in the caller's own PATH order
  # (never the tool list's order: a stub share's own test or CI PATH puts ahead of /usr/bin must stay ahead in the
  # baked PATH too, or that PATH resolves the real /usr/bin/<tool> once anything shells out through a plain lookup)
  local tools=(caddy cloudflared jq curl pandoc gh trash security) p="" d t needed dirs
  IFS=: read -ra dirs <<<"$PATH"
  for d in "${dirs[@]}"; do
    [[ -n $d ]] || continue
    needed=0
    for t in "${tools[@]}"; do [[ -x "$d/$t" ]] && { needed=1; break; }; done
    [[ $needed == 1 ]] || continue
    case ":$p:" in *":$d:"*) ;; *) p="${p:+$p:}$d" ;; esac
  done
  echo "$p:/usr/bin:/bin:/usr/sbin:/sbin"
}
xml() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }

svc_install() {
  local self plist_env="" unit_env=""; self="$(self_path)"
  running && ! svc_installed && cmd_stop >/dev/null
  mk_root
  if [[ -n $profile ]]; then   # the daemon reads the profile's Keychain item; the default's files stay byte-identical
    plist_env=$'\n\t\t<key>SHARE_PROFILE</key><string>'"$profile"'</string>'
    unit_env=" \"SHARE_PROFILE=$profile\""
  fi
  if [[ $(uname -s) == Darwin ]]; then
    mkdir -p "$(dirname "$svc_plist")"
    cat >"$svc_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>$svc_label</string>
	<key>ProgramArguments</key><array><string>$(xml "$self")</string><string>serve</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
	<key>ThrottleInterval</key><integer>30</integer>
	<key>EnvironmentVariables</key><dict>
		<key>PATH</key><string>$(xml "$(svc_path)")</string>
		<key>SHARE_CONFIG_DIR</key><string>$(xml "$config_dir")</string>
		<key>SHARE_ROOT</key><string>$(xml "$root")</string>$plist_env
	</dict>
	<key>StandardOutPath</key><string>$(xml "$root/serve.log")</string>
	<key>StandardErrorPath</key><string>$(xml "$root/serve.log")</string>
</dict>
</plist>
EOF
    svc_unload
    svc_load
  elif command -v systemctl >/dev/null; then
    mkdir -p "$(dirname "$svc_unit")"
    cat >"$svc_unit" <<EOF
[Unit]
Description=share: publish local snapshots through a Cloudflare Tunnel
After=network-online.target

[Service]
ExecStart="$self" serve
Environment="PATH=$(svc_path)" "SHARE_CONFIG_DIR=$config_dir" "SHARE_ROOT=$root"$unit_env
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now "$svc_label.service" >/dev/null
  else
    die "no launchd or systemd here; use '$me start' instead"
  fi
}

svc_uninstall() {
  if [[ -f $svc_plist ]]; then
    svc_unload
    to_trash "$svc_plist"
  fi
  if [[ -f $svc_unit ]]; then
    systemctl --user disable --now "$svc_label.service" >/dev/null 2>&1 || true
    to_trash "$svc_unit"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
  return 0
}

wait_running() { # wait_running <seconds>: the server is up and, with the tunnel, connected to Cloudflare
  local i
  for ((i = 0; i < $1 * 2; i++)); do
    if running; then
      if [[ $tunnel != 1 ]]; then return 0
      elif [[ $mode == quick ]]; then [[ -s $root/quick.url ]] && return 0
      elif curl -sf -o /dev/null "http://127.0.0.1:$metrics_port/ready"; then return 0; fi
    fi
    sleep 0.5
  done
  return 1
}

cmd_service() {
  r2_no_local
  case "${1:-status}" in
    install)
      migrated_guard
      host_ok || die_code not_in_hosts "$(this_host) is not in hosts=$hosts" "$me status"
      svc_install
      wait_running 10 || die "the service did not start, see $root/serve.log"
      warn_not_live
      echo "service installed ($svc_label): serving now and at every login" ;;
    uninstall)
      svc_uninstall; echo "service removed; links are down until '$me start'" ;;
    status)
      if svc_installed; then echo "service: installed ($svc_label)"; else echo "service: not installed"; fi ;;
    *) die "usage: share service install|uninstall|status" ;;
  esac
}

cmd_start() {
  r2_no_local
  migrated_guard
  running && { echo "already serving (pid $(cat "$pidfile"))"; return 0; }
  host_ok || die_code not_in_hosts "$(this_host) is not in hosts=$hosts; serve from one machine only (a second one splits requests)" "$me status"
  mk_root
  if svc_installed; then
    if [[ -f $svc_plist ]]; then
      svc_load 2>/dev/null || launchctl kickstart "gui/$(id -u)/$svc_label"
    else
      systemctl --user start "$svc_label.service"
    fi
  else
    local envu=(env)   # a long-lived child never inherits a token resolved from a command (DEC-28)
    [[ $admin_token_src != cmd ]] || envu+=(-u CLOUDFLARE_API_TOKEN)
    [[ $minter_token_src != cmd ]] || envu+=(-u SHARE_MINTER_TOKEN)
    nohup "${envu[@]}" bash "$0" serve >>"$root/serve.log" 2>&1 &   # serve exports SHARE_API_TOKEN_OFF: an inherited token serves --host cleanup only, never Access
  fi
  wait_running 10 || die_code server_not_started "server did not start, see $root/serve.log" "$me status"
  local _; for _ in $(seq 1 20); do [[ -e $root/.serve-exit ]] || break; sleep 0.1; done   # serve drops a stale exit record once it answers; start returns after it
  warn_not_live
  echo "  serving in the background (pid $(cat "$pidfile")); $me stop to end"
}

# The tunnel reports ready before caddy may listen, and the Cloudflare edge keeps routing to an
# old connection for a few seconds after a restart. Only a public fetch proves a link works.
live_check() { # live_check <seconds> [host]: a probe file answers 200 through the public hostname, 3 times in a row
  # One 200 is not enough: during a handover the edge still sends some requests to the old connection.
  local probe code streak=0 _ h
  h="${2:-$(serving_host)}"
  [[ -n $h ]] || return 1
  probe="_probe-$(rand_id).txt"
  mkdir -p "$pub" && echo ok >"$pub/$probe"
  for _ in $(seq 1 "$1"); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 --doh-url https://1.1.1.1/dns-query "https://$h/$probe" 2>/dev/null ||
      curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$h/$probe" || true)"
    if [[ $code == 200 ]]; then streak=$((streak + 1)); else streak=0; fi
    [[ $streak -ge 3 ]] && break
    sleep 1
  done
  rm -f "$pub/$probe"
  [[ $streak -ge 3 ]]
}
warn_not_live() {
  [[ ${SHARE_LIVE_CHECK:-1} == 1 ]] || return 0   # test seam: no public probe in the suite
  local h; h="$(serving_host)"
  [[ $tunnel == 1 && -n $h ]] || return 0
  live_check 20 "$h" || echo "  share: https://$h/ is not answering yet; see $root/serve.log" >&2
}

cmd_stop() {
  r2_no_local
  running || { echo "not serving"; return 0; }
  local pid; pid="$(cat "$pidfile")"
  if [[ -f $svc_plist ]]; then svc_unload
  elif [[ -f $svc_unit ]]; then systemctl --user stop "$svc_label.service"
  else kill "$pid"; fi
  while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
  serve_exit_write stopped   # after the serve pid is gone, so serve's own post-wait record never lands on top of it
  rm -f "$root/quick.url"
  if svc_installed; then echo "stopped (all links down; the service starts again at next login)"
  else echo "stopped (all links down)"; fi
}

cmd_status() {
  [[ $backend != r2 ]] || { cmd_status_r2; return; }
  cmd_prune quiet
  serve_state
  case $serve_phase in
    serving|starting|tunnel_down)
      local where="$host_name"; [[ $mode != quick ]] || where="$(serving_host)"
      case $serve_phase in
        serving)
          if [[ $mode == quick ]]; then echo "serving (pid $(cat "$pidfile")) on https://$where (quick tunnel; the URL changes on every start)"
          else echo "serving (pid $(cat "$pidfile")) on $where: links are live"; fi ;;
        starting) echo "starting (pid $(cat "$pidfile")): the tunnel is connecting; links answer in a few seconds" ;;
        *) echo "serving (pid $(cat "$pidfile")) but the tunnel does not answer: links are down; see $root/cloudflared.log, then: $me stop; $me start" ;;
      esac ;;
    not_setup)
      if [[ $role == migrated ]]; then echo "not serving: this profile moved${migrated_to:+ to $migrated_to}; nothing serves here"
      else echo "not set up: $me setup <hostname>, or $me setup --quick"; fi ;;
    elsewhere) echo "not serving here: this machine is not in hosts=$hosts; links work while a machine in hosts= serves" ;;
    failed) echo "not serving: the last run ended with $serve_reason; see $root/serve.log, then: $me start" ;;
    *) echo "not serving: $me start" ;;
  esac
  role_line
  svc_installed && echo "service: installed ($svc_label)"
  ops_status
  cmd_ls
}

member_json() { # state.member on a member (R7): {id, name, mode, status, step, token_expires}; status from the .health cache (no network); null elsewhere
  [[ $role == member ]] || { echo null; return 0; }
  local c='{}'; [[ ! -f $health ]] || c="$(jq -c '.member // {}' "$health" 2>/dev/null || echo '{}')"
  jq -nc --arg id "$(cfg member_id)" --arg mode "$(cfg member_mode || true)" --arg te "$(cfg token_expires || true)" --argjson c "$c" \
    '{id: $id, name: ($id | sub("^m-"; "") | sub("-[0-9a-f]{8}$"; "")), mode: (if $mode == "" then null else $mode end),
      status: ($c.status // null), step: ($c.step // null), token_expires: ($c.token_expires // (if $te == "" then null else $te end))}'
}
role_line() { # status: what kind of profile this is, in words
  local w
  case $role in
    none) return 0 ;;
    quick) w="quick tunnel" ;; origin) w="origin" ;; tenant_origin) w="tenant origin (R2 on)" ;;
    r2_profile) w="r2 profile" ;; member) w="member" ;; migrated) w="moved to another machine" ;; *) w=$role ;;
  esac
  echo "role: $w"
  if [[ $role == member ]]; then echo "member: $(member_json | jq -r '"\(.name) (\(.id), \(.mode // "?")): \(.status // "not read yet")\(if .token_expires then ", token expires \(.token_expires)" else "" end)"')"; fi
  if [[ $tier_drift == 1 ]]; then echo "drift: config_drift: share.json and $config disagree on members; repair: $me setup $host_name --r2 --bucket $(cfg bucket || true) --members"; fi
  return 0
}

cmd_state() { # read-only JSON snapshot for the menu bar app: never prunes, writes, needs a TTY, or touches the clipboard
  [[ $backend != r2 ]] || { cmd_state_r2; return; }
  local mode_val="named" host_val="" state_val ready_val serves_val="false" service_val="false" skipped_n=0
  [[ $mode == quick ]] && mode_val="quick"
  serve_state; state_val=$serve_state_val ready_val=$serve_ready_val
  if [[ $mode_val == named ]]; then host_val="$host_name"
  elif [[ $state_val == serving ]]; then host_val="$(cat "$root/quick.url" 2>/dev/null || true)"; fi
  host_ok && serves_val="true"
  svc_installed && service_val="true"
  # skipped_n is computed here, not inside the pipeline below: a `{ } | jq` pipeline
  # forks the left side, so an assignment made there never reaches this shell's copy
  # of the variable, and jq's --argjson would see only the local's initial "0".
  [[ -s $index ]] && skipped_n=$(($(awk 'length {c++} END {print c+0}' "$index") - $(rows | awk 'END {print NR}')))
  # SHARE_STATE_BRIEF (the text profiles list) reads no bucket; the menu poll reads it with a stored token only
  if [[ ${SHARE_STATE_BRIEF:-0} == 1 ]]; then list_rows brief; else list_rows state; fi
  state_lines | jq -nR \
    --arg state "$state_val" --argjson ready "$ready_val" --arg mode "$mode_val" \
    --arg host "$host_val" --arg hosts "$hosts" --argjson serves_here "$serves_val" \
    --argjson service "$service_val" --argjson skipped "$skipped_n" --argjson access_pending "$(pending_count deferred orphan)" --argjson access_inflight "$(pending_count intent bound)" --argjson access_bad "$(pending_count bad)" \
    --argjson r2 "$([[ $r2on == 1 ]] && echo true || echo false)" --arg sdef "$([[ $r2on == 1 ]] && { cfg storage_default || true; })" \
    --arg cerr "$list_cloud_error" --arg ccode "${list_cloud_error_code:-}" --argjson cmore "$list_cloud_more" \
    --argjson codes_v "$codes_v" --arg role "$role" --arg tier "$tier" --arg sphase "$serve_phase" --arg sreason "$serve_reason" --argjson token "$(token_json)" --argjson compat "$(compat_json)" --argjson tdrift "$([[ $tier_drift == 1 ]] && echo true || echo false)" --argjson member "$(member_json)" --argjson ops "$(ops_json)" "$state_jq_row"'
    {schema: 1, state: $state, ready: $ready, mode: $mode,
     host: (if $host == "" then null else $host end), hosts: $hosts,
     serves_here: $serves_here, service: $service, access_pending: $access_pending, access_inflight: $access_inflight, access_bad: $access_bad,
     shares: [inputs | select(length > 0) | row]}
    + (if $skipped > 0 then {skipped: $skipped} else {} end)
    + {r2: $r2} + (if $r2 then {storage_default: (if $sdef == "" then "local" else $sdef end)} else {} end)
    + (if $cerr == "" then {} else {cloud_error: $cerr} end) + (if $ccode == "" then {} else {cloud_error_code: $ccode} end)
    + (if $cmore > 0 then {cloud_more: $cmore} else {} end) + {codes_v: $codes_v, role: $role}
    + (if $tier == "" then {} else {tier: $tier} end) + {ops: $ops, serve: {phase: $sphase, reason: $sreason}}
    + (if $token == null then {} else {token: $token} end) + (if $compat == null then {} else {compat: $compat} end)
    + (if $tdrift then {tier_drift: true} else {} end) + (if $member == null then {} else {member: $member} end)'
}
state_jq_row='def row: split("\t") | {id: .[0], name: .[1], url: .[2], kind: .[3],
      own_host: (if .[4] == "" then null else .[4] end), expires: (.[5] | tonumber),
      access: (if .[6] == "" then null else .[6] end), storage: .[7], type: .[8], by: .[9]}
      + (if (.[10] // "") == "" then {} else {origin: .[10]} end)
      + {link_state: (.[11] // "live")} + (if (.[12] // "") == "" then {} else {reason: .[12]} end);'


# --- Cloudflare setup / teardown ---
#
# Two ways to authorize. With CLOUDFLARE_API_TOKEN set, share uses the API for
# everything. Without it, share runs `cloudflared tunnel login`: the user picks
# the zone in a browser and Cloudflare hands back a cert.pem whose token may
# manage tunnels but not DNS records. That path creates DNS through
# `cloudflared tunnel route dns` and checks the hostname through public DNS.

cf_token="" account="" auth="" zone_name="" zone_id="" tun_id=""
cf_soft() { # cf_soft METHOD PATH: cf's call that never dies; sets cf_code (HTTP status, 000 on a transport failure) and cf_body
  local out
  cf_code=000 cf_body=""
  out="$(curl -sS --max-time 30 -w '\n%{http_code}' -X "$1" "$api$2" -H @<(printf 'Authorization: Bearer %s\n' "$cf_token") 2>/dev/null)" || return 0
  cf_code="${out##*$'\n'}"; cf_body="${out%$'\n'*}"
}
tunnel_delete() { # tunnel_delete <account> <tid>: its connections, then the tunnel; 1 when it is gone already (404, or deleted_at set), so a rerun converges
  cf_soft GET "/accounts/$1/cfd_tunnel/$2"
  [[ $cf_code != 404 && -z "$(jq -r '(.result | objects | .deleted_at) // empty' <<<"$cf_body" 2>/dev/null)" ]] || return 1
  cf_soft DELETE "/accounts/$1/cfd_tunnel/$2/connections"
  cf DELETE "/accounts/$1/cfd_tunnel/$2" >/dev/null
}
cf() { # cf METHOD PATH [JSON]; the token goes through a header file, never argv
  local out
  out="$(curl -sS --max-time 30 -X "$1" "$api$2" -H @<(printf 'Authorization: Bearer %s\n' "$cf_token") \
    -H 'Content-Type: application/json' ${3:+--data "$3"})" || die "Cloudflare API $1 $2: request failed"
  if [[ "$(jq -r '.success' <<<"$out" 2>/dev/null)" != true ]]; then
    die "Cloudflare API $1 $2 failed: $(jq -c '.errors' <<<"$out" 2>/dev/null || head -c 300 <<<"$out")"
  fi
  printf '%s' "$out"
}
doh() { curl -s --max-time 10 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$1&type=$2"; }
public_zone() { # the zone apex that owns $1, from public DNS
  doh "$1" SOA | jq -r '[(.Answer // [])[], (.Authority // [])[]] | map(select(.type == 6)) | .[0].name // empty' | sed 's/\.$//'
}
resolves() { [[ "$(doh "$1" A | jq '(.Answer // []) | length')" -gt 0 ]]; }

cert="$config_dir/cert.pem"
cert_field() { sed -n '/BEGIN ARGO TUNNEL TOKEN/,/END ARGO TUNNEL TOKEN/p' "$cert" | grep -v 'ARGO TUNNEL TOKEN' | base64 -d | jq -r ".$1 // empty"; }

auth_api() {
  cf_token="$CLOUDFLARE_API_TOKEN"; auth=api
  local status; status="$(cf GET /user/tokens/verify | jq -r .result.status)"
  echo "auth:       API token ($status)"
}
auth_login() { # auth_login <zone>: browser login unless a cert for this zone exists
  auth=login
  if [[ ! -f $cert || "$(cat "$config_dir/cert.zone" 2>/dev/null)" != "$1" ]]; then
    echo "auth:       opening Cloudflare in your browser. Pick $1, then click Authorize."
    local tmp; tmp="$(mktemp -d)"
    HOME="$tmp" cloudflared tunnel login >&2 || die "cloudflared login failed"
    [[ -f $tmp/.cloudflared/cert.pem ]] || die "the login returned no certificate"
    mkdir -p "$config_dir"
    mv -f "$tmp/.cloudflared/cert.pem" "$cert" && chmod 600 "$cert"
    echo "$1" >"$config_dir/cert.zone"
    rm -rf "$tmp"
  fi
  cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"
  [[ -n $cf_token && -n $account ]] || die "cannot read $cert; delete it and rerun setup"
  echo "auth:       browser login ($cert)"
}
cf_token_account() { cert_field accountID; }

cf_zone() { # API mode: prints "<zone_id> <account_id> <zone_name>" for the zone owning $host_name
  local cand="$host_name" r
  while [[ $cand == *.* ]]; do
    r="$(cf GET "/zones?name=$cand")"
    if [[ "$(jq '.result | length' <<<"$r")" -gt 0 ]]; then
      jq -r '.result[0] | "\(.id) \(.account.id) \(.name)"' <<<"$r"; return
    fi
    [[ $cand == *.*.* ]] || break
    cand="${cand#*.}"
  done
  die "no Cloudflare zone for $host_name in this token's accounts"
}

listening() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
other_cfg() { # other_cfg <key>: that key from every OTHER profile's config; the default claims port 8787 even with no config
  local c v dflt="${XDG_CONFIG_HOME:-$HOME/.config}/share/config"
  for c in "$dflt" "$profiles_dir"/*/config; do
    [[ $c != "$config" ]] || continue
    v=""; [[ -f $c ]] && v="$(awk -v k="$1" 'index($0, k "=") == 1 {print substr($0, length(k) + 2); exit}' "$c")"
    [[ $1 == port && $c == "$dflt" ]] && v="${v:-8787}"
    [[ -n $v ]] && echo "$v"
  done
  return 0
}
port_claimed() { # port_claimed <p>: p is another profile's port or metrics port
  local q
  for q in $(other_cfg port); do
    [[ $q =~ ^[1-9][0-9]*$ ]] || continue   # another profile's corrupt port= is its own problem, never this command's
    [[ $1 == "$q" || $1 == "$((q + 1))" ]] && return 0
  done
  return 1
}
live_shared() { # live_shared <p>: p is a live share's port in any profile's index (its dev server may be down right now)
  local f
  for f in "$HOME/share/index.tsv" "$HOME/share/profiles"/*/index.tsv; do
    [[ -f $f ]] && awk -F'\t' -v p="$1" '$6 ~ /(^| )live( |$)/ {sub(/.*:/, "", $3); if ($3 == p) f = 1} END {exit !f}' "$f" && return 0
  done
  return 1
}
free_port() { # the lowest odd port from 8789 (SHARE_TEST_PORT_BASE test seam) whose pair (port, metrics) no other profile claims or live-shares and nothing listens on
  local p base=${SHARE_TEST_PORT_BASE:-8789}
  for ((p = base; p < 65000; p += 2)); do
    port_claimed "$p" || port_claimed "$((p + 1))" || live_shared "$p" || live_shared "$((p + 1))" ||
      listening "$p" || listening "$((p + 1))" || { echo "$p"; return 0; }
  done
  die "no free port pair from $base up"
}
profile_port() { # a named profile's first setup picks its own port pair, before any Cloudflare call; the config keeps it from then on
  [[ -n $profile && -z ${SHARE_PORT:-} && -z "$(cfg port || true)" ]] || return 0
  port="$(free_port)"; metrics_port=$((port + 1))
  echo "port:       $port (metrics $metrics_port)"
}

profiles_child_env() { # the overrides every per-profile child drops; the menu app's strip list names the same six
  env -u SHARE_ROOT \
      -u SHARE_CONFIG_DIR \
      -u SHARE_PORT \
      -u SHARE_HOSTNAME \
      -u SHARE_HOSTS \
      -u SHARE_SERVICE_LABEL "$@"
}

cmd_profiles() { # the default, then every directory under profiles/; state and host from each one's own `share state`
  local n d line
  case "${1:-}" in
    --json) [[ $# -eq 1 ]] || die "usage: share profiles [--json]"; cmd_profiles_json; return ;;
    "") ;;
    *) die "usage: share profiles [--json]" ;;
  esac
  for n in default "$profiles_dir"/*/; do
    [[ $n == default || -d $n ]] || continue
    d="${n%/}"; d="${d##*/}"
    # the overrides are unset for the children: an inherited SHARE_ROOT or SHARE_HOSTNAME would make every row read one setup
    line="$(profiles_child_env SHARE_PROFILE="$d" SHARE_STATE_BRIEF=1 bash "$0" state 2>/dev/null | jq -r '[.state, (.host // "-")] | @tsv' 2>/dev/null)" || line=""
    printf '%s\t%s\n' "$d" "${line:-error	-}"
  done
}

cmd_profiles_json() { # one read for the menu app: every profile's `state` object, or its error line, jq-built per entry
  local n d out rc err
  for n in default "$profiles_dir"/*/; do
    [[ $n == default || -d $n ]] || continue
    d="${n%/}"; d="${d##*/}"
    if [[ $n != default && $d == default ]]; then   # reserved: `--profile default` is the unnamed profile
      jq -nc --arg error "reserved name; rename or remove $profiles_dir/default" '{name:"profiles/default",error:$error}'
      continue
    fi
    rc=0
    out="$(profiles_child_env SHARE_PROFILE="$d" bash "$0" state 2>/dev/null)" || rc=$?
    if [[ $rc -eq 0 ]] && jq -e . >/dev/null 2>&1 <<<"$out"; then
      jq -nc --arg name "$d" --argjson state "$out" '{name:$name,state:$state}'
      continue
    fi
    # rerun only the failed child, stdout discarded, to read its stderr without a temp file
    err="$(profiles_child_env SHARE_PROFILE="$d" bash "$0" state 2>&1 >/dev/null | awk 'NF {l=$0} END {print l}' || true)"
    if [[ -z $err ]]; then
      if [[ $rc -ne 0 ]]; then err="state exited $rc"; else err="state printed invalid JSON"; fi
    fi
    jq -nc --arg name "$d" --arg error "$err" '{name:$name,error:$error}'
  done | jq -s '{schema:1,profiles:.}'
}

write_config_quick() { # quick mode: a mode flag and the serving facts, nothing Cloudflare
  hosts="${hosts:-$(this_host)}"
  config_put "$own_write_config_quick" mode=quick "hosts=$hosts" "port=$port"
}

cmd_setup_quick() {
  [[ -z $(cfg tunnel_id || true) ]] || die_code quick_has_named_tunnel "already set up with a named tunnel; run '$me teardown' first" "$me teardown"
  local missing="" c
  for c in caddy cloudflared jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  profile_port
  write_config_quick
  mode=quick   # the file is written; this process still read it as named at startup
  echo "mode:       quick tunnel (no domain, no login; links get a random trycloudflare.com URL)"
  host_ok || { echo "this host ($(this_host)) is not in hosts=$hosts; skipping the service"; return 0; }
  local service="${1:-1}"
  if [[ $service == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then
    svc_install; echo "service:    runs at login ($svc_label); the URL is new on every start"
  fi
  running || cmd_start >/dev/null 2>&1
  local q; q="$(serving_host)"
  [[ -n $q ]] || die "serving but no trycloudflare URL yet; see $root/cloudflared.log"
  warn_not_live
  echo "ready:      https://$q/ is live. The URL changes on every start. Next: $me add <file|dir>"
}

write_config() { # write_config <tunnel_id> <tunnel_name>: the tunnel keys; token_cmd, api_token_cmd, the tenant keys and every other line stay
  local z=()
  hosts="${hosts:-$(this_host)}"
  [[ -z $zone_name ]] || z=("zone=$zone_name")
  config_put "$own_write_config" "hostname=$host_name" "tunnel_id=$1" "tunnel_name=$2" "auth=$auth" "hosts=$hosts" "port=$port" ${z[@]+"${z[@]}"}
}

# --- own hostnames: one CNAME + one ingress rule per --host share ---
#
# Create order is ingress, DNS, then the index row; delete order is DNS,
# ingress, then the row. SHARE_HOST_DRY=1 skips every Cloudflare call and
# records the intended calls, one per line, in $root/host-calls.log.

host_zone() { # the zone every --host name lives under; learned once, kept in config
  [[ -n $zone_name ]] && return 0
  zone_name="$(cfg zone || true)"
  if [[ -z $zone_name ]]; then
    if [[ ${SHARE_HOST_DRY:-0} == 1 || ${SHARE_ACCESS_DRY:-0} == 1 ]]; then zone_name="${host_name#*.}"
    else zone_name="$(public_zone "$host_name")"; fi
    [[ -n $zone_name ]] || die "cannot find the DNS zone of $host_name; is the domain on Cloudflare?"
    mkdir -p "$config_dir"; grep -q '^zone=' "$config" 2>/dev/null || echo "zone=$zone_name" >>"$config"
  fi
}

host_check() { # host_check <fqdn>: credential and name are settled before any write
  local fqdn="$1" label
  if [[ ${SHARE_HOST_DRY:-0} != 1 && -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
    die "--host needs CLOUDFLARE_API_TOKEN or a browser login ($me setup --login)"
  fi
  [[ $fqdn != "$host_name" ]] || die "--host cannot be the main hostname"
  host_zone
  case $fqdn in
    *."$zone_name") label="${fqdn%."$zone_name"}" ;;
    *) die "--host must be one label under $zone_name (Universal SSL stops at one level)" ;;
  esac
  case $label in
    ""|*.*|*[!a-z0-9-]*|-*|*-)
      die "--host must be one label under $zone_name (Universal SSL stops at one level)" ;;
  esac
}

host_auth() { # cf_token, account, zone_id, tun_id for Cloudflare-side host work
  [[ -n $cf_token && -n $account && -n $zone_id && -n $tun_id ]] && return 0
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    cf_token="$CLOUDFLARE_API_TOKEN"; auth=api
  elif [[ -f $cert ]]; then
    cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"; auth=login
  else
    die "--host needs CLOUDFLARE_API_TOKEN or a browser login ($me setup --login)"
  fi
  [[ -n $cf_token ]] || die "--host needs CLOUDFLARE_API_TOKEN or a browser login ($me setup --login)"
  local z; z="$(cf GET "/zones?name=$zone_name")"
  zone_id="$(jq -r '.result[0].id // empty' <<<"$z")"
  account="${account:-$(jq -r '.result[0].account.id // empty' <<<"$z")}"
  [[ -n $zone_id && -n $account ]] || die "the credential cannot see the $zone_name zone"
  tun_id="$(cfg tunnel_id || true)"
  [[ -n $tun_id ]] || die "no tunnel_id in $config; run '$me setup' first"
}

host_lock() { lock_take host "${SHARE_HOST_LOCK_TIMEOUT:-60}"; }   # one Cloudflare-side edit at a time
host_unlock() { lock_release host; }   # as soon as the edit lands; the EXIT trap is the die-path backstop

ingress_get() { # the tunnel config as {"config":{"ingress":[...]}}; dry mode reads a fixture
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    if [[ -f $root/host-fixture.json ]]; then cat "$root/host-fixture.json"
    else printf '{"config":{"ingress":[{"hostname":"%s","service":"http://127.0.0.1:%s"},{"service":"http_status:404"}]}}' "$host_name" "$port"; fi
    return 0
  fi
  cf GET "/accounts/$account/cfd_tunnel/$tun_id/configurations" | jq -c '.result'
}

ingress_check() { # the catch-all stays last and the primary hostname first, else hands off
  jq -e --arg h "$host_name" '
    (.config.ingress | length) >= 2
    and (.config.ingress[-1].service == "http_status:404")
    and (.config.ingress[0].hostname == $h)' <<<"$1" >/dev/null \
    || die "tunnel ingress was edited outside share; fix it in the dashboard or rerun $me setup --force"
}

ingress_put() { # ingress_put <config-json> <dry-log-word>
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "PUT ingress $2" >>"$root/host-calls.log"; return 0
  fi
  cf PUT "/accounts/$account/cfd_tunnel/$tun_id/configurations" "$(jq -c '{config:.config}' <<<"$1")" >/dev/null
}

host_add() { # host_add <fqdn>: collision guard, ingress rule, then the CNAME
  local fqdn="$1" rec="" rid="" rtype="" rcontent="" cfg_json new out
  if [[ ${SHARE_HOST_DRY:-0} != 1 ]]; then
    host_auth
    rec="$(cf GET "/zones/$zone_id/dns_records?name=$fqdn")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    rtype="$(jq -r '.result[0].type // empty' <<<"$rec")"
    rcontent="$(jq -r '.result[0].content // empty' <<<"$rec")"
    if [[ -n $rid && $rcontent != "$tun_id.cfargotunnel.com" ]]; then
      die "$fqdn already has a $rtype record ($rcontent); pick another hostname"
    fi
  fi
  host_lock
  cfg_json="$(ingress_get)"
  ingress_check "$cfg_json"
  new="$(jq -c --arg h "$fqdn" --arg s "http://127.0.0.1:$port" \
    '.config.ingress |= (.[:-1] + [{hostname:$h, service:$s, originRequest:{httpHostHeader:$h}}] + [.[-1]])' <<<"$cfg_json")"
  ingress_put "$new" "+1"
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "POST CNAME" >>"$root/host-calls.log"
  elif [[ -z $rid ]]; then
    # DNS comes after ingress; a POST failure puts the ingress back before dying
    if ! out="$(cf POST "/zones/$zone_id/dns_records" \
        "{\"type\":\"CNAME\",\"name\":\"$fqdn\",\"content\":\"$tun_id.cfargotunnel.com\",\"proxied\":true,\"comment\":\"share host\"}" 2>&1)"; then
      (ingress_put "$cfg_json" revert) || true
      if [[ $auth == login ]]; then
        die "the login cert cannot edit DNS records directly: export CLOUDFLARE_API_TOKEN with DNS Edit, or run $me setup with the token"
      fi
      die "could not create the DNS record for $fqdn (the ingress change was reverted): $out"
    fi
  fi
  host_unlock
}

host_rm() { # host_rm <fqdn>: delete the CNAME, then the ingress rule; missing counts as done
  local fqdn="$1" cfg_json rec="" rid="" out
  [[ $fqdn != "$host_name" ]] || die "$fqdn is the main hostname; host_rm never touches it"
  host_lock
  if [[ ${SHARE_HOST_DRY:-0} == 1 ]]; then
    echo "DELETE CNAME" >>"$root/host-calls.log"
  else
    if [[ -z ${CLOUDFLARE_API_TOKEN:-} && ! -f $cert ]]; then
      echo "share: no Cloudflare credential; DNS and ingress for $fqdn stay behind" >&2
      host_unlock; return 0
    fi
    host_zone
    host_auth
    rec="$(cf GET "/zones/$zone_id/dns_records?name=$fqdn")"
    # only a record pointing at this tunnel is ours to delete, as host_add checks before it creates one
    rid="$(jq -r --arg t "$tun_id.cfargotunnel.com" 'first(.result[] | select(.content == $t) | .id) // empty' <<<"$rec")"
    if [[ -z $rid ]] && jq -e '.result | length > 0' <<<"$rec" >/dev/null; then
      echo "share: $fqdn has a DNS record that does not point at this tunnel; left alone" >&2
    fi
    if [[ -n $rid ]]; then
      if ! out="$(cf DELETE "/zones/$zone_id/dns_records/$rid" 2>&1)"; then
        if [[ $auth == login ]]; then
          die "the login cert cannot edit DNS records directly: export CLOUDFLARE_API_TOKEN with DNS Edit, or run $me setup with the token"
        fi
        die "could not delete the DNS record for $fqdn: $out"
      fi
    fi
  fi
  cfg_json="$(ingress_get)"
  ingress_check "$cfg_json"
  cfg_json="$(jq -c --arg h "$fqdn" '.config.ingress |= map(select(.hostname != $h))' <<<"$cfg_json")"
  ingress_put "$cfg_json" "-1"
  host_unlock
}

# --- login gate: one Cloudflare Access app per share (ADR-0006) ---
#
# The bytes go public only after the gate is observed at the edge, and the gate goes
# only after the bytes are gone. Every app is tracked in $pending from the intent line
# before the POST until the line is dropped after the DELETE. SHARE_ACCESS_DRY=1 (with
# SHARE_TUNNEL=0 only) answers every Access call from fixtures and logs each one, one
# per line, in $root/access-calls.log.

access_usage="usage: --access group:<name> | email:<a>[,<b>...] | domain:<domain>"
access_rule="" access_include="" access_app="" access_aud="" access_group_out="" access_found="" acct=""
api_token="" api_token_src="" own_start_v="" probe_round=0
access_wait="${SHARE_ACCESS_WAIT:-900}"
access_named_only() { die "--access needs a named tunnel on a Cloudflare account with Access: '$me teardown', then '$me setup <hostname>'"; }
api_token_file="$config_dir/api-token"
api_token_key() { echo "share-api${profile:+.$profile}:$host_name"; }
dry_log() { # an r2 profile logs beside its bucket calls, so one log orders PUTs, PROBEs, and app calls
  [[ ${SHARE_ACCESS_DRY:-0} == 1 ]] || return 0
  if [[ $backend == r2 || $r2on == 1 ]]; then echo "$*" >>"$root/r2-calls.log"; else echo "$*" >>"$root/access-calls.log"; fi
}
hostname_ok() { [[ $1 =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z][a-z]+$ ]]; }

access_parse() { # access_parse <rule>: validates and normalizes into access_rule; the include JSON waits for the account (group: is resolved by name)
  local kind="${1%%:*}" v="${1#*:}" e lp dom out="" list=()
  case $1 in *[[:space:]]*) die "$access_usage" ;; esac
  [[ $1 == *:* && -n $kind && -n $v ]] || die "$access_usage"
  case $kind in
    group)
      [[ ${#v} -le 64 ]] || die "$access_usage"
      case $v in *[!A-Za-z0-9._-]*) die "$access_usage" ;; esac
      access_rule="group:$v" ;;
    email)
      v="$(tr '[:upper:]' '[:lower:]' <<<"$v")"
      IFS=, read -ra list <<<"$v"
      [[ ${#list[@]} -ge 1 && ${#list[@]} -le 50 ]] || die "$access_usage"
      for e in "${list[@]}"; do
        lp="${e%%@*}"; dom="${e#*@}"
        [[ $e == *@* && -n $lp && $dom != *@* ]] || die "$access_usage"
        case $lp in *[!a-z0-9._%+-]*) die "$access_usage" ;; esac
        hostname_ok "$dom" || die "$access_usage"
        out="${out:+$out,}$e"
      done
      access_rule="email:$out" ;;
    domain)
      v="$(tr '[:upper:]' '[:lower:]' <<<"$v")"
      hostname_ok "$v" || die "$access_usage"
      echo "share: --access domain:$v admits every address at $v, contractors included; use group: to narrow it" >&2
      access_rule="domain:$v" ;;
    *) die "$access_usage" ;;
  esac
}
access_include_json() { # the policy include for access_rule; group: from access_group_out
  local kind="${access_rule%%:*}" v="${access_rule#*:}"
  case $kind in
    group) access_include="$(jq -nc --arg id "$access_group_out" '[{group:{id:$id}}]')" ;;
    email) access_include="$(jq -nc --arg v "$v" '[$v | split(",")[] | {email:{email:.}}]')" ;;
    domain) access_include="$(jq -nc --arg v "$v" '[{email_domain:{domain:$v}}]')" ;;
  esac
}

# the API token, one resolver for every Access path: the stored source wins over the shell,
# so a broad token exported in a shell never silently replaces the profile's own
api_token_resolve() { # api_token_resolve [env|soft]: sets api_token and api_token_src; api_token_cmd, then the Keychain item or 600 file, then CLOUDFLARE_API_TOKEN.
  # `env`: the environment only (a listing never runs op read or prompts). `soft` (the prune verb): a failing api_token_cmd warns and
  # resolves nothing, so expiry is never blocked. Nothing from any source under SHARE_API_TOKEN_OFF (share serve). Never exported.
  local cmd rc=0
  api_token="" api_token_src=""
  [[ ${SHARE_API_TOKEN_OFF:-0} == 1 ]] && return 0
  if [[ ${1:-} != env ]]; then
    cmd="$(cfg api_token_cmd || true)"
    if [[ -n $cmd ]]; then
      api_token="$(eval "$cmd" 2>/dev/null)" || rc=$?
      if [[ $rc != 0 || -z $api_token ]]; then
        api_token=""
        [[ ${1:-} == soft ]] || die "api_token_cmd failed (exit $rc); run it by hand to see why, or replace it: $me api-token --cmd '<command>'"
        echo "share: api_token_cmd failed (exit $rc); expired shares are still unpublished and their Access apps wait; run it by hand to see why, then: $me prune" >&2
        return 0
      fi
      api_token_src="api_token_cmd"; return 0
    fi
    if command -v security >/dev/null; then
      api_token="$(security find-generic-password -a share -s "$(api_token_key)" -w 2>/dev/null || true)"
      [[ -n $api_token ]] && { api_token_src="keychain $(api_token_key)"; return 0; }
    fi
    if [[ -f $api_token_file ]]; then
      api_token="$(cat "$api_token_file")"
      [[ -n $api_token ]] && { api_token_src="$api_token_file"; return 0; }
    fi
  fi
  [[ -n ${CLOUDFLARE_API_TOKEN:-} ]] && { api_token="$CLOUDFLARE_API_TOKEN"; api_token_src="CLOUDFLARE_API_TOKEN"; }
  return 0
}
api_token_store() { # api_token_store <token>: through stdin into the Keychain, or a 600 file; never argv. Called direct, never in $( ): a die must kill this process.
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "that does not look like a Cloudflare API token (letters, digits, - and _ only); rerun: $me api-token"
  if command -v security >/dev/null; then
    printf 'add-generic-password -U -a share -s "%s" -w "%s"\n' "$(api_token_key)" "$1" | security -i >/dev/null
    api_token_store_out="stored in the keychain (service $(api_token_key))"
  else
    (umask 077 && printf '%s' "$1" >"$api_token_file.$$") && mv -f "$api_token_file.$$" "$api_token_file"   # a fresh 600 file replaces any wider one; the token never sits in a readable file
    api_token_store_out="stored in $api_token_file (mode 600)"
  fi
}
api_token_forget() {
  if command -v security >/dev/null; then security delete-generic-password -a share -s "$(api_token_key)" >/dev/null 2>&1 || true; fi
  [[ -f $api_token_file ]] && to_trash "$api_token_file"
  return 0
}
access_token_url() { # the account-token template URL (Cloudflare docs, "API token template URLs"): the three permission keys, named for the profile
  printf 'https://dash.cloudflare.com/?to=/:account/api-tokens&permissionGroupKeys=%s&name=share%%20access%%20%%28%s%%29' \
    '%5B%7B%22key%22%3A%22access%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22access_acct%22%2C%22type%22%3A%22read%22%7D%2C%7B%22key%22%3A%22zone%22%2C%22type%22%3A%22read%22%7D%5D' \
    "${profile:-default}"
}
r2_publisher_token_url() { # the user-token template URL (Cloudflare docs, "API token template URLs"): Zone Read, this account, the name
  # share derives the S3 key from /user/tokens/verify, so the form is a user token's; no documented template key presets a bucket-scoped permission
  local ep a
  ep="$(cfg r2_endpoint || true)"; a="${ep#https://}"; a="${a%%.*}"
  [[ -n $ep && $a =~ ^[A-Za-z0-9-]+$ ]] || a='%2A'
  printf 'https://dash.cloudflare.com/profile/api-tokens?permissionGroupKeys=%s&accountId=%s&zoneId=all&name=share%%20publisher%%20%%28%s%%29' \
    '%5B%7B%22key%22%3A%22zone%22%2C%22type%22%3A%22read%22%7D%5D' "$a" "${profile:-default}"
}
access_no_token() { # the guided block when no token source resolves; callers send it to stderr
  local z; z="$(cfg zone || true)"; z="${z:-${host_name#*.}}"
  cat <<EOF
share: --access needs a Cloudflare API token for $host_name${profile:+ (profile $profile)}; none is set.
  New token (opens the prefilled form, then paste):  $me api-token
  Already have a token with Access scopes:          $me api-token --cmd 'op read "op://<vault>/<item>/credential"'
  Form link, pick the account that owns $z:
     $(access_token_url)
EOF
}
access_scope_line() { echo "the token lacks '$1'; add it at https://dash.cloudflare.com/?to=/:account/api-tokens (account API tokens), then: $me api-token --check"; }
access_enable_line() { echo "Cloudflare Access is not enabled on the account that owns $zone_name; enable Zero Trust for this account in the Cloudflare dashboard, then: $me api-token --check"; }

# --- admin and minter tokens (G13): a command in the config prints each, never the token itself (ADR-0009, DEC-15, DEC-35) ---
admin_token_src="" minter_token_src="" token_cmd_out=""
token_cmd_run() { # token_cmd_run <command> <key> <code> <next>: token_cmd_out = its first stdout line; neither of its streams is ever printed
  local rc=0 out
  out="$(eval "$1" 2>/dev/null)" || rc=$?
  [[ $rc == 0 ]] || die_code "$3" "$2 exited $rc; its output is not shown (run it by hand to see why); nothing was changed" "$4"
  token_cmd_out="${out%%$'\n'*}"
  [[ $token_cmd_out =~ ^[A-Za-z0-9_-]+$ ]] || { token_cmd_out=""; die_code "$3" "$2 printed no token on its first line (letters, digits, - and _ only); nothing was changed" "$4"; }
}
admin_token_resolve() { # admin_token_resolve required|optional [what]: CLOUDFLARE_API_TOKEN wins; else admin_token_cmd, once per process, into this shell only (never exported, never stored)
  [[ -z $admin_token_src ]] || return 0
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then admin_token_src="env"; return 0; fi
  local cmd; cmd="$(cfg admin_token_cmd || true)"
  if [[ -z $cmd ]]; then
    [[ $1 == required ]] || return 0   # optional: today's path (the browser-login cert, or the verb's own refusal)
    die_code admin_token_missing "${2:-this} needs the admin token: set CLOUDFLARE_API_TOKEN, or store a command that prints it with $me admin-token --cmd '<command>'; nothing was changed" "$me admin-token --cmd '<command>'"
  fi
  token_cmd_run "$cmd" admin_token_cmd admin_token_cmd_failed "$me admin-token --test"
  CLOUDFLARE_API_TOKEN="$token_cmd_out" token_cmd_out="" admin_token_src=cmd
}
minter_token_resolve() { # minter_token_resolve: SHARE_MINTER_TOKEN wins; else minter_token_cmd, once per process, into this shell only; minter paths only
  [[ -z $minter_token_src ]] || return 0
  if [[ -n ${SHARE_MINTER_TOKEN:-} ]]; then minter_token_src="env"; return 0; fi
  local cmd; cmd="$(cfg minter_token_cmd || true)"
  [[ -n $cmd ]] || die_code minter_token_missing "this needs the minter token (API Tokens Read and Write): set SHARE_MINTER_TOKEN, or store a command that prints it with $me minter-token --cmd '<command>'; nothing was changed" "$me minter-token --cmd '<command>'"
  token_cmd_run "$cmd" minter_token_cmd minter_token_cmd_failed "$me minter-token --test"
  SHARE_MINTER_TOKEN="$token_cmd_out" token_cmd_out="" minter_token_src=cmd
}
token_verb() { # token_verb admin|minter <args>: the admin-token and minter-token verbs; --cmd and --clear write the config, --test probes
  local kind=$1 key="$1_token_cmd" usage="usage: share $1-token --cmd '<command>' | --clear | --test [--json]"; shift
  case ${1:-} in
    --cmd) [[ $# -eq 2 && -n $2 ]] || die "$usage"
      config_put "$key" "$key=$2"
      echo "token:      $key stored in $config (a command, never the token; it runs only on $kind paths)" ;;
    --clear) [[ $# -eq 1 ]] || die "$usage"
      [[ -f $config ]] || { echo "token:      no config at $config; nothing to clear"; return 0; }   # never create a profile by clearing
      config_put "$key"
      echo "token:      $key removed from $config" ;;
    --test) [[ $# -eq 1 || ( $# -eq 2 && $2 == --json ) ]] || die "$usage"
      if [[ $kind == admin ]]; then admin_token_test "${2:-}"; else minter_token_test "${2:-}"; fi ;;
    *) die "$usage" ;;
  esac
}
admin_token_test() { # admin_token_test [--json]: one read per capability with the resolved admin token; the token and the command's output are never printed
  local worker="share-${host_name//./-}" k can="{}" ok
  need_host
  admin_token_resolve required "admin-token --test"
  api_token="$CLOUDFLARE_API_TOKEN"
  r2_setup_zone
  r2_api GET "/accounts/$acct/workers/scripts/$worker/settings"   # first: a token that cannot read the Worker's settings is no admin token
  case $cf_code in
    200|404) ;;
    401|403) api_token=""; die_code admin_token_not_admin "the token cannot read Worker $worker's settings (HTTP $cf_code): it is not an admin token" "$me admin-token --cmd '<command>'" ;;
    *) api_token=""; die "reading Worker $worker's settings answered HTTP $cf_code; the token was not judged" ;;
  esac
  can="$(jq -c '. + {workers: true}' <<<"$can")"
  for k in tunnels dns r2 connectivity; do
    case $k in
      tunnels) r2_api GET "/accounts/$acct/cfd_tunnel?per_page=1" ;;
      dns) r2_api GET "/zones/$zone_id/dns_records?per_page=1" ;;
      r2) r2_api GET "/accounts/$acct/r2/buckets" ;;
      connectivity) r2_api GET "/accounts/$acct/connectivity/directory/services?per_page=1" ;;
    esac
    ok=false; [[ $cf_code == 200 ]] && ok=true
    can="$(jq -c --arg k "$k" --argjson v "$ok" '. + {($k): $v}' <<<"$can")"
  done
  api_token=""
  if [[ ${1:-} == --json ]]; then jq -nc --arg s "$admin_token_src" --argjson can "$can" '{source: $s, can: $can}'; return 0; fi
  echo "admin token: from ${admin_token_src/cmd/admin_token_cmd}"
  jq -r 'to_entries[] | "  \(.key): \(if .value then "yes" else "no" end)"' <<<"$can"
}
minter_token_test() { # minter_token_test [--json]: one read, GET /user/tokens; the token and the command's output are never printed
  local ok=false
  minter_token_resolve
  api_token="$SHARE_MINTER_TOKEN"
  r2_api GET "/user/tokens?per_page=1"
  api_token=""
  [[ $cf_code == 200 ]] && ok=true
  if [[ ${1:-} == --json ]]; then jq -nc --arg s "$minter_token_src" --argjson ok "$ok" '{source: $s, can: {list_tokens: $ok}}'; return 0; fi
  echo "minter token: from ${minter_token_src/cmd/minter_token_cmd}"
  echo "  list_tokens: $([[ $ok == true ]] && echo yes || echo no)"
}

cf_try() { # cf_try METHOD PATH [JSON]: like cf() but never dies; sets cf_body, cf_code (HTTP status, 000 on transport failure), cf_err (first errors[].code).
  # Call it directly, never inside $( ): globals set in a command substitution are lost. The token goes through a header file, never argv.
  local out
  cf_body="" cf_code=000 cf_err=""
  if [[ ${SHARE_ACCESS_DRY:-0} == 1 ]]; then   # the seam answers only with SHARE_TUNNEL=0; on a real install it refuses (000), never fakes a delete
    [[ $tunnel == 0 ]] || { echo "share: SHARE_ACCESS_DRY=1 is a test seam for SHARE_TUNNEL=0 only; the Cloudflare call was refused; unset it" >&2; return 0; }
    cf_dry "$@"; return 0
  fi
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then   # a dry r2 run answers Access calls only through SHARE_ACCESS_DRY
    echo "share: SHARE_R2_DRY=1 without SHARE_ACCESS_DRY=1: the Cloudflare call $1 $2 was refused" >&2; return 0
  fi
  out="$(curl -sS --max-time 30 -w '\n%{http_code}' -X "$1" "$api$2" -H @<(printf 'Authorization: Bearer %s\n' "$api_token") \
    -H 'Content-Type: application/json' ${3:+--data "$3"} 2>/dev/null)" || return 0
  cf_code="${out##*$'\n'}"; cf_body="${out%$'\n'*}"
  cf_err="$(jq -r '.errors[0].code // empty' <<<"$cf_body" 2>/dev/null || true)"
}
cf_dry() { # the SHARE_ACCESS_DRY answers: fixtures and knobs in, one log line per call; created apps live in $root/.access-dry
  local d="$root/.access-dry" name id nonce uuid page
  mkdir -p "$d"
  cf_code=200 cf_err="" cf_body='{"success":true,"result":[]}'
  case "$1 $2" in
    "GET /zones?"*)
      dry_log "GET zones"
      case ${SHARE_ACCESS_DRY_ZONES:-1} in
        0) cf_body='{"success":true,"result":[]}' ;;
        1) cf_body='{"success":true,"result":[{"id":"zone-dry","account":{"id":"acct-dry"}}]}' ;;
        *) cf_body='{"success":true,"result":[{"id":"zone-dry","account":{"id":"acct-dry"}},{"id":"zone-dry2","account":{"id":"acct-dry2"}}]}' ;;
      esac ;;
    "GET "*/access/organizations)
      dry_log "GET orgs"
      case ${SHARE_ACCESS_DRY_ORGS:-ok} in
        deny) cf_code=403 cf_err=10000 cf_body='{"success":false,"errors":[{"code":10000}]}' ;;
        off) cf_code=403 cf_err=9999 cf_body='{"success":false,"errors":[{"code":9999}]}' ;;
      esac ;;
    "GET "*/access/groups?*)
      dry_log "GET groups"
      page="${2#*&page=}"; page="${page%%&*}"
      # the name filter is ignored on purpose: the client-side exact match over every page is what gets exercised
      [[ -f $root/access-groups-fixture.json ]] && cf_body="$(jq -c --argjson p "$page" \
        '{success:true, result: .[($p - 1) * 100:$p * 100], result_info:{total_pages: (((length + 99) / 100 | floor) | if . < 1 then 1 else . end)}}' "$root/access-groups-fixture.json")" ;;
    "POST "*/access/apps)
      if [[ ${3:-} == '{}' ]]; then
        dry_log "POST app {}"
        case ${SHARE_ACCESS_DRY_APPS:-ok} in
          deny) cf_code=403 cf_err=10000 cf_body='{"success":false,"errors":[{"code":10000}]}' ;;
          off) cf_code=403 cf_err=9999 cf_body='{"success":false,"errors":[{"code":9999}]}' ;;
          *) cf_code=400 cf_err=12130 cf_body='{"success":false,"errors":[{"code":12130,"message":"access.api.error.invalid_request: app type is missing or invalid"}]}' ;;
        esac
      elif [[ ${SHARE_ACCESS_DRY_POST:-} == lost ]]; then
        dry_log "POST app (lost) $3"; printf '%s' "$3" >"$d/lost.json"; cf_code=000 cf_body=""
      else
        name="$(jq -r .name <<<"$3")"; id="$(awk '{print $2}' <<<"$name")"; nonce="${name##* }"
        uuid="00000000-0000-4000-8000-000000$id"
        jq -c --arg id "$uuid" --arg aud "$(printf '%s' "$nonce" | shasum -a 256 | cut -c1-64)" '. + {id:$id, aud:$aud}' <<<"$3" >"$d/$uuid.json"   # 64 hex, as a real AUD tag
        cf_code=201 cf_body="{\"success\":true,\"result\":$(cat "$d/$uuid.json")}"
        dry_log "POST app"
      fi ;;
    "PUT "*/access/apps/*)   # the full read-back with its destinations changed, as a real PUT replaces every field; a self_hosted_domains entry no longer among the new destinations answers 400, as the real API does on a shrinking PUT
      uuid="${2##*/}"; dry_log "PUT app $uuid"
      if [[ -f $d/$uuid.json ]]; then
        if jq -e '((.self_hosted_domains // []) - [.destinations[]?.uri]) != []' <<<"$3" >/dev/null 2>&1; then
          cf_code=400 cf_err=12130 cf_body='{"success":false,"errors":[{"code":12130,"message":"access.api.error.invalid_request: self_hosted_domains is inconsistent with destinations"}]}'
        else
          jq -c . <<<"$3" >"$d/$uuid.json"; cf_body="{\"success\":true,\"result\":$3}"
        fi
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":12103}]}' cf_err=12103; fi ;;
    "GET "*/access/apps/*)
      uuid="${2##*/}"; dry_log "GET app $uuid"
      if [[ -f $d/$uuid.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/$uuid.json")}"
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":12103}]}' cf_err=12103; fi ;;
    "GET "*"/access/apps?"*)
      dry_log "GET apps"
      if [[ $backend == r2 ]]; then
        cf_body="$(find "$d" -name '*-*.json' -exec cat {} + 2>/dev/null | jq -sc '{success:true, result:[.[] | {id, name}], result_info:{total_pages:1}}')"
      elif [[ -f $d/lost.json ]]; then
        jq -c '{id:"00000000-0000-4000-8000-000000001057", name:.name}' "$d/lost.json" >"$d/00000000-0000-4000-8000-000000001057.json"
        cf_body="$(jq -c '{success:true, result:[.], result_info:{total_pages:1}}' "$d/00000000-0000-4000-8000-000000001057.json")"
      fi ;;
    "DELETE "*/access/apps/*)
      uuid="${2##*/}"
      if [[ ${SHARE_ACCESS_DRY_DELETE:-} == lost ]]; then dry_log "DELETE app $uuid (lost)"; cf_code=000 cf_body=""
      else dry_log "DELETE app $uuid"; rm -f "$d/$uuid.json"; [[ $uuid == *001057 ]] && rm -f "$d/lost.json"; fi ;;
    *) dry_log "$1 $2" ;;
  esac
  return 0
}

access_account() { # access_account [soft]: acct, the account of the ONE active zone that owns the main hostname; needs the resolved token.
  # soft (a listing): a token for another account warns in one line and returns 1, so ls and status never die on it
  [[ -n $acct ]] && return 0
  [[ ${1:-} == soft && -n ${access_soft_warned:-} ]] && return 1   # a soft miss already warned once this run
  [[ -n $api_token ]] || { access_no_token >&2; exit 1; }
  local n why=""
  if [[ ${1:-} == soft ]]; then zone_name="${zone_name:-$(cfg zone || true)}"; zone_name="${zone_name:-${host_name#*.}}"; else host_zone; fi
  cf_try GET "/zones?name=$zone_name&status=active"
  n="$(jq -r '.result | length' <<<"$cf_body" 2>/dev/null || echo 0)"
  if [[ $cf_code != 200 ]]; then why="$(access_scope_line 'Zone: Read')"
  elif [[ $n != 1 ]]; then why="the token sees $n active zones named $zone_name; use a token scoped to the account that owns $host_name"; fi
  if [[ -n $why ]]; then
    [[ ${1:-} == soft ]] || die "$why"
    [[ -z ${access_soft_warned:-} ]] && echo "share: $why; skipping the Access check" >&2
    access_soft_warned=1; return 1
  fi
  acct="$(jq -r '.result[0].account.id' <<<"$cf_body")"
}
access_apps_edit_ok() { # the preflight's Apps Edit probe alone: the invalid body {} answers 400 (12130) only with the scope, and creates nothing
  cf_try POST "/accounts/$acct/access/apps" '{}'
  [[ $cf_code == 400 && $cf_err == 12130 ]]
}
access_read_proven=0
access_proof() { # once per process: a token without the Access read scope answers 404 to any app id, so a 404 proves nothing until this passes
  [[ $access_read_proven == 1 ]] && return 0
  cf_try GET "/accounts/$acct/access/organizations"
  [[ $cf_code == 200 ]] || return 1
  access_read_proven=1
}
access_preflight() { # read-only, safe to rerun: the token source, then one call per scope, one line each on stderr; 0 only when every line is ok.
  # The Apps Edit probe is an invalid body ({}): a 400 with code 12130 proves the scope without creating anything (measured on a live account).
  local fails=0 n z
  api_token_resolve
  z="$(cfg zone || true)"; z="${z:-${host_name#*.}}"
  echo "share: checking the API token for profile ${profile:-default} (zone $z)" >&2
  if [[ -z $api_token ]]; then   # before any lookup: the guided block needs no network
    printf '  %-8s token found\n' MISSING >&2
    access_no_token >&2
    return 1
  fi
  printf '  %-8s token found (%s)\n' ok "$api_token_src" >&2
  host_zone
  cf_try GET "/zones?name=$zone_name&status=active"
  n="$(jq -r '.result | length' <<<"$cf_body" 2>/dev/null || echo 0)"
  if [[ $cf_code == 200 && $n == 1 ]]; then
    acct="$(jq -r '.result[0].account.id' <<<"$cf_body")"
    printf '  %-8s %-62s GET /zones?name=%s -> 1 zone\n' ok "Zone: Read" "$zone_name" >&2
  elif [[ $cf_code == 200 && $n -gt 1 ]]; then
    printf '  %-8s ambiguous: %s active zones named %s; use a token scoped to the account that owns %s\n' MISSING "$n" "$zone_name" "$host_name" >&2; fails=1
  else
    printf '  %-8s %-62s GET /zones?name=%s -> %s\n' MISSING "Zone: Read" "$zone_name" "$cf_code" >&2; fails=1
  fi
  if [[ -n $acct ]]; then
    cf_try GET "/accounts/$acct/access/organizations"
    if [[ $cf_code == 200 ]]; then
      printf '  %-8s %-62s GET /accounts/<acct>/access/organizations -> 200\n' ok "Access: Organizations, Identity Providers, and Groups Read" >&2
    elif [[ $cf_err == 9999 ]]; then
      printf '  %-8s %s\n' MISSING "$(access_enable_line)" >&2; fails=1
    else
      printf '  %-8s %-62s GET /accounts/<acct>/access/organizations -> %s\n' MISSING "Access: Organizations, Identity Providers, and Groups Read" "${cf_err:-$cf_code}" >&2; fails=1
    fi
    cf_try POST "/accounts/$acct/access/apps" '{}'
    if [[ $cf_code == 400 && $cf_err == 12130 ]]; then
      printf '  %-8s %-62s POST /accounts/<acct>/access/apps {} -> 400 (12130, nothing created)\n' ok "Access: Apps and Policies Edit" >&2
    elif [[ $cf_err == 9999 ]]; then
      printf '  %-8s %s\n' MISSING "$(access_enable_line)" >&2; fails=1
    elif [[ $cf_err == 10000 ]]; then
      printf '  %-8s %-62s POST /accounts/<acct>/access/apps {} -> 10000\n' MISSING "Access: Apps and Policies Edit" >&2; fails=1
    else
      printf '  could not check  Access: Apps and Policies Edit (%s); rerun: %s api-token --check\n' "$cf_code${cf_err:+/$cf_err}" "$me" >&2; fails=1
    fi
  fi
  [[ $fails == 0 ]] && return 0
  echo "  fix: add the missing permission to this token at https://dash.cloudflare.com/?to=/:account/api-tokens (account API tokens), then run: $me api-token --check" >&2
  return 1
}
access_prepare() { # for add --access, before any write: the preflight (the guided block or a scope line), the sweep, then the include JSON
  access_preflight || exit 1
  access_sweep
  [[ ${access_rule%%:*} == group ]] && access_group_id "${access_rule#*:}"
  access_include_json
}
access_group_id() { # access_group_id <name>: sets access_group_out from an exact name match over every page; none or two is a refusal
  local page=1 pages=1 ids="" n
  while :; do
    cf_try GET "/accounts/$acct/access/groups?name=$1&page=$page&per_page=100"
    [[ $cf_code == 200 ]] || die "$(access_scope_line 'Access: Organizations, Identity Providers, and Groups Read')"
    ids="$ids $(jq -r --arg n "$1" '.result[] | select(.name == $n) | .id' <<<"$cf_body" | tr '\n' ' ')"
    pages="$(jq -r '.result_info.total_pages // 1' <<<"$cf_body")"
    [[ $page -lt $pages ]] || break
    page=$((page + 1))
  done
  n="$(wc -w <<<"$ids" | tr -d ' ')"
  case $n in
    0) access_group_missing "$1" >&2; exit 1 ;;
    1) access_group_out="${ids// /}" ;;
    *) die "two Access groups are named '$1'; rename one" ;;
  esac
}
access_group_missing() { # the dashboard path is quoted from Cloudflare docs, "Rule groups"
  cat <<EOF
share: no Access group named '$1' on the account that owns $zone_name.
  Create it once (share never creates groups):
  Cloudflare dashboard > Zero Trust > Access controls > Policies > Rule groups tab > Add a group
    Name: $1
    Include > Selector: Emails > Value: each address (one per entry)
    Save
  then rerun the same $me add.
EOF
}

# the pending file: <share id>\t<app uuid or -:<nonce>>\t<owner pid>\t<owner start>\t<created epoch>; every read and write under the index lock
proc_start() { LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//'; }   # pinned: a locale or zone never changes a start another process compares (DEC-23, DEC-34)
proc_start_local() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//'; }   # the caller's own format, which a pre-upgrade CLI wrote
own_start() { [[ -n $own_start_v ]] || own_start_v="$(proc_start $$)"; echo "$own_start_v"; }
pending_add() { # pending_add <id> <app> [created] [owner pid]: an owner of 0 (a deferred delete) is dead by definition, so the next sweep claims it
  local o="${4-$$}" st="-"; o="${o:-0}"   # an empty fourth argument means "no owner", never this pid
  [[ $o == 0 ]] || st="$(own_start)"
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$o" "$st" "${3:-$(date +%s)}" >>"$pending"
}
pending_has() { grep -qF "$(printf '%s\t%s\t%s\t%s\t' "$1" "$2" "$$" "$(own_start)")" "$pending" 2>/dev/null; }
pending_has_id() { grep -q "^$1"$'\t' "$pending" 2>/dev/null; }
pending_drop() { # pending_drop <id> <app>: this process's exact line only
  [[ -f $pending ]] || return 0
  local tmp; tmp="$(mktemp "$root/.pending.XXXXXX")"
  grep -vF "$(printf '%s\t%s\t%s\t%s\t' "$1" "$2" "$$" "$(own_start)")" "$pending" >"$tmp" || true
  mv -f "$tmp" "$pending"
}
pending_drop_id() { # pending_drop_id <id> <app>: every line for that app, whoever owns it; the app is gone
  [[ -f $pending ]] || return 0
  local tmp; tmp="$(mktemp "$root/.pending.XXXXXX")"
  awk -F'\t' -v id="$1" -v app="$2" '!($1 == id && $2 == app)' "$pending" >"$tmp"
  mv -f "$tmp" "$pending"
}
pending_set_app() { # pending_set_app <id> <old> <new>: rewrite this process's exact line; 1 when a sweep claimed or removed it
  pending_has "$1" "$2" || return 1
  local tmp; tmp="$(mktemp "$root/.pending.XXXXXX")"
  awk -F'\t' -v OFS='\t' -v id="$1" -v old="$2" -v new="$3" -v pid="$$" -v st="$(own_start)" \
    '$1 == id && $2 == old && $3 == pid && $4 == st {$2 = new} {print}' "$pending" >"$tmp"
  mv -f "$tmp" "$pending"
}
pending_line_ok() { [[ $1 =~ ^[0-9a-f]{6}$ ]] && [[ $2 =~ ^[0-9a-f-]{36}$ || $2 =~ ^-:[0-9a-f]{8}$ ]] && [[ $3 =~ ^[0-9]+$ ]]; }
pending_state() { # pending_state <line>: intent (an add before its app exists), bound (the app is known, the owner runs), deferred (owner 0: a delete waiting for a token), orphan (the owner died), bad (a hand-edited line)
  local id app pid st created
  IFS=$'\t' read -r id app pid st created <<<"$1"
  if ! pending_line_ok "$id" "$app" "$created"; then echo bad
  elif [[ $pid == 0 ]]; then echo deferred
  elif owner_live "$pid" "$st"; then case $app in -:*) echo intent ;; *) echo bound ;; esac
  else echo orphan; fi
}
pending_count() { # pending_count [<state>...]: no argument counts every non-empty line; `live` the well-formed ones; state names (intent bound deferred orphan bad) count the lines in any of them
  local line n=0 w st
  [[ -f $pending ]] || { echo 0; return 0; }
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    case ${1:-} in
      "") n=$((n + 1)) ;;
      live) [[ $(pending_state "$line") == bad ]] || n=$((n + 1)) ;;
      *) st="$(pending_state "$line")"; for w in "$@"; do if [[ $st == "$w" ]]; then n=$((n + 1)); break; fi; done ;;
    esac
  done <"$pending"
  echo "$n"
}
owner_live() { # owner_live <pid> <start>: alive, a share process, and the same start time (pid reuse, share serve included)
  [[ $1 != 0 ]] || return 1   # kill -0 0 would signal the process group and answer yes
  kill -0 "$1" 2>/dev/null && [[ $(ps -o command= -p "$1" 2>/dev/null) == *share* ]] || return 1
  [[ "$(proc_start "$1")" != "$2" ]] || return 0
  # one release only (DEC-34; drop in the release after next): a start a pre-upgrade CLI wrote in this same environment
  [[ -n $2 && "$(proc_start_local "$1")" == "$2" ]]
}

# --- the .health cache (G10): what the last token check and the last Worker probe saw ---
# $config_dir/.health is one JSON file, mode 600, never a secret: {token: {source, verified_at, expires_on, verify}, worker: {pair, deploy, at},
# gates: {at, missing}, min_cli}. Each writer replaces only its own top-level key (jq, tmp + mv -f), so a key another writer owns survives
# (SPEC-009 adds a members key). `state` reads it and never refreshes it: it stays read-only and makes no network call.
health="$config_dir/.health"
health_put() { # health_put <key> <json>: this key only; a failure is ignored, the cache is advisory
  [[ -d $config_dir && -d $root ]] || return 0   # never create a profile dir for a cache: a half-set-up profile would list as a ghost
  local tmp cur='{}'
  lock_take config
  tmp="$(mktemp "$config_dir/.health.XXXXXX" 2>/dev/null)" || { lock_release config; return 0; }
  chmod 600 "$tmp" 2>/dev/null || true
  [[ ! -f $health ]] || cur="$(cat "$health" 2>/dev/null || echo '{}')"
  if jq -c --arg k "$1" --argjson v "$2" '(if type == "object" then . else {} end) | .[$k] = $v' <<<"$cur" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$health" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  lock_release config
  return 0
}
tok_source="" tok_status="" tok_expires="" cmp_status="" cmp_worker="" cmp_min=""
token_source() { # sets tok_source to the first token source that exists (cmd, keychain, file, env), nothing when none: existence only, never a value, never a command run
  tok_source=""
  if [[ -n "$(cfg api_token_cmd || true)$(cfg r2_token_cmd || true)" ]]; then tok_source="cmd"
  elif command -v security >/dev/null && security find-generic-password -a share -s "$(api_token_key)" >/dev/null 2>&1; then tok_source="keychain"
  elif [[ -s $api_token_file ]]; then tok_source="file"
  elif [[ -n ${CLOUDFLARE_API_TOKEN:-}${SHARE_R2_TOKEN:-} ]]; then tok_source="env"; fi
  return 0
}
token_state() { # token_state: tok_source, tok_status (missing, unchecked, invalid, expired, expiring, ok; empty when this profile uses no token), tok_expires; reads only
  local c_verify="" c_at=0 c_exp="" c_src="" c_epoch="" now
  tok_status="" tok_expires=""
  token_source
  [[ $r2on == 1 || $backend == r2 || -n $tok_source ]] || return 0   # a plain tunnel profile with no token has nothing to report
  [[ -n $tok_source ]] || { tok_status=missing; return 0; }
  now="${SHARE_STATE_NOW:-$(date +%s)}"
  if [[ -f $health ]]; then
    IFS=$'\037' read -r c_verify c_at c_exp c_src c_epoch < <(jq -r '(.token // {}) as $t
      | [($t.verify // ""), (($t.verified_at // 0) | tostring), ($t.expires_on // ""), ($t.source // ""),
         (try ($t.expires_on | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | tostring) catch "")] | join("\u001f")' "$health" 2>/dev/null) || true
  fi
  [[ $c_at =~ ^[0-9]+$ ]] || c_at=0
  # a cache written for another source describes another token; one older than a week no longer vouches for the verdict,
  # but an expires_on is a hard date for the same token, so it keeps counting
  if [[ $c_src != "$tok_source" || $c_at -eq 0 ]]; then c_verify="" c_exp="" c_epoch=""
  elif [[ $((now - c_at)) -gt 604800 ]]; then c_verify=""; fi
  tok_expires=$c_exp
  if [[ $c_epoch =~ ^[0-9]+$ && $c_epoch -le $now ]]; then tok_status=expired
  elif [[ $c_verify == invalid ]]; then tok_status=invalid
  elif [[ $c_epoch =~ ^[0-9]+$ && $((c_epoch - now)) -le 1209600 ]]; then tok_status=expiring
  elif [[ -z $c_verify ]]; then tok_status=unchecked
  else tok_status=ok; fi
  return 0
}
ver_lt() { # ver_lt <a> <b>: a < b as dotted numbers; a non-numeric part counts as 0
  awk -v a="$1" -v b="$2" 'BEGIN { na = split(a, x, "."); nb = split(b, y, "."); n = na > nb ? na : nb
    for (i = 1; i <= n; i++) { p = x[i] + 0; q = y[i] + 0; if (p < q) exit 0; if (p > q) exit 1 } exit 1 }'
}
compat_state() { # compat_state: cmp_status (ok, worker_older, worker_newer, cli_below_min, unknown), cmp_worker (the Worker's "<version> <sha>" pair), cmp_min (min_cli); empty status when this profile has no Worker
  local wv
  cmp_status="" cmp_worker="" cmp_min=""
  [[ $r2on == 1 || $backend == r2 ]] || return 0
  if [[ -f $health ]]; then
    IFS=$'\037' read -r cmp_worker cmp_min < <(jq -r '[(.worker.pair // ""), (.min_cli // "")] | join("\u001f")' "$health" 2>/dev/null) || true
  fi
  wv="${cmp_worker%% *}"
  if [[ $cmp_min =~ ^[0-9]+(\.[0-9]+)*$ ]] && ver_lt "$SHARE_VERSION" "$cmp_min"; then cmp_status=cli_below_min
  elif [[ $wv =~ ^[0-9]+$ ]]; then
    if [[ $wv -lt $WORKER_VERSION ]]; then cmp_status=worker_older
    elif [[ $wv -gt $WORKER_VERSION ]]; then cmp_status=worker_newer
    else cmp_status=ok; fi
  else cmp_status=unknown; fi
  return 0
}
token_json() { # state.token: {source, status, expires_on}, null when this profile uses no token
  token_state
  [[ -n $tok_status ]] || { echo null; return 0; }
  jq -nc --arg s "$tok_source" --arg st "$tok_status" --arg e "$tok_expires" '{source: (if $s == "" then null else $s end), status: $st, expires_on: (if $e == "" then null else $e end)}'
}
compat_json() { # state.compat: {cli, worker, status, min_cli}, null when this profile has no Worker
  compat_state
  [[ -n $cmp_status ]] || { echo null; return 0; }
  jq -nc --arg c "$SHARE_VERSION" --arg w "$cmp_worker" --arg st "$cmp_status" --arg m "$cmp_min" \
    '{cli: $c, worker: (if $w == "" then null else $w end), status: $st, min_cli: (if $m == "" then null else $m end)}'
}
health_token_put() { # health_token_put ok|invalid [expires_on]: what a verify call just saw, under the current source
  token_source
  [[ -n $tok_source ]] || return 0
  health_put token "$(jq -nc --arg s "$tok_source" --argjson t "$(date +%s)" --arg e "${2:-}" --arg v "$1" \
    '{source: $s, verified_at: $t, expires_on: (if $e == "" then null else $e end), verify: $v}')"
}
health_worker_put() { # health_worker_put: the Worker pair the last healthz answered (hz_pair, hz_deploy)
  [[ $hz_code == 200 && $hz_pair =~ ^[0-9]+\ [0-9a-f]{12}$ ]] || return 0
  health_put worker "$(jq -nc --arg p "$hz_pair" --arg d "${hz_deploy:-}" --argjson t "$(date +%s)" '{pair: $p, deploy: $d, at: $t}')"
}

# --- the step journal: one file per running multi-step verb, $root/ops/<verb>.<pid>.json (DEC-5) ---
# op_begin before the first step, op_step <n> at each step, op_done on success. A die or a signal leaves the
# file at the step it reached; the next run of the verb reports it and runs from step 1 again, each step
# skipping what is already in place. The file never holds a token, a secret, or a single-use code.
op_verb="" op_file="" op_of=0 op_n=0 op_name="" op_started=0 op_conc=0 op_rerun_json='[]' op_rerun="" op_rollback_json="" op_rollback=""
op_prev_step="" op_prev_name=""   # op_prev_name: the step name a resuming verb reads (SPEC-009's join)
op_steps_setup_tunnel() { printf '%s\n' "1 auth" "2 tunnel" "3 route" "4 dns" "5 token" "6 config" "7 service" "8 live"; }
op_steps_setup_r2() { printf '%s\n' "1 alias" "2 worker" "3 bucket" "4 alias-domain" "5 routes" "6 snapshot" "7 alias-apps" "8 deploy" \
  "9 pointers" "10 access" "11 config" "12 marker" "13 route" "14 alias-bind" "15 probe" "16 handoff"; }
op_steps_add() { printf '%s\n' "1 pointer" "2 publish" "3 access" "4 host" "5 gate" "6 row"; }
op_steps_no_r2() { printf '%s\n' "1 route" "2 config"; }
op_steps_teardown() { printf '%s\n' "1 gated" "2 service" "3 dns" "4 hosts" "5 tunnel" "6 token" "7 config"; }
op_steps_teardown_purge() { printf '%s\n' "1 shares" "2 records" "3 marker" "4 domain" "5 worker" "6 bucket" "7 local"; }
op_steps_migrate() { printf '%s\n' "1 copy" "2 switch" "3 verify" "4 retire" "5 dns" "6 tunnel" "7 token"; }
op_steps() { # op_steps <verb>: its "n name" lines; nothing for a verb with no list
  local f="op_steps_${1//-/_}"
  if declare -F "$f" >/dev/null; then "$f"; fi
  return 0
}
op_argv_json() { # op_argv_json <arg>...: a JSON array of strings, one jq per argument so a newline or quote survives
  local a s out=""
  for a in "$@"; do s="$(printf '%s' "$a" | jq -Rs .)"; out="${out:+$out,}$s"; done
  printf '[%s]' "$out"
}
op_display() { # op_display <arg>...: "share" plus each argument through printf %q; for reading only, never run
  local a q out=share
  for a in "$@"; do printf -v q '%q' "$a"; out="$out $q"; done
  printf '%s' "$out"
}
op_read() { # op_read <file>: op_r_* from one v1 journal file; 1 for a file that is not one (truncated, not JSON, an unknown v)
  local line
  op_r_pid="" op_r_start="" op_r_step="" op_r_of="" op_r_name="" op_r_verb="" op_r_rerun="" op_r_rollback=""
  line="$(jq -r 'select(.v == 1) | [.pid, .start, .step, .of, .name, .verb, .rerun, (.rollback // "")] | map(tostring) | join("\u001f")' "$1" 2>/dev/null)" || return 1
  [[ -n $line ]] || return 1
  IFS=$'\037' read -r op_r_pid op_r_start op_r_step op_r_of op_r_name op_r_verb op_r_rerun op_r_rollback <<<"$line"
  [[ $op_r_pid =~ ^[0-9]+$ && $op_r_step =~ ^[0-9]+$ && $op_r_of =~ ^[0-9]+$ ]]
}
op_write() { # the journal file at the current step, tmp + mv; a failed write (disk full) is ignored: the journal never blocks its verb
  [[ -n $op_file ]] || return 0
  local tmp="$root/ops/.$op_verb.$$.json.tmp"
  if jq -nc --arg verb "$op_verb" --argjson step "$op_n" --argjson of "$op_of" --arg name "$op_name" --argjson pid "$$" \
      --arg start "$(own_start)" --argjson started "$op_started" --argjson rerun_argv "$op_rerun_json" --arg rerun "$op_rerun" \
      --argjson id "${op_id_json:-null}" --arg rb "$op_rollback" --argjson rb_argv "${op_rollback_json:-null}" \
      '{v: 1, verb: $verb, step: $step, of: $of, name: $name, pid: $pid, start: $start, started: $started,
        rerun_argv: $rerun_argv, id: $id, rerun: $rerun} + (if $rb_argv == null then {} else {rollback_argv: $rb_argv, rollback: $rb} end)' \
      >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$op_file" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp" 2>/dev/null
  fi
  return 0
}
op_begin() { # op_begin <verb> [--concurrent] <rerun args...> [-- <rollback args...>]: refuse a live run of the same verb, report and clear a dead one, write step 0
  local verb=$1 a inrb=0 f rerun=() rb=() pfx=(); shift
  op_conc=0; if [[ ${1:-} == --concurrent ]]; then op_conc=1; shift; fi
  for a in "$@"; do
    if [[ $inrb == 0 && $a == -- ]]; then inrb=1; elif [[ $inrb == 1 ]]; then rb+=("$a"); else rerun+=("$a"); fi
  done
  [[ -z $profile ]] || pfx=(--profile "$profile")
  op_verb=$verb op_n=0 op_name="" op_prev_step="" op_prev_name="" op_started="$(date +%s)"
  op_of="$(op_steps "$verb" | grep -c . || true)"
  op_rerun_json="$(op_argv_json ${pfx[@]+"${pfx[@]}"} ${rerun[@]+"${rerun[@]}"})"
  op_rerun="$(op_display ${pfx[@]+"${pfx[@]}"} ${rerun[@]+"${rerun[@]}"})"
  op_rollback_json="" op_rollback=""
  if [[ ${#rb[@]} -gt 0 ]]; then
    op_rollback_json="$(op_argv_json ${pfx[@]+"${pfx[@]}"} "${rb[@]}")"; op_rollback="$(op_display ${pfx[@]+"${pfx[@]}"} "${rb[@]}")"
  fi
  mk_root; mkdir -p "$root/ops" 2>/dev/null && chmod 700 "$root/ops" 2>/dev/null
  op_file="$root/ops/$verb.$$.json"
  if [[ $op_conc == 0 ]]; then   # one owner at a time: a live run of this verb refuses; a dead one is reported and removed
    lock_take ops
    for f in "$root/ops/$verb".*.json; do
      [[ -e $f && $f != "$op_file" ]] || continue
      if op_read "$f"; then
        if owner_live "$op_r_pid" "$op_r_start"; then
          lock_release ops; op_file=""
          die_code op_running "$verb is already running (pid $op_r_pid, step $op_r_step of $op_r_of); wait for it to finish" "$me state"
        fi
        echo "previous $verb died at step $op_r_step ($op_r_name); continuing"
        # shellcheck disable=SC2034 # op_prev_name is read by the resuming verbs SPEC-009 adds
        if [[ -z $op_prev_step || $op_r_step -gt $op_prev_step ]]; then op_prev_step=$op_r_step op_prev_name=$op_r_name; fi
      fi
      rm -f "$f"   # transient bookkeeping, like the pidfile: never to the Trash (DEC-24)
    done
  fi
  op_write
  [[ $op_conc == 1 ]] || lock_release ops
}
op_step() { # op_step <n>: the step this run reached; SHARE_PROGRESS=1 prints one progress line; SHARE_OP_PAUSE=<verb>:<n> holds here (test seam)
  [[ -n $op_file ]] || return 0
  op_n=$1 op_name="$(op_steps "$op_verb" | awk -v n="$1" '$1 == n {print $2; exit}')"
  op_write
  if [[ ${SHARE_PROGRESS:-} == 1 ]]; then   # unprefixed, so a reader of the last "share: " line never takes it for the error
    jq -nc --arg v "$op_verb" --argjson n "$op_n" --argjson of "$op_of" --arg name "$op_name" '{progress: {verb: $v, step: $n, of: $of, name: $name}}' >&2 2>/dev/null || true
  fi
  if [[ ${SHARE_OP_PAUSE:-} == "$op_verb:$1" ]]; then   # held at this step until the release file appears, 60 s at most
    local rel="$root/.op-release-$op_verb-$1" w=0
    while [[ ! -e $rel && $w -lt 300 ]]; do sleep 0.2; w=$((w + 1)); done
    rm -f "$rel"
  fi
  return 0
}
op_done() { # op_done: this run's file goes; a success also removes every dead journal of the profile, except dead adds, which only prune consumes (DEC-33)
  [[ -n $op_file ]] || return 0
  rm -f "$op_file"; op_file=""
  [[ $op_conc == 0 ]] || return 0   # a concurrent verb (add) runs no sweep of its own
  local f
  lock_take ops
  for f in "$root/ops/"*.json; do
    [[ -e $f ]] || continue
    case ${f##*/} in add.*) continue ;; esac
    op_read "$f" || continue   # a file this share cannot read (a newer CLI's?) goes only with the next run of its own verb
    owner_live "$op_r_pid" "$op_r_start" && continue   # another process's live run is never touched
    rm -f "$f"
  done
  lock_release ops
}
ops_dead() { # ops_dead <verb>: 0 when a dead journal of that verb is on disk
  local f
  for f in "$root/ops/$1".*.json; do
    [[ -e $f ]] || continue
    if op_read "$f" && owner_live "$op_r_pid" "$op_r_start"; then continue; fi
    return 0
  done
  return 1
}
ops_json() { # state.ops: [{verb, step, of, name, alive, rerun, rerun_argv, rollback?, rollback_argv?}]; reads only
  local f o alive out=""
  for f in "$root/ops/"*.json; do
    [[ -e $f ]] || continue
    o=""
    if op_read "$f"; then
      alive=false; owner_live "$op_r_pid" "$op_r_start" && alive=true
      o="$(jq -c --argjson alive "$alive" '{verb, step, of, name, alive: $alive, rerun, rerun_argv}
        + (if has("rollback_argv") then {rollback, rollback_argv} else {} end)' "$f" 2>/dev/null)" || o=""
    fi
    [[ -n $o ]] || o='{"verb":"?","alive":false}'
    out="${out:+$out,}$o"
  done
  printf '[%s]' "$out"
}
ops_status() { # status: one line per journal file; a dead op names its rerun, and its rollback when it has one
  local f
  for f in "$root/ops/"*.json; do
    [[ -e $f ]] || continue
    if ! op_read "$f"; then echo "op:         ${f##*/} is not a journal this share reads; the next run of its verb removes it"; continue; fi
    if owner_live "$op_r_pid" "$op_r_start"; then echo "$op_r_verb running (pid $op_r_pid): step $op_r_step of $op_r_of ($op_r_name)"
    else echo "$op_r_verb stopped at step $op_r_step of $op_r_of ($op_r_name); rerun: $op_r_rerun${op_r_rollback:+; or roll back: $op_r_rollback}"; fi
  done
  return 0
}

access_create() { # access_create <id> [fqdn]: the intent line, the app, its uuid into the line, then a read-back; sets access_app and access_aud
  local nonce name dests body
  nonce="${access_nonce:-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')}"   # an r2 gated add passes its prefix nonce
  name="share $1 $host_name $nonce"   # the nonce is the last word: a lookup by name can never match an older app for the same id
  lock_take index; pending_add "$1" "-:$nonce"; lock_release index
  dests="[{\"type\":\"public\",\"uri\":\"$host_name/$1\"},{\"type\":\"public\",\"uri\":\"$host_name/$1/*\"}]"
  [[ -n ${2:-} ]] && dests="$(jq -c --arg u "$2" '. + [{type:"public", uri:$u}]' <<<"$dests")"
  body="$(jq -nc --arg name "$name" --arg pname "share $1" --argjson d "$dests" --argjson inc "$access_include" \
    '{name:$name, type:"self_hosted", destinations:$d, app_launcher_visible:false, session_duration:"24h",
      policies:[{name:$pname, decision:"allow", include:$inc, precedence:1}]}')"
  cf_try POST "/accounts/$acct/access/apps" "$body"
  [[ $cf_code != 000 ]] || die "the Cloudflare API did not answer the Access app create for $1; nothing was published (the next '$me prune' with the token finds or forgets it); rerun the same $me add"
  [[ $cf_err != 9999 ]] || die "$(access_enable_line)"
  [[ $cf_err != 10000 ]] || die "$(access_scope_line 'Access: Apps and Policies Edit')"
  [[ $cf_code == 2* ]] || die "Cloudflare API POST access/apps failed ($cf_code): $(jq -c '.errors' <<<"$cf_body" 2>/dev/null || head -c 300 <<<"$cf_body"); rerun the same $me add"
  access_app="$(jq -r '.result.id // empty' <<<"$cf_body")"; access_aud="$(jq -r '.result.aud // empty' <<<"$cf_body")"
  [[ $access_app =~ ^[0-9a-f-]{36}$ && -n $access_aud ]] || die "the Access app create for $1 answered without an id or aud; see '$me prune' with the token to clean up; rerun the same $me add"
  lock_take index
  if ! pending_set_app "$1" "-:$nonce" "$access_app"; then
    lock_release index; access_delete "$access_app" "$1" || true
    die "a sweep claimed the Access app of $1 while it was created; nothing was published; rerun the same $me add"
  fi
  lock_release index
  cf_try GET "/accounts/$acct/access/apps/$access_app"   # a stored app is checked, not assumed
  if ! jq -e --argjson d "$dests" '([.result.destinations[].uri] | sort) == ([$d[].uri] | sort) and ((.result.policies // []) | length) > 0' <<<"$cf_body" >/dev/null 2>&1; then
    if access_delete "$access_app" "$1"; then lock_take index; pending_drop "$1" "$access_app"; lock_release index; fi
    die "the Access app for $1 did not read back as sent (destinations or policy); it was deleted, nothing was published; rerun the same $me add"
  fi
}
access_delete() { # access_delete <uuid> <share id>: only an app whose name says it is this share's; 404 is done; anything else (000 included) is not
  local name
  access_deleted_nonce=""
  cf_try GET "/accounts/$acct/access/apps/$1"
  if [[ $cf_code == 404 ]]; then access_proof; return; fi   # done only once Access read is proven: a scope-less token 404s on every id
  [[ $cf_code == 200 ]] || return 1
  name="$(jq -r '.result.name // empty' <<<"$cf_body")"
  local a al ok=0; al="$(cfg aliases || true)"
  for a in "$host_name" ${al//,/ }; do [[ $name == "share $2 $a "* ]] && ok=1; done   # a folded app keeps the name it got at its alias
  if [[ $ok == 0 ]]; then   # a forged row or line must never delete a foreign app with an account-wide token
    echo "share: Access app $1 is not the app of share $2 (its name is '$name'); left alone" >&2
    return 1
  fi
  access_deleted_nonce="${name##* }"   # on r2 the app's nonce is its upload's: the sweep deletes o/<id>.<nonce>/ by it
  cf_try DELETE "/accounts/$acct/access/apps/$1"
  [[ $cf_code == 2* || $cf_code == 404 ]]
}
access_find_by_nonce() { # access_find_by_nonce <nonce>: sets access_found to the app whose name ends in " <nonce>", over every page; 1 when the list could not be read
  local page=1 pages
  access_found=""
  while :; do
    cf_try GET "/accounts/$acct/access/apps?page=$page&per_page=100"
    [[ $cf_code == 200 ]] || return 1
    access_found="$(jq -r --arg s " $1" 'first(.result[] | select(.name | endswith($s)) | .id) // empty' <<<"$cf_body")"
    [[ -n $access_found ]] && return 0
    pages="$(jq -r '.result_info.total_pages // 1' <<<"$cf_body")"
    [[ $page -lt $pages ]] || return 0
    page=$((page + 1))
  done
}

access_probe_round() { # access_probe_round <aud> <url>...: one probe per url; 0 when every one redirects to Access with kid == aud
  local aud="$1" u out code redir host rest kid ok=1 result; shift
  probe_round=$((probe_round + 1))
  if [[ ${SHARE_ACCESS_DRY:-0} == 1 ]]; then   # the fixture's next line, the last one repeating; nothing there is a pass
    result="$(sed -n "${probe_round}p" "$root/access-probe-fixture" 2>/dev/null || true)"
    [[ -n $result ]] || result="$(tail -1 "$root/access-probe-fixture" 2>/dev/null || true)"
    result="${result:-pass}"
    dry_log "PROBE $result"
    [[ $result == pass ]]; return
  fi
  for u in "$@"; do
    host="${u#https://}"; host="${host%%/*}"
    # a failed curl still prints its -w line ("000 "), so the fallback replaces the output instead of appending to it
    out="$(curl -s -o /dev/null --max-time 10 --doh-url https://1.1.1.1/dns-query -w '%{http_code} %{redirect_url}' "$u?share_gate=$(rand_id_raw)" 2>/dev/null)" ||
      out="$(curl -s -o /dev/null --max-time 10 -w '%{http_code} %{redirect_url}' "$u?share_gate=$(rand_id_raw)" 2>/dev/null)" || out=""
    code="${out%% *}"; redir="${out#* }"
    [[ $code == 30? && $redir =~ ^https://[a-z0-9-]+\.cloudflareaccess\.com/cdn-cgi/access/login/ ]] || { ok=0; continue; }
    rest="${redir#*/cdn-cgi/access/login/}"
    [[ ${rest%%[/?]*} == "$host" ]] || ok=0
    kid="$(sed -n 's/.*[?&]kid=\([^&]*\).*/\1/p' <<<"$redir")"
    [[ $kid == "$aud" ]] || ok=0
  done
  [[ $ok == 1 ]]
}
access_gate() { # access_gate <id> <aud> [fqdn]: every gated URL must pass three rounds in a row; 1 when SHARE_ACCESS_WAIT runs out
  local wait="$access_wait" poll="${SHARE_ACCESS_POLL:-10}" start now streak=0 last_msg=0 urls s
  urls="https://$host_name/$1/ https://$host_name/$1"
  [[ -n ${3:-} ]] && urls="$urls https://$3/"
  start="$(date +%s)"; last_msg="$start"   # the next notice comes after 60 s of waiting
  echo "share: waiting up to ${wait}s for Cloudflare Access to enforce on $host_name/$1 (a new app can take minutes; Ctrl-C is safe: nothing is published, the next add or prune removes the app)" >&2
  held_access_id="$1"
  while :; do
    # shellcheck disable=SC2086 # the url list is space-separated on purpose
    if access_probe_round "$2" $urls; then
      streak=$((streak + 1)); [[ $streak -ge 3 ]] && return 0
    else
      streak=0
    fi
    now="$(date +%s)"
    [[ $((now - start)) -lt $wait ]] || return 1
    if [[ $((now - last_msg)) -ge 60 ]]; then
      echo "share: waiting for Cloudflare Access to enforce on $host_name/$1 (new apps can take several minutes)" >&2; last_msg="$now"
    fi
    s=5; [[ $streak == 0 || ${SHARE_ACCESS_DRY:-0} == 1 ]] && s="$poll"   # confirmation rounds 5 s apart; the poll interval until the first pass
    sleep "$s"
  done
}

access_link_check() { # access_link_check <url>: after publish, the link itself must answer the Access challenge (302 or 403) within SHARE_ACCESS_POST_WAIT seconds (default 30); 1 when it still answers anything else at the timeout
  local wait="${SHARE_ACCESS_POST_WAIT:-30}" poll="${SHARE_ACCESS_POST_POLL:-2}" start now code n=0
  start="$(date +%s)"
  while :; do
    n=$((n + 1))
    if [[ ${SHARE_ACCESS_DRY:-0} == 1 ]]; then   # the fixture's next line, the last one repeating; no fixture is a 302
      code="$(sed -n "${n}p" "$root/access-link-fixture" 2>/dev/null || true)"
      [[ -n $code ]] || code="$(tail -1 "$root/access-link-fixture" 2>/dev/null || true)"
      code="${code:-302}"
      echo "$code" >>"$root/access-link-checks"
    else
      code="$(curl -s -o /dev/null --max-time 10 --doh-url https://1.1.1.1/dns-query -w '%{http_code}' "$1" 2>/dev/null)" ||
        code="$(curl -s -o /dev/null --max-time 10 -w '%{http_code}' "$1" 2>/dev/null)" || code=000
    fi
    code="${code%% *}"
    [[ $code == 302 || $code == 403 ]] && return 0
    access_link_code="$code"
    now="$(date +%s)"
    [[ $((now - start)) -lt $wait ]] || return 1
    sleep "$poll"
  done
}
access_link_code=""
access_link_die() { # access_link_die <id> <url>: the published link answered no Access challenge in time; it stays published, the message names the way out
  die "the gated link $1 answered HTTP ${access_link_code:-000} instead of the Access login after ${SHARE_ACCESS_POST_WAIT:-30}s: at some Cloudflare edges it may be readable without the login. Unpublish it now with '$me rm $1', or check $2 yourself and rerun"
}

access_sweep() { # every pending line: a live owner is skipped, a finished add's stale line dropped, the rest claimed under the lock
  # (orphaned bytes trashed first), then each app deleted with no lock held. A line that is not done stays claimed by
  # this process; once it exits, the next sweep sees a dead owner and retries.
  [[ -s $pending ]] || return 0
  local id app pid st created tmp reload=0 claimed="" uuid mcode="" r2side
  lock_take index
  tmp="$(mktemp "$root/.pending.XXXXXX")"
  while IFS=$'\t' read -r id app pid st created; do
    [[ -n $id && -n $app ]] || continue
    # a hand-edited line is kept but never acted on: its id would become a path, its app a DELETE
    if ! pending_line_ok "$id" "$app" "$created"; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$app" "$pid" "$st" "$created" >>"$tmp"; continue
    fi
    if owner_live "$pid" "$st"; then printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$app" "$pid" "$st" "$created" >>"$tmp"; continue; fi
    # the add finished: a stale line. On r2 a fresh GET m/<id> decides below, outside the lock
    [[ $backend != r2 && "$(opt_val access "$(row "$id" | cut -f6)" || true)" == "$app" ]] && continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$app" "$$" "$(own_start)" "$created" >>"$tmp"
    claimed="$claimed$id $app $created"$'\n'
    if [[ $backend != r2 && -z "$(row "$id")" ]]; then   # orphaned bytes, or a live route an rm whose reload failed left in the running Caddy
      [[ -e $pub/$id ]] && { to_trash "$pub/$id"; dry_log "TRASH $id"; }
      reload=1
    fi
  done <"$pending"
  mv -f "$tmp" "$pending"
  if [[ $reload == 1 ]]; then
    write_caddyfile
    caddy_reload || { lock_release index; echo "share: the waiting Access apps stay until Caddy reloads (see $root/caddy.log), then: $me prune" >&2; return 0; }
  fi
  lock_release index
  while read -r id app created; do
    [[ -n $id ]] || continue
    uuid="$app"
    if [[ $app == -:* ]]; then
      access_proof || continue   # an app list read without the scope is empty and proves nothing
      access_find_by_nonce "${app#-:}" || continue
      uuid="$access_found"
      if [[ -z $uuid ]]; then   # a POST can still commit after the client timeout: only an old line is forgotten
        [[ $(( $(date +%s) - created )) -gt 600 ]] || continue
        lock_take index; pending_drop "$id" "$app"; lock_release index
        continue
      fi
    fi
    # an origin with R2 on decides per id: a line with no local row may be a gated --cloud add, which takes the r2 rule
    r2side=0; [[ $backend == r2 || ( $r2on == 1 && -z "$(row "$id")" ) ]] && r2side=1
    mcode=""
    if [[ $r2side == 1 ]]; then   # never the snapshot: a record naming this app is a finished add; a 404 frees the app; anything else keeps the line
      r2_call GET "m/$id"; mcode=$cf_code
      if [[ $cf_code == 200 && "$(jq -r '.opts // ""' <<<"$cf_body" 2>/dev/null | tr ' ' '\n' | sed -n 's/^access=//p')" == "$uuid" ]]; then
        lock_take index; pending_drop "$id" "$app"; lock_release index
        continue
      fi
      [[ $cf_code == 200 || $cf_code == 404 ]] || continue   # a record naming another app is another publisher's share
    fi
    if access_delete "$uuid" "$id"; then
      lock_take index; pending_drop "$id" "$app"; lock_release index
      # the upload of an add that never published: its own nonce only, never another publisher's prefix
      if [[ $r2side == 1 && $mcode == 404 && $access_deleted_nonce =~ ^[0-9a-f]{8}$ ]]; then
        (r2_delete_prefix "o/$id.$access_deleted_nonce/") >/dev/null 2>&1 || true
      fi
    fi
  done <<<"$claimed"
}

access_pending_note() { # ls and status: apps waiting for a token, and lines no sweep will ever touch
  local n b; n="$(pending_count deferred orphan)"; b="$(pending_count bad)"
  [[ $n -gt 0 ]] && echo "share: $n Access app(s) await deletion; run '$me prune' with a token (the stored one, or CLOUDFLARE_API_TOKEN)" >&2
  [[ $b -gt 0 ]] && echo "share: $b malformed line(s) in $pending; a sweep never acts on them; remove them by hand" >&2
  return 0
}
access_ls_check() { # with an exported CLOUDFLARE_API_TOKEN only (never op read or a prompt from a listing): a gated row whose app is gone is PUBLIC
  [[ $backend == r2 ]] && return 0   # on r2 a missing app leaves the link closed: the Worker checks the JWT itself
  local pairs id app missing=""
  api_token_resolve env
  [[ -n $api_token && -n $host_name ]] || return 0
  pairs="$(rows | awk -F'\t' '{n = split($6, a, " "); for (i = 1; i <= n; i++) if (substr(a[i], 1, 7) == "access=") print $1, substr(a[i], 8)}')"
  if [[ -z $pairs ]]; then gates_put ""; return 0; fi   # no gated row: an older "missing" list is stale
  access_account soft || return 0
  access_proof || return 0   # a 404 from a token without the Access read scope would call every gated link PUBLIC
  while read -r id app; do
    [[ -n $id ]] || continue
    cf_try GET "/accounts/$acct/access/apps/$app"
    if [[ $cf_code == 404 ]]; then echo "share: Access app for $id is gone; the link is PUBLIC; $me rm $id" >&2; missing="$missing $id"; fi
  done <<<"$pairs"
  gates_put "$missing"   # a check that ran; state reads it as link_state gate_missing and never makes the call itself
  return 0
}
gates_put() { # gates_put "<ids>": the gated rows whose Access app the last check found gone (G7); an empty list clears an older one
  health_put gates "$(jq -nc --arg m "$1" --argjson t "$(date +%s)" '{at: $t, missing: ($m | split(" ") | map(select(length > 0)))}')"
}

cmd_api_token() { # cmd_api_token [--cmd '<command>' | --check]: store a token command, a hidden paste, or stdin; then the read-only preflight
  need_host
  [[ $mode != quick ]] || access_named_only
  local usage="usage: share api-token [--cmd '<command>' | --check]" tok="" url
  case ${1:-} in
    --check) [[ $# -eq 1 ]] || die "$usage" ;;
    --cmd)
      [[ $# -eq 2 && -n $2 ]] || die "$usage"
      case $2 in *$'\n'*|*$'\r'*) die "$usage" ;; esac   # a line break would inject a second config line
      if [[ $backend == r2 || $r2on == 1 ]]; then   # the command's token is checked before the command is stored
        tok="$(eval "$2" 2>/dev/null)" || tok=""
        [[ -n $tok ]] || die "the command printed no token; run it by hand to see why; nothing was stored"
        r2_publisher_check "$tok"; tok=""
      fi
      config_put api_token_cmd "api_token_cmd=$2"
      echo "token:      api_token_cmd stored in $config (no secret written)" ;;
    "")
      if [[ $backend == r2 ]]; then url="$(r2_publisher_token_url)"; else url="$(access_token_url)"; fi
      if [[ -t 0 ]]; then
        if [[ $backend == r2 ]]; then
          echo "Create the publisher token in the Cloudflare dashboard: the form is prefilled with Zone: Read and the name;"
          echo "  add Workers R2 Storage Bucket Item Write with the resource bucket $(cfg bucket || true) only (a link cannot preset a bucket), set an expiry, click Create."
        elif [[ $r2on == 1 ]]; then   # an origin with R2 on: the Access scopes stay required, the bucket scope is added by hand
          echo "Create the token in the Cloudflare dashboard: the form is prefilled with the Access scopes, pick the account that owns $host_name;"
          echo "  add Workers R2 Storage Bucket Item Write with the resource bucket $(cfg bucket || true) only (a link cannot preset a bucket), set an expiry, click Create."
        else
          echo "Create the token in the Cloudflare dashboard: the form is prefilled, pick the account that owns $host_name, click Create."
        fi
        echo "  $url"
        access_open_url "$url"
        read -rs -p "Paste the new token (input hidden): " tok; echo
      else
        IFS= read -r tok || true
      fi
      [[ -n $tok ]] || die "no token entered; rerun: $me api-token"
      if [[ $backend == r2 || $r2on == 1 ]]; then r2_publisher_check "$tok"; fi
      api_token_store "$tok"   # direct call: a bad token dies here, never reaches the preflight
      echo "token:      $api_token_store_out"
      tok="" ;;
    *) die "$usage" ;;
  esac
  if [[ $backend == r2 ]]; then   # the bucket token is enough for ungated links; the Access scopes are reported, not required
    if [[ ${1:-} == --check ]]; then
      api_token_resolve
      [[ -n $api_token ]] || die "no token for $host_name; store one: $me api-token"
      r2_publisher_check "$api_token"
    fi
    echo "share: a publisher token for bucket $(cfg bucket || true): not an admin token, no other bucket in reach" >&2
    r2_expiry_note
    access_preflight || echo "share: ungated adds work with this token; gated adds and their removal also need the Access scopes above" >&2
    return 0
  fi
  if [[ $r2on == 1 ]]; then   # an origin with R2 on: the same publisher refusals, and the Access scopes stay required (SPEC-004)
    if [[ ${1:-} == --check ]]; then
      api_token_resolve
      [[ -n $api_token ]] || die "no token for $host_name; store one: $me api-token"
      r2_publisher_check "$api_token"
    fi
    echo "share: a publisher token for bucket $(cfg bucket || true): not an admin token, no other bucket in reach" >&2
    r2_expiry_note
  fi
  access_preflight
}
r2_expiry_note() { # r2_expiry_note: the publisher token's expires_on from /user/tokens/verify; a warning 14 days ahead, since an expired token stops every add (on an origin with R2 on, local adds too)
  local e left
  api_token_resolve
  [[ -n $api_token ]] || return 0
  r2_api GET /user/tokens/verify
  case $cf_code in 401|403) health_token_put invalid ;; esac
  [[ $cf_code == 200 ]] || return 0
  e="$(jq -r '.result.expires_on // empty' <<<"$cf_body" 2>/dev/null)" || return 0
  health_token_put ok "$e"
  [[ -n $e ]] || return 0
  left="$(jq -rn --arg e "$e" '(($e | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) - now) / 86400 | floor' 2>/dev/null)" || return 0
  [[ $left =~ ^-?[0-9]+$ ]] || return 0
  if [[ $left -lt 0 ]]; then
    echo "share: the publisher token expired on ${e%%T*}; every add to $host_name fails until a new one is stored: $me api-token" >&2
  elif [[ $left -le 14 ]]; then
    echo "share: the publisher token expires on ${e%%T*} (in $left days); then every add to $host_name fails; mint a new one and store it: $me api-token" >&2
  fi
  return 0
}
r2_publisher_check() { # r2_publisher_check <token> [env]: before a publisher token is stored or used from CLOUDFLARE_API_TOKEN, refuse one that edits the Worker (admin) or lists another bucket (account-wide R2)
  local ep a worker="share-${host_name//./-}" bucket others tail="nothing was stored"
  [[ ${2:-} != env ]] || tail="the token came from CLOUDFLARE_API_TOKEN; unset it or store a publisher token with $me api-token; nothing was changed"
  bucket="$(cfg bucket || true)"
  ep="$(cfg r2_endpoint || true)"; a="${ep#https://}"; a="${a%%.*}"
  [[ -n $ep && $a =~ ^[A-Za-z0-9-]+$ ]] || die "the profile config has no r2_endpoint; rerun $me setup $host_name --backend r2 --bucket $bucket"
  api_token="$1"
  r2_api GET "/accounts/$a/workers/scripts/$worker/settings"
  case $cf_code in
    200) die "that token can edit Worker $worker: it is an admin token, which stays in CLOUDFLARE_API_TOKEN for setup only; store a token with Workers R2 Storage Bucket Item Write on bucket $bucket only; $tail" ;;
    401|403) ;;
    *) die "checking the token against Worker $worker answered HTTP $cf_code; $tail" ;;
  esac
  r2_api GET "/accounts/$a/r2/buckets"
  case $cf_code in
    200) others="$(jq -r --arg b "$bucket" '[(.result.buckets // [])[].name | select(. != $b)] | join(" ")' <<<"$cf_body" 2>/dev/null || echo '?')"
      [[ -z $others ]] || die "that token reaches other buckets ($others): an account-wide R2 token; store a token with Workers R2 Storage Bucket Item Write on bucket $bucket only; $tail" ;;
    401|403) ;;
    *) die "listing buckets with the token answered HTTP $cf_code; $tail" ;;
  esac
  api_token=""
}
access_open_url() { # the platform opener, backgrounded; skipped over ssh or with no display, so a text browser never fights the hidden prompt
  local opener
  [[ -z ${SSH_CONNECTION:-} ]] || return 0
  if [[ $(uname -s) == Darwin ]]; then opener=open
  else [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || return 0; opener=xdg-open; fi
  command -v "$opener" >/dev/null || return 0
  ( trap "" HUP; nohup "$opener" "$1" >/dev/null 2>&1 & )   # survives the terminal closing mid-run
  return 0
}

# --- r2 backend ---
# A profile with backend=r2 publishes snapshots to a private R2 bucket; a Worker
# serves them on the profile's hostname. The config holds backend=r2 and the
# port=r2 sentinel: an older share dies on that port at load, so it can never
# write pub/ or an Access app against an r2 profile.

WORKER_VERSION=5            # bump on every Worker source change; deploys refuse a downgrade without --force
WORKER_SHA=682fa73390b1     # first 12 hex of the emitted source's sha256; the suite fails when it drifts
WORKER_COMPAT_DATE=2026-09-30   # moves only with a WORKER_VERSION bump
WORKER_RECORD_V=3           # the record schema this source understands: v:1 cloud records, v:2 and v:3 machine pointers; a newer record answers 404
worker_meta() { printf '%s\n' "$WORKER_VERSION" "$WORKER_SHA" "$WORKER_COMPAT_DATE" "$WORKER_RECORD_V"; }   # one line, four fields, for the deploy and sweep paths

worker_js() { # worker_js <path>: the Worker source to $1; never a heredoc inside $( ) (macOS /bin/bash 3.2)
  cat >"$1" <<'SHARE_WORKER_JS'
// share Worker: serves R2-backed snapshots on one hostname, a gated record only
// inside a valid Cloudflare Access session for that record's app. With PASS set (a tenant
// with R2 on) it runs as a route in front of the tenant's tunnel: a cloud record is served
// from R2, a machine pointer or a miss passes through to the origin, and an alias host 301s.
// A member's pointer (v:3) reaches that member's machine through the deploy's M_<8hex> binding;
// POST /_share/redeem hands out a sealed invite once.
const TYPES = {
  html: "text/html", css: "text/css", js: "text/javascript", mjs: "text/javascript",
  json: "application/json", txt: "text/plain", md: "text/markdown", csv: "text/csv",
  xml: "application/xml", svg: "image/svg+xml", png: "image/png", jpg: "image/jpeg",
  jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp", ico: "image/x-icon",
  pdf: "application/pdf", mp4: "video/mp4", webm: "video/webm", mp3: "audio/mpeg",
  wav: "audio/wav", woff: "font/woff", woff2: "font/woff2", zip: "application/zip",
  wasm: "application/wasm",
};

let jwks = { ts: 0, keys: null };   // isolate-global cert cache, one hour
let jwksFetch = 0;                  // a refetch at most once a minute, failures never cached

const b64u = (s) => {
  s = s.replace(/-/g, "+").replace(/_/g, "/");
  while (s.length % 4) s += "=";
  const bin = atob(s);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
};
const b64json = (s) => JSON.parse(new TextDecoder().decode(b64u(s)));

async function certs(env, kid) {
  const now = Date.now();
  const want = !jwks.keys || now - jwks.ts > 3600e3 || !jwks.keys.some((k) => k.kid === kid);
  if (want && now - jwksFetch >= 60e3) {
    jwksFetch = now;
    try {
      const r = await fetch("https://" + env.TEAM + "/cdn-cgi/access/certs");
      if (r.ok) {
        const j = await r.json();
        if (Array.isArray(j.keys) && j.keys.length) jwks = { ts: now, keys: j.keys };
      }
    } catch { /* a failed fetch is never cached */ }
  }
  return jwks.keys || [];
}

async function gatedOk(request, env, rec) {
  if (!env.TEAM) return false;
  if (typeof rec.aud !== "string" || !/^[0-9a-f]{64}$/.test(rec.aud)) return false;
  const jwt = request.headers.get("cf-access-jwt-assertion");
  if (!jwt) return false;
  const p = jwt.split(".");
  if (p.length !== 3) return false;
  const head = b64json(p[0]);
  if (head.alg !== "RS256" || typeof head.kid !== "string" || !head.kid) return false;
  const body = b64json(p[1]);
  if (body.iss !== "https://" + env.TEAM) return false;
  const auds = Array.isArray(body.aud) ? body.aud : [body.aud];
  if (!auds.includes(rec.aud)) return false;
  if (typeof body.exp !== "number" || body.exp * 1000 <= Date.now()) return false;
  if (body.nbf !== undefined && (typeof body.nbf !== "number" || body.nbf * 1000 > Date.now())) return false;
  const jwk = (await certs(env, head.kid)).find((k) => k.kid === head.kid && k.kty === "RSA");
  if (!jwk) return false;
  const key = await crypto.subtle.importKey("jwk",
    { kty: "RSA", n: jwk.n, e: jwk.e, ext: jwk.ext },
    { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" }, false, ["verify"]);
  return crypto.subtle.verify({ name: "RSASSA-PKCS1-v1_5" }, key, b64u(p[2]),
    new TextEncoder().encode(p[0] + "." + p[1]));
}

const isGated = (rec) =>
  (typeof rec.aud === "string" && rec.aud !== "") ||
  (typeof rec.opts === "string" && rec.opts.split(/\s+/).some((o) => o.startsWith("access=")));

const hex = async (s) => {
  const d = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s)));
  return [...d].map((b) => b.toString(16).padStart(2, "0")).join("");
};

// Worker v5: one pure route() before any read, one pure decide() per record, and a named row on every answer.
// Every 404 carries the same body and no header names the row: a per-row answer would tell which 24-bit ids exist.
const ROW = Object.freeze(Object.fromEntries([
  "ALIAS_301", "WRONG_HOST", "BAD_PATH", "HEALTHZ", "PASS_NON_ID", "PASS_MISS", "BAD_JSON", "PASS_V2", "V2_EXPIRED", "BAD_RECORD",
  "GATE_DENIED", "V3_PAUSED", "V3_UNBOUND", "V3_DOWN", "V3_METHOD", "V3_EXPIRED", "V3_SERVED", "REDEEM_OK", "REDEEM_METHOD",
  "REDEEM_BAD_BODY", "REDEEM_UNKNOWN", "REDEEM_EXPIRED", "REDEEM_UNAVAILABLE", "SHARE_PATH_UNKNOWN", "CLOUD_OBJECT",
].map((r) => [r, r])));
const NOT_FOUND = "no such link (it may have expired or been removed)";
const OFFLINE = "the machine serving this link is offline; try again later";
const PAUSED_TEXT = "this link is paused by the tenant admin";
const MISS = Symbol("miss"), BAD_JSON = Symbol("bad json");   // decide()'s record when the read found nothing, or found no JSON
const ORIGIN = /^m-[a-z0-9-]{2,24}-[0-9a-f]{8}$/;
const V3_WAIT_MS = 10000;   // a member listener that never answers is offline after this; cleared once headers arrive (TASK-1a(d))
const INVITE_DAYS = 30;     // an invite that expires further ahead than this was not written by share
const INERT = /^(image\/(?!svg)|audio\/|video\/|application\/pdf$|text\/plain$|application\/octet-stream$)/;
const SANDBOX = "sandbox allow-scripts allow-forms allow-popups allow-downloads";
const PASS_HEADERS = ["accept-ranges", "content-length", "content-range", "content-encoding", "content-disposition", "content-language",
  "etag", "last-modified", "location", "date", "vary"];

const rowOf = new WeakMap();   // the row of each answer; read by tests only, never a header
const passed = new WeakSet();  // answers that set their own headers: the origin's, a member machine's; no hit counted
const tag = (row, resp) => { rowOf.set(resp, row); return resp; };
const plain = (row, status, headers = {}) => tag(row, status === 404
  ? new Response(NOT_FOUND, { status, headers: { "Content-Type": "text/plain; charset=utf-8", ...headers } })
  : new Response(null, { status, headers }));

const getish = (request) => request.method === "GET" || request.method === "HEAD";
const tailOf = (request) => {
  const u = new URL(request.url);
  return request.url.slice(request.url.indexOf(u.hostname) + u.hostname.length).replace(/^:\d+/, "");
};
const typeOf = (path) => {   // the Worker's type for a path: a folder (trailing /) is an index or listing
  if (path.endsWith("/")) return "text/html";
  const last = path.split("/").pop(), dot = last.lastIndexOf(".");
  return (dot > 0 && TYPES[last.slice(dot + 1).toLowerCase()]) || "application/octet-stream";
};
const pausedSet = (env) => {   // a malformed PAUSED pauses every member link: only the admin's deploy writes it, so it fails closed
  if (!env.PAUSED) return [];
  try { const p = JSON.parse(env.PAUSED); return Array.isArray(p) ? p : null; } catch { return null; }
};

function route(request, env) { // pure: every row decided before a bucket read; { read } names the read the request needs
  const u = new URL(request.url), tail = tailOf(request);
  const aliases = (env.ALIASES || "").split(",").map((a) => a.trim()).filter(Boolean);
  if (aliases.includes(u.hostname)) {
    return getish(request) ? { row: ROW.ALIAS_301, status: 301, location: "https://" + env.HOST + tail.split("#")[0] } : { row: ROW.ALIAS_301, status: 405 };
  }
  if (u.hostname !== env.HOST) return { row: ROW.WRONG_HOST, status: 404 };
  const raw = tail.split(/[?#]/)[0] || "/";
  if (raw === "/_share/redeem") return request.method === "POST" ? { read: "redeem" } : { row: ROW.REDEEM_METHOD, status: 405 };
  if (raw === "/_share" || raw.startsWith("/_share/")) return { row: ROW.SHARE_PATH_UNKNOWN, status: 404 };
  if (!env.PASS && !getish(request)) return { row: ROW.BAD_PATH, status: 405 };
  if (/%2f|%5c|%2e|%0[0-9a-f]|%1[0-9a-f]/i.test(raw) || raw.includes("//")) return { row: ROW.BAD_PATH, status: 400 };
  if (raw === "/healthz") return { row: ROW.HEALTHZ, status: getish(request) ? 200 : 405 };
  const id = u.pathname.split("/")[1];
  if (!/^[0-9a-f]{6}$/.test(id)) return { row: ROW.PASS_NON_ID, status: env.PASS ? "pass" : 404 };
  return { read: "m/" + id, id };
}

function decide(request, env, rec, now = Date.now() / 1000) { // pure: the row for a link request, given its m/<id> record (MISS, BAD_JSON, or the parsed value)
  const id = new URL(request.url).pathname.split("/")[1];
  if (rec === MISS) return { row: ROW.PASS_MISS, status: env.PASS ? "pass" : 404 };
  if (rec === BAD_JSON) return { row: ROW.BAD_JSON, status: 404 };
  const obj = rec !== null && typeof rec === "object";
  if (obj && rec.v === 2 && rec.storage === "machine") {   // the origin's pointer
    if (typeof rec.expires === "number" && rec.expires > 0 && now > rec.expires) return { row: ROW.V2_EXPIRED, status: 404 };
    return { row: ROW.PASS_V2, status: env.PASS ? "pass" : 404 };
  }
  if (obj && rec.v === 3) {   // a member's pointer: routed by the deploy's binding for its origin's suffix, never by the record alone
    if (rec.storage !== "machine" || rec.id !== id || typeof rec.origin !== "string" || !ORIGIN.test(rec.origin) || typeof rec.expires !== "number") {
      return { row: ROW.BAD_RECORD, status: 404 };
    }
    if (rec.expires > 0 && now > rec.expires) return { row: ROW.V3_EXPIRED, status: 404 };
    const sfx = rec.origin.slice(-8), paused = pausedSet(env);
    if (paused === null || paused.includes(sfx)) return { row: ROW.V3_PAUSED, status: 503 };
    const b = env["M_" + sfx];
    if (!b || typeof b.fetch !== "function") return { row: ROW.V3_UNBOUND, status: 404 };
    if (!getish(request)) return { row: ROW.V3_METHOD, status: 405 };
    return { row: ROW.V3_SERVED, status: "bind", binding: "M_" + sfx };
  }
  // a cloud record is v:1 with no storage key; any other shape answers 404 and never reaches the origin
  if (!obj || rec.v !== 1 || "storage" in rec || rec.id !== id || typeof rec.prefix !== "string" ||
    !new RegExp("^o/" + id + "\\.[0-9a-f]{8}/$").test(rec.prefix) || (rec.expires > 0 && now > rec.expires)) {
    return { row: ROW.BAD_RECORD, status: 404 };
  }
  return { row: ROW.CLOUD_OBJECT, status: "serve", gated: isGated(rec) };
}

function settleV3(answer, id, path) { // pure: a member machine's answer (null when the fetch threw or timed out) to its row
  if (!answer || !answer.headers.has("x-share-served")) return { row: ROW.V3_DOWN, status: 503 };
  const loc = answer.headers.get("location");
  if (answer.status >= 300 && answer.status < 400 && loc !== null) {
    let ok = false;   // a relative path, or an absolute path under /<id>/; never another host or scheme
    if (!/^[a-z][a-z0-9+.-]*:/i.test(loc) && !loc.startsWith("//") && !loc.includes("\\")) {
      try {
        const to = new URL(loc, "http://h.invalid" + path);
        ok = to.host === "h.invalid" && (to.pathname === "/" + id + "/" || to.pathname.startsWith("/" + id + "/"));
      } catch { ok = false; }
    }
    if (!ok) return { row: ROW.V3_SERVED, status: 502 };
  }
  return { row: ROW.V3_SERVED, status: answer.status };
}

function decideRedeem(body, env, mo, now = Date.now() / 1000) { // pure: the redeem row before the claim; mo is MISS, BAD_JSON, or the envelope
  if (!/^[0-9a-f]{64}$/.test(body)) return { row: ROW.REDEEM_BAD_BODY, status: 400 };
  if (mo === MISS || mo === BAD_JSON || mo === null || typeof mo !== "object") return { row: ROW.REDEEM_UNKNOWN, status: 404 };
  if (mo.v !== 1 || typeof mo.member_id !== "string" || !ORIGIN.test(mo.member_id) || typeof mo.expires !== "number" ||
    typeof mo.sealed !== "string" || !mo.sealed || typeof mo.mac !== "string" || !/^[0-9a-f]{64}$/.test(mo.mac)) {
    return { row: ROW.REDEEM_UNKNOWN, status: 404 };   // a claimed envelope keeps no sealed bytes, so it lands here too
  }
  if (now > mo.expires) return { row: ROW.REDEEM_EXPIRED, status: 410 };
  if (mo.expires > now + INVITE_DAYS * 86400) return { row: ROW.REDEEM_UNKNOWN, status: 404 };
  return { row: ROW.REDEEM_OK, status: "claim" };
}

async function pass(request) {   // the route is skipped for a same-host fetch, so this reaches the tunnel (spike TASK-1a)
  let r;
  try { r = await fetch(request); } catch { r = null; }
  if (r && r.status === 101) { passed.add(r); return r; }   // a WebSocket upgrade goes back untouched
  // an edge error carries no cf-cache-status; the origin's own answers do (spike TASK-1a(e)).
  // 502 is never one of Cloudflare's own edge codes (521-527, 530): it is Caddy's reverse_proxy
  // answer for a dead live port, a working machine, so it goes back unchanged like any other origin answer.
  const down = !r || r.status === 530 || (r.status >= 520 && r.status <= 527) ||
    (r.status === 503 && !r.headers.has("cf-cache-status"));
  const out = down
    ? new Response(OFFLINE, { status: 503, headers: { "Retry-After": "60", "Content-Type": "text/plain; charset=utf-8" } })
    : new Response(r.body, r);   // rewrapped: a fetch answer's headers are immutable
  out.headers.delete("X-Share-Served");   // the origin Caddy's marker stays between the Worker and the machine
  out.headers.set("Cache-Control", "no-store");
  out.headers.set("X-Robots-Tag", "noindex, nofollow");
  passed.add(out);
  return out;
}

const capped = (p, ms) => {   // a bucket read that hangs counts as a failed one
  let t;
  return Promise.race([p, new Promise((_, rej) => { t = setTimeout(() => rej(new Error("slow")), ms); })]).finally(() => clearTimeout(t));
};

async function readJson(env, key) { // MISS for an absent or unreadable object (the read failed or hung), BAD_JSON for a body that is not JSON
  let mo;
  try { mo = await capped(env.BUCKET.get(key), 2000); } catch { mo = null; }
  if (mo === null) return { rec: MISS, mo: null };
  try { return { rec: await mo.json(), mo }; } catch { return { rec: BAD_JSON, mo }; }
}

async function redeem(request, env) { // row 3: POST /_share/redeem with h; the envelope once, claimed then deleted
  let body = "";   // 64 hex: a declared length over 128 is refused unread
  if (Number(request.headers.get("content-length") || 0) <= 128) {
    try { body = new TextDecoder().decode((await request.arrayBuffer()).slice(0, 128)); } catch { body = ""; }
  }
  const pre = decideRedeem(body, env, MISS);
  if (pre.row === ROW.REDEEM_BAD_BODY) return plain(pre.row, pre.status);
  const key = "i/" + body;
  let got;
  try {
    const mo = await capped(env.BUCKET.get(key), 2000);
    got = mo === null ? { rec: MISS, mo } : await mo.text().then((t) => { try { return { rec: JSON.parse(t), mo, text: t }; } catch { return { rec: BAD_JSON, mo }; } });
  } catch { return plain(ROW.REDEEM_UNAVAILABLE, 503); }
  const d = decideRedeem(body, env, got.rec);
  if (d.row === ROW.REDEEM_EXPIRED) {
    try { await env.BUCKET.delete(key); } catch { /* the sweep in member sync deletes it later */ }
    return plain(d.row, d.status);
  }
  if (d.row !== ROW.REDEEM_OK) return plain(d.row, d.status);
  let claimed;   // only one of two concurrent redeems wins the conditional put; the claim keeps expires for the sweep
  try {
    claimed = await env.BUCKET.put(key, JSON.stringify({ v: 1, member_id: got.rec.member_id, expires: got.rec.expires, claimed: Math.floor(Date.now() / 1000) }),
      { onlyIf: { etagMatches: got.mo.etag } });
  } catch { return plain(ROW.REDEEM_UNAVAILABLE, 503); }
  if (claimed === null) return plain(ROW.REDEEM_UNKNOWN, 404);
  try { await env.BUCKET.delete(key); } catch { return plain(ROW.REDEEM_UNAVAILABLE, 503); }   // the sealed bytes stay unreturned; the claim stays
  return tag(ROW.REDEEM_OK, new Response(got.text, { status: 200, headers: { "Content-Type": "application/json" } }));
}

async function member(request, env, d, id) { // row 15: GET or HEAD through the member's binding, with only content-negotiation headers
  const tail = tailOf(request).split("#")[0], path = tail.split("?")[0];
  const headers = new Headers();
  for (const [k, v] of request.headers) {
    const n = k.toLowerCase();
    if (n === "range" || n.startsWith("if-") || n.startsWith("accept") || n === "user-agent") headers.set(k, v);
  }
  const ac = new AbortController(), timer = setTimeout(() => ac.abort(), V3_WAIT_MS);
  let r;
  try {
    r = await env[d.binding].fetch(new Request("http://" + env.HOST + tail, { method: request.method, headers, redirect: "manual", signal: ac.signal }),
      { signal: ac.signal });   // TASK-1a(d) sampled fetch(req, {signal}); the Request carries it too
  } catch { r = null; } finally { clearTimeout(timer); }   // cleared once the headers arrive: a long body is never cut at the timer
  const s = settleV3(r, id, path);
  if (s.row === ROW.V3_DOWN) {
    return tag(s.row, new Response(OFFLINE, { status: 503, headers: { "Retry-After": "60", "Content-Type": "text/plain; charset=utf-8" } }));
  }
  const keep = new Headers();   // an allowlist: no cookie, auth prompt, HSTS, Link, Refresh or Clear-Site-Data from a member machine
  const redirect = s.status >= 300 && s.status < 400;   // Location only on a 3xx, the one settleV3 checked
  if (s.status !== 502) for (const h of PASS_HEADERS) if (r.headers.has(h) && (h !== "location" || redirect)) keep.set(h, r.headers.get(h));
  const out = new Response(s.status === 502 ? null : r.body, { status: s.status, statusText: s.status === 502 ? "" : r.statusText, headers: keep });
  // the member's Caddy never picks the type: XHTML, XML or a sniffed answer would run script on this origin. The sandbox goes on
  // unless both the path's type and the type the machine answered are inert (an answer with no type is not inert)
  const type = typeOf(path), said = ((r && r.headers.get("content-type")) || "").split(";")[0].trim().toLowerCase();
  out.headers.set("Content-Type", type);
  out.headers.set("X-Content-Type-Options", "nosniff");
  if (!INERT.test(type) || !INERT.test(said)) out.headers.set("Content-Security-Policy", SANDBOX);
  out.headers.set("Cache-Control", "no-store");
  out.headers.set("X-Robots-Tag", "noindex, nofollow");
  passed.add(out);   // never counted as a hit
  return tag(s.row, out);
}

async function handle(request, env) {
  const u = new URL(request.url);
  const rt = route(request, env);
  if (rt.read === "redeem") return redeem(request, env);
  if (rt.row === ROW.ALIAS_301 && rt.status === 301) return tag(rt.row, new Response(null, { status: 301, headers: { Location: rt.location } }));
  if (rt.row === ROW.HEALTHZ && rt.status === 200) {
    const headers = {
      "X-Share-Worker": (env.VERSION || "") + " " + (env.SHA || ""),
      "X-Share-Gate": env.TEAM ? "1" : "0",
    };
    if (env.DEPLOY) headers["X-Share-Deploy"] = env.DEPLOY;   // the deploy nonce: a deploy is live once this answers it
    if (!env.PASS) return tag(rt.row, new Response("ok", { status: 200, headers }));
    let up = false;   // the tunnel leg: the origin's own /healthz, through the same skipped route
    try {
      const r = await fetch("https://" + env.HOST + "/healthz", { signal: AbortSignal.timeout(3000) });
      up = r.status === 200 && (await r.text()).trim() === "ok";
    } catch { up = false; }
    headers["X-Share-Tunnel"] = up ? "1" : "0";
    return tag(rt.row, new Response(up ? "ok" : "tunnel down", { status: up ? 200 : 503, headers }));
  }
  if (!rt.read) return rt.status === "pass" ? tag(rt.row, await pass(request)) : plain(rt.row, rt.status);
  const { rec } = await readJson(env, rt.read);
  const d = decide(request, env, rec);
  if (d.status === "pass") return tag(d.row, await pass(request));
  if (d.status === "bind") return member(request, env, d, rt.id);
  if (d.row === ROW.V3_PAUSED) return tag(d.row, new Response(PAUSED_TEXT, { status: 503, headers: { "Content-Type": "text/plain; charset=utf-8" } }));
  if (d.status !== "serve") return plain(d.row, d.status);
  if (d.gated) {
    let ok = false;
    try { ok = await gatedOk(request, env, rec); } catch { ok = false; }
    if (!ok) return plain(ROW.GATE_DENIED, 404);
  }
  return tag(ROW.CLOUD_OBJECT, await cloud(request, env, rec, u));
}

async function cloud(request, env, rec, u) { // row 16: a cloud record's bytes from R2
  const id = rec.id, raw = tailOf(request).split(/[?#]/)[0] || "/";
  const segs = u.pathname.split("/");
  const nf = () => new Response(NOT_FOUND, { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
  if (!getish(request)) return new Response(null, { status: 405 });
  const rest = segs.slice(2);
  if (rest.length === 0) return new Response(null, { status: 308, headers: { Location: u.origin + "/" + id + "/" } });
  const cond = { range: request.headers, onlyIf: request.headers };
  const get = async (k) => {   // R2 throws on a Range past the end; that object answers 416 with its size
    try { return await env.BUCKET.get(k, cond); }
    catch (e) {
      const hd = request.headers.has("range") ? await env.BUCKET.head(k) : null;
      if (hd === null) throw e;
      return { unsat: hd.size };
    }
  };
  let dir;
  try { dir = rest.map(decodeURIComponent).join("/"); }
  catch { return new Response(null, { status: 400 }); }
  const redir = !raw.endsWith("/");
  let rel = redir ? dir : dir + "index.html";
  let obj = await get(rec.prefix + rel);
  if (obj === null && !redir) {
    obj = await get(rec.prefix + dir + "README.html");
    if (obj !== null) rel = dir + "README.html";
  }
  if (obj === null && redir &&
    (await env.BUCKET.head(rec.prefix + rel + "/index.html") !== null ||
      await env.BUCKET.head(rec.prefix + rel + "/README.html") !== null)) {
    return new Response(null, { status: 308, headers: { Location: u.origin + u.pathname + "/" + u.search } });
  }
  if (obj === null) return nf();
  if (obj.unsat !== undefined) return new Response(null, { status: 416, headers: { "Content-Range": `bytes */${obj.unsat}` } });
  if (obj.body === null) return new Response(null, { status: 412 });
  const h = new Headers();
  if (obj.writeHttpMetadata) obj.writeHttpMetadata(h);
  const ext = rel.split(".").pop().toLowerCase();
  const type = TYPES[ext] || "application/octet-stream";
  h.set("Content-Type", type);
  if (env.MEMBERS === "1" && /^(text\/html|image\/svg\+xml|application\/xml)$/.test(type)) {   // on T2 any publisher token writes any cloud record
    h.set("Content-Security-Policy", SANDBOX);
    h.set("X-Content-Type-Options", "nosniff");
  }
  let status = 200;   // R2 sets obj.range whenever a range option is passed, so only a request Range makes a 206
  if (request.headers.has("range") && obj.range) {
    const r = obj.range, sfx = r.suffix !== undefined;   // live R2 carries every key, unset ones undefined
    const start = sfx ? Math.max(0, obj.size - r.suffix) : (r.offset ?? 0), len = sfx ? obj.size - start : (r.length ?? obj.size - start);
    h.set("Content-Range", `bytes ${start}-${start + len - 1}/${obj.size}`);
    status = 206;
  }
  return new Response(request.method === "HEAD" ? null : obj.body, { status, headers: h });
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const id = (url.pathname.split("/")[1] || "");
    let resp;
    try { resp = await handle(request, env); }
    catch { resp = plain(ROW.BAD_RECORD, 404); }   // an unexpected throw fails closed
    if (passed.has(resp)) return resp;
    resp.headers.set("Cache-Control", "no-store");
    resp.headers.set("X-Robots-Tag", "noindex, nofollow");
    if (resp.status < 400 && url.pathname !== "/healthz" && rowOf.get(resp) === ROW.CLOUD_OBJECT &&
      env.HITS && env.SALT && /^[0-9a-f]{6}$/.test(id)) {
      const pseudo = (await hex(env.SALT + (request.headers.get("cf-connecting-ip") || ""))).slice(0, 16);
      ctx.waitUntil(Promise.resolve(env.HITS.writeDataPoint({ indexes: [id], blobs: [id, pseudo] })).catch(() => {}));
    }
    return resp;
  },
};
SHARE_WORKER_JS
}


r2_no_local() { # an r2 profile has no local server to run or manage
  [[ $backend != r2 ]] || die "an r2 profile serves from Cloudflare; nothing runs on this machine ('$me rm <id>' unpublishes a link)"
}

r2_token_check() { # every r2 publisher verb, before its first call: a token source resolves; the dry seam checks the source only
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    [[ -n ${SHARE_R2_TOKEN:-} || -n "$(cfg r2_token_cmd || true)" ]] && return 0
    api_token_resolve
    [[ -n $api_token ]] && { [[ $api_token_src != CLOUDFLARE_API_TOKEN ]] || r2_publisher_check "$api_token" env; return 0; }
  else
    r2_creds && return 0
  fi
  cat >&2 <<EOF
share: this r2 profile needs a publisher token for $host_name; none resolved.
  Store one (Workers R2 Storage Bucket Item Write on bucket $(cfg bucket || true) only):  $me api-token
  Or point at one you have:  $me api-token --cmd 'op read "op://<vault>/<item>/credential"'
EOF
  exit 1
}

r2_stage_check() { # r2_stage_check <stage>: the file cap, the per-file size cap, and no control byte, backslash, or double quote in a name, before the first PUT
  local LC_ALL=C f n=0 big max_files="${SHARE_R2_MAX_FILES:-500}" max_bytes="${SHARE_R2_MAX_BYTES:-314572800}"
  while IFS= read -r -d '' f; do
    n=$((n + 1))
    case $f in *[[:cntrl:]]*) die "a file name holds a control character ($(printf '%q' "${f#./}")); rename it; nothing was uploaded" ;; esac
    # curl unescapes -K config values, so a\.\./ could name a file outside the stage; the Worker refuses %5C anyway
    case $f in *[\\\"]*) die "a file name holds a backslash or a double quote (${f#./}); rename it; nothing was uploaded" ;; esac
  done < <(cd "$1" && find . -type f -print0)
  [[ $n -le $max_files ]] || die "$n files is over the r2 cap of $max_files per add (SHARE_R2_MAX_FILES); nothing was uploaded"
  big="$(cd "$1" && find . -type f -size +"${max_bytes}"c | head -1)"
  [[ -z $big ]] || die "${big#./} is over the r2 cap of $max_bytes bytes per file (SHARE_R2_MAX_BYTES); nothing was uploaded"
}

r2_prefix_matches() { # r2_prefix_matches <stage> <prefix>: the prefix listing equals the stage's file list, name for name
  local want got="" k
  want="$(cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"
  r2_list "$2"
  while IFS= read -r k; do [[ -n $k ]] && got+="${k#"$2"}"$'\n'; done <<<"$r2_list_out"
  [[ "$(printf '%s' "$got" | LC_ALL=C sort)" == "$want" ]]
}

r2_by() { local b; b="$(this_host | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9.-')"; echo "${b:-unknown}"; }   # the record's by=: rows() takes a-z 0-9 . - only

r2_nonce() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }   # 8 hex: one upload's prefix, o/<id>.<nonce>/

r2_release_prefix() { # r2_release_prefix <id> <prefix>: the EXIT trap's r2 part; an upload no record names is deleted, one a record names or an unread one stays
  r2_call GET "m/$1" || return 0
  case $cf_code in
    404) ;;
    200) [[ "$(jq -r '.prefix // empty' <<<"$cf_body" 2>/dev/null || true)" != "$2" ]] || return 0 ;;
    *) echo "share: m/$1 answered HTTP $cf_code; the upload under $2 stays until a $me prune removes it after 24 h" >&2; return 0 ;;
  esac
  ( r2_delete_prefix "$2" ) >/dev/null 2>&1 || echo "share: some objects under $2 remain; a $me prune removes them after 24 h" >&2
  return 0
}

share_type() { type_of "$1"; echo "$type_out"; }
type_of() { # type_of <path>: the file-type word for a link's source into type_out, first match wins; the extension match ignores case; no fork (state types every row)
  if [[ -d $1 ]]; then   # a published folder's generated listing is not a site of its own
    local l=""; [[ -f $1/index.html ]] && read -r l <"$1/index.html"
    if [[ -f $1/index.html && $l != *'<title>index</title>'* ]]; then type_out=site; else type_out=folder; fi
    return 0
  fi
  local nc=0; shopt -q nocasematch && nc=1; shopt -s nocasematch
  case ${1##*/} in
    *.html|*.htm) type_out=site ;;
    *.md|*.markdown) type_out=markdown ;;
    *.pdf) type_out=pdf ;;
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.svg|*.heic|*.ico|*.avif) type_out=image ;;
    *.mp4|*.mov|*.webm|*.m4v|*.mkv) type_out=video ;;
    *.mp3|*.wav|*.m4a|*.aac|*.flac|*.ogg) type_out=audio ;;
    *.zip|*.tar|*.gz|*.tgz|*.bz2|*.xz|*.7z|*.rar|*.dmg) type_out=archive ;;
    *.txt|*.csv|*.json|*.yaml|*.yml|*.toml|*.xml|*.log|*.sh|*.py|*.js|*.mjs|*.ts|*.go|*.rs|*.rb|*.swift|*.java|*.c|*.h|*.css|*.sql) type_out=text ;;
    *) type_out=other ;;
  esac
  [[ $nc == 1 ]] || shopt -u nocasematch
}
type_ok() { case ${1:-} in pdf|image|video|audio|folder|site|markdown|archive|text|other) return 0 ;; esac; return 1; }
optv() { # optv <key> <opts>: the value of a key=value token into optv_out, empty when absent; no fork
  local rest=" $2"
  optv_out="" rest="${rest#*" $1="}"
  [[ $rest == " $2" ]] || optv_out="${rest%% *}"
}

r2_menu_token() { # state (the menu poll): the bucket is read only with a stored publisher token (the Keychain item or the 600 file); never a command, which may prompt, never the environment
  [[ ${SHARE_API_TOKEN_OFF:-0} != 1 ]] || return 1
  [[ -z ${SHARE_R2_TOKEN:-} ]] || return 0   # the test seam stands for a stored token
  [[ -z "$(cfg r2_token_cmd || true)" && -z "$(cfg api_token_cmd || true)" ]] || return 1
  api_token_resolve
  [[ -n $api_token && $api_token_src != CLOUDFLARE_API_TOKEN ]]
}

list_bucket() { # list_bucket ls|state <local ids>: the bucket's display rows (fields split by \x1f), "#more <n>" first; run in a subshell, so a die becomes cloud_error
  local id name src date exp opts us=$'\x1f'
  if [[ $1 == state ]]; then
    r2_menu_token || die_code cloud_token_missing "the menu reads cloud links only with a stored token: $me api-token" "$me api-token"
    r2_read 25 "$2"
  elif [[ -z ${r2_snap_file:-} ]]; then r2_read; fi   # a member's ls reuses the read its prune made
  echo "#more ${r2_list_more:-0}"
  while IFS=$'\t' read -r id name src date exp opts; do
    case $'\n'"$2" in *$'\n'"$id"$'\n'*) echo "#shadow $id"; continue ;; esac   # a shadowed id lists its local row once, and link_state names it
    optv type "$opts"; type_out=$optv_out
    if ! type_ok "$type_out"; then if [[ $name == *.* ]]; then type_of "/dev/null/$name"; else type_out=folder; fi; fi
    optv by "$opts"
    printf '%s\n' "$id$us$name$us$src$us$date$us$exp$us$opts${us}cloud$us$type_out$us${optv_out:-?}$us"
  done < <(crows)
  # on the origin a v:2 is its own pointer (its index is their truth), so it lists only the members' v:3 rows; an expired pointer is a prune's, not a link
  # a member (R7) lists its own v:3 rows from its index, so only other origins' pointers come from the bucket
  printf '%s' "${r2_mrows:-}" | tr '\t' "$us" | grep -v '^$' | awk -F"$us" -v OFS="$us" -v now="$(date +%s)" -v all="$([[ $backend == r2 ]] && echo 1)" \
    -v own="$([[ $role == member ]] && cfg member_id || true)" '($4 == 0 || $4 > now) && (all == 1 || ($8 != "" && $8 != own)) {print $1, $2, "", $3, $4, $5, "machine", $6, $7, $8}' || true
}

list_rows() { # list_rows ls|state|brief: this profile's display rows into list_out (fields split by \x1f): id name src added expires opts storage type by origin link_state reason
  list_shadow="" list_shadow_read=0
  list_rows_raw "$@"
  link_apply
}
list_shadow="" list_shadow_read=0   # the local ids a cloud record also holds, read from the bucket by list_bucket (a full read only)
shadow_put() { # shadow_put "<ids>": what the last full listing found; an empty list clears an older one
  health_put shadow "$(jq -nc --arg m "$1" --argjson t "$(date +%s)" '{at: $t, ids: ($m | split(" ") | map(select(length > 0)))}')"
}
list_rows_raw() {
  # sets list_cloud_error and list_cloud_more. Bucket rows are display data: they never reach rows(), the index, a Caddyfile, or a stage path
  local id name src date exp opts lids="" f me_by us=$'\x1f'
  list_out="" list_cloud_error="" list_cloud_error_code="" list_cloud_more=0
  if [[ $backend != r2 ]]; then
    me_by="$(r2_by)"
    while IFS=$'\t' read -r id name src date exp opts; do
      if has_opt live "$opts"; then type_out=site; else type_of "$pub/$id/$name"; fi
      optv by "$opts"
      list_out+="$id$us$name$us$src$us$date$us$exp$us$opts${us}machine$us$type_out$us${optv_out:-$me_by}$us"$'\n'
      lids+="$id"$'\n'
    done < <(rows)
    [[ $r2on == 1 && $1 != brief ]] || return 0
  fi
  [[ $1 != brief ]] || return 0
  f="$(mktemp "${TMPDIR:-/tmp}/share-list.XXXXXX")"
  if ( list_bucket "$1" "$lids" ) >"$f" 2>"$f.err"; then
    list_cloud_more="$(sed -n '1s/^#more //p' "$f")"
    list_shadow="$(sed -n 's/^#shadow //p' "$f")"
    if [[ $1 == ls ]]; then list_shadow_read=1; shadow_put "$list_shadow"; fi   # only a full read sees every local id's record (the menu poll skips them); remember what it saw
    list_out+="$(sed '1d; /^#shadow /d' "$f")"
    [[ -z $list_out ]] || list_out+=$'\n'
  else
    # SHARE_ERROR_JSON=1 adds a JSON line after the die's own line: the human text stays the last other line, the code comes from it
    list_cloud_error="$(awk 'NF && index($0, "{\"error\":") != 1 {l = $0} END {print l}' "$f.err")"; list_cloud_error="${list_cloud_error#share: }"
    list_cloud_error_code="$(awk 'index($0, "{\"error\":") == 1 {l = $0} END {print l}' "$f.err" | jq -r '.error.code // empty' 2>/dev/null || true)"
    list_cloud_error="${list_cloud_error:-the bucket could not be read}"
  fi
  rm -f "$f" "$f.err"
  [[ $list_cloud_more =~ ^[0-9]+$ ]] || list_cloud_more=0
}

link_apply() { # appends link_state and reason to every list_out row (G7): revoked, expired, shadowed, gate_missing, else live
  [[ -n $list_out ]] || return 0
  local gates="" shadow="$list_shadow" now us=$'\x1f'
  now="${SHARE_STATE_NOW:-$(date +%s)}"
  # the menu poll never reads a local id's record, so a shadow is the one the last full listing (ls) saw, while that is under a week old
  if [[ $list_shadow_read == 0 && -f $health ]]; then
    shadow="$shadow $(jq -r --argjson now "$now" '(.shadow // {}) | select((.at // 0) > ($now - 604800)) | (.ids // [])[]' "$health" 2>/dev/null | tr '\n' ' ' || true)"
  fi
  # a gated row whose Access app the last listing with an exported token found gone, while that check is under a week old
  [[ ! -f $health ]] || gates="$(jq -r --argjson now "$now" '(.gates // {}) | select((.at // 0) > ($now - 604800)) | (.missing // [])[]' "$health" 2>/dev/null | tr '\n' ' ' || true)"
  # the members cache (DEC-71): member ls wrote it; a v:3 row reads paused or offline by its origin's suffix while the cache is under 24 h old.
  # On a member (R7) its own rows read paused from its own record, as the last read saw it
  local mpaused="" moffline="" self=""
  if [[ -f $health ]]; then
    IFS=$'\037' read -r mpaused moffline self < <(jq -r --argjson now "$now" '
      ((.members // {}) as $m | if (($m.at // 0) > ($now - 86400)) then ($m.list // []) else [] end) as $l
      | [([$l[] | select(.paused == true) | .suffix] | join(" ")), ([$l[] | select(.paused != true and (.connectors // 1) == 0) | .suffix] | join(" ")),
         ((.member // {}).status // "")] | join("\u001f")' "$health" 2>/dev/null) || true
  fi
  [[ $role == member ]] || self=""
  list_out="$(awk -F"$us" -v OFS="$us" -v now="$now" -v shadow=" ${shadow//$'\n'/ } " -v gates=" $gates" -v mp=" $mpaused " -v mo=" $moffline " -v self="$self" '
    NF == 0 { next }
    { n = split($6, o, " "); st = "live"; why = ""; gated = 0
      for (i = 1; i <= n; i++) {
        if (o[i] == "revoked") st = "revoked"
        if (o[i] ~ /^revoked_by=/ && why == "") why = o[i]
        if (o[i] ~ /^access=/) gated = 1
      }
      if (st == "live" && $5 + 0 > 0 && $5 + 0 <= now) st = "expired"
      if (st == "live" && $7 == "machine" && index(shadow, " " $1 " ")) { st = "shadowed"; why = "cloud_id_wins" }
      if (st == "live" && gated && index(gates, " " $1 " ")) { st = "gate_missing"; why = "access_app_gone" }
      if (st == "live" && $10 != "") { sx = substr($10, length($10) - 7); if (index(mp, " " sx " ")) st = "paused"; else if (index(mo, " " sx " ")) st = "offline" }
      if (st == "live" && $10 == "" && $7 == "machine" && (self == "paused" || self == "pausing")) st = "paused"
      if (st == "live" || st == "expired" || st == "paused" || st == "offline") why = ""
      NF = 10; print $0, st, why }' <<<"$list_out")"$'\n'
}

r2_token_ok() { # r2_token_ok off|env|soft: a publisher token resolves, never a die; env reads the environment only, so a listing runs no command
  [[ $1 != off && ${SHARE_API_TOKEN_OFF:-0} != 1 ]] || return 1
  if [[ -n ${SHARE_R2_TOKEN:-} ]]; then :
  elif [[ $1 == env ]]; then [[ -n ${CLOUDFLARE_API_TOKEN:-} ]] || return 1
  elif [[ -z "$(cfg r2_token_cmd || true)" ]]; then api_token_resolve soft; [[ -n $api_token ]] || return 1
  fi
  [[ ${SHARE_R2_DRY:-0} == 1 ]] && return 0
  ( r2_creds ) >/dev/null 2>&1 || return 1   # an admin token from the environment dies in r2_publisher_check: here that only means no
  r2_creds
}

r2_pointer_write() { # r2_pointer_write <id> <name> <type> <expires> <opts> <gated> <added>: one machine record, If-None-Match: *; the answer in cf_code;
  # v:2 on the origin, v:3 with origin=<member_id> on a member (R7), never a v:2 there (DEC-65)
  local po="" w rec
  for w in $5; do case $w in noindex|live) po="${po:+$po }$w" ;; esac; done
  [[ -z $6 ]] || po="${po:+$po }gated"   # a flag, never the rule: every member reads this object
  rec="$(mktemp "$root/.r2rec.XXXXXX")"
  if [[ $role == member ]]; then
    jq -nc --arg id "$1" --arg name "$2" --arg by "$(r2_by)" --arg added "$7" --argjson exp "$4" --arg type "$3" --arg o "$(cfg member_id)" \
      '{v: 3, id: $id, storage: "machine", origin: $o, name: $name, by: $by, added: $added, expires: $exp, opts: "", type: $type}' >"$rec"
    if [[ " $po " == *" noindex "* ]]; then jq -c '.opts = "noindex"' "$rec" >"$rec.t" && mv -f "$rec.t" "$rec"; fi
    r2_call PUT "m/$1" "$rec" -H 'If-None-Match: *' || true
    rm -f "$rec"; return 0
  fi
  jq -nc --arg id "$1" --arg name "$2" --arg by "$(r2_by)" --arg added "$7" --argjson exp "$4" --arg opts "$po" --arg type "$3" --arg oh "$(opt_val host "$5" || true)" \
    '{v: 2, id: $id, storage: "machine", name: $name, by: $by, added: $added, expires: $exp, opts: $opts, type: $type}
      + (if $oh == "" then {} else {own_host: $oh} end)' >"$rec"   # own_host: a member lists a --host row at its own name
  r2_call PUT "m/$1" "$rec" -H 'If-None-Match: *' || true
  rm -f "$rec"
}

r2_pointer_put() { # r2_pointer_put <kind> <name> <src> <expires> <opts> [rule]: the origin's v:2 machine record for cmd_add's $id, If-None-Match: *
  # a 412 means the bucket holds the id: cmd_add's id moves to a fresh one; any other answer dies before anything is served.
  # The add lock on the id tells the reconcile that this pointer has a row on the way.
  local t i
  if [[ $1 == live ]]; then t=site; else t="$(share_type "$3")"; fi
  for i in 1 2 3 4 5; do
    lock_take "add-$id" 5
    r2_pointer_write "$id" "$2" "$t" "$4" "$5" "${6:-}" "$(date +%F)"
    case $cf_code in
      200) return 0 ;;
      412) lock_release "add-$id"; id="$(rand_id)" || exit 1 ;;
      *) die "R2 did not take the pointer record m/$id (HTTP $cf_code${cf_err:+, $cf_err}); $host_name has R2 on, so a local link needs one; nothing was published" ;;
    esac
  done
  die "R2 answered 412 for five ids in a row; nothing was published; rerun the same $me add"
}

add_held() { local p; p="$(readlink "$root/.lock-add-$1" 2>/dev/null)" && [[ -n $p ]] && kill -0 "$p" 2>/dev/null; }   # a live add holds this id's pointer

r2_reconcile() { # after r2_read, on the origin's interactive ls and prune: an orphan pointer goes, a row with no pointer gets one, a shadowed id is named
  local now cut ids id e lm name src date exp opts t
  now="$(date +%s)"; cut="$(r2_ago $((now - 600)))"
  ids="$(rows | cut -f1)"
  while IFS=$'\t' read -r id e; do   # one origin per tenant: every machine pointer is this machine's
    [[ -n $id ]] || continue
    grep -qx "$id" <<<"$ids" && continue
    lm="$(awk -F'\t' -v k="m/$id" '$1 == k {print $2; exit}' <<<"$r2_mmods")"
    [[ -n $lm && ${lm:0:19} < $cut ]] || continue   # under 10 minutes old: an add may not have written its row yet
    pending_has_id "$id" && continue   # a gated add inside its wait
    add_held "$id" && continue
    r2_call DELETE "m/$id" || true
    if [[ $cf_code == 20? || $cf_code == 404 ]]; then echo "removed orphan pointer m/$id"
    else echo "share: deleting the orphan pointer m/$id answered HTTP $cf_code; the next $me prune retries" >&2; fi
  done <<<"$r2_machine"
  while IFS=$'\t' read -r id name src date exp opts; do
    [[ -n $id ]] || continue
    [[ $exp == 0 || $exp -gt $now ]] || continue   # an expired row is the local prune's
    grep -q "^$id"$'\t' <<<"$r2_machine" && continue
    if ! grep -qx "$id" <<<"$r2_mkeys"; then
      if has_opt live "$opts"; then t=site; else t="$(share_type "$pub/$id/$name")"; fi
      r2_pointer_write "$id" "$name" "$t" "$exp" "$opts" "$(opt_val access "$opts" || true)" "$date"
      case $cf_code in
        200) echo "share: wrote the missing pointer m/$id" >&2; continue ;;
        412) ;;
        *) echo "share: writing the pointer m/$id answered HTTP $cf_code; the next $me ls or prune retries" >&2; continue ;;
      esac
    fi
    echo "share: $id is shadowed by a cloud link; rm one of them" >&2   # never deleted here: either side may be the link someone holds
  done < <(rows)
}

r2_pointer_drop() { # r2_pointer_drop <id> off|env|soft: after a local row is gone, its machine pointer goes too; without a token it stays (the Worker passes it to Caddy, which 404s)
  [[ $r2on == 1 ]] || return 0
  r2_token_ok "$2" || { [[ $2 == off ]] || echo "share: the pointer m/$1 stays until '$me prune' runs with the publisher token" >&2; return 0; }
  r2_call GET "m/$1" || true
  [[ $cf_code == 200 ]] || return 0   # 404: nothing to delete; anything else: the reconcile retries
  # only this origin's own pointer: a cloud record on the same id is another link (a shadow), never deleted here
  [[ "$(jq -r --arg o "$([[ $role == member ]] && cfg member_id || true)" 'if .storage == "machine" and (if $o == "" then .v == 2 else (.v == 3 and .origin == $o) end) then "machine" else "" end' <<<"$cf_body" 2>/dev/null)" == machine ]] || return 0
  r2_call DELETE "m/$1" || true
  [[ $cf_code == 20? || $cf_code == 404 ]] || echo "share: deleting the pointer m/$1 answered HTTP $cf_code; '$me prune' retries it" >&2
  return 0
}

cmd_add_r2() { # cmd_add_r2 <secs> <noindex> <target> [rule]: stage, upload to a fresh prefix, then PUT m/<id> with If-None-Match: * is the publish
  # gated (a rule, already parsed): the app and its gate sit between the upload and the record, and the record carries the app's aud
  local secs=$1 opts="" src name id exp=0 prefix rec url nonce gated="${4:-}"
  src="$(realpath "$3")"; name="$(basename "$src")"
  case $src in *$'\t'*|*$'\n'*) die "paths with tabs or newlines are not supported" ;; esac
  case $name in *[{}\"\\]*) die "names with { } \" or \\ are not supported" ;; esac
  [[ -n $2 ]] && opts="noindex"
  r2_token_check
  mk_root
  if [[ -n $gated ]]; then   # before any write: a Worker with no Access team 404s every gated link, then the Access token and scopes
    r2_healthz
    [[ $hz_code == 200 ]] || die "https://$host_name/healthz answered $hz_code; nothing was published"
    [[ $hz_gate == 1 ]] || die "the Worker at $host_name has no Access team, so a gated link would never open; whoever holds the admin token reruns '$me setup $host_name --backend r2 --bucket $(cfg bucket || true)' with Access: Organizations Read; nothing was published"
    access_prepare
  fi
  id="$(rand_id)"
  [[ $secs -gt 0 ]] && exp=$(($(date +%s) + secs))
  stage_copy "$src" "$opts"
  r2_stage_check "$stage_out"
  nonce="$(r2_nonce)"; prefix="o/$id.$nonce/"
  r2_held_id=$id r2_held_prefix=$prefix   # from the first PUT on, the EXIT trap owns this prefix
  r2_put_tree "$stage_out" "$prefix" || die "uploading $name failed (HTTP $cf_code); nothing was published"
  r2_prefix_matches "$stage_out" "$prefix" || die "the objects under $prefix do not match the stage; nothing was published"
  if [[ -n $gated ]]; then
    access_nonce=$nonce access_create "$id"   # intent line, the app, its id into the line, read-back
    if [[ ! $access_aud =~ ^[0-9a-f]{64}$ ]] || ! access_gate "$id" "$access_aud"; then
      local left=""
      if access_delete "$access_app" "$id"; then lock_take index; pending_drop "$id" "$access_app"; lock_release index; held_access_id=""
      else left="; the app stays in access-pending for the next '$me prune' with the token"; fi
      [[ $access_aud =~ ^[0-9a-f]{64}$ ]] || die "the Access app for $id has an aud the Worker cannot check ($access_aud); nothing was published$left"
      die "Cloudflare Access did not enforce on $host_name/$id within ${access_wait}s; nothing was published$left; rerun the same $me add (Access can take several minutes on a new app)"
    fi
    opts="${opts:+$opts }access=$access_app access_rule=$access_rule"
    lock_take index   # publish under the lock: a sweep that claimed this line may have deleted the app
    pending_has "$id" "$access_app" || { lock_release index; die "the Access app of $id was claimed by a sweep during the wait; nothing was published; rerun the same $me add"; }
  fi
  rec="$(mktemp "$root/.r2rec.XXXXXX")"
  jq -nc --arg id "$id" --arg name "$name" --arg src "$src" --arg added "$(date +%F)" --argjson exp "$exp" \
    --arg opts "$opts" --arg prefix "$prefix" --arg by "$(r2_by)" --arg aud "${gated:+$access_aud}" --arg type "$(share_type "$src")" \
    --arg origin "$([[ $role == member ]] && cfg member_id || true)" \
    '{v: 1, id: $id, name: $name, src: $src, added: $added, expires: $exp, opts: $opts, prefix: $prefix, by: $by, type: $type}
      + (if $aud == "" then {} else {aud: $aud} end) + (if $origin == "" then {} else {origin: $origin} end)' >"$rec"
  r2_call PUT "m/$id" "$rec" -H 'If-None-Match: *'
  rm -f "$rec"
  case $cf_code in
    200) ;;
    412) # the trap sees their prefix and deletes ours; a gated add deletes its app too
      if [[ -n $gated ]]; then
        lock_release index; held_access_id=""
        if access_delete "$access_app" "$id"; then lock_take index; pending_drop "$id" "$access_app"; lock_release index; fi
      fi
      die "another publisher took id $id during the upload; nothing was published; rerun the same $me add" ;;
    *) # a lost-but-committed PUT: the trap keeps the prefix the record names; a gated line stays for the sweep's fresh read
      local tail=""
      [[ -z $gated ]] || { held_access_id=""; tail=" (the next '$me prune' with the token settles its Access app)"; }
      die "publishing m/$id answered HTTP $cf_code${cf_err:+ ($cf_err)}; rerun the same $me add$tail" ;;
  esac
  if [[ -n $gated ]]; then pending_drop "$id" "$access_app"; lock_release index; held_access_id=""; fi
  r2_held_prefix="" r2_held_id=""
  r2_own_put "$id" "$prefix" "$src"
  r2_link_base="$stage_out"; share_url "$id" "$name" "$opts"; r2_link_base=""
  rm -rf "$stage_out"; stage_out=""
  url="$share_url_out"
  [[ -z $gated ]] || access_link_check "$url" || access_link_die "$id" "$url"
  echo "$url"
  if [[ ${SHARE_CLIPBOARD:-1} == 1 ]] && command -v pbcopy >/dev/null; then
    printf '%s' "$url" | pbcopy && echo "  (link copied)"
  fi
  [[ -n $gated ]] || warn_private "$src" "$id"   # it says "public to anyone with the link", which a gated link is not
}

r2_md5() { # r2_md5 <file>: an etag-shaped lowercase hex
  if command -v md5sum >/dev/null; then md5sum "$1" | cut -d' ' -f1; else md5 -q "$1"; fi
}

r2_url() { # r2_url <key>: sets r2_url_out; the key through urlenc, only / stays literal
  urlenc "$1"
  printf -v r2_url_out '%s/%s/%s' "${r2_endpoint:-$(cfg r2_endpoint || true)}" "${r2_bucket:-$(cfg bucket || true)}" "$urlenc_out"
}

urldec() { # urldec <str>: sets urldec_out; %XX back to bytes, a malformed tail stays literal
  local LC_ALL=C s="$1" out="" c i n
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    if [[ $c == % && $((i + 2)) -lt $n && ${s:i+1:2} =~ ^[0-9A-Fa-f][0-9A-Fa-f]$ ]]; then
      printf -v c '%b' "\\x${s:i+1:2}"   # one raw byte; UTF-8 sequences arrive as consecutive %XX
      i=$((i + 2))
    fi
    out+="$c"
  done
  urldec_out="$out"
}

r2_list() { # r2_list <prefix>: every key under it into r2_list_out (decoded, newline-joined) and "<key>\t<LastModified>" into r2_list_mods; dies on a bad page
  local prefix=$1 tok="" k m
  r2_list_out="" r2_list_mods=""
  while :; do
    r2_call LIST "$prefix" ${tok:+"$tok"}
    [[ $cf_code == 200 ]] || die "r2 list of '$prefix' failed (HTTP $cf_code${cf_err:+, $cf_err})"
    while IFS=$'\t' read -r k m; do   # the raw key is url-encoded, so it holds no tab
      [[ -n $k ]] || continue
      urldec "$k"
      [[ $urldec_out != *[[:cntrl:]]* ]] || continue   # share never writes such a key; a decoded newline must never become a key of its own
      r2_list_out+="$urldec_out"$'\n'; r2_list_mods+="$urldec_out"$'\t'"$m"$'\n'
    done < <(grep -oE '<Key>[^<]*</Key>|<LastModified>[^<]*</LastModified>' <<<"$cf_body" |
      awk '/^<Key>/ {if (k != "") print k "\t" m; k = substr($0, 6, length($0) - 11); m = ""; next} {m = substr($0, 15, length($0) - 29)} END {if (k != "") print k "\t" m}')
    tok="$(grep -o '<NextContinuationToken>[^<]*' <<<"$cf_body" | sed 's/.*>//' || true)"   # pipefail: an absent token must not kill the run
    [[ $cf_body == *'<IsTruncated>true</IsTruncated>'* && -n $tok ]] || break
  done
}

r2_put_tree() { # r2_put_tree <dir> <prefix>: every file under dir to prefix<relpath>; parallel up to 8 live; a failed transfer is retried alone through r2_call
  local dir=$1 prefix=$2 f rel files=()
  while IFS= read -r f; do files+=("$f"); done < <(cd "$dir" && find . -type f | LC_ALL=C sort)
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    for f in ${files[@]+"${files[@]}"}; do
      rel="${f#./}"
      r2_call PUT "$prefix$rel" "$dir/$rel"
      [[ $cf_code == 2?? ]] || { r2_call PUT "$prefix$rel" "$dir/$rel"; [[ $cf_code == 2?? ]]; } || return 1
    done
    return 0
  fi
  [[ ${#files[@]} -gt 0 ]] || return 0
  local wd kf mapf out code url retries
  wd="$(mktemp -d "${TMPDIR:-/tmp}/share-r2put.XXXXXX")"
  kf="$wd/transfers"; mapf="$wd/map"; : >"$kf"; : >"$mapf"
  r2_creds || { rm -rf "$wd"; return 1; }
  for f in "${files[@]}"; do
    rel="${f#./}"
    r2_url "$prefix$rel"
    f="$dir/$rel"; f="${f//\\/\\\\}"; f="${f//\"/\\\"}"   # curl unescapes quoted config values; the url is already %-encoded
    printf 'url = "%s"\nupload-file = "%s"\noutput = "/dev/null"\n' "$r2_url_out" "$f" >>"$kf"
    printf '%s\t%s\n' "$r2_url_out" "$dir/$rel" >>"$mapf"
  done
  out="$(curl -sS --parallel --parallel-max 8 --max-time 300 -w '%{http_code} %{url_effective}\n' \
    -K "$kf" -K <(printf 'user = "%s:%s"\n' "$r2_key_id" "$r2_secret") \
    --aws-sigv4 'aws:amz:auto:s3' 2>/dev/null)" || true
  retries=""
  while IFS=' ' read -r code url; do
    [[ -n $code && $code != 2?? ]] || continue
    f="$(awk -F'\t' -v u="$url" '$1 == u {print $2; exit}' "$mapf")"
    [[ -n $f ]] || { rm -rf "$wd"; echo "share: a failed r2 transfer did not map back to a file ($url)" >&2; return 1; }
    retries+="$f"$'\n'
  done <<<"$out"
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    rel="${f#"$dir"/}"
    r2_call PUT "$prefix$rel" "$f"
    [[ $cf_code == 2?? ]] || { rm -rf "$wd"; return 1; }
  done <<<"$retries"
  rm -rf "$wd"
}

r2_delete_prefix() { # r2_delete_prefix <prefix>: every key under it deleted; a surviving key fails the call
  local prefix=$1 k fails=0
  r2_list "$prefix"
  while IFS= read -r k; do
    [[ -n $k ]] || continue
    r2_call DELETE "$k"
    [[ $cf_code == 204 || $cf_code == 200 || $cf_code == 404 ]] || fails=1
  done <<<"$r2_list_out"
  [[ $fails == 0 ]] || return 1
  r2_list "$prefix"
  [[ -z $r2_list_out ]]
}

r2_record_row() { # r2_record_row <m/ key> <json>: the index.tsv row for a sound record, nothing for a forged or newer one
  local id=${1#m/}
  jq -r --arg id "$id" '
    def clean: type == "string" and (explode | all(. >= 32 and . != 127));   # a control byte in a field drops the record
    select(.v == 1
      and .id == $id
      and (.name | clean) and (.src | clean) and (.opts | clean)
      and (.added | clean)
      and (.expires | type == "number" and . >= 0 and . < 1e11)   # epoch seconds; 1e300 would break bash arithmetic
      and (.opts | test("(^| )(prefix|by|type)=") | not)   # the row gains its own prefix=, by=, and type=; a record never supplies them
      and (.prefix | type == "string" and test("^o/" + $id + "\\.[0-9a-f]{8}/$"))
      and (.by | type == "string" and test("^[a-z0-9.-]+$"))
      and ((.aud // "") | test("^[0-9a-f]{64}$|^$")))
    | [.id, .name, .src, .added, (.expires | floor | tostring),
       (if .opts == "" then "" else .opts + " " end) + "prefix=" + .prefix + " by=" + .by
         + ((.type // "") as $t | if (["pdf", "image", "video", "audio", "folder", "site", "markdown", "archive", "text", "other"] | index($t)) then " type=" + $t else "" end)]
    | @tsv' <<<"$2" 2>/dev/null || true   # a corrupt or forged record is dropped, never fatal
}

r2_fetch_records() { # r2_fetch_records <snap>: parallel-GET every key in r2_list_out, each answer appended to $1 through r2_record_row; a non-200/404 dies
  local snap=$1 wd i=0 k f key code
  wd="$(mktemp -d "${TMPDIR:-/tmp}/share-r2get.XXXXXX")"
  : >"$wd/transfers"; : >"$wd/map"
  while IFS= read -r k; do
    [[ $k == m/* ]] || continue
    i=$((i + 1))
    r2_url "$k"
    printf 'url = "%s"\noutput = "%s"\n' "$r2_url_out" "$wd/$i" >>"$wd/transfers"
    printf '%s\t%s\n' "$wd/$i" "$k" >>"$wd/map"
  done <<<"$r2_list_out"
  [[ $i -gt 0 ]] || { rm -rf "$wd"; return 0; }
  r2_creds || { rm -rf "$wd"; return 1; }
  curl -sS --parallel --parallel-max 8 --max-time 60 -w '%{http_code} %{filename_effective}\n' \
    -K "$wd/transfers" -K <(printf 'user = "%s:%s"\n' "$r2_key_id" "$r2_secret") \
    --aws-sigv4 'aws:amz:auto:s3' >"$wd/codes" 2>/dev/null || true
  # walk the map, not curl's output: a key curl printed no line for counts as failed, never as absent
  while IFS=$'\t' read -r f key; do
    code="$(awk -v f="$f" 'substr($0, index($0, " ") + 1) == f {print $1; exit}' "$wd/codes")"
    if [[ $code != 200 && $code != 404 ]]; then   # a failed or missing transfer is retried alone through r2_call
      r2_call GET "$key"
      code=$cf_code
      [[ $code == 200 ]] && printf '%s' "$cf_body" >"$f"
    fi
    case $code in
      200) r2_take "$snap" "$key" "$(cat "$f")" ;;
      404) ;;
      *) rm -rf "$wd"; die "r2 snapshot: GET $key answered HTTP $code" ;;
    esac
  done <"$wd/map"
  rm -rf "$wd"
}

r2_snapshot() { r2_read; index="$r2_snap_file"; }   # an r2 profile: the bucket read is its index, so rows() stays the only reader

r2_read() { # r2_read [<n> <local ids>]: every m/ record into this process's own file (r2_snap_file, read through crows), the sweep view, and the machine pointers; never assigns $index
  # with <n> (the menu poll): the local ids' keys are skipped and only the newest n others by LastModified are fetched; r2_list_more counts the rest
  local snap k keep
  mkdir -p "$root"
  snap="$(mktemp "$root/.r2-index.XXXXXX")"
  r2_snap_file="$snap"; trap release_locks EXIT
  r2_refs="" r2_sweep_block="" r2_machine="" r2_mrows="" r2_list_more=0
  r2_list "m/"
  r2_list_out="$(grep -E '^m/[0-9a-f]{6}$' <<<"$r2_list_out" || true)"   # a key is read, shown, or deleted only in the shape share writes
  r2_mkeys="${r2_list_out//m\//}" r2_mmods="$r2_list_mods"
  if [[ -n ${1:-} ]]; then
    keep="$(awk -F'\t' 'NR == FNR {if ($0 != "") own["m/" $0]; next} $1 ~ /^m\/[0-9a-f]+$/ && length($1) == 8 && !($1 in own) {print $2 "\t" $1}' \
      <(printf '%s\n' "${2:-}") <(printf '%s\n' "$r2_list_mods") | LC_ALL=C sort -r | cut -f2)"
    r2_list_out="$(head -n "$1" <<<"$keep")"
    r2_list_more=$(( $(grep -c . <<<"$keep" || true) - $(grep -c . <<<"$r2_list_out" || true) ))
  fi
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    while IFS= read -r k; do
      [[ -n $k ]] || continue
      r2_call GET "$k"
      case $cf_code in
        200) r2_take "$snap" "$k" "$cf_body" ;;
        404) ;;
        *) die "r2 snapshot: GET $k answered HTTP $cf_code" ;;
      esac
    done <<<"$r2_list_out"
  else
    r2_fetch_records "$snap" || die "r2 snapshot: a record fetch failed; nothing was listed"
  fi
}

r2_take() { # r2_take <snap> <m/ key> <json>: one record into the cloud rows, the sweep view, r2_machine ("<id>\t<expires>" per v:2 machine pointer), and r2_mrows (v:2 and v:3)
  local e
  r2_record_row "$2" "$3" >>"$1"; r2_record_raw "$2" "$3"
  # the reap list: the origin's own v:2, or on a member (R7) only its own-origin v:3, never a v:2 (DEC-65)
  e="$(jq -r --arg id "${2#m/}" --arg o "$([[ $role == member ]] && cfg member_id || true)" 'select(.storage == "machine" and .id == $id and (.expires | type == "number" and . >= 0 and . < 1e11)
    and (if $o == "" then .v == 2 else (.v == 3 and .origin == $o) end)) | .expires | floor' <<<"$3" 2>/dev/null)" || return 0
  [[ -z $e ]] || r2_machine+="${2#m/}"$'\t'"$e"$'\n'
  # the machine display reader (v:2 the origin's pointer, v:3 a member's with its origin): every field checked before shell arithmetic
  # or a URL sees it; a record that fails is skipped like a forged row. The reap list above stays v:2 only (a v:3 is never the origin's)
  r2_mrows+="$(jq -r --arg id "${2#m/}" '
    def clean: type == "string" and (explode | all(. >= 32 and . != 127));
    select(type == "object" and .storage == "machine" and .id == $id
      and (.expires | tostring | test("^[0-9]{1,11}$")) and (.added | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))
      and (.name | clean and length > 0) and (.by | clean and test("^[a-z0-9.-]+$"))
      and ((.type // "") as $t | ["pdf", "image", "video", "audio", "folder", "site", "markdown", "archive", "text", "other"] | index($t))
      and ((.v == 2
          and (.opts | type == "string" and (split(" ") | all(. == "" or . == "noindex" or . == "live" or . == "gated")))
          and ((.own_host // "") | type == "string" and test("^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\\.[a-z][a-z]+$")))
        or (.v == 3 and (.expires | type == "number")
          and (.origin | type == "string" and test("^m-[a-z0-9-]{2,24}-[0-9a-f]{8}$"))
          and (.opts | type == "string" and (split(" ") | all(. == "" or . == "noindex")))
          and (has("own_host") | not))))
    | [.id, .name, .added, (.expires | tostring), (.opts + (if (.own_host // "") == "" then "" else " host=" + .own_host end)), .type, .by,
       (if .v == 3 then .origin else "" end)] | @tsv' <<<"$3" 2>/dev/null)"$'\n' || true
  return 0
}

r2_record_raw() { # r2_record_raw <m/ key> <json>: the orphan sweep's own view; the prefix into r2_refs, or the first key this CLI cannot read into r2_sweep_block
  # a cloud record (v:1) names its upload; a machine pointer (v:2 the origin's, v:3 a member's, any later v; storage machine, no prefix) is readable and names none
  local p
  p="$(jq -r 'if type == "object" and .v == 1 and (.prefix | type == "string") then .prefix
    elif type == "object" and (.v | type == "number") and .v >= 2 and .storage == "machine" and (has("prefix") | not) then ""
    else error("unreadable") end' <<<"$2" 2>/dev/null)" ||
    { r2_sweep_block="${r2_sweep_block:-$1}"; return 0; }
  [[ -z $p ]] || r2_refs+="$p"$'\n'
}

r2_ago() { date -u -r "$1" +%Y-%m-%dT%H:%M:%S 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%S; }   # epoch -> the ISO form S3's LastModified starts with

r2_sweep_orphans() { # bare prune: every o/<id>.<nonce>/ no record names, whose newest object is over 24 h old, is deleted; one unreadable record skips it all
  if [[ -n ${r2_sweep_block:-} ]]; then
    echo "share: orphan sweep skipped: $r2_sweep_block is unreadable or newer than this share; no upload was deleted" >&2
    return 0
  fi
  local cutoff p
  cutoff="$(r2_ago $(($(date +%s) - 86400)))"   # the local clock; 24 h absorbs any sane skew against R2's LastModified
  r2_list "o/"
  # no {n} intervals: mawk lacks them. An object with no LastModified counts as fresh, so its prefix stays
  for p in $(printf '%s' "$r2_list_mods" | R2_REFS="$r2_refs" awk -F'\t' -v cut="$cutoff" '
    BEGIN { n = split(ENVIRON["R2_REFS"], r, "\n"); for (i = 1; i <= n; i++) if (r[i] != "") ref[r[i]] = 1 }   # -v cannot carry a newline in every awk
    length($1) > 18 && substr($1, 1, 2) == "o/" && substr($1, 3, 6) !~ /[^0-9a-f]/ && substr($1, 9, 1) == "." &&
      substr($1, 10, 8) !~ /[^0-9a-f]/ && substr($1, 18, 1) == "/" {
      k = substr($1, 1, 18)
      if (k in ref) next
      seen[k] = 1
      if ($2 == "" || substr($2, 1, 19) >= cut) fresh[k] = 1
    }
    END { for (k in seen) if (!(k in fresh)) print k }'); do
    if (r2_delete_prefix "$p") >/dev/null 2>&1; then echo "removed orphan upload $p"
    else echo "share: could not delete every object under $p; the next $me prune retries" >&2; fi
  done
}

r2_prune() { # r2_prune [quiet|listing]: the snapshot; unless quiet, every expired row through rm, a gated one only with an Access-proven token; a bare prune then sweeps orphan uploads
  # on an origin with R2 on (cmd_prune calls it first) the cloud rows come from its own reader and never touch $index; cmd_prune runs the access sweep there
  if [[ $backend == r2 ]]; then r2_snapshot; else r2_read; fi
  [[ ${1:-} != quiet ]] || return 0
  local now id opts expired gate_ok=0 e
  now="$(date +%s)"
  expired="$(crows | awk -F'\t' -v now="$now" '$5 > 0 && $5 < now {print $1 "\t" $6}')"
  if [[ -s $pending || $expired == *access=* ]]; then   # listing: the environment only, never op read; bare: the full resolver, soft
    if [[ ${1:-} == listing ]]; then api_token_resolve env; else api_token_resolve soft; fi
    [[ -n $api_token ]] && access_account soft && access_apps_edit_ok && gate_ok=1
    [[ $gate_ok == 0 || $backend != r2 ]] || access_sweep
  fi
  while IFS=$'\t' read -r id opts; do
    [[ -n $id ]] || continue
    if [[ $gate_ok == 0 && -n "$(opt_val access "$opts" || true)" ]]; then   # the Worker already answers 404; the app needs an Access-capable token
      echo "share: expired gated share $id waits for a publisher with the Access token" >&2
      continue
    fi
    cmd_rm_r2 "$id" prune | sed 's/$/ (expired)/' || true   # a listing never dies on one row
  done <<<"$expired"
  if [[ $backend == r2 ]]; then   # a member: a machine pointer past its expiry goes; the origin's own prune unpublishes the link
    while IFS=$'\t' read -r id e; do
      [[ -n $id && $e -gt 0 && $e -lt $now ]] || continue
      r2_call DELETE "m/$id" || true
      if [[ $cf_code == 20? || $cf_code == 404 ]]; then echo "removed expired pointer m/$id"; fi
    done <<<"$r2_machine"
  fi
  [[ -n ${1:-} ]] || r2_sweep_orphans
}

cmd_rm_r2() { # cmd_rm_r2 <id> [prune]: the record, a fresh read proving it gone, then every nonce's objects, then a gated share's app
  # any publisher may rm any share; a gated one needs a token that passes the Apps Edit probe first (prune: r2_prune proved it)
  local r opts tmp app
  [[ -n ${r2_snap_file:-} ]] || { if [[ $backend == r2 ]]; then r2_snapshot; else r2_read; fi; }
  r="$(crow "${1:-}")"
  if [[ -z $r ]]; then   # a member never removes the origin's machine link: the origin keeps serving it and its reconcile writes the pointer back
    [[ $backend == r2 ]] && grep -q "^${1:-x}"$'\t' <<<"$r2_machine" && die "$1 is served from the tenant's origin; remove it there"
    die "no share with id '${1:-}'"
  fi
  opts="$(awk -F'\t' '{print $6}' <<<"$r")"
  app="$(opt_val access "$opts" || true)"
  if [[ -n $app ]]; then
    if [[ ${2:-} != prune ]]; then   # before any change: a teammate without Access scopes never strands the app
      api_token_resolve; [[ -n $api_token ]] || { access_no_token >&2; exit 1; }
      access_account
      access_apps_edit_ok || die "$(access_scope_line 'Access: Apps and Policies Edit')"
      access_sweep
    fi
    lock_take index; pending_has_id "$1" || pending_add "$1" "$app" "" "$$"; lock_release index
  fi
  local dcode
  r2_call DELETE "m/$1"; dcode=$cf_code   # any answer, 000 included: the fresh read below decides
  r2_call GET "m/$1"   # a lost DELETE must not look done; a gated line and its app stay
  [[ $cf_code == 404 ]] || die "m/$1 still answers HTTP $cf_code after its delete (HTTP $dcode); its objects${app:+ and its Access app} were kept; rerun $me rm $1"
  tmp="$(mktemp "$root/.r2-index.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$r2_snap_file" >"$tmp" && mv -f "$tmp" "$r2_snap_file"   # this process's listing drops the row too; on an origin never $index
  r2_own_drop "$1"
  (r2_delete_prefix "o/$1.") || echo "share: some objects under o/$1. remain; nothing serves them, and a $me prune removes them after 24 h" >&2
  echo "unpublished $1"
  [[ -n $app ]] || return 0
  if access_delete "$app" "$1"; then lock_take index; pending_drop_id "$1" "$app"; lock_release index
  else die "could not delete the Access app for $1 (HTTP $cf_code, or the app is not this share's, see above); it stays in access-pending for the next '$me prune' with the token"; fi
}

cmd_refresh_r2() { # cmd_refresh_r2 <id>: this install's own share only; a new prefix, the record swap under If-Match, then the old prefix goes
  local body etag own oprefix src opts new rec
  [[ ${1:-} =~ ^[0-9a-f]{6}$ ]] || die "no share with id '${1:-}'"
  r2_token_check
  mk_root
  r2_call GET "m/$1"
  case $cf_code in
    200) ;;
    404) die "no share with id '$1'" ;;
    *) die "reading m/$1 answered HTTP $cf_code; nothing was changed" ;;
  esac
  body=$cf_body etag=$r2_etag
  [[ $backend != r2 || "$(jq -r 'if .v == 2 and .storage == "machine" then 1 else 0 end' <<<"$body" 2>/dev/null)" != 1 ]] ||
    die "$1 is served from the tenant's origin; remove it there"
  [[ -n "$(r2_record_row "m/$1" "$body")" && -n $etag ]] || die "no share with id '$1'"
  oprefix="$(jq -r '.prefix' <<<"$body")"
  own="$(r2_own_get "$1" || true)"
  [[ -n $own && "$(cut -f2 <<<"$own")" == "$oprefix" ]] || die "$1 was added from another install; refresh it there"
  src="$(cut -f3 <<<"$own")"   # never the record's src: another publisher could forge it
  [[ -e $src ]] || die "source is gone: $src (the snapshot keeps serving; $me rm $1 to unpublish)"
  opts="$(jq -r '.opts' <<<"$body")"
  stage_copy "$src" "$opts"
  r2_stage_check "$stage_out"
  new="o/$1.$(r2_nonce)/"
  r2_held_id=$1 r2_held_prefix=$new
  r2_put_tree "$stage_out" "$new" || die "uploading $src failed (HTTP $cf_code); $1 still serves its old copy"
  r2_prefix_matches "$stage_out" "$new" || die "the objects under $new do not match the stage; $1 still serves its old copy"
  rec="$(mktemp "$root/.r2rec.XXXXXX")"
  jq -c --arg p "$new" --arg src "$src" '.prefix = $p | .src = $src' <<<"$body" >"$rec"
  r2_call PUT "m/$1" "$rec" -H "If-Match: \"$etag\""
  rm -f "$rec"
  case $cf_code in
    200) ;;
    412|404) die "$1 changed during the refresh (a concurrent rm or refresh won); nothing was published" ;;   # the trap deletes the new prefix no record names
    *) die "swapping m/$1 answered HTTP $cf_code${cf_err:+ ($cf_err)}; rerun $me refresh $1" ;;
  esac
  r2_held_prefix="" r2_held_id=""
  r2_own_put "$1" "$new" "$src"
  rm -rf "$stage_out"; stage_out=""
  (r2_delete_prefix "$oprefix") || echo "share: some objects under $oprefix remain; nothing serves them, and a $me prune removes them after 24 h" >&2
  echo "refreshed $1 from $src"
}

cmd_hits_r2() { # cmd_hits_r2 <id>: one Analytics Engine SQL call; the id is checked before it can reach the query
  [[ ${1:-} =~ ^[0-9a-f]{6}$ ]] || die "no share with id '${1:-}'"
  local ds="share_${host_name//[.-]/_}" ep
  if [[ $backend != r2 ]]; then   # an origin: only a sound cloud record reaches the query; a member keeps one account call and no bucket read
    r2_call GET "m/$1" || true
    [[ $cf_code == 200 && -n "$(r2_record_row "m/$1" "$cf_body")" ]] || die "no share with id '$1'"
  fi
  [[ $ds =~ ^[a-z0-9_]+$ ]] || die "bad hostname '$host_name' for a dataset name"
  ep="$(cfg r2_endpoint || true)"; acct="${ep#https://}"; acct="${acct%%.*}"
  [[ -n $ep && $acct =~ ^[A-Za-z0-9-]+$ ]] || die "the profile config has no r2_endpoint; rerun $me setup $host_name --backend r2 --bucket $(cfg bucket || true)"
  api_token_resolve
  [[ -n $api_token ]] || die "hits needs an API token with Account Analytics: Read (it reads every dataset on the account): $me api-token, or CLOUDFLARE_API_TOKEN"
  r2_api POST "/accounts/$acct/analytics_engine/sql" \
    "SELECT SUM(_sample_interval) AS hits, COUNT(DISTINCT blob2) AS visitors, MAX(timestamp) AS last FROM $ds WHERE index1 = '$1' FORMAT JSON"
  [[ $cf_code == 200 ]] || die "the Analytics Engine query answered HTTP $cf_code (the token needs Account Analytics: Read)"
  jq -r 'def n($k; $w): "\($k) \($w)\(if $k == 1 then "" else "s" end)";
    (.data[0] // {}) as $r | ($r.hits // 0 | tonumber) as $h | ($r.visitors // 0 | tonumber) as $v
    | n($h; "hit") + ", " + n($v; "visitor")
      + (if $h > 0 and ($r.last // "") != "" then ", last " + ($r.last | strptime("%Y-%m-%d %H:%M:%S") | mktime | strflocaltime("%F %H:%M")) else "" end)' <<<"$cf_body"
  # a member reads no bucket here, so a 0 for an id it did not add may be a machine link the Worker never counts
  [[ $backend == r2 && "$(jq -r '.data[0].hits // 0 | tonumber' <<<"$cf_body")" == 0 && -z "$(r2_own_get "$1")" ]] &&
    echo "this machine counts cloud links only; if $1 is a machine link, its stats are on the tenant's origin: $me hits $1 there"
  return 0
}

cmd_status_r2() { # read-only: the Worker's health and version, then the listing without its prune (status never deletes)
  local waiting
  echo "r2 backend: https://$host_name/"
  hz_code=000 hz_pair="" hz_gate=0
  serve_state 5   # the one classifier probes the Worker; the lines below read its answer
  health_worker_put
  if [[ $hz_code == 200 ]]; then echo "worker:     up ($hz_pair)"; else echo "worker:     DOWN: $hz_code"; fi
  if [[ $hz_code == 200 && $hz_gate == 1 ]]; then echo "gated:      on (the Worker checks the Access login)"
  elif [[ $hz_code == 200 ]]; then echo "gated:      off (the Worker has no Access team; add --access is refused)"; fi
  [[ $hz_code != 200 || $hz_pair == "$WORKER_VERSION $WORKER_SHA" ]] ||
    echo "the Worker at $host_name runs $hz_pair; this share ships $WORKER_VERSION $WORKER_SHA; whoever holds the admin token reruns '$me setup $host_name --backend r2 --bucket $(cfg bucket || true)'"
  role_line
  ops_status
  cmd_prune quiet
  [[ -z ${r2_sweep_block:-} ]] || echo "orphan sweep blocked by $r2_sweep_block"
  waiting="$(rows | awk -F'\t' -v now="$(date +%s)" '$5 > 0 && $5 < now && (" " $6) ~ / access=/ {c++} END {print c + 0}')"
  [[ $waiting == 0 ]] || echo "$waiting expired gated share(s) wait for a publisher with the Access token"
  cmd_ls
}

cmd_state_r2() { # the Share Bar snapshot for an r2 profile: schema 1 plus "backend"; SHARE_STATE_BRIEF=1 (profiles) skips the share list and its m/ reads
  local state_val ready
  serve_state; state_val=$serve_state_val ready=$serve_ready_val
  list_out="" list_cloud_error="" list_cloud_error_code="" list_cloud_more=0
  [[ -z $host_name || ${SHARE_STATE_BRIEF:-0} == 1 ]] || list_rows state
  state_lines | jq -nR --arg state "$state_val" --argjson ready "$ready" --arg host "$host_name" --argjson access_pending "$(pending_count deferred orphan)" --argjson access_inflight "$(pending_count intent bound)" --argjson access_bad "$(pending_count bad)" \
    --arg cerr "$list_cloud_error" --arg ccode "${list_cloud_error_code:-}" --argjson cmore "$list_cloud_more" \
    --argjson codes_v "$codes_v" --arg role "$role" --arg sphase "$serve_phase" --arg sreason "$serve_reason" --argjson token "$(token_json)" --argjson compat "$(compat_json)" --argjson ops "$(ops_json)" "$state_jq_row"'
    {schema: 1, state: $state, ready: $ready, mode: "named", host: (if $host == "" then null else $host end), hosts: "",
     serves_here: false, service: false, access_pending: $access_pending, access_inflight: $access_inflight, access_bad: $access_bad, backend: "r2",
     shares: [inputs | select(length > 0) | row], r2: true}
    + (if $cerr == "" then {} else {cloud_error: $cerr} end) + (if $ccode == "" then {} else {cloud_error_code: $ccode} end)
    + (if $cmore > 0 then {cloud_more: $cmore} else {} end) + {codes_v: $codes_v, role: $role, ops: $ops, serve: {phase: $sphase, reason: $sreason}}
    + (if $token == null then {} else {token: $token} end) + (if $compat == null then {} else {compat: $compat} end)'
}

r2_own_get() { # r2_own_get <id>: the "<id>\t<prefix>\t<source>" line for one of this install's own adds
  # no {n} intervals: mawk lacks them
  [[ -f $r2own ]] && awk -F'\t' -v id="$1" 'NF == 3 && $1 == id && substr($2, 3, 6) == id && $2 ~ /^o\/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\/$/' "$r2own"
}

r2_own_put() { # r2_own_put <id> <prefix> <src>: remember the share this install added, replacing any older line
  mkdir -p "$root"
  local tmp
  tmp="$(mktemp "$root/.r2own.XXXXXX")"
  { [[ -f $r2own ]] && awk -F'\t' -v id="$1" '$1 != id' "$r2own"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } >"$tmp"
  mv -f "$tmp" "$r2own"
}

r2_own_drop() { # r2_own_drop <id>: forget the line, missing counts as dropped
  [[ -f $r2own ]] || return 0
  local tmp
  tmp="$(mktemp "$root/.r2own.XXXXXX")"
  awk -F'\t' -v id="$1" '$1 != id' "$r2own" >"$tmp" && mv -f "$tmp" "$r2own"
}

r2_creds() { # r2_creds: the publisher pair into r2_key_id/r2_secret; the token never reaches argv, a file, or output
  [[ -n ${r2_key_id:-} && -n ${r2_secret:-} ]] && return 0   # setup presets them; one resolve per process
  r2_key_id="${SHARE_R2_KEY_ID:-$(cfg r2_key_id || true)}"
  local tok="${SHARE_R2_TOKEN:-}" c out
  [[ -z $tok ]] && { c="$(cfg r2_token_cmd || true)"; [[ -n $c ]] && tok="$(eval "$c" 2>/dev/null)"; }
  if [[ -z $tok ]]; then   # a stored token was checked when stored; one from the environment is checked here, once per process
    api_token_resolve; tok="$api_token"
    [[ -z $tok || $api_token_src != CLOUDFLARE_API_TOKEN ]] || r2_publisher_check "$tok" env
  fi
  [[ -n $tok ]] || return 1
  if [[ -z $r2_key_id ]]; then   # the S3 access key is the token's own id
    out="$(curl -sS --max-time 30 "$api/user/tokens/verify" -H @<(printf 'Authorization: Bearer %s\n' "$tok") 2>/dev/null || true)"
    r2_key_id="$(jq -r '.result.id // empty' <<<"$out" 2>/dev/null)"
    [[ -n $r2_key_id ]] || return 1
  fi
  r2_secret="$(printf '%s' "$tok" | shasum -a 256 | cut -d' ' -f1)"
}

r2_call() { # r2_call METHOD KEY [ARG] [curl args...]: one S3 call on cf_try's globals; LIST takes <prefix> [continuation]; 429 and 5xx retried, Retry-After capped at 30s
  cf_body="" cf_code=000 cf_err="" r2_etag=""
  [[ $backend == r2 || $r2on == 1 ]] || { cf_err=backend; return 1; }
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    if [[ $tunnel != 0 || $host_name != *.test ]]; then
      echo "share: SHARE_R2_DRY=1 is a test seam for SHARE_TUNNEL=0 and a .test hostname only; the r2 call was refused; unset it" >&2
      return 1
    fi
    r2_dry "$@"; return $?
  fi
  local meth=$1 key=$2 arg3=${3:-} url hdrs i ra xmeth=$1
  r2_creds || { echo "share: no r2 publisher token for $host_name (needs r2_key_id and a token source in the profile config)" >&2; return 1; }
  hdrs="$(mktemp "${TMPDIR:-/tmp}/share-r2h.XXXXXX")"
  local args=()
  case $meth in
    LIST) urlenc "$key"; url="${r2_endpoint:-$(cfg r2_endpoint)}/${r2_bucket:-$(cfg bucket)}?list-type=2&prefix=$urlenc_out&encoding-type=url&max-keys=1000"; xmeth=GET
      [[ -n $arg3 ]] && { urlenc "$arg3"; url+="&continuation-token=$urlenc_out"; } ;;
    *) r2_url "$key"; url=$r2_url_out; [[ -n $arg3 ]] && args+=(--upload-file "$arg3") ;;
  esac
  for i in 1 2 3; do
    cf_body="$(curl -sS --max-time 60 -D "$hdrs" -w '\n%{http_code}' -X "$xmeth" "$url" \
      --aws-sigv4 'aws:amz:auto:s3' -K <(printf 'user = "%s:%s"\n' "$r2_key_id" "$r2_secret") \
      "${args[@]+"${args[@]}"}" "${@:4}" 2>/dev/null)" || true
    cf_code="${cf_body##*$'\n'}"; cf_body="${cf_body%$'\n'*}"
    [[ $cf_code == 429 || $cf_code == 5?? ]] || break
    [[ $i -lt 3 ]] || break
    ra="$(awk 'tolower($1)=="retry-after:"{gsub(/\r/,"",$2); print $2; exit}' "$hdrs")"
    [[ $ra =~ ^[0-9]+$ ]] || ra=0; (( ra > 30 )) && ra=30
    sleep "$ra"
  done
  r2_etag="$(sed -n 's/^[Ee][Tt][Aa][Gg]: //p' "$hdrs" | tr -d '"\r' | head -1)"
  rm -f "$hdrs"
  cf_err="$(sed -n 's:.*<Code>\([^<]*\)</Code>.*:\1:p' <<<"$cf_body" | head -1)"
}

r2_dry() { # r2_dry METHOD KEY [ARG]: a directory-backed bucket for tests; one "METHOD key" line per call; etags and conditional headers honored
  local meth=$1 key=$2 arg3=${3:-} d="${SHARE_R2_DRY_DIR:-$root/r2-dry}" f h k rest
  mkdir -p "$d" "$root"
  if [[ ${SHARE_R2_DRY_PAUSE:-} == "$meth $key" ]]; then
    local w=0
    : >"$d/.paused"   # a test waits for this, then looks at the world while the call is held
    while [[ ! -f $d/.resume && $w -lt 600 ]]; do sleep 0.05; w=$((w + 1)); done
  fi
  printf '%s %s\n' "$meth" "$key" >>"$root/r2-calls.log"
  cf_body="" cf_code=200 cf_err="" r2_etag=""
  f="$d/$key"
  case $meth in
    PUT)
      [[ ${SHARE_R2_DRY_PUT:-} == 500 || ${SHARE_R2_DRY_FAIL:-} == "PUT $key" ]] && { cf_code=500 cf_err=InternalError; return 0; }
      if [[ ${SHARE_R2_DRY_PUT:-} == race-once && $key == m/* && ! -f $d/.fx/race.done ]]; then   # another publisher takes this id just before the PUT
        mkdir -p "$d/.fx" "${f%/*}"; : >"$d/.fx/race.done"
        printf '{"v":1,"id":"%s","name":"theirs.txt","src":"/x","added":"2026-10-01","expires":0,"opts":"","prefix":"o/%s.00000000/","by":"peer"}\n' "${key#m/}" "${key#m/}" >"$f"
      fi
      for h in "${@:4}"; do
        case "$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')" in
          -h) ;;
          if-none-match:\ \*) [[ -e $f ]] && { cf_code=412 cf_err=PreconditionFailed; return 0; } ;;
          if-match:*) [[ -e $f && $h == *"$(r2_md5 "$f")"* ]] || { cf_code=412 cf_err=PreconditionFailed; return 0; } ;;
        esac
      done
      if [[ ${SHARE_R2_DRY_PUT:-} == 500-once && ! -f $d/.fx/p500.done ]]; then
        mkdir -p "$d/.fx"; : >"$d/.fx/p500.done"; cf_code=500 cf_err=InternalError; return 0
      fi
      mkdir -p "${f%/*}"
      if [[ -n $arg3 && -f $arg3 ]]; then cp "$arg3" "$f"; else : >"$f"; fi
      [[ ${SHARE_R2_DRY_PUT:-} == lost || ( ${SHARE_R2_DRY_PUT:-} == lost-record && $key == m/* ) ]] && { cf_code=000; return 0; }
      r2_etag="$(r2_md5 "$f")" ;;
    GET) [[ -e $f ]] || { cf_code=404 cf_err=NoSuchKey; return 0; }
      cf_body="$(cat "$f")"; r2_etag="$(r2_md5 "$f")" ;;
    HEAD) [[ -e $f ]] || { cf_code=404 cf_err=NoSuchKey; return 0; }
      r2_etag="$(r2_md5 "$f")" ;;
    DELETE) [[ ${SHARE_R2_DRY_DELETE:-} == lost ]] && { cf_code=000; return 0; }
      rm -f "$f"; cf_code=204 ;;
    LIST)
      [[ ${SHARE_R2_DRY_LIST:-} == 500 ]] && { cf_code=500 cf_err=InternalError; return 0; }
      local all="" count=0 last="" want=""
      [[ -n $arg3 ]] && { urldec "$arg3"; want="$urldec_out"; }   # the continuation token arrives url-encoded, as S3 serves it
      while IFS= read -r k; do
        [[ $k == "$key"* ]] && [[ -z $want || $k > $want ]] && all+="$k"$'\n'
      done < <({ cd "$d" && find . -type f ! -name '.*' ! -path './.*' ! -name 'r2-calls.log' | sed 's|^\./||'; [[ -z ${SHARE_R2_DRY_LIST_EXTRA:-} ]] || echo "$SHARE_R2_DRY_LIST_EXTRA"; } | LC_ALL=C sort)   # EXTRA: a key no file holds (m/../share.json)
      cf_body='<?xml version="1.0" encoding="UTF-8"?><ListBucketResult><Name>dry</Name><Prefix>'"$key"'</Prefix><MaxKeys>1000</MaxKeys><EncodingType>url</EncodingType>'
      while IFS= read -r k; do
        [[ -n $k ]] || continue
        if [[ $count -ge 1000 ]]; then urlenc "$last"; cf_body+='<IsTruncated>true</IsTruncated><NextContinuationToken>'"$urlenc_out"'</NextContinuationToken>'; break; fi
        urlenc "$k"; cf_body+='<Contents><Key>'"$urlenc_out"'</Key><LastModified>'"$(date -u -r "$d/$k" +%Y-%m-%dT%H:%M:%S.000Z)"'</LastModified><ETag>"'"$(r2_md5 "$d/$k")"'"</ETag><Size>'"$(wc -c <"$d/$k" | tr -d ' ')"'</Size></Contents>'
        last="$k"; count=$((count + 1))
      done <<<"$all"
      [[ $count -lt 1000 ]] && cf_body+='<IsTruncated>false</IsTruncated>'
      cf_body+="<KeyCount>$count</KeyCount></ListBucketResult>" ;;
    *) cf_code=400 cf_err=NotImplemented ;;
  esac
}

r2_api() { # r2_api METHOD PATH [JSON]: cf_try, or the dry account under SHARE_R2_DRY; call directly, never in $( )
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    cf_body="" cf_code=000 cf_err=""
    if [[ $tunnel != 0 || $host_name != *.test ]]; then
      echo "share: SHARE_R2_DRY=1 is a test seam for SHARE_TUNNEL=0 and a .test hostname only; the Cloudflare call was refused; unset it" >&2
      return 0
    fi
    r2_api_dry "$@"; return 0
  fi
  cf_try "$@"
}

r2_api_retry() { # r2_api_retry METHOD PATH [JSON]: r2_api again on a Cloudflare 5xx, 3 tries in all, SHARE_CF_RETRY_SLEEP seconds (default 2) doubling between them; the last answer stays in cf_code
  local try=1 nap="${SHARE_CF_RETRY_SLEEP:-2}"
  while :; do
    r2_api "$@"
    [[ $cf_code == 5?? && $try -lt 3 ]] || return 0
    echo "share: Cloudflare answered HTTP $cf_code to $1 $2; retrying in ${nap}s (try $try of 3)" >&2
    sleep "$nap"; nap=$((nap * 2)); try=$((try + 1))
  done
}

r2_api_dry() { # the account API under SHARE_R2_DRY: state files in $SHARE_R2_DRY_DIR/.cf, one "API METHOD path" line per call
  local d="${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf" p=$2 n g deny='{"success":false,"errors":[{"code":10000}]}' globs=()
  mkdir -p "$d" "$root"
  # SHARE_R2_DRY_PAUSE="API <METHOD> <path glob>": the call is held until .resume, as the bucket seam holds a bucket call (a kill point at a Cloudflare step)
  # shellcheck disable=SC2053 # every seam below is a glob on purpose
  if [[ ${SHARE_R2_DRY_PAUSE:-} == API\ * && "API $1 $p" == $SHARE_R2_DRY_PAUSE ]]; then
    n=0; : >"$d/../.paused"
    while [[ ! -f $d/../.resume && $n -lt 600 ]]; do sleep 0.05; n=$((n + 1)); done
  fi
  printf 'API %s %s\n' "$1" "$p" >>"$root/r2-calls.log"
  cf_code=200 cf_err="" cf_body='{"success":true,"result":[]}'
  # SHARE_R2_DRY_DENY="<glob>[|<glob>...]" over "API <METHOD> <path>": 403 10000, a token without that scope (the scope probes)
  if [[ -n ${SHARE_R2_DRY_DENY:-} ]]; then
    IFS='|' read -r -a globs <<<"$SHARE_R2_DRY_DENY"
    for g in ${globs[@]+"${globs[@]}"}; do
      # shellcheck disable=SC2053
      [[ "API $1 $p" != $g ]] || { cf_code=403 cf_err=10000 cf_body=$deny; return 0; }
    done
  fi
  # SHARE_R2_DRY_FAIL="API <METHOD> <path glob>": that call answers 500 and changes nothing; a die-injection seam
  # shellcheck disable=SC2053 # the seam is a glob on purpose
  # SHARE_R2_DRY_FAIL_TIMES=<n> limits the failure to the first n matching calls, so a retry can succeed
  if [[ -n ${SHARE_R2_DRY_FAIL:-} && "API $1 $p" == $SHARE_R2_DRY_FAIL ]]; then
    n="$(cat "$d/fail.count" 2>/dev/null || echo 0)"
    if [[ -z ${SHARE_R2_DRY_FAIL_TIMES:-} || $n -lt $SHARE_R2_DRY_FAIL_TIMES ]]; then
      echo $((n + 1)) >"$d/fail.count"
      cf_code=500 cf_err=10013 cf_body='{"success":false,"errors":[{"code":10013}]}'; return 0
    fi
  fi
  case "$1 $p" in
    "GET /user/tokens/verify")
      if [[ ${api_who:-} == minter ]]; then r2_api_dry_member "$1" "$p" "" "$d"   # the minter's own token: its id, then its policies by GET /user/tokens/<id>
      else cf_body="$(jq -nc --arg e "${SHARE_R2_DRY_EXPIRES:-}" '{success: true, result: ({id: "dry-token-id", status: "active"} + (if $e == "" then {} else {expires_on: $e} end))}')"; fi ;;
    "GET /zones?name="*)
      n="${p#*name=}"; n="${n%%&*}"
      [[ $n == "${host_name#*.}" ]] && cf_body="{\"success\":true,\"result\":[{\"id\":\"zone-dry\",\"name\":\"$n\",\"account\":{\"id\":\"acct-dry\"}}]}" ;;
    "GET "*/workers/scripts/*/settings)
      n="${p%/settings}"; n="${n##*/}"
      if [[ ${SHARE_R2_DRY_ROLE:-} == deny ]]; then cf_code=403 cf_body=$deny
      elif [[ -f $d/script-$n.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/script-$n.json")}"   # a second Worker on the account (an alias's)
      elif [[ -f $d/script.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/script.json")}"
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":10007}]}'; fi ;;
    "PUT "*/workers/scripts/*) cf_body='{"success":true,"result":{}}' ;;   # r2_deploy writes script.json itself
    "POST "*/subdomain) [[ ${SHARE_R2_DRY_SUBDOMAIN:-} == stuck ]] || printf '%s' "$3" >"$d/subdomain.json"; cf_body='{"success":true,"result":{}}' ;;
    "GET "*/subdomain) cf_body="{\"success\":true,\"result\":$(cat "$d/subdomain.json" 2>/dev/null || echo '{"enabled":true,"previews_enabled":true}')}" ;;
    "GET "*/domains/managed)
      if [[ ${SHARE_R2_DRY_BUCKETDOM:-} == deny ]]; then cf_code=403 cf_body=$deny
      else cf_body="{\"success\":true,\"result\":{\"enabled\":$([[ -f $d/r2dev ]] && echo true || echo false)}}"; fi ;;
    "GET "*/domains/custom)
      if [[ ${SHARE_R2_DRY_BUCKETDOM:-} == deny ]]; then cf_code=403 cf_body=$deny
      elif [[ -f $d/bucket-domain ]]; then cf_body='{"success":true,"result":{"domains":[{"domain":"cdn.example.test"}]}}'
      else cf_body='{"success":true,"result":{"domains":[]}}'; fi ;;
    "GET "*/r2/buckets/*)
      if [[ ${SHARE_R2_DRY_BUCKETDOM:-} == deny ]]; then cf_code=403 cf_body=$deny   # a bucket-scoped token reads no bucket settings
      elif [[ ! -f $d/bucket ]]; then cf_code=404 cf_body='{"success":false,"errors":[{"code":10006}]}'; fi ;;
    "POST "*/r2/buckets) : >"$d/bucket"; cf_body='{"success":true,"result":{}}' ;;
    "GET "*/r2/buckets)   # a bucket-scoped token gets 403; SHARE_R2_DRY_BUCKETS="a b" answers as an account-wide token that lists them
      if [[ -z ${SHARE_R2_DRY_BUCKETS:-} ]]; then cf_code=403 cf_body=$deny
      else cf_body="$(jq -nc --arg l "$SHARE_R2_DRY_BUCKETS" '{success: true, result: {buckets: [$l | split(" ")[] | {name: .}]}}')"; fi ;;
    "GET /zones/"*/dns_records*) [[ -f $d/dns ]] && cf_body="{\"success\":true,\"result\":$(cat "$d/dns")}" ;;
    "GET "*/workers/domains*)
      if [[ ${SHARE_R2_DRY_DOMAINS:-} == 500 ]]; then cf_code=500 cf_body='{"success":false,"errors":[{"code":10013}]}'
      elif [[ -f $d/domain.json ]]; then cf_body="{\"success\":true,\"result\":[$(jq -c '{id: "dom-dry"} + .' "$d/domain.json")]}"; fi ;;
    "DELETE "*/workers/domains/*) rm -f "$d/domain.json" ;;
    "GET /zones/"*/workers/routes)
      if [[ ${SHARE_R2_DRY_ROUTES:-} == deny ]]; then cf_code=403 cf_body=$deny
      else cf_body="{\"success\":true,\"result\":$(cat "$d/routes.json" 2>/dev/null || echo '[]')}"; fi ;;
    "POST /zones/"*/workers/routes)
      jq -c --argjson r "$3" '. + [$r + {id: "route-\(length + 1)"}]' "$d/routes.json" 2>/dev/null >"$d/routes.tmp" || jq -nc --argjson r "$3" '[$r + {id: "route-1"}]' >"$d/routes.tmp"
      mv -f "$d/routes.tmp" "$d/routes.json"; cf_body='{"success":true,"result":{}}' ;;
    "PUT /zones/"*/workers/routes/*)
      jq -c --argjson r "$3" --arg id "${p##*/}" 'map(if .id == $id then $r + {id: $id} else . end)' "$d/routes.json" >"$d/routes.tmp" && mv -f "$d/routes.tmp" "$d/routes.json"
      cf_body='{"success":true,"result":{}}' ;;
    "DELETE /zones/"*/workers/routes/*)
      jq -c --arg id "${p##*/}" 'map(select(.id != $id))' "$d/routes.json" >"$d/routes.tmp" && mv -f "$d/routes.tmp" "$d/routes.json" ;;
    "DELETE "*/workers/scripts/*) rm -f "$d/script.json" ;;
    "DELETE "*/r2/buckets/*) rm -f "$d/bucket" ;;
    "PUT "*/workers/domains) jq -c '{hostname, service}' <<<"$3" >"$d/domain.json"; cf_body='{"success":true,"result":{}}' ;;
    "POST "*/analytics_engine/sql)
      printf 'SQL %s\n' "$3" >>"$root/r2-calls.log"
      cf_body="$(cat "$d/sql.json" 2>/dev/null || echo '{"meta":[],"data":[],"rows":0}')" ;;
    "GET "*/connectivity/directory/services/*)   # one VPC Service by id: a file per service under .cf/services/ (the carry-forward check)
      n="${p##*/}"
      if [[ ${SHARE_R2_DRY_ROLE:-} == deny ]]; then cf_code=403 cf_body=$deny
      elif [[ $n =~ ^[A-Za-z0-9-]+$ && -f $d/services/$n.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/services/$n.json")}"
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":5104}]}'; fi ;;
    "GET "*/cfd_tunnel*|"GET "*/connectivity/directory/services*|"GET /user/tokens?"*|*/cfd_tunnel|*/cfd_tunnel/*|*/connectivity/directory/services|*/connectivity/directory/services/*|"GET /user/tokens/"*|*" /user/tokens"|*" /user/tokens/"*)
      if [[ ${SHARE_R2_DRY_ROLE:-} == deny ]]; then cf_code=403 cf_body=$deny   # admin-token and minter-token --test probes
      else r2_api_dry_member "$1" "$p" "${3:-}" "$d"; fi ;;
    "GET "*/access/organizations)
      if [[ -f $d/team ]]; then cf_body="{\"success\":true,\"result\":{\"auth_domain\":\"$(cat "$d/team")\"}}"
      else cf_code=403 cf_body=$deny; fi ;;
    *) cf_code=400 cf_body='{"success":false,"errors":[{"code":7003}]}' ;;
  esac
  # SHARE_R2_DRY_COMMIT_FAIL="API <METHOD> <path glob>": the call is applied, then answers 500, once (a create that committed but did not say so)
  # shellcheck disable=SC2053
  if [[ -n ${SHARE_R2_DRY_COMMIT_FAIL:-} && "API $1 $p" == $SHARE_R2_DRY_COMMIT_FAIL && ! -f $d/commit-fail.done ]]; then
    : >"$d/commit-fail.done"; cf_code=500 cf_body='{"success":false,"errors":[{"code":10013}]}'
  fi
  cf_err="$(jq -r '.errors[0].code // empty' <<<"$cf_body" 2>/dev/null || true)"
}

r2_api_dry_member() { # r2_api_dry_member METHOD PATH JSON <.cf dir>: the member objects of the dry account (tunnels, VPC Services, the minter's user tokens), one file each
  local m=$1 p=$2 body=$3 d=$4 id n f u q page per all name tn
  local gone='{"success":false,"errors":[{"code":1003,"message":"not found"}]}'
  u="$(printf '%s' "${api_token:-}" | cksum | cut -d' ' -f1)"   # the user a token belongs to: each minter lists only its own tokens
  q="${p#*\?}"; [[ $q != "$p" ]] || q=""
  page="$(sed -n 's/.*[?&]page=\([0-9]*\).*/\1/p' <<<"$p")"; page="${page:-1}"
  per="$(sed -n 's/.*[?&]per_page=\([0-9]*\).*/\1/p' <<<"$p")"; per="${per:-50}"
  mkdir -p "$d/tunnels" "$d/services" "$d/tokens/$u"
  case "$m ${p%%\?*}" in
    "POST /accounts/"*/cfd_tunnel)
      name="$(jq -r '.name // empty' <<<"$body")"
      for f in "$d/tunnels"/*.json; do
        [[ -e $f ]] || continue
        jq -e --arg n "$name" '.name == $n and .deleted_at == null' "$f" >/dev/null && { cf_code=409 cf_body='{"success":false,"errors":[{"code":1013,"message":"You already have a tunnel with this name"}]}'; return 0; }
      done
      n=$(( $(cat "$d/tunnels/.n" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$d/tunnels/.n"
      id="$(printf '00000000-0000-4000-8000-%012d' "$n")"
      jq -nc --arg id "$id" --arg n "$name" '{id: $id, name: $n, config_src: "cloudflare", deleted_at: null}' >"$d/tunnels/$id.json"
      cf_body="{\"success\":true,\"result\":$(cat "$d/tunnels/$id.json")}" ;;
    "GET /accounts/"*/cfd_tunnel)
      name="$(sed -n 's/.*[?&]name=\([^&]*\).*/\1/p' <<<"$p")"
      cf_body="$(find "$d/tunnels" -name '*.json' -exec cat {} + 2>/dev/null | jq -sc --arg n "$name" --arg del "$([[ $q == *is_deleted=false* ]] && echo 0 || echo 1)" \
        '{success: true, result: [.[] | select(($n == "" or .name == $n) and ($del == "1" or .deleted_at == null))], result_info: {per_page: 1000}}')" ;;
    "GET /accounts/"*/cfd_tunnel/*/token)
      id="${p%/token}"; id="${id##*/}"
      if [[ -f $d/tunnels/$id.json ]] && jq -e '.deleted_at == null' "$d/tunnels/$id.json" >/dev/null; then cf_body="{\"success\":true,\"result\":\"ctok-SECRET-${id##*-}\"}"
      else cf_code=404 cf_body=$gone; fi ;;
    "PUT /accounts/"*/cfd_tunnel/*/configurations)
      id="${p%/configurations}"; id="${id##*/}"
      if [[ -f $d/tunnels/$id.json ]]; then printf '%s\n' "$body" >"$d/tunnels/$id.config"; cf_body="{\"success\":true,\"result\":{\"version\":1,\"config\":$(jq -c '.config' <<<"$body")}}"
      else cf_code=404 cf_body=$gone; fi ;;
    "GET /accounts/"*/cfd_tunnel/*/connections)   # one entry per connector, each holding its 4 conns (TASK-1a(f)); .conns holds the connector count
      id="${p%/connections}"; id="${id##*/}"
      n="$(cat "$d/tunnels/$id.conns" 2>/dev/null || echo 0)"
      cf_body="$(jq -nc --argjson n "$n" '{success: true, result: [range($n) | {id: "conn-\(.)", conns: [range(4) | {id: "c\(.)"}]}]}')" ;;
    "DELETE /accounts/"*/cfd_tunnel/*/connections)
      id="${p%/connections}"; id="${id##*/}"; rm -f "$d/tunnels/$id.conns"; cf_body='{"success":true,"result":null}' ;;
    "GET /accounts/"*/cfd_tunnel/*)
      id="${p##*/}"
      if [[ -f $d/tunnels/$id.json ]]; then cf_body="{\"success\":true,\"result\":$(cat "$d/tunnels/$id.json")}"; else cf_code=404 cf_body=$gone; fi ;;
    "DELETE /accounts/"*/cfd_tunnel/*)
      id="${p##*/}"
      if [[ ! -f $d/tunnels/$id.json ]] || ! jq -e '.deleted_at == null' "$d/tunnels/$id.json" >/dev/null; then cf_code=404 cf_body=$gone
      elif [[ "$(cat "$d/tunnels/$id.conns" 2>/dev/null || echo 0)" -gt 0 ]]; then cf_code=400 cf_body='{"success":false,"errors":[{"code":1022,"message":"This tunnel has active connections."}]}'
      else jq -c '.deleted_at = "2026-11-15T00:00:00Z"' "$d/tunnels/$id.json" >"$d/tunnels/$id.tmp" && mv -f "$d/tunnels/$id.tmp" "$d/tunnels/$id.json"; cf_body="{\"success\":true,\"result\":$(cat "$d/tunnels/$id.json")}"; fi ;;
    "POST /accounts/"*/connectivity/directory/services)
      name="$(jq -r '.name // empty' <<<"$body")"; tn="$(jq -r '"\(.host.network.tunnel_id // "") \(.host.ipv4 // "") \(.http_port // "")"' <<<"$body")"
      for f in "$d/services"/*.json; do
        [[ -e $f ]] || continue
        if jq -e --arg n "$name" --arg t "$tn" '.name == $n or "\(.host.network.tunnel_id // "") \(.host.ipv4 // "") \(.http_port // "")" == $t' "$f" >/dev/null; then
          cf_code=400 cf_body='{"success":false,"errors":[{"code":5101,"message":"request contained invalid parameters: Service already exists"}]}'; return 0
        fi
      done
      n=$(( $(cat "$d/services/.n" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$d/services/.n"
      id="$(printf '5e000000-0000-4000-8000-%012d' "$n")"
      jq -c --arg id "$id" '{service_id: $id} + .' <<<"$body" >"$d/services/$id.json"
      cf_body="{\"success\":true,\"result\":$(cat "$d/services/$id.json")}" ;;
    "GET /accounts/"*/connectivity/directory/services)   # no result_info, ?name= ignored: paged by per_page and page only (TASK-1a(a))
      all="$(find "$d/services" -name '*.json' -exec cat {} + 2>/dev/null | jq -sc 'sort_by(.service_id)')"
      cf_body="$(jq -c --argjson pg "$page" --argjson pp "$per" '{success: true, result: .[($pg - 1) * $pp:$pg * $pp]}' <<<"${all:-[]}")" ;;
    "PUT /accounts/"*/connectivity/directory/services/*)
      id="${p##*/}"
      if [[ ! -f $d/services/$id.json ]]; then cf_code=404 cf_body='{"success":false,"errors":[{"code":5104}]}'
      elif ! jq -e 'has("host") and has("name") and has("type")' <<<"$body" >/dev/null 2>&1; then cf_code=400 cf_body='{"success":false,"errors":[{"code":5102,"message":"invalid json: missing field host"}]}'
      else jq -c --arg id "$id" '{service_id: $id} + .' <<<"$body" >"$d/services/$id.json"; cf_body="{\"success\":true,\"result\":$(cat "$d/services/$id.json")}"; fi ;;
    "DELETE /accounts/"*/connectivity/directory/services/*)
      id="${p##*/}"
      if [[ $id =~ ^[A-Za-z0-9-]+$ && -f $d/services/$id.json ]]; then rm -f "$d/services/$id.json"; cf_body='{"success":true,"result":null}'
      else cf_code=404 cf_body='{"success":false,"errors":[{"code":5104}]}'; fi ;;
    "GET /user/tokens/verify") cf_body="{\"success\":true,\"result\":{\"id\":\"self$u\",\"status\":\"active\"}}" ;;
    "GET /user/tokens/permission_groups")
      cf_body='{"success":true,"result":[{"id":"pg-r2-item-write","name":"Workers R2 Storage Bucket Item Write","scopes":["com.cloudflare.edge.r2.bucket"]},{"id":"pg-zone-read","name":"Zone Read","scopes":["com.cloudflare.api.account.zone"]},{"id":"pg-tokens-write","name":"API Tokens Write","scopes":["com.cloudflare.api.user"]}]}' ;;
    "GET /user/tokens")
      all="$(find "$d/tokens/$u" -name '*.json' -exec cat {} + 2>/dev/null | jq -sc 'sort_by(.id) | map(del(.value))')"
      cf_body="$(jq -c --argjson pg "$page" --argjson pp "$per" --argjson held "${SHARE_R2_DRY_TOKENS_HELD:-0}" \
        '(length + $held) as $t | {success: true, result: .[($pg - 1) * $pp:$pg * $pp],
          result_info: {page: $pg, per_page: $pp, total_count: $t, count: (.[($pg - 1) * $pp:$pg * $pp] | length), total_pages: ((($t + $pp - 1) / $pp) | floor)}}' <<<"${all:-[]}")" ;;
    "GET /user/tokens/"*)
      id="${p##*/}"
      if [[ $id == "self$u" ]]; then   # the minter's own token: its permission groups by name, SHARE_R2_DRY_MINTER_GROUPS (| between names)
        cf_body="$(jq -nc --arg id "$id" --arg g "${SHARE_R2_DRY_MINTER_GROUPS:-API Tokens Read|API Tokens Write}" \
          '{success: true, result: {id: $id, name: "minter", status: "active", policies: [{effect: "allow", resources: {"com.cloudflare.api.user.*": "*"}, permission_groups: [$g | split("|")[] | {id: ("pg-" + .), name: .}]}]}}')"
      elif [[ -f $d/tokens/$u/$id.json ]]; then cf_body="$(jq -c '{success: true, result: del(.value)}' "$d/tokens/$u/$id.json")"
      else cf_code=404 cf_body=$gone; fi ;;
    "POST /user/tokens")
      n=$(( $(cat "$d/tokens/.n" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$d/tokens/.n"
      id="$(printf '%032d' "$n")"
      jq -c --arg id "$id" --arg n "$n" --arg u "$u" '{id: $id, status: "active"} + . + {value: ("msec-" + $n + "-" + $u)}' <<<"$body" >"$d/tokens/$u/$id.json"   # the value is built in jq, so no argv holds it
      cf_body="$(jq -c '{success: true, result: .}' "$d/tokens/$u/$id.json")" ;;
    "PUT /user/tokens/"*)
      id="${p##*/}"
      if [[ -f $d/tokens/$u/$id.json ]]; then jq -c --argjson b "$body" '. + $b' "$d/tokens/$u/$id.json" >"$d/tokens/$u/$id.tmp" && mv -f "$d/tokens/$u/$id.tmp" "$d/tokens/$u/$id.json"
        cf_body="$(jq -c '{success: true, result: del(.value)}' "$d/tokens/$u/$id.json")"
      else cf_code=404 cf_body=$gone; fi ;;
    "DELETE /user/tokens/"*)
      id="${p##*/}"
      if [[ -f $d/tokens/$u/$id.json ]]; then rm -f "$d/tokens/$u/$id.json"; cf_body="{\"success\":true,\"result\":{\"id\":\"$id\"}}"
      else cf_code=404 cf_body=$gone; fi ;;
    *) cf_code=400 cf_body='{"success":false,"errors":[{"code":7003}]}' ;;
  esac
  return 0
}

r2_healthz() { # r2_healthz [secs]: hz_code (200 only for a "200 ok" body), hz_pair (X-Share-Worker), hz_gate (X-Share-Gate: 1 when TEAM is set), hz_tunnel (X-Share-Tunnel) from https://<host>/healthz
  # a tenant Worker answers 503 with its pair and X-Share-Tunnel: 0 while the origin is off: the Worker is up, so hz_code is 200 and hz_tunnel 0
  hz_code=000 hz_pair="" hz_gate=0 hz_tunnel="" hz_deploy=""
  local h b
  h="$(mktemp "${TMPDIR:-/tmp}/share-hz.XXXXXX")"
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then   # the dry Worker's answer as a header file and a body, read by the same lines below
    local d="${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf" pair gate
    printf 'HEALTHZ\n' >>"$root/r2-calls.log"
    local routed=0   # a tenant Worker answers through its route on <host>/*, an r2 profile's through its custom domain
    [[ -f $d/routes.json ]] && jq -e --arg p "$host_name/*" 'any(.[]; .pattern == $p)' "$d/routes.json" >/dev/null 2>&1 && routed=1
    if [[ ${SHARE_R2_DRY_HEALTHZ:-} != down && ( -f $d/domain.json || $routed == 1 ) && -f $d/script.json ]]; then
      pair="$(jq -r '[(.bindings[] | select(.name == "VERSION") | .text), (.bindings[] | select(.name == "SHA") | .text)] | join(" ")' "$d/script.json")"
      gate="$(jq -r 'if any(.bindings[]; .name == "TEAM" and (.text // "") != "") then 1 else 0 end' "$d/script.json")"
      local dn; dn="$(jq -r '[.bindings[] | select(.name == "DEPLOY") | .text] | first // ""' "$d/script.json")"
      [[ ${SHARE_R2_DRY_HEALTHZ:-} != old-deploy ]] || dn="0000000000000000"   # the runtime still serves an earlier deploy
      [[ -z $dn ]] || gate="$gate"$'\r\nx-share-deploy: '"$dn"
      case ${SHARE_R2_DRY_HEALTHZ:-} in
        tunnel-down) printf 'HTTP/2 503 \r\nx-share-worker: %s\r\nx-share-gate: %s\r\nx-share-tunnel: 0\r\n\r\n' "$pair" "$gate" >"$h"; b="tunnel down" ;;
        503-bare) printf 'HTTP/2 503 \r\n\r\n' >"$h"; b="" ;;
        *) local tl=""; jq -e 'any(.bindings[]; .name == "PASS" and .text == "1")' "$d/script.json" >/dev/null && tl=$'x-share-tunnel: 1\r\n'
           printf 'HTTP/2 200 \r\nx-share-worker: %s\r\nx-share-gate: %s\r\n%s\r\n' "$pair" "$gate" "$tl" >"$h"; b="ok" ;;
      esac
    fi
  else
    # DNS over HTTPS first, as live_check does: a new name's NXDOMAIN from before its record existed sits in the local cache
    b="$(curl -sS --max-time "${1:-5}" --doh-url https://1.1.1.1/dns-query -D "$h" "https://$host_name/healthz" 2>/dev/null)" ||
      b="$(curl -sS --max-time "${1:-5}" -D "$h" "https://$host_name/healthz" 2>/dev/null)" || true
  fi
  hz_code="$(awk 'NR == 1 {sub(/\r$/, ""); print $2}' "$h")"; hz_code="${hz_code:-000}"
  hz_pair="$(awk 'tolower($1) == "x-share-worker:" {sub(/\r$/, ""); print $2 " " $3; exit}' "$h")"
  [[ "$(awk 'tolower($1) == "x-share-gate:" {sub(/\r$/, ""); print $2; exit}' "$h")" == 1 ]] && hz_gate=1
  hz_tunnel="$(awk 'tolower($1) == "x-share-tunnel:" {sub(/\r$/, ""); print $2; exit}' "$h")"
  hz_deploy="$(awk 'tolower($1) == "x-share-deploy:" {sub(/\r$/, ""); print $2; exit}' "$h")"
  rm -f "$h"
  if [[ $hz_code == 503 && $hz_tunnel == 0 && $hz_pair =~ ^[0-9]+\ [0-9a-f]{12}$ ]]; then hz_code=200   # read from the headers, never the status alone
  elif [[ $hz_code == 200 && ${b:-} != ok ]]; then hz_code=000; fi
  return 0
}

r2_wait_healthz() { # r2_wait_healthz admin|join: three 200s in a row within SHARE_R2_WAIT; admin also needs this CLI's pair; a new name waits for its certificate
  local wait="${SHARE_R2_WAIT:-300}" start=$SECONDS streak=0 poll=2
  [[ ${SHARE_R2_DRY:-0} == 1 ]] && poll=0
  while :; do
    r2_healthz
    if [[ $hz_code == 200 && ( $1 == join || $hz_pair == "$WORKER_VERSION $WORKER_SHA" ) && ( $1 != tenant || $hz_tunnel == 1 ) &&
      ( $1 == join || -z $r2_deploy_nonce || $hz_deploy == "$r2_deploy_nonce" ) ]]; then
      streak=$((streak + 1)); [[ $streak -ge 3 ]] && { health_worker_put; return 0; }   # the pair this setup just proved is what compat reads
    else
      streak=0
    fi
    if [[ $1 == tenant && $((SECONDS - start)) -ge $wait ]]; then   # the config is written by now: the rollback is --no-r2
      local leg="the Worker leg"; [[ $hz_code == 200 && $hz_pair == "$WORKER_VERSION $WORKER_SHA" ]] && leg="the tunnel leg (X-Share-Tunnel: ${hz_tunnel:-none})"
      [[ -z $r2_deploy_nonce || $hz_deploy == "$r2_deploy_nonce" ]] || leg="the deploy (X-Share-Deploy ${hz_deploy:-none}, not this deploy's $r2_deploy_nonce; rerun the same setup)"
      tenant_die "https://$host_name/healthz did not answer 200 ok with this share's Worker and X-Share-Tunnel: 1 three times in a row within ${wait}s (last: $hz_code ${hz_pair:-no pair}); $leg is down"
    fi
    [[ $((SECONDS - start)) -lt $wait ]] ||
      die "https://$host_name/healthz did not answer 200 ok three times in a row within ${wait}s (last: $hz_code ${hz_pair:-no pair}${r2_deploy_nonce:+, X-Share-Deploy ${hz_deploy:-none} where this deploy is $r2_deploy_nonce}); the config was not written; rerun setup once the certificate is issued"
    sleep "$poll"
  done
}

r2_deploy_meta() { # r2_deploy_meta <team> <dataset> [salt]: the multipart metadata; printf only, so the salt never reaches an argv
  local salt=""
  [[ -n ${3:-} ]] && salt=',{"type":"secret_text","name":"SALT","text":"'"$3"'"}'
  local tenant=""   # a tenant Worker (setup --r2) passes misses to the origin and 301s its aliases; an r2-only profile binds neither
  [[ -z ${r2_pass:-} ]] || tenant=',{"type":"plain_text","name":"PASS","text":"1"},{"type":"plain_text","name":"ALIASES","text":"'"${r2_aliases:-}"'"}'
  local carry=""   # every deployed member binding, MEMBERS and PAUSED, resent as read (SPEC-009 DEC-15); then this deploy's own nonce
  [[ ${r2_carry:-[]} == "[]" ]] || carry=",$(jq -r 'map(tojson) | join(",")' <<<"$r2_carry")"
  [[ -z ${r2_deploy_nonce:-} ]] || carry="$carry"',{"type":"plain_text","name":"DEPLOY","text":"'"$r2_deploy_nonce"'"}'
  printf '{"main_module":"share.js","compatibility_date":"%s","bindings":[{"type":"r2_bucket","name":"BUCKET","bucket_name":"%s"},{"type":"analytics_engine","name":"HITS","dataset":"%s"},{"type":"plain_text","name":"HOST","text":"%s"},{"type":"plain_text","name":"TEAM","text":"%s"},{"type":"plain_text","name":"VERSION","text":"%s"},{"type":"plain_text","name":"SHA","text":"%s"}%s%s%s],"keep_bindings":["secret_text"]}\n' \
    "$WORKER_COMPAT_DATE" "$r2_bucket" "$2" "$host_name" "$1" "$WORKER_VERSION" "$WORKER_SHA" "$tenant" "$carry" "$salt"
}

r2_carry="[]" r2_carry_dep="[]" r2_dep_nonce="" r2_deploy_nonce=""
r2_carry_read() { # r2_carry_read <settings body>: the bindings every deploy re-sends (each M_<8hex> vpc_service, MEMBERS, PAUSED) into r2_carry, and the
  # deployed copy into r2_carry_dep for the compare; the deployed DEPLOY nonce into r2_dep_nonce. A shape this share cannot carry dies before any write
  local out
  out="$(jq -c '[.result.bindings[]? | select((.type == "vpc_service" and (.name | type == "string" and test("^M_[0-9a-f]{8}$")))
      or (.type == "plain_text" and (.name == "MEMBERS" or .name == "PAUSED")))
    | if .type == "vpc_service" then {type, name, service_id} else {type, name, text} end] | sort_by(.name)' <<<"$1" 2>/dev/null)" || out=""
  if [[ -z $out ]] || ! jq -e 'all(.[]; if .type == "vpc_service" then (.service_id | type == "string" and test("^[A-Za-z0-9-]{1,64}$"))
      elif .name == "MEMBERS" then .text == "1"
      else (.text | type == "string" and ((try fromjson catch null) | type == "array" and all(.[]; type == "string" and test("^[0-9a-f]{8}$")))) end)' <<<"$out" >/dev/null 2>&1; then
    die "the deployed Worker's settings hold a member binding, MEMBERS or PAUSED this share cannot carry forward; refused, nothing was changed"
  fi
  r2_carry="$out" r2_carry_dep="$out"
  r2_dep_nonce="$(jq -r '[.result.bindings[]? | select(.type == "plain_text" and .name == "DEPLOY") | .text] | first // ""' <<<"$1" 2>/dev/null || true)"
  [[ $r2_dep_nonce =~ ^[0-9a-f]{16}$ ]] || r2_dep_nonce=""
}

r2_carry_fresh() { # r2_carry_fresh <settings path>: on a tenant with something to carry, the settings read must be what the Worker serves: its DEPLOY equals
  # the X-Share-Deploy /healthz answers, re-read up to 3 times (a settings GET right after a deploy once answered the pre-deploy list, TASK-1a(b))
  [[ ( $r2_carry != "[]" || $r2_carry_force == 1 ) && -n $r2_dep_nonce ]] || return 0   # forced on T2: a stale read with nothing to carry would drop MEMBERS
  local i prev
  for i in 1 2 3; do
    r2_healthz
    [[ $hz_deploy == "$r2_dep_nonce" ]] && return 0
    prev=$r2_dep_nonce
    [[ ${SHARE_R2_DRY:-0} == 1 ]] || sleep 2
    r2_api GET "$1"
    [[ $cf_code == 200 ]] || die "reading the Worker settings again answered HTTP $cf_code; nothing was changed"
    r2_carry_read "$cf_body"
    if [[ ! $hz_pair =~ ^[0-9]+\ [0-9a-f]{12}$ && $r2_dep_nonce == "$prev" ]]; then   # no Worker answers /healthz (a missing route is what this rerun repairs)
      echo "share: https://$host_name/healthz is not the Worker; two settings reads agree on deploy $prev, so they are used" >&2
      return 0
    fi
  done
  die "the Worker settings name deploy ${r2_dep_nonce:-none} while https://$host_name/healthz serves ${hz_deploy:-none}; a stale settings read could drop a member binding, so nothing was changed; rerun the same setup in a minute"
}

r2_carry_services() { # every carried vpc_service binding whose VPC Service is gone is dropped and named: a deploy naming a deleted service fails
  # 10180, and so would every later deploy (TASK-1a(e)); any other answer dies before the deploy
  [[ $r2_carry == *vpc_service* ]] || return 0
  local name sid
  while IFS=$'\t' read -r name sid; do
    [[ -n $name ]] || continue
    r2_api GET "/accounts/$acct/connectivity/directory/services/$sid"
    case $cf_code in
      200) ;;
      404) [[ $cf_err == 5104 ]] || die "reading VPC Service $sid (binding $name) answered HTTP 404 without code 5104; refused, nothing was changed"
           echo "share: binding $name names VPC Service $sid, which is gone; this deploy drops the binding" >&2
           r2_carry="$(jq -c --arg n "$name" 'map(select(.name != $n))' <<<"$r2_carry")" ;;
      *) die "reading VPC Service $sid (binding $name) answered HTTP $cf_code; a deploy that carries a member binding needs Connectivity Directory Admin on the admin token; nothing was changed" ;;
    esac
  done < <(jq -r '.[] | select(.type == "vpc_service") | [.name, .service_id] | @tsv' <<<"$r2_carry")
  return 0
}

r2_carry_downgrade() { # r2_carry_downgrade <dep_v> [marker]: --force never lowers WORKER_VERSION under a member tenant: v:3 links and the redeem route need v5
  [[ ${1:-0} -gt $WORKER_VERSION ]] || return 0
  if jq -e 'any(.[]; .type == "vpc_service" or .name == "MEMBERS" or (.name == "PAUSED" and (.text | fromjson | length > 0)))' <<<"$r2_carry" >/dev/null 2>&1 ||
    jq -e '.members == true' <<<"${2:-null}" >/dev/null 2>&1; then
    die "Worker version $1 is deployed on a tenant with members (a member binding, MEMBERS, a pause, or members:true in share.json); --force would break every member link; refused, nothing was changed"
  fi
}

r2_deploy() { # r2_deploy <worker> <team> <dataset> <first>: one multipart PUT; the first deploy adds the SALT secret, later ones keep it
  local worker=$1 team=$2 dataset=$3 salt="" out
  [[ $4 == 1 ]] && salt="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  r2_deploy_nonce="$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"   # DEPLOY: /healthz echoes it, so the wait below proves this deploy is the one serving
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    r2_api_retry PUT "/accounts/$acct/workers/scripts/$worker"   # a deploy is a whole-script PUT, so a 5xx retry is safe (OT-08)
    [[ $cf_code == 200 ]] || die "deploying Worker $worker answered HTTP $cf_code; the bucket and marker stay, rerun setup"
    # the settings a real GET answers: every binding, the secret without its value
    r2_deploy_meta "$team" "$dataset" "$salt" | jq -c '{bindings: ([.bindings[] | select(.type != "secret_text")] + [{type: "secret_text", name: "SALT"}])}' \
      >"${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf/script.json"
    return 0
  fi
  worker_js "$root/worker.js"
  local try nap="${SHARE_CF_RETRY_SLEEP:-2}"
  for try in 1 2 3; do   # a deploy is a whole-script PUT, so a 5xx retry is safe (OT-08)
    out="$(curl -sS --max-time 120 -w '\n%{http_code}' -X PUT "$api/accounts/$acct/workers/scripts/$worker" \
      -H @<(printf 'Authorization: Bearer %s\n' "$api_token") \
      -F 'metadata=<-;type=application/json' -F "share.js=@$root/worker.js;filename=share.js;type=application/javascript+module" \
      < <(r2_deploy_meta "$team" "$dataset" "$salt") 2>/dev/null)" || true
    cf_code="${out##*$'\n'}"   # the part's filename is the module name Cloudflare resolves main_module against
    [[ $cf_code == 5?? && $try -lt 3 ]] || break
    echo "share: Cloudflare answered HTTP $cf_code to the Worker deploy; retrying in ${nap}s (try $try of 3)" >&2
    sleep "$nap"; nap=$((nap * 2))
  done
  rm -f "$root/worker.js"
  [[ $cf_code == 200 ]] || die "deploying Worker $worker answered HTTP $cf_code ($(jq -r '[.errors[]?.message] | join("; ")' <<<"${out%$'\n'*}" 2>/dev/null | head -c 300)); the bucket and marker stay, rerun setup"
}

r2_no_token() { # the admin/publisher token block; callers send it to stderr
  cat <<EOF
share: setup --backend r2 reads its token from CLOUDFLARE_API_TOKEN only; none is set.
  Admin (creates the bucket, deploys the Worker, once per hostname): an account API token with
     Workers Scripts: Edit and Workers R2 Storage: Edit (account), Zone: Read and DNS: Read (zone),
     Access: Organizations Read (optional, for gated links),
     Access: Apps and Policies Edit (teardown --purge needs it to remove the Access apps of gated shares)
  Publisher (joins a hostname an admin set up): Workers R2 Storage Bucket Item Write on bucket $1 only, and Zone: Read
  Then: CLOUDFLARE_API_TOKEN=<token> $me setup $host_name --backend r2 --bucket $1
EOF
}

r2_setup_zone() { # r2_setup_zone: zone_name, zone_id, acct for the zone owning $host_name, walking up its labels
  local cand="$host_name"
  while [[ $cand == *.* ]]; do
    r2_api GET "/zones?name=$cand&status=active"
    [[ $cf_code == 200 ]] || die "reading zones answered HTTP $cf_code (the token needs Zone: Read); nothing was changed"
    if [[ "$(jq '.result | length' <<<"$cf_body")" == 1 ]]; then
      zone_id="$(jq -r '.result[0].id' <<<"$cf_body")"; acct="$(jq -r '.result[0].account.id' <<<"$cf_body")"; zone_name="$cand"
      return 0
    fi
    [[ $cand == *.*.* ]] || break
    cand="${cand#*.}"
  done
  die "no active Cloudflare zone for $host_name in this token's accounts; nothing was changed"
}

write_config_r2() { # write_config_r2 <bucket>: the r2 profile config; never a tunnel key; api_token_cmd, r2_token_cmd and every other line stay
  local a=()
  [[ -z ${r2_join_aliases:-} ]] || a=("aliases=$r2_join_aliases")   # a member's rm and expiry of a folded share delete its app
  config_put "$own_write_config_r2" backend=r2 "hostname=$host_name" "zone=$zone_name" "bucket=$1" port=r2 "r2_endpoint=$r2_endpoint" ${a[@]+"${a[@]}"}
}

tenant_admin() { # tenant_admin <bucket>: setup --r2 and --no-r2 on the origin: the profile checks, the admin token, zone, and the admin's own S3 pair
  [[ $mode != quick ]] || die "$host_name is a quick tunnel; R2 needs a named tunnel tenant: '$me teardown', then '$me setup <hostname>'"
  migrated_guard
  [[ -n $(cfg tunnel_id || true) && "$(cfg hostname || true)" == "$host_name" && $backend != r2 ]] ||
    die "this profile is not the tunnel origin of $host_name; run '$me setup $host_name' on the origin first"
  host_ok || die "run this on the origin, $hosts"
  local c
  for c in jq curl; do command -v "$c" >/dev/null || die "missing: $c (brew install $c)"; done
  admin_token_resolve required "setup --r2 and --no-r2 (Workers Scripts Edit, Workers R2 Storage Edit, Workers Routes Edit, Zone Read, DNS Read, Access Organizations Read)"
  api_token="$CLOUDFLARE_API_TOKEN"
  r2_setup_zone
  admin_pair_set "$1"
}
admin_pair_set() { # admin_pair_set <bucket>: the admin token's own S3 pair (r2_creds refuses an admin token as a publisher), after r2_setup_zone
  r2_endpoint="https://$acct.r2.cloudflarestorage.com" r2_bucket=$1
  r2_api GET /user/tokens/verify   # the admin token's own S3 pair, as SPEC-007's setup uses it
  r2_key_id="$(jq -r '.result.id // empty' <<<"$cf_body" 2>/dev/null || true)"
  [[ $cf_code == 200 && -n $r2_key_id ]] || die "the token did not verify (HTTP $cf_code); nothing was changed"
  r2_secret="$(printf '%s' "$api_token" | shasum -a 256 | cut -d' ' -f1)"
  r2on=1
}

tenant_route() { # tenant_route <worker>: the routes on the zone; sets route_id and route_open for <host>/* naming the worker; dies on a route of another script on this host
  local w=$1 p sc
  route_id="" route_open=""
  r2_api GET "/zones/$zone_id/workers/routes"
  [[ $cf_code == 200 ]] || die "reading Worker routes answered HTTP $cf_code (the token needs Workers Routes Edit); nothing was changed"
  while IFS=$'\t' read -r p sc; do   # any pattern whose host part matches this host and names another script would shadow or be shadowed by ours
    [[ -n $p ]] || continue
    # shellcheck disable=SC2053 # the route's host part is a glob on purpose
    [[ $host_name == ${p%%/*} ]] || continue
    [[ $sc == "$w" ]] || die "Worker route $p names script ${sc:-none}, not $w; refused, nothing was changed"
  done < <(jq -r '.result[]? | [.pattern, (.script // "")] | @tsv' <<<"$cf_body")
  route_id="$(jq -r --arg p "$host_name/*" --arg w "$w" '[.result[]? | select(.pattern == $p and .script == $w) | .id] | first // empty' <<<"$cf_body")"
  route_open="$(jq -r --arg p "$host_name/*" --arg w "$w" '[.result[]? | select(.pattern == $p and .script == $w) | .request_limit_fail_open] | first // empty' <<<"$cf_body")"
}

tenant_config() { # tenant_config [<bucket> <endpoint> <storage_default> <aliases>]: the four tenant keys in the tunnel config; none given drops them
  if [[ $# == 0 ]]; then config_put "$own_tenant_config"
  else config_put "$own_tenant_config" "bucket=$1" "r2_endpoint=$2" "storage_default=$3" "aliases=$4"; fi
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then if [[ $# == 0 ]]; then echo "CONFIG r2 off"; else echo "CONFIG r2 on"; fi >>"$root/r2-calls.log"; fi
}

alias_scan() { # alias_scan strict|list: after r2_read, every gated cloud record by its Access app's name: fold_apps ("<uuid> <id>" per app named for $alias), fold_late (ids gated at this host already: added since the fold); strict dies on any other app, before any write
  local cid copts uuid nm checked=0
  fold_apps="" fold_late=""
  while IFS=$'\t' read -r cid _ _ _ _ copts; do
    uuid="$(opt_val access "$copts" || true)"
    [[ -n $uuid ]] || continue
    if [[ $1 == strict && $checked == 0 ]]; then
      access_apps_edit_ok || die "the token lacks Access: Apps and Policies Edit, which --alias needs to move each gated link's app to $host_name; nothing was changed"
      checked=1
    fi
    cf_try GET "/accounts/$acct/access/apps/$uuid"
    nm=""; [[ $cf_code == 200 ]] && nm="$(jq -r '.result.name // empty' <<<"$cf_body")"
    case $nm in
      "share $cid $alias "*) fold_apps+="$uuid $cid"$'\n' ;;
      "share $cid $host_name "*) fold_late+="${fold_late:+ }$cid" ;;
      *) [[ $1 != strict ]] || die "the Access app $uuid of cloud link $cid answered HTTP $cf_code named '$nm', not 'share $cid $alias <nonce>'; refused, nothing was changed" ;;
    esac
  done < <(crows)
}

alias_dests() { # alias_dests add|undo|drop: each fold app gains <host>/<id>{,/*}, loses them again, or loses <alias>/<id>{,/*}; the PUT sends the full read-back (an omitted field resets to its default) and is skipped when nothing changes; alias_moved gets "<id> <aud>" per changed app
  local uuid id have want aud body
  alias_moved=""
  while read -r uuid id; do
    [[ -n $uuid ]] || continue
    cf_try GET "/accounts/$acct/access/apps/$uuid"
    [[ $cf_code == 200 ]] || return 1
    aud="$(jq -r '.result.aud // empty' <<<"$cf_body")"
    have="$(jq -c '[.result.destinations[]?]' <<<"$cf_body")"
    case $1 in
      add) want="$(jq -c --arg u "$host_name/$id" 'reduce ($u, $u + "/*") as $x (.; if any(.[]; .uri == $x) then . else . + [{type: "public", uri: $x}] end)' <<<"$have")" ;;
      undo) want="$(jq -c --arg u "$host_name/$id" 'map(select(.uri != $u and .uri != $u + "/*"))' <<<"$have")" ;;
      drop) want="$(jq -c --arg u "$alias/$id" 'map(select(.uri != $u and .uri != $u + "/*"))' <<<"$have")" ;;
    esac
    [[ $want != "$have" ]] || continue
    # del(.self_hosted_domains, .domain): these legacy mirrors of an app's original single destination
    # are not kept in sync by a later PUT. Echoing one back stale, now naming a destination this PUT
    # removes (drop's own case), answers 400; dropping them lets the API recompute them from destinations.
    body="$(jq -c --argjson d "$want" '.result | .destinations = $d | del(.self_hosted_domains, .domain)' <<<"$cf_body")"
    cf_try PUT "/accounts/$acct/access/apps/$uuid" "$body"
    [[ $cf_code == 200 && "$(jq -r '.result.aud // empty' <<<"$cf_body")" == "$aud" ]] || return 1
    alias_moved+="$id $aud"$'\n'
  done <<<"${fold_apps:-}"
}

alias_wait_301() { # alias_wait_301: https://<alias>/healthz answers 301 to https://<host>/healthz three times in a row within SHARE_R2_WAIT
  local wait="${SHARE_R2_WAIT:-300}" start=$SECONDS streak=0 out d="${SHARE_R2_DRY_DIR:-$root/r2-dry}/.cf"
  while :; do
    out="000 "
    if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then   # the dry alias answers 301 once its domain names this host's Worker and that Worker binds it in ALIASES
      printf 'ALIAS-301 %s\n' "$alias" >>"$root/r2-calls.log"
      if [[ ${SHARE_R2_DRY_FAIL:-} != ALIAS-301 && "$(jq -r .service "$d/domain.json" 2>/dev/null)" == "share-${host_name//./-}" ]] &&
        jq -e --arg a "$alias" 'any(.bindings[]; .name == "ALIASES" and (.text | split(",") | index($a)))' "$d/script.json" >/dev/null 2>&1; then
        out="301 https://$host_name/healthz"
      fi
    else
      out="$(curl -s -o /dev/null --max-time 10 --doh-url https://1.1.1.1/dns-query -w '%{http_code} %{redirect_url}' "https://$alias/healthz" 2>/dev/null)" ||
        out="$(curl -s -o /dev/null --max-time 10 -w '%{http_code} %{redirect_url}' "https://$alias/healthz" 2>/dev/null)" || out="000 "
    fi
    if [[ $out == "301 https://$host_name/healthz" ]]; then streak=$((streak + 1)); [[ $streak -ge 3 ]] && return 0; else streak=0; fi
    [[ $((SECONDS - start)) -lt $wait ]] || return 1
    if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then sleep 0.2; else sleep 2; fi
  done
}

alias_rollback() { # alias_rollback: the alias rollback list on stderr, in the order R1 rehearses it (the app destinations come back before the rebind)
  local apps="" ptrs cl uuid id
  while read -r uuid id; do [[ -n $uuid ]] && apps+="${apps:+, }$uuid ($id)"; done <<<"${fold_apps:-}"
  ptrs="$({ rows | cut -f1; cut -f1 <<<"${r2_machine:-}"; } | { grep -E '^[0-9a-f]{6}$' || true; } | sort -u | sed 's|^|m/|' | tr '\n' ' ')"   # no local rows and no pointers is a valid state: a grep with no match must not end the run under set -e before the list prints
  cl="$(crows | cut -f1 | tr '\n' ' ')"
  {
    echo "alias rollback for $alias, in this order, each with the tenant admin token:"
    echo "  1. each folded Access app gets $alias/<id> and $alias/<id>/* back (PUT the full GET result, only destinations changed): ${apps:-none}"
    echo "  2. PUT /accounts/$acct/workers/domains {\"hostname\":\"$alias\",\"service\":\"share-${alias//./-}\",\"zone_id\":\"$zone_id\",\"environment\":\"production\",\"override_existing_origin\":true}"
    echo "  3. PUT share.json in bucket $bucket with If-Match on its ETag: {\"v\":1,\"host\":\"$alias\"}"
    echo "  4. remove the aliases= line from $config"
    echo "  5. DELETE every v:2 machine record: ${ptrs:-none}"
    echo "  6. $me setup $host_name --no-r2"
    echo "  cloud links ${cl:-none }answer at https://$alias/<id>/ again, never at https://$host_name/<id>/; gated ones added since the fold (${fold_late:-none}) have no app on $alias: re-add them or tell their readers first"
  } >&2
}

tenant_die() { # tenant_die <msg>: a die after the config write names the rollback: the alias list when an alias is folded, --no-r2 otherwise
  if [[ -n ${alias:-} ]]; then alias_rollback; die_code tenant_rollback "$1; roll back with the alias rollback list above, or rerun the same setup" "$me setup $host_name --r2 --bucket ${bucket:-<name>}"; fi
  die_code tenant_rollback "$1; roll back with: $me setup $host_name --no-r2" "$me setup $host_name --no-r2"
}

alias_own_handoff() { # the local profile serving $alias hands its r2-own lines to this profile, so refresh keeps working on the shares it added; its own file stays
  local c n r id pfx src
  for c in "${XDG_CONFIG_HOME:-$HOME/.config}/share/config" "$profiles_dir"/*/config; do
    [[ -f $c && $c != "$config" ]] || continue
    [[ "$(awk 'index($0, "hostname=") == 1 {print substr($0, 10); exit}' "$c")" == "$alias" ]] || continue
    n="${c%/config}"; n="${n##*/}"
    if [[ $c == */profiles/*/config ]]; then r="$HOME/share/profiles/$n"; else r="$HOME/share"; fi
    [[ -f $r/r2-own ]] || continue
    while IFS=$'\t' read -r id pfx src; do
      [[ $id =~ ^[0-9a-f]{6}$ && $pfx == "o/$id."*/ ]] && r2_own_put "$id" "$pfx" "$src"
    done <"$r/r2-own"
    echo "r2-own:     the shares profile ${n:-default} added at $alias are this profile's to refresh"
  done
}

tenant_dep_read() { # tenant_dep_read <settings body>: the caller's dep_v, dep_sha, dep_team, dep_pass, dep_aliases
  dep_v="$(jq -r '[.result.bindings[] | select(.name == "VERSION") | .text] | first // "0"' <<<"$1")"
  dep_sha="$(jq -r '[.result.bindings[] | select(.name == "SHA") | .text] | first // ""' <<<"$1")"
  dep_team="$(jq -r '[.result.bindings[] | select(.name == "TEAM") | .text] | first // ""' <<<"$1")"
  dep_pass="$(jq -r '[.result.bindings[] | select(.name == "PASS") | .text] | first // ""' <<<"$1")"
  dep_aliases="$(jq -r '[.result.bindings[] | select(.name == "ALIASES") | .text] | first // ""' <<<"$1")"
}
cmd_setup_tenant() { # cmd_setup_tenant <bucket> <storage_default> <force> [alias]: setup <host> --r2 on the origin; every read and refusal before the first write; a rerun converges
  local bucket=$1 sdef=$2 force=$3 alias=${4:-} worker="share-${host_name//./-}" dataset="share_${host_name//[.-]/_}" calias
  calias="$(cfg aliases || true)"; alias="${alias:-$calias}"   # a rerun without --alias keeps the folded alias, so the redeploy keeps ALIASES
  if [[ -n $alias ]]; then   # step 1: one alias, another hostname
    if [[ $alias == "$host_name" ]] || ! hostname_ok "$alias"; then die "--alias needs another hostname, not '$alias'; nothing was changed"; fi
    [[ -z $calias || $calias == "$alias" ]] || die "$host_name already folds $calias; one alias per tenant; nothing was changed"
  fi
  [[ $bucket =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || die "bad bucket name '$bucket' (3-63 chars of a-z 0-9 -; no leading or trailing -)"
  [[ $dataset =~ ^[a-z0-9_]+$ ]] || die "bad hostname '$host_name' for a dataset name"
  local cur; cur="$(cfg bucket || true)"
  [[ -z $cur || $cur == "$bucket" ]] || die "R2 is on for $host_name with bucket $cur; '$me setup $host_name --no-r2' first"
  [[ $tunnel == 0 ]] || running || die "$host_name is not serving on this machine; '$me start', then rerun; nothing was changed"
  local rerun=(setup "$host_name" --r2 --bucket "$bucket") rollback=(-- setup "$host_name" --no-r2)
  [[ -z $sdef ]] || rerun+=(--storage-default "$sdef")
  [[ $force != 1 ]] || rerun+=(--force)
  [[ -z ${4:-} ]] || rerun+=(--alias "$4")
  [[ -z $alias ]] || rollback=()   # after an alias fold --no-r2 refuses; the rollback is the alias list tenant_die prints
  migrated_guard   # these two refusals come before the journal: nothing is written for them
  admin_token_resolve required "setup --r2 and --no-r2 (Workers Scripts Edit, Workers R2 Storage Edit, Workers Routes Edit, Zone Read, DNS Read, Access Organizations Read)"
  op_begin setup-r2 "${rerun[@]}" ${rollback[@]+"${rollback[@]}"}
  op_step 1
  sdef="${sdef:-$(cfg storage_default || true)}"; sdef="${sdef:-local}"
  tenant_admin "$bucket"
  [[ -z $alias || $alias == *".$zone_name" ]] || die "--alias $alias is not in zone $zone_name, where the tenant Worker lives; nothing was changed"

  # step 2: only an admin token reads the Worker's settings
  op_step 2
  local first=0 dep_v=0 dep_sha="" dep_team="" dep_pass="" dep_aliases=""
  r2_api GET "/accounts/$acct/workers/scripts/$worker/settings"
  case $cf_code in
    200) ;;
    404) first=1 ;;
    401|403) die "the token cannot read Worker $worker's settings: only the tenant admin enables R2 (an admin token in CLOUDFLARE_API_TOKEN); nothing was changed" ;;
    *) die "reading Worker $worker answered HTTP $cf_code; nothing was changed" ;;
  esac
  echo "deploying as admin"
  if [[ $first == 0 ]]; then   # step 3, SPEC-007 step 4: share's Worker for this host and bucket, never a downgrade
    jq -e --arg h "$host_name" --arg b "$bucket" '.result.bindings as $bs
      | ($bs | any(.name == "HOST" and .text == $h)) and ($bs | any(.name == "BUCKET" and .bucket_name == $b))
        and ($bs | any(.name == "VERSION" and (.text | test("^[0-9]+$"))))' <<<"$cf_body" >/dev/null ||
      die "Worker $worker exists but is not share's Worker for $host_name on bucket $bucket (its bindings differ); refused, nothing was changed"
    tenant_dep_read "$cf_body"
    [[ $dep_v -le $WORKER_VERSION || $force == 1 ]] ||
      die "Worker $worker runs version $dep_v, newer than this share's $WORKER_VERSION; upgrade share, or pass --force to downgrade it; nothing was changed"
    r2_carry_read "$cf_body"   # carry-forward: this deploy re-sends every member binding, MEMBERS and PAUSED as deployed
    r2_carry_downgrade "$dep_v"
    r2_carry_fresh "/accounts/$acct/workers/scripts/$worker/settings"
    r2_carry_services
  fi

  # step 3, SPEC-007 step 5: a private bucket, empty or holding this host's marker
  op_step 3
  local bucket_new=0 marker="" marker_etag=""
  r2_api GET "/accounts/$acct/r2/buckets/$bucket"
  case $cf_code in
    404) bucket_new=1 ;;
    200)
      r2_api GET "/accounts/$acct/r2/buckets/$bucket/domains/managed"
      [[ $cf_code == 200 ]] || die "reading bucket $bucket's r2.dev setting answered HTTP $cf_code; nothing was changed"
      [[ "$(jq -r '.result.enabled' <<<"$cf_body")" == false ]] || die "bucket $bucket has its public r2.dev URL on; a share bucket must be private; refused, nothing was changed"
      r2_api GET "/accounts/$acct/r2/buckets/$bucket/domains/custom"
      [[ $cf_code == 200 ]] || die "reading bucket $bucket's custom domains answered HTTP $cf_code; nothing was changed"
      [[ "$(jq '.result.domains | length' <<<"$cf_body")" == 0 ]] || die "bucket $bucket has a public custom domain; a share bucket must be private; refused, nothing was changed"
      r2_call LIST ""
      [[ $cf_code == 200 ]] || die "listing bucket $bucket answered HTTP $cf_code; nothing was changed"
      local has_objects=0; [[ $cf_body == *"<Key>"* ]] && has_objects=1
      r2_call GET share.json
      case $cf_code in
        200) marker="$cf_body" marker_etag=$r2_etag   # the fold: a marker naming the alias is the alias's bucket, adopted in place
          r2_carry_downgrade "$dep_v" "$marker"   # a T2 tenant with cloud members only still needs the redeem route
          jq -e --arg h "$host_name" --arg a "$alias" '.v == 1 and (.host == $h or ($a != "" and .host == $a))
            and ((.aliases // []) - [$a] | length == 0)' <<<"$marker" >/dev/null 2>&1 ||
            die "bucket $bucket's share.json names another hostname or alias; refused, nothing was changed" ;;
        404) [[ $has_objects == 0 ]] || die "bucket $bucket holds objects and no share.json; it is not a share bucket; refused, nothing was changed" ;;
        *) die "reading $bucket/share.json answered HTTP $cf_code; nothing was changed" ;;
      esac ;;
    *) die "reading bucket $bucket answered HTTP $cf_code (the token needs Workers R2 Storage: Edit); nothing was changed" ;;
  esac

  local t2=0   # T2 (config members=on OR marker members:true, DEC-33): the deploy needs Connectivity scope, and its body is read under the lease (DEC-62)
  [[ "$(cfg members || true)" != on ]] || t2=1
  jq -e '.members == true' <<<"${marker:-null}" >/dev/null 2>&1 && t2=1
  [[ -z $marker ]] || marker_cache "$(jq -e '.members == true' <<<"$marker" >/dev/null 2>&1 && echo 1 || echo 0)"
  if [[ $t2 == 1 ]]; then
    r2_api GET "/accounts/$acct/connectivity/directory/services?per_page=1"
    [[ $cf_code == 200 ]] || die_code admin_token_scope "$host_name has members, and every deploy there carries member bindings: the admin token lacks Connectivity Directory Admin (HTTP $cf_code); nothing was changed" "$me admin-token --test"
  fi

  # step 4: the alias's custom domain is its own share Worker on this bucket, or this one's after an earlier fold
  op_step 4
  local alias_svc=""
  if [[ -n $alias ]]; then
    local aw="share-${alias//./-}"
    r2_api GET "/accounts/$acct/workers/domains?hostname=$alias"
    [[ $cf_code == 200 ]] || die "reading Worker custom domains answered HTTP $cf_code; nothing was changed"
    alias_svc="$(jq -r --arg h "$alias" '[.result[]? | select(.hostname == $h) | .service] | first // empty' <<<"$cf_body")"
    if [[ -n $alias_svc && $alias_svc != "$worker" ]]; then
      [[ $alias_svc == "$aw" ]] || die "$alias is the custom domain of Worker $alias_svc, not $aw; refused, nothing was changed"
      r2_api GET "/accounts/$acct/workers/scripts/$aw/settings"
      [[ $cf_code == 200 ]] || cf_body='{}'
      jq -e --arg h "$alias" --arg b "$bucket" '.result.bindings as $bs
        | ($bs | any(.name == "HOST" and .text == $h)) and ($bs | any(.name == "BUCKET" and .bucket_name == $b))' <<<"$cf_body" >/dev/null 2>&1 ||
        die "Worker $aw is not share's Worker for $alias on bucket $bucket (HTTP $cf_code, or its bindings differ); refused, nothing was changed"
    fi
  fi

  # step 5: no route of another script on this host
  op_step 5
  tenant_route "$worker"

  local team=""   # SPEC-007 step 7: the Access team for gated cloud links
  r2_api GET "/accounts/$acct/access/organizations"
  if [[ $cf_code == 200 ]]; then
    team="$(jq -r '.result.auth_domain // empty' <<<"$cf_body")"
    [[ $team =~ ^[a-z0-9-]+\.cloudflareaccess\.com$ ]] || team=""
  else
    team="$dep_team"
  fi

  # step 6, under the index lock through step 11 so a concurrent add waits: the bucket snapshot against the local index
  op_step 6
  mkdir -p "$root"
  lock_take index
  local ids id clash=""
  ids="$(rows | cut -f1)"
  if [[ $bucket_new == 0 ]]; then
    r2_read
    for id in $ids; do
      grep -qx "$id" <<<"$r2_mkeys" || continue
      grep -q "^$id"$'\t' <<<"$r2_machine" || clash="${clash:+$clash }$id"
    done
    [[ -z $clash ]] || die "local links $clash share an id with a record in bucket $bucket (a cloud link); rm one of each pair, then rerun; nothing was changed"
  fi
  fold_apps="" fold_late=""
  op_step 7
  [[ -z $alias || $bucket_new == 1 ]] || alias_scan strict   # step 7: every gated cloud link's app is the alias's (or this host's after a fold)

  # writes. A new bucket gets its marker before any pointer, so a die below leaves a bucket that names this host
  op_step 8
  if [[ $bucket_new == 1 ]]; then
    r2_api POST "/accounts/$acct/r2/buckets" "{\"name\":\"$bucket\"}"
    [[ $cf_code == 200 ]] || die "creating bucket $bucket answered HTTP $cf_code"
  fi
  if [[ -z $marker ]]; then
    local mf; mf="$(mktemp "$root/.marker.XXXXXX")"
    printf '{"v":1,"host":"%s"}\n' "$host_name" >"$mf"
    r2_call PUT share.json "$mf" -H 'If-None-Match: *'
    [[ $cf_code == 200 || $cf_code == 412 ]] || { rm -f "$mf"; die "writing $bucket/share.json answered HTTP $cf_code"; }
    if [[ $cf_code == 412 ]]; then
      r2_call GET share.json
      jq -e --arg h "$host_name" '.v == 1 and .host == $h' <<<"$cf_body" >/dev/null 2>&1 || { rm -f "$mf"; die "bucket $bucket's share.json names another hostname"; }
      marker="$cf_body" marker_etag=$r2_etag
    else
      marker="$(cat "$mf")" marker_etag=$r2_etag
    fi
    rm -f "$mf"
  fi
  # step 8: the Worker with PASS and ALIASES, workers.dev off; on T2 under lock/admin, its body from a settings read made after the lease
  if [[ $t2 == 1 && $first == 0 ]]; then
    lease_take setup-r2 "-"
    r2_api GET "/accounts/$acct/workers/scripts/$worker/settings"
    [[ $cf_code == 200 ]] || die "reading Worker $worker's settings under the lease answered HTTP $cf_code; rerun the same setup"
    tenant_dep_read "$cf_body"
    r2_carry_read "$cf_body"
    r2_carry_downgrade "$dep_v" "$marker"
    r2_carry_force=1; r2_carry_fresh "/accounts/$acct/workers/scripts/$worker/settings"; r2_carry_force=0
    r2_carry_services
  fi
  r2_pass=1 r2_aliases="$alias"
  if [[ $first == 1 || $dep_v != "$WORKER_VERSION" || $dep_sha != "$WORKER_SHA" || $dep_team != "$team" || $dep_pass != 1 || $dep_aliases != "$r2_aliases" ||
    $r2_carry != "$r2_carry_dep" ]]; then
    r2_deploy "$worker" "$team" "$dataset" "$first"
    echo "worker:     $worker $WORKER_VERSION $WORKER_SHA deployed (passes misses to the tunnel)"
  else
    echo "worker:     $worker $WORKER_VERSION $WORKER_SHA already deployed"
  fi
  r2_api POST "/accounts/$acct/workers/scripts/$worker/subdomain" '{"enabled":false,"previews_enabled":false}'
  [[ $cf_code == 200 ]] || die "turning off $worker's workers.dev route answered HTTP $cf_code; no route exists yet, nothing is exposed"
  r2_api GET "/accounts/$acct/workers/scripts/$worker/subdomain"
  [[ $cf_code == 200 && "$(jq -r '"\(.result.enabled),\(.result.previews_enabled)"' <<<"$cf_body")" == false,false ]] ||
    die "$worker's workers.dev route still reads on; no route exists yet, nothing is exposed; rerun setup"

  # step 9: a pointer for every local row; one that holds this origin's pointer already is done
  op_step 9
  local n=0 ptr_hint=""
  [[ -z $alias ]] || ptr_hint=" (or DELETE the v:2 pointers written so far: an older member sweep cannot read them)"
  for id in $ids; do
    grep -q "^$id"$'\t' <<<"${r2_machine:-}" && continue
    local name src date exp opts t
    IFS=$'\t' read -r _ name src date exp opts <<<"$(row "$id")"
    if has_opt live "$opts"; then t=site; else t="$(share_type "$pub/$id/$name")"; fi
    r2_pointer_write "$id" "$name" "$t" "$exp" "$opts" "$(opt_val access "$opts" || true)" "$date"
    case $cf_code in
      200) n=$((n + 1)) ;;
      412) die "another publisher took id $id in bucket $bucket during setup; the route is not attached; rm one of them, then rerun$ptr_hint" ;;
      *) die "writing the pointer m/$id answered HTTP $cf_code; the route is not attached; rerun the same setup$ptr_hint" ;;
    esac
  done
  echo "pointers:   $n written"

  # step 10: each folded app gains this host's destinations (AUD kept); Access must enforce there before anything points visitors at it
  op_step 10
  if [[ -n $fold_apps ]]; then
    alias_dests add || { alias_dests undo || true; die "moving the Access apps to $host_name answered HTTP $cf_code; the added destinations were removed; the route is not attached; rerun the same setup (or DELETE the v:2 pointers written so far)"; }
    local gid gaud
    while read -r gid gaud; do
      [[ -n $gid ]] || continue
      access_gate "$gid" "$gaud" || { alias_dests undo || true; die "Cloudflare Access did not enforce on $host_name/$gid within ${access_wait}s; the added destinations were removed; the route is not attached; rerun the same setup (or DELETE the v:2 pointers written so far)"; }
    done <<<"$alias_moved"
    held_access_id=""   # every folded app enforced, so nothing waits in access-pending
    echo "access:     $(grep -c . <<<"$fold_apps") gated link(s) also gated at $host_name"
  fi

  # step 11: the config, before the marker and the route, so every later die leaves a state a rerun and the rollback can read
  op_step 11
  tenant_config "$bucket" "$r2_endpoint" "$sdef" "$alias"
  lock_release index

  # step 12: the marker names this host and its alias, written only over the copy read above
  op_step 12
  if [[ -n $alias ]]; then
    local want; want="{\"v\":1,\"host\":\"$host_name\",\"aliases\":[\"$alias\"]}"
    if [[ "$(jq -c . <<<"${marker:-null}" 2>/dev/null)" != "$want" ]]; then
      local mf2; mf2="$(mktemp "$root/.marker.XXXXXX")"; printf '%s\n' "$want" >"$mf2"
      if [[ -n $marker ]]; then r2_call PUT share.json "$mf2" -H "If-Match: \"$marker_etag\""; else r2_call PUT share.json "$mf2"; fi
      rm -f "$mf2"
      [[ $cf_code == 200 ]] || tenant_die "writing $bucket/share.json answered HTTP $cf_code (412: it changed since it was read)"
    fi
  fi

  # step 13: the route; fail open at a request limit (a drop to the free plan) keeps machine links up
  op_step 13
  local body="{\"pattern\":\"$host_name/*\",\"script\":\"$worker\",\"request_limit_fail_open\":true}"
  if [[ -z $route_id ]]; then
    r2_api POST "/zones/$zone_id/workers/routes" "$body"
    [[ $cf_code == 200 ]] || tenant_die "attaching the route $host_name/* answered HTTP $cf_code; links still serve from the tunnel"
    echo "route:      $host_name/* -> $worker"
  elif [[ $route_open != true ]]; then
    r2_api PUT "/zones/$zone_id/workers/routes/$route_id" "$body"
    [[ $cf_code == 200 ]] || tenant_die "setting the route $host_name/* to fail open answered HTTP $cf_code"
    echo "route:      $host_name/* -> $worker (now fails open)"
  else
    echo "route:      $host_name/* -> $worker already attached"
  fi

  # step 14: the alias's custom domain moves to this Worker in place (the plain PUT refuses a bound name)
  op_step 14
  if [[ -n $alias && $alias_svc != "$worker" ]]; then
    r2_api_retry PUT "/accounts/$acct/workers/domains" "{\"hostname\":\"$alias\",\"service\":\"$worker\",\"zone_id\":\"$zone_id\",\"environment\":\"production\",\"override_existing_origin\":true}"
    [[ $cf_code == 200 ]] || tenant_die "binding $alias to $worker answered HTTP $cf_code (after up to 3 tries); ${alias_svc:-no Worker} still serves it"
    echo "alias:      $alias -> $worker (answers 301 to $host_name)"
  fi

  # step 15: both legs, then a probe file through the tunnel leg, then the alias's 301
  op_step 15
  r2_wait_healthz tenant
  lease_release   # T2: held from the settings read through the nonce wait (DEC-62)
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then echo "TUNNEL-PROBE" >>"$root/r2-calls.log"
  else live_check 60 "$host_name" || tenant_die "a probe file did not answer through https://$host_name/ three times in a row; the tunnel leg is down"; fi
  [[ -z $alias ]] || alias_wait_301 || tenant_die "https://$alias/healthz did not answer 301 to https://$host_name/healthz three times in a row within ${SHARE_R2_WAIT:-300}s"

  # step 16: the folded apps drop the alias's destinations; this profile takes over the alias profile's own shares
  op_step 16
  if [[ -n $alias ]]; then
    alias_dests drop || die "dropping $alias from the folded Access apps answered HTTP $cf_code; the fold serves; rerun the same setup to finish"
    alias_own_handoff
  fi
  op_done
  echo "ready:      R2 is on for https://$host_name/ (bucket $bucket, storage default $sdef${alias:+, $alias redirects here}). Store this origin's publisher token: $me api-token"
}

cmd_setup_no_r2() { # cmd_setup_no_r2: the rollback without an alias: the route goes, then the four config keys; the bucket, records, and Worker stay
  local bucket worker="share-${host_name//./-}"
  bucket="$(cfg bucket || true)"
  local alias; alias="$(cfg aliases || true)"
  tenant_admin "${bucket:-none}"
  [[ -z $bucket ]] || t2_refuse "--no-r2 (run $me setup $host_name --r2 --bucket $bucket --no-members first)" "$me setup $host_name --r2 --bucket $bucket --no-members"
  if [[ -z $alias && -n $bucket ]]; then   # the marker's aliases count too: a 301 landing on a plain tunnel turns every folded cloud link into a 404
    r2_call GET share.json
    [[ $cf_code == 200 ]] && alias="$(jq -r '(.aliases // []) | join(",")' <<<"$cf_body" 2>/dev/null || true)"
  fi
  if [[ -n $alias ]]; then
    fold_apps="" fold_late=""
    r2_read; alias_scan list
    alias_rollback
    die "$alias redirects here; run the alias rollback above first; nothing was changed"
  fi
  op_begin no-r2 setup "$host_name" --no-r2
  op_step 1
  tenant_route "$worker"
  if [[ -n $route_id ]]; then
    r2_api DELETE "/zones/$zone_id/workers/routes/$route_id"
    [[ $cf_code == 200 || $cf_code == 404 ]] || die "deleting the route $host_name/* answered HTTP $cf_code; R2 stays on; rerun"
    echo "route:      $host_name/* removed"
  fi
  op_step 2
  tenant_config
  op_done
  echo "ready:      R2 is off for https://$host_name/: the tunnel serves it alone. The bucket, its records, and Worker $worker stay"
}

cmd_setup_r2() { # cmd_setup_r2 <force> <bucket> <tname> <login> <service> <quick>: every refusal before the first write
  local force=$1 bucket=$2 tname=$3 login=$4 service=$5 quick=$6
  local rusage="usage: share setup <hostname> --backend r2 --bucket <name> [--force]"
  [[ $quick == 0 && -z $tname && $login == 0 && $service == 1 && -n $bucket ]] || die "$rusage"
  [[ $bucket =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || die "bad bucket name '$bucket' (3-63 chars of a-z 0-9 -; no leading or trailing -)"
  [[ -n $host_name ]] || die "$rusage"
  [[ $host_name =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || die "bad hostname '$host_name' ($rusage)"
  [[ -z $(cfg tunnel_id || true) && $(cfg mode || true) != quick ]] || die "already set up with a tunnel; run '$me teardown' first"
  local o
  for o in $(other_cfg hostname); do
    [[ $o != "$host_name" ]] || die "$host_name is already the hostname of another profile (share profiles)"
  done
  local worker="share-${host_name//./-}" dataset="share_${host_name//[.-]/_}" c missing=""
  [[ $dataset =~ ^[a-z0-9_]+$ ]] || die "bad hostname '$host_name' for a dataset name"
  for c in jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  backend=r2 r2_bucket=$bucket

  # steps 1 to 7 only read; every refusal happens here, before the first write
  admin_token_resolve optional   # B6: a publisher with no token keeps today's guidance block below
  api_token="${CLOUDFLARE_API_TOKEN:-}"
  [[ -n $api_token ]] || { r2_no_token "$bucket" >&2; exit 1; }
  r2_setup_zone
  r2_endpoint="https://$acct.r2.cloudflarestorage.com"
  r2_api GET /user/tokens/verify   # the S3 access key is the token's own id; the secret its sha256, from stdin
  r2_key_id="$(jq -r '.result.id // empty' <<<"$cf_body" 2>/dev/null || true)"
  [[ $cf_code == 200 && -n $r2_key_id ]] || die "the token did not verify (HTTP $cf_code); nothing was changed"
  r2_secret="$(printf '%s' "$api_token" | shasum -a 256 | cut -d' ' -f1)"

  local role first=0 dep_v=0 dep_sha="" dep_team=""
  r2_api GET "/accounts/$acct/workers/scripts/$worker/settings"
  case $cf_code in
    200) role="admin" ;;
    404) role="admin" first=1 ;;
    401|403) role="join" ;;
    *) die "reading Worker $worker answered HTTP $cf_code; nothing was changed" ;;
  esac
  [[ $role == admin ]] && echo "deploying as admin" || echo "joining as publisher"
  if [[ $role == admin && $first == 0 ]]; then
    jq -e --arg h "$host_name" --arg b "$bucket" '.result.bindings as $bs
      | ($bs | any(.name == "HOST" and .text == $h)) and ($bs | any(.name == "BUCKET" and .bucket_name == $b))
        and ($bs | any(.name == "VERSION" and (.text | test("^[0-9]+$"))))' <<<"$cf_body" >/dev/null ||
      die "Worker $worker exists but is not share's Worker for $host_name on bucket $bucket (its bindings differ); refused, nothing was changed"
    dep_v="$(jq -r '.result.bindings[] | select(.name == "VERSION") | .text' <<<"$cf_body")"
    dep_sha="$(jq -r '[.result.bindings[] | select(.name == "SHA") | .text] | first // ""' <<<"$cf_body")"
    dep_team="$(jq -r '[.result.bindings[] | select(.name == "TEAM") | .text] | first // ""' <<<"$cf_body")"
    [[ $dep_v -le $WORKER_VERSION || $force == 1 ]] ||
      die "Worker $worker runs version $dep_v, newer than this share's $WORKER_VERSION; upgrade share, or pass --force to downgrade it; nothing was changed"
    r2_carry_read "$cf_body"
    # a tenant Worker (PASS) sits in front of a tunnel: this path would drop PASS and ALIASES and swap the CNAME for a custom domain
    jq -e '.result.bindings | any(.name == "PASS" and .text == "1")' <<<"$cf_body" >/dev/null &&
      die "$host_name is a tenant with R2 on (its Worker passes misses to a tunnel); refused even with --force, nothing was changed; run '$me setup $host_name --r2 --bucket $bucket' on the origin"
  fi

  local bucket_new=0 marker="" skipped=0
  r2_api GET "/accounts/$acct/r2/buckets/$bucket"
  case "$role $cf_code" in
    "admin 404") bucket_new=1 ;;
    "join 404") die "bucket $bucket does not exist; whoever holds the admin token runs '$me setup $host_name --backend r2 --bucket $bucket' first" ;;
    "admin 200"|"join 200"|"join 403")   # a bucket-scoped token cannot read bucket settings; the S3 reads below prove the bucket
      r2_api GET "/accounts/$acct/r2/buckets/$bucket/domains/managed"
      if [[ $role == join && $cf_code == 403 ]]; then skipped=1
      else
        [[ $cf_code == 200 ]] || die "reading bucket $bucket's r2.dev setting answered HTTP $cf_code; nothing was changed"
        [[ "$(jq -r '.result.enabled' <<<"$cf_body")" == false ]] || die "bucket $bucket has its public r2.dev URL on; a share bucket must be private; refused, nothing was changed"
      fi
      r2_api GET "/accounts/$acct/r2/buckets/$bucket/domains/custom"
      if [[ $role == join && $cf_code == 403 ]]; then skipped=1
      else
        [[ $cf_code == 200 ]] || die "reading bucket $bucket's custom domains answered HTTP $cf_code; nothing was changed"
        [[ "$(jq '.result.domains | length' <<<"$cf_body")" == 0 ]] || die "bucket $bucket has a public custom domain; a share bucket must be private; refused, nothing was changed"
      fi
      [[ $skipped == 1 ]] && echo "public-route check skipped (publisher token)"
      r2_call LIST ""
      [[ $cf_code == 200 ]] || die "listing bucket $bucket answered HTTP $cf_code; nothing was changed"
      local has_objects=0; [[ $cf_body == *"<Key>"* ]] && has_objects=1
      r2_call GET share.json
      case $cf_code in
        200) marker="$cf_body"
          jq -e --arg h "$host_name" '.v == 1 and .host == $h' <<<"$marker" >/dev/null 2>&1 ||
            die "bucket $bucket's share.json names another hostname; refused, nothing was changed"
          [[ $role != admin ]] || ! jq -e '(.aliases // []) | length > 0' <<<"$marker" >/dev/null 2>&1 ||
            die "$host_name is a tenant with R2 on (its marker holds aliases); refused even with --force, nothing was changed; run '$me setup $host_name --r2 --bucket $bucket' on the origin" ;;
        404) [[ $role == admin ]] || die "bucket $bucket has no share.json; whoever holds the admin token runs '$me setup $host_name --backend r2 --bucket $bucket' first"
          [[ $has_objects == 0 ]] || die "bucket $bucket holds objects and no share.json; it is not a share bucket; refused, nothing was changed" ;;
        *) die "reading $bucket/share.json answered HTTP $cf_code; nothing was changed" ;;
      esac ;;
    *) die "reading bucket $bucket answered HTTP $cf_code (the token needs Workers R2 Storage: Edit); nothing was changed" ;;
  esac

  if [[ $role == join ]]; then   # join writes nothing on Cloudflare: the live check, then the local config
    r2_wait_healthz join
    local alias
    r2_join_aliases=""   # read once from the marker (any publisher can write it), kept only when the alias really answers 301 here
    for alias in $(jq -r '(.aliases // [])[] | strings' <<<"${marker:-null}" 2>/dev/null || true); do
      if hostname_ok "$alias" && alias_wait_301; then r2_join_aliases+="${r2_join_aliases:+,}$alias"
      else echo "alias $alias: the marker names it, but https://$alias/healthz does not answer 301 here; not kept"; fi
    done
    if [[ $hz_pair != "$WORKER_VERSION $WORKER_SHA" && -n $hz_tunnel ]]; then   # a tenant Worker: only its origin redeploys it
      echo "the Worker at $host_name runs $hz_pair; this share ships $WORKER_VERSION $WORKER_SHA; whoever holds the admin token runs '$me setup $host_name --r2 --bucket $bucket' on the tenant's origin"
    elif [[ $hz_pair != "$WORKER_VERSION $WORKER_SHA" ]]; then
      echo "the Worker at $host_name runs $hz_pair; this share ships $WORKER_VERSION $WORKER_SHA; whoever holds the admin token reruns '$me setup $host_name --backend r2 --bucket $bucket'"
    fi
    write_config_r2 "$bucket"
    echo "ready:      https://$host_name/ serves from bucket $bucket. Store your publisher token: $me api-token; then: $me add <file|dir>"
    return 0
  fi

  r2_api GET "/zones/$zone_id/workers/routes"   # a route on the hostname means a tenant; SPEC-007's minimal admin set may answer 403, which the PASS check covers
  case $cf_code in
    200) [[ "$(jq --arg p "$host_name/*" '[.result[]? | select(.pattern == $p)] | length' <<<"$cf_body")" == 0 ]] ||
           die "$host_name has a Worker route on $host_name/* (a tenant with R2 on); refused even with --force, nothing was changed; run '$me setup $host_name --r2 --bucket $bucket' on the origin" ;;
    403) ;;
    *) die "reading Worker routes answered HTTP $cf_code; nothing was changed" ;;
  esac
  r2_api GET "/zones/$zone_id/dns_records?name=$host_name"
  [[ $cf_code == 200 ]] || die "reading DNS for $host_name answered HTTP $cf_code (the token needs DNS: Read); nothing was changed"
  local ndns ours theirs
  ndns="$(jq '.result | length' <<<"$cf_body")"
  r2_api GET "/accounts/$acct/workers/domains?hostname=$host_name"
  [[ $cf_code == 200 ]] || die "reading Worker custom domains answered HTTP $cf_code; nothing was changed"
  ours="$(jq --arg h "$host_name" --arg w "$worker" '[.result[] | select(.hostname == $h and .service == $w)] | length' <<<"$cf_body")"
  theirs="$(jq --arg h "$host_name" --arg w "$worker" '[.result[] | select(.hostname == $h and .service != $w)] | length' <<<"$cf_body")"
  [[ $theirs == 0 ]] || die "$host_name is the custom domain of another Worker; refused even with --force, nothing was changed"
  [[ $ndns == 0 || $ours != 0 || $force == 1 ]] || die "$host_name already has a DNS record that is not this Worker's custom domain; refused (--force replaces it), nothing was changed"

  local team=""
  r2_api GET "/accounts/$acct/access/organizations"
  if [[ $cf_code == 200 ]]; then
    team="$(jq -r '.result.auth_domain // empty' <<<"$cf_body")"
    [[ $team =~ ^[a-z0-9-]+\.cloudflareaccess\.com$ ]] || team=""
  else
    team="$dep_team"   # a token without Access: Organizations Read keeps the deployed TEAM rather than blanking every gated link
  fi

  # steps 8 to 11 write
  mkdir -p "$root"
  if [[ $bucket_new == 1 ]]; then
    r2_api POST "/accounts/$acct/r2/buckets" "{\"name\":\"$bucket\"}"
    [[ $cf_code == 200 ]] || die "creating bucket $bucket answered HTTP $cf_code"
  fi
  if [[ -z $marker ]]; then
    local mf; mf="$(mktemp "$root/.marker.XXXXXX")"
    printf '{"v":1,"host":"%s"}\n' "$host_name" >"$mf"
    r2_call PUT share.json "$mf" -H 'If-None-Match: *'
    rm -f "$mf"
    [[ $cf_code == 200 || $cf_code == 412 ]] || die "writing $bucket/share.json answered HTTP $cf_code"
    if [[ $cf_code == 412 ]]; then   # another admin wrote it first: it must name this hostname
      r2_call GET share.json
      jq -e --arg h "$host_name" '.v == 1 and .host == $h' <<<"$cf_body" >/dev/null 2>&1 || die "bucket $bucket's share.json names another hostname"
    fi
  fi
  if [[ $first == 1 || $dep_v != "$WORKER_VERSION" || $dep_sha != "$WORKER_SHA" || $dep_team != "$team" || $r2_carry != "$r2_carry_dep" ]]; then
    [[ $first == 0 && $dep_team != "$team" ]] && echo "Access team: '${dep_team:-none}' -> '${team:-none}'"
    r2_deploy "$worker" "$team" "$dataset" "$first"
    echo "worker:     $worker $WORKER_VERSION $WORKER_SHA deployed"
  else
    echo "worker:     $worker $WORKER_VERSION $WORKER_SHA already deployed"
  fi
  r2_api POST "/accounts/$acct/workers/scripts/$worker/subdomain" '{"enabled":false,"previews_enabled":false}'
  [[ $cf_code == 200 ]] || die "turning off $worker's workers.dev route answered HTTP $cf_code; no custom domain exists yet, nothing is exposed"
  r2_api GET "/accounts/$acct/workers/scripts/$worker/subdomain"
  [[ $cf_code == 200 && "$(jq -r '"\(.result.enabled),\(.result.previews_enabled)"' <<<"$cf_body")" == false,false ]] ||
    die "$worker's workers.dev route still reads on; no custom domain exists yet, nothing is exposed; rerun setup"
  if [[ $ours == 0 ]]; then
    r2_api_retry PUT "/accounts/$acct/workers/domains" "{\"hostname\":\"$host_name\",\"service\":\"$worker\",\"zone_id\":\"$zone_id\",\"environment\":\"production\"$([[ $force == 1 ]] && echo ',"override_existing_dns_record":true')}"
    [[ $cf_code == 200 ]] || die "adding $host_name as $worker's custom domain answered HTTP $cf_code (after up to 3 tries)"
  fi

  r2_wait_healthz admin

  write_config_r2 "$bucket"
  echo "ready:      https://$host_name/ serves from bucket $bucket. Next: $me add <file|dir>"
}

tusage="usage: share setup <hostname> --r2 --bucket <name> [--storage-default local|cloud] [--alias <old-host>] | share setup <hostname> --r2 --bucket <name> --members|--no-members [--yes] | share setup <hostname> --no-r2"
cmd_setup() {
  [[ $role != member ]] || die "this machine is a member of $host_name; share leave first"
  local tunnel_name="" force=0 service=1 login=0 quick_setup=0 had_host_arg=0 backend_arg="" bucket="" r2flag="" sdef="" alias_arg="" token_stdin=0 mflag="" yes=0
  [[ -n ${1:-} && ${1:-} != --* ]] && { host_name="$1"; had_host_arg=1; shift; }
  while [[ $# -gt 0 ]]; do
    case $1 in
      --tunnel-name) tunnel_name="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      --no-service) service=0; shift ;;
      --login) login=1; shift ;;
      --quick) quick_setup=1; shift ;;
      --backend) backend_arg="${2:-}"; shift 2 ;;
      --bucket) bucket="${2:-}"; shift 2 ;;
      --r2|--no-r2) [[ -z $r2flag ]] || die "$tusage"; r2flag="$1"; shift ;;
      --storage-default) sdef="${2:-}"; shift 2 ;;
      --alias) alias_arg="${2:-}"; [[ -n $alias_arg ]] || die "$tusage"; shift 2 ;;
      --token-stdin) token_stdin=1; shift ;;
      --members|--no-members) [[ -z $mflag ]] || die "$tusage"; mflag="$1"; shift ;;
      --yes) yes=1; shift ;;
      *) die "usage: share setup [hostname] [--tunnel-name N] [--force] [--no-service] [--login] [--backend tunnel|r2 --bucket <name>] | share setup --quick [--no-service] | $tusage" ;;
    esac
  done
  if [[ $token_stdin == 1 ]]; then   # migrate's switch: one line on stdin, into this process only; never argv, a file, or a child's environment
    CLOUDFLARE_API_TOKEN=""; IFS= read -r CLOUDFLARE_API_TOKEN || true
    [[ -n $CLOUDFLARE_API_TOKEN ]] || die "--token-stdin read no token"
  fi
  if [[ -n $r2flag ]]; then   # R2 on a tunnel tenant: the origin's own setup, never a new tunnel
    [[ $had_host_arg == 1 && -z $backend_arg && -z $tunnel_name && $service == 1 && $login == 0 && $quick_setup == 0 ]] || die "$tusage"
    if [[ $r2flag == --r2 && -n $mflag ]]; then   # T1 to T2 and back: a step of its own, after R2 is on
      [[ -n $bucket && -z $sdef && $force == 0 && -z $alias_arg ]] || die "$tusage"
      cmd_setup_members "$bucket" "$yes" "$mflag"
    elif [[ $r2flag == --r2 ]]; then
      [[ -n $bucket && ( -z $sdef || $sdef == local || $sdef == cloud ) && $yes == 0 ]] || die "$tusage"
      cmd_setup_tenant "$bucket" "$sdef" "$force" "$alias_arg"
    else
      [[ -z $bucket && -z $sdef && $force == 0 && -z $alias_arg && -z $mflag && $yes == 0 ]] || die "$tusage"
      cmd_setup_no_r2
    fi
    return
  fi
  [[ -z $sdef && -z $alias_arg && -z $mflag ]] || die "--storage-default, --alias and --members need --r2"
  [[ -z $backend_arg || $backend_arg == tunnel || $backend_arg == r2 ]] || die "--backend must be 'tunnel' or 'r2'"
  [[ -z $bucket || $backend_arg == r2 ]] || die "--bucket needs --backend r2"
  if [[ $backend_arg == r2 ]]; then
    cmd_setup_r2 "$force" "$bucket" "$tunnel_name" "$login" "$service" "$quick_setup"
    return
  fi
  [[ $backend != r2 ]] || die "this profile is set up with the r2 backend; run '$me teardown' first"
  if [[ $quick_setup == 1 ]]; then
    [[ $had_host_arg == 0 && -z $tunnel_name && $force == 0 && $login == 0 ]] || die "usage: share setup --quick [--no-service]"
    cmd_setup_quick "$service"; return
  fi
  [[ $mode != quick ]] || die "already set up with a quick tunnel; run '$me teardown' first"
  if [[ -z $host_name && -t 0 ]]; then read -rp "Hostname for your links (for example s.example.com): " host_name; fi
  [[ $host_name =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || die "usage: share setup <hostname>, for example s.example.com"
  local old_host; old_host="$(cfg hostname || true)"
  if [[ -n $old_host && $old_host != "$host_name" ]]; then   # the main site would answer the new name for the whole pub tree; the apps cover only the old one
    [[ -z "$(host_name="$old_host" rows | awk -F'\t' '$6 ~ /(^| )access=/')" && $(pending_count) == 0 ]] ||
      die "$old_host has gated shares or Access apps awaiting deletion; under $host_name they would be served with no gate; remove them first ('$me rm <id>', see '$me ls', then '$me prune' with the token; a line prune reports as malformed is yours to delete from $pending) or run '$me teardown'"
  elif [[ -z $old_host && $token_stdin == 0 ]]; then   # a not_setup profile can still hold rows from an earlier import; the first setup must not start serving a gated one with no gate. migrate's own switch (--token-stdin) is exempt: it never renames the hostname, so a row's existing Access app still covers it
    [[ -z "$(rows | awk -F'\t' '$6 ~ /(^| )access=/')" ]] ||
      die "this not-yet-set-up profile already holds gated shares; under $host_name they would be served with no gate; remove them first ('$me rm <id>', see '$me ls') or run '$me teardown'"
  fi
  local tunnel_arg="$tunnel_name"
  tunnel_name="${tunnel_name:-share-${host_name//./-}}"
  local other   # two profiles on one hostname or one tunnel name would reuse, then delete, one tunnel
  for other in $(other_cfg hostname); do
    [[ $other != "$host_name" ]] || die "$host_name is already the hostname of another profile (share profiles)"
  done
  for other in $(other_cfg tunnel_name); do
    [[ $other != "$tunnel_name" ]] || die "tunnel $tunnel_name already belongs to another profile (share profiles); pass --tunnel-name"
  done

  local missing="" c
  for c in caddy cloudflared jq curl; do command -v "$c" >/dev/null || missing="$missing $c"; done
  [[ -z $missing ]] || die "missing:$missing (brew install$missing)"
  if [[ $token_stdin == 0 ]]; then   # migrate's remote switch writes no journal: its rerun needs stdin; the local migrate journal covers it (B7)
    local rerun=(setup "$host_name")
    [[ -z $tunnel_arg ]] || rerun+=(--tunnel-name "$tunnel_arg")
    [[ $force != 1 ]] || rerun+=(--force)
    [[ $service == 1 ]] || rerun+=(--no-service)
    [[ $login != 1 ]] || rerun+=(--login)
    op_begin setup-tunnel "${rerun[@]}"
  fi
  op_step 1
  profile_port

  local zone="" zone_name za
  [[ $login == 1 ]] || admin_token_resolve optional
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} && $login == 0 ]]; then
    auth_api
    za="$(cf_zone)"; read -r zone account zone_name <<<"$za"
  else
    zone_name="$(public_zone "$host_name")"
    [[ -n $zone_name ]] || die "cannot find the DNS zone of $host_name; is the domain on Cloudflare?"
    auth_login "$zone_name"
  fi
  echo "zone:       $zone_name"

  local t tid created=0
  t="$(cf GET "/accounts/$account/cfd_tunnel?name=$tunnel_name&is_deleted=false")"
  tid="$(jq -r '.result[0].id // empty' <<<"$t")"

  # Check the hostname before creating anything, so a taken name leaves no orphan tunnel.
  local rec="" rid="" rtype="" rcontent=""
  if [[ $auth == api ]]; then
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r '.result[0].id // empty' <<<"$rec")"
    rtype="$(jq -r '.result[0].type // empty' <<<"$rec")"
    rcontent="$(jq -r '.result[0].content // empty' <<<"$rec")"
    if [[ -n $rid && $force == 0 && ( -z $tid || $rcontent != "$tid.cfargotunnel.com" ) ]]; then
      die "$host_name already has a $rtype record ($rcontent); pick another hostname or rerun with --force"
    fi
  elif [[ -z $tid && $force == 0 ]] && resolves "$host_name"; then
    die "$host_name already resolves in public DNS; pick another hostname or rerun with --force"
  fi

  op_step 2
  if [[ -n $tid ]]; then
    echo "tunnel:     reusing $tunnel_name"
  else
    tid="$(cf POST "/accounts/$account/cfd_tunnel" "{\"name\":\"$tunnel_name\",\"config_src\":\"cloudflare\"}" | jq -r .result.id)"
    created=1
    echo "tunnel:     created $tunnel_name"
  fi
  op_step 3
  cf PUT "/accounts/$account/cfd_tunnel/$tid/configurations" \
    "{\"config\":{\"ingress\":[{\"hostname\":\"$host_name\",\"service\":\"http://127.0.0.1:$port\"},{\"service\":\"http_status:404\"}]}}" >/dev/null
  echo "route:      $host_name -> 127.0.0.1:$port"

  op_step 4
  local target="$tid.cfargotunnel.com" body out
  if [[ $auth == api ]]; then
    body="{\"type\":\"CNAME\",\"name\":\"$host_name\",\"content\":\"$target\",\"proxied\":true,\"comment\":\"share tunnel $tunnel_name\"}"
    if [[ -z $rid ]]; then
      cf POST "/zones/$zone/dns_records" "$body" >/dev/null; echo "dns:        created CNAME $host_name"
    elif [[ $rtype == CNAME && $rcontent == "$target" ]]; then
      echo "dns:        CNAME $host_name already points at the tunnel"
    else
      cf PUT "/zones/$zone/dns_records/$rid" "$body" >/dev/null; echo "dns:        replaced $rtype $host_name (--force)"
    fi
  else
    local overwrite=""
    [[ $force == 1 || $created == 0 ]] && overwrite="--overwrite-dns"
    # shellcheck disable=SC2086
    out="$(cloudflared tunnel --origincert "$cert" --loglevel info route dns $overwrite "$tid" "$host_name" 2>&1)" || true
    if ! grep -qE "CNAME $host_name which|$host_name is already configured" <<<"$out"; then
      [[ $created == 1 ]] && cf DELETE "/accounts/$account/cfd_tunnel/$tid" >/dev/null
      rm -f "$config_dir/cert.zone"
      die "DNS route failed (did you pick $zone_name in the browser?): $(grep -E 'ERR|Added' <<<"$out" | tail -2)"
    fi
    echo "dns:        CNAME $host_name -> tunnel"
  fi

  op_step 5
  local tok where
  tok="$(cf GET "/accounts/$account/cfd_tunnel/$tid/token" | jq -r .result)"
  if [[ -n $(cfg token_cmd || true) ]]; then
    echo "token:      config has token_cmd; store this tunnel's token there yourself"
  else
    where="$(token_store "$tok")"; echo "token:      stored in $where"
  fi
  tok=""
  op_step 6
  write_config "$tid" "$tunnel_name"

  op_step 7
  host_ok || { echo "this host ($(this_host)) is not in hosts=$hosts; skipping the service and the live check"; op_done; return 0; }
  if [[ $service == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then
    svc_install; echo "service:    runs at login ($svc_label)"
  fi

  op_step 8
  local started=0 live=0
  running || { cmd_start >/dev/null 2>&1; [[ $service == 1 ]] || started=1; }
  live_check 60 && live=1
  [[ $started == 1 ]] && cmd_stop >/dev/null
  [[ $live == 1 ]] || die "live check failed: https://$host_name/ does not answer (see $root/serve.log)"
  op_done
  echo "ready:      https://$host_name/ is live. Next: $me add <file|dir>"
}

cmd_teardown() {
  [[ $role != member ]] || die "this machine is a member of $host_name: use share leave"
  [[ $backend != r2 ]] || { cmd_teardown_r2 "$@"; return; }
  if [[ $mode == quick ]]; then
    if [[ ${1:-} != --yes ]]; then
      [[ -t 0 ]] || die "rerun '$me teardown --yes' to confirm"
      local a; read -rp "Remove the quick-tunnel setup? Nothing lives on Cloudflare; shares in $root stay. [y/N] " a
      [[ $a == y* || $a == Y* ]] || die "aborted"
    fi
    svc_uninstall
    cmd_stop >/dev/null
    rm -f "$root/quick.url"
    to_trash "$config"
    rm -f "$health" "$config_dir"/.health.??????; [[ -z $profile ]] || rmdir "$config_dir" 2>/dev/null || true   # a torn-down profile leaves no empty dir in `share profiles`
    echo "removed the quick setup (no tunnel, DNS, or token existed); shares in $root stay"
    return 0
  fi
  if [[ -z $host_name ]] && ops_dead teardown; then   # an earlier teardown died after its config went: every delete before it is done
    op_begin teardown teardown --yes; op_done
    echo "teardown: the earlier run had removed the tunnel, the token and the config; nothing is left"
    return 0
  fi
  need_host
  local tid; tid="$(cfg tunnel_id || true)"
  [[ -n $tid ]] || die "no tunnel_id in $config"
  if [[ $r2on == 1 ]]; then   # T2 refuses before anything changes: the marker and the deployed bindings, never the config alone (TN-07, TN-11, TN-12)
    admin_token_resolve optional
    if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then api_token="$CLOUDFLARE_API_TOKEN"; r2_setup_zone; admin_pair_set "$(cfg bucket)"; fi
    t2_refuse "teardown" "$me member ls"
    api_token="" acct=""
  fi
  if [[ ${1:-} != --yes ]]; then
    [[ -t 0 ]] || die "rerun '$me teardown --yes' to confirm"
    local a; read -rp "Delete the tunnel and DNS record for $host_name? Shares in $root stay. [y/N] " a
    [[ $a == y* || $a == Y* ]] || die "aborted"
  fi
  # the refusals come before the journal and before anything stops: a missing token is not a dead teardown
  admin_token_resolve optional
  # a gated share never survives teardown: pub/ and the index stay, so a later setup would serve it with no app
  local gated n_apps
  gated="$(rows | awk -F'\t' '$6 ~ /(^| )access=/ {print $1}')"
  n_apps=$(( $(wc -w <<<"$gated") + $(pending_count) ))
  if [[ $n_apps -gt 0 ]]; then
    api_token_resolve
    [[ -n $api_token ]] || { access_no_token >&2; die "teardown would orphan $n_apps Access app(s); rerun with CLOUDFLARE_API_TOKEN"; }
  fi
  op_begin teardown teardown --yes
  op_step 1
  if [[ $n_apps -gt 0 ]]; then
    local gid
    for gid in $gated; do cmd_rm "$gid" | sed 's/$/ (gated: unpublished before the tunnel goes)/'; done
    access_account; access_sweep
    n_apps="$(pending_count live)"
    [[ $n_apps == 0 ]] || die "$n_apps Access app(s) could not be deleted (see above); teardown stops before the tunnel goes; fix the cause, then rerun $me teardown"
  fi
  # a hand-edited gated row that rows() rejects keeps its bytes in pub; a later setup would serve them ungated
  if [[ -s $index ]]; then
    local raw raws; raws="$(awk -F'\t' 'index($6, "access=") {print $1}' "$index")"
    for raw in $raws; do
      [[ $raw =~ ^[0-9a-f]{6}$ && -z "$(row "$raw")" && -d $pub/$raw ]] || continue
      to_trash "$pub/$raw"; echo "gated:   trashed pub/$raw (malformed index row; its Access app, if any, stays in the dashboard)"
    done
  fi
  op_step 2
  svc_uninstall
  cmd_stop >/dev/null
  op_step 3
  local zone za rec rid _zn
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    auth_api >/dev/null
    za="$(cf_zone)"; read -r zone account _zn <<<"$za"
    rec="$(cf GET "/zones/$zone/dns_records?name=$host_name")"
    rid="$(jq -r --arg t "$tid.cfargotunnel.com" '.result[] | select(.content == $t) | .id' <<<"$rec" | head -1)"
    if [[ -n $rid ]]; then cf DELETE "/zones/$zone/dns_records/$rid" >/dev/null; echo "dns:     deleted $host_name"
    else echo "dns:     no record for $host_name points at this tunnel, left alone"; fi
    # every host share loses its DNS record and ingress rule before the tunnel goes
    op_step 4
    zone_id="$zone"; zone_name="${zone_name:-$_zn}"; tun_id="$tid"; auth=api
    if [[ -s $index ]]; then
      local _hn _hs _hd _he hopts hfqdn
      while IFS=$'\t' read -r _ _hn _hs _hd _he hopts; do
        hfqdn="$(opt_val host "$hopts" || true)"
        [[ -n $hfqdn ]] && host_rm "$hfqdn" && echo "dns:     deleted $hfqdn"
      done < <(rows)
    fi
  elif [[ -f $cert ]]; then
    op_step 4
    cf_token="$(cert_field apiToken)"; account="$(cf_token_account)"
    echo "dns:     the login token cannot delete DNS records. Delete the CNAME $host_name in the Cloudflare dashboard, or rerun with CLOUDFLARE_API_TOKEN."
    if [[ -s $index ]] && rows | awk -F'\t' '$6 ~ /host=/ {f=1} END {exit !f}'; then
      echo "dns:     host shares in $index keep their records; remove them in the dashboard or rerun with CLOUDFLARE_API_TOKEN."
    fi
  else
    die "set CLOUDFLARE_API_TOKEN, or run '$me setup $host_name' once to log in again"
  fi
  op_step 5
  if tunnel_delete "$account" "$tid"; then echo "tunnel:  deleted"; else echo "tunnel:  already deleted"; fi
  op_step 6
  token_forget; api_token_forget; echo "token:   removed"
  echo "service: removed"
  op_step 7
  [[ -f $cert ]] && to_trash "$cert"
  rm -f "$config_dir/cert.zone"
  to_trash "$config"; echo "config:  moved to the Trash"
  rm -f "$health" "$config_dir"/.health.??????; [[ -z $profile ]] || rmdir "$config_dir" 2>/dev/null || true
  op_done
}

cmd_teardown_r2() { # cmd_teardown_r2 [--yes] [--purge]: local by default; --purge also removes every share, the Worker, its domain, and the empty bucket
  local a yes=0 purge=0 bucket n
  for a in "$@"; do
    case $a in --yes) yes=1 ;; --purge) purge=1 ;; *) die "usage: share teardown [--yes] [--purge]" ;; esac
  done
  if [[ $purge == 1 && -z $host_name ]] && ops_dead teardown-purge; then   # an earlier purge died after its config went
    op_begin teardown-purge teardown --yes --purge; op_done
    echo "teardown: the earlier purge had removed everything up to the config; nothing is left"
    return 0
  fi
  need_host
  bucket="$(cfg bucket || true)"
  if [[ $yes == 0 ]]; then
    [[ -t 0 ]] || die "rerun '$me teardown --yes$([[ $purge == 1 ]] && echo ' --purge')' to confirm"
    if [[ $purge == 1 ]]; then read -rp "Delete every share on $host_name, its Worker, its domain, and bucket $bucket for every publisher? [y/N] " a
    else read -rp "Remove this install's r2 setup for $host_name? The bucket and every share stay. [y/N] " a; fi
    [[ $a == y* || $a == Y* ]] || die "aborted"
  fi
  if [[ $purge == 1 ]]; then
    admin_token_resolve required "teardown --purge"   # before the journal: a missing token writes nothing
    op_begin teardown-purge teardown --yes --purge; op_step 1; r2_purge "$bucket"
  fi
  op_step 7
  api_token_forget; echo "token:   removed"
  n="$(pending_count)"
  [[ $n == 0 ]] || echo "access:  $n Access app(s) stay listed in $pending; a later setup of $host_name and '$me prune' with the token removes them"
  [[ -f $r2own ]] && to_trash "$r2own"
  to_trash "$config"; echo "config:  moved to the Trash"
  rm -f "$health" "$config_dir"/.health.??????; [[ -z $profile ]] || rmdir "$config_dir" 2>/dev/null || true
  [[ $purge == 1 ]] || echo "kept:    bucket $bucket, the Worker, and every share on $host_name stay for the other publishers; '$me teardown --yes --purge' with the admin token removes them"
  op_done
}

r2_purge() { # r2_purge <bucket>: the admin token from the environment; every check before the first delete, then shares, apps, marker, domain, script, bucket
  local bucket=$1 worker="share-${host_name//./-}" dataset="share_${host_name//[.-]/_}" dom_id gated
  admin_token_resolve required "teardown --purge"
  api_token="$CLOUDFLARE_API_TOKEN"
  r2_setup_zone
  r2_bucket=$bucket r2_endpoint="$(cfg r2_endpoint || true)"
  r2_api GET /user/tokens/verify   # the admin token's own S3 pair, as setup uses it
  r2_key_id="$(jq -r '.result.id // empty' <<<"$cf_body" 2>/dev/null || true)"
  [[ $cf_code == 200 && -n $r2_key_id ]] || die "the token did not verify (HTTP $cf_code); nothing was changed"
  r2_secret="$(printf '%s' "$api_token" | shasum -a 256 | cut -d' ' -f1)"
  # a rerun after a purge that died: what an earlier run deleted reads as done, never as a refusal (prev = the step it died at)
  local prev="${op_prev_step:-0}"
  if [[ $prev -ge 6 ]]; then
    r2_api GET "/accounts/$acct/r2/buckets/$bucket"
    if [[ $cf_code == 404 ]]; then echo "bucket:  already deleted by the earlier run"; return 0; fi
  fi
  r2_api GET "/accounts/$acct/workers/scripts/$worker/settings"
  if [[ $cf_code == 404 && $prev -ge 5 ]]; then
    echo "worker:  already deleted by the earlier run"
  else
    [[ $cf_code == 200 ]] || die "reading Worker $worker answered HTTP $cf_code (purge needs the admin token); nothing was changed"
    jq -e --arg h "$host_name" --arg b "$bucket" '.result.bindings as $bs
      | ($bs | any(.name == "HOST" and .text == $h)) and ($bs | any(.name == "BUCKET" and .bucket_name == $b))' <<<"$cf_body" >/dev/null ||
      die "Worker $worker is not share's Worker for $host_name on bucket $bucket (its bindings differ); refused, nothing was changed"
    ! jq -e '.result.bindings | any(.name == "PASS" and .text == "1")' <<<"$cf_body" >/dev/null ||
      die "$host_name is a tenant with R2 on: its origin runs '$me setup $host_name --no-r2' first; refused, nothing was changed"
  fi
  r2_call GET share.json
  if [[ $cf_code == 404 && $prev -ge 3 ]]; then :   # the earlier run deleted the marker
  elif [[ $cf_code != 200 ]] || ! jq -e --arg h "$host_name" '.v == 1 and .host == $h' <<<"$cf_body" >/dev/null 2>&1; then
    die "bucket $bucket's share.json does not name $host_name (HTTP $cf_code); refused, nothing was changed"
  fi
  r2_api GET "/accounts/$acct/workers/domains?hostname=$host_name"
  [[ $cf_code == 200 ]] || die "reading Worker custom domains answered HTTP $cf_code; nothing was changed"
  [[ "$(jq --arg h "$host_name" --arg w "$worker" '[.result[] | select(.hostname == $h and .service != $w)] | length' <<<"$cf_body")" == 0 ]] ||
    die "$host_name is the custom domain of another Worker; refused, nothing was changed"
  dom_id="$(jq -r --arg h "$host_name" '[.result[] | select(.hostname == $h) | .id] | first // empty' <<<"$cf_body")"
  r2_snapshot
  gated="$(rows | awk -F'\t' '(" " $6) ~ / access=/ {print $1}')"
  if [[ -n $gated || -s $pending ]]; then   # a gated share's app must go with it: the scope is proven before any delete
    access_account
    access_apps_edit_ok || die "$(access_scope_line 'Access: Apps and Policies Edit'); purge needs it for the gated shares; nothing was changed"
  fi

  local id
  for id in $gated $(rows | awk -F'\t' '(" " $6) !~ / access=/ {print $1}'); do   # gated first; any failure dies before the Worker goes
    cmd_rm_r2 "$id" prune
  done
  [[ -z $gated && ! -s $pending ]] || access_sweep
  r2_purge_apps
  # what no rm reached: records this share cannot read, and uploads no record names
  op_step 2
  r2_delete_prefix "m/" || die "some m/ keys remain in bucket $bucket; the Worker, domain, and bucket stay; rerun $me teardown --yes --purge"
  r2_delete_prefix "o/" || die "some o/ keys remain in bucket $bucket; the Worker, domain, and bucket stay; rerun $me teardown --yes --purge"
  op_step 3
  r2_call DELETE share.json
  [[ $cf_code == 204 || $cf_code == 200 || $cf_code == 404 ]] || die "deleting $bucket/share.json answered HTTP $cf_code; the Worker, domain, and bucket stay"
  echo "marker:  deleted $bucket/share.json"
  op_step 4
  if [[ -n $dom_id ]]; then
    r2_api DELETE "/accounts/$acct/workers/domains/$dom_id"
    [[ $cf_code == 200 ]] || die "removing $host_name from $worker answered HTTP $cf_code; the Worker and bucket stay"
    echo "domain:  removed $host_name"
  fi
  op_step 5
  r2_api DELETE "/accounts/$acct/workers/scripts/$worker"
  [[ $cf_code == 200 || $cf_code == 404 ]] || die "deleting Worker $worker answered HTTP $cf_code; the bucket stays"
  echo "worker:  deleted $worker"
  op_step 6
  r2_list ""
  if [[ -z $r2_list_out ]]; then
    r2_api DELETE "/accounts/$acct/r2/buckets/$bucket"
    [[ $cf_code == 200 ]] || die "deleting bucket $bucket answered HTTP $cf_code"
    echo "bucket:  deleted $bucket"
  else
    echo "bucket:  kept $bucket: $(grep -c . <<<"$r2_list_out") key(s) remain that share did not write"
  fi
  echo "dataset: the Analytics Engine dataset $dataset cannot be deleted; it ages out on its own"
}

r2_purge_apps() { # every Access app named "share <6 hex> <host> <8 hex>", read and name-checked by access_delete; skipped without Access read
  local page=1 pages ids="" id n
  if ! { access_account soft && access_proof; }; then echo "access:  by-name pass skipped (the token cannot read Access apps)"; return 0; fi
  while :; do
    cf_try GET "/accounts/$acct/access/apps?page=$page&per_page=100"
    [[ $cf_code == 200 ]] || die "listing Access apps answered HTTP $cf_code; the Worker, domain, and bucket stay"
    ids="$ids$(jq -r --arg h "$host_name" --arg a "$(cfg aliases || true)" '.result[] | (.name | split(" ")) as $w
      | select(($w | length) == 4 and $w[0] == "share" and ($w[1] | test("^[0-9a-f]{6}$")) and ([$h] + ($a | split(",")) | index($w[2])) and ($w[3] | test("^[0-9a-f]{8}$")))
      | "\(.id) \($w[1])"' <<<"$cf_body")"$'\n'
    pages="$(jq -r '.result_info.total_pages // 1' <<<"$cf_body")"
    [[ $page -lt $pages ]] || break
    page=$((page + 1))
  done
  while read -r id n; do
    [[ -n $id ]] || continue
    access_delete "$id" "$n" || die "could not delete Access app $id; the Worker, domain, and bucket stay"
    echo "access:  deleted app $id (share $n)"
  done <<<"$ids"
}

# --- members (SPEC-009): the admin context, the lease, the registry, the Cloudflare objects, the invite, member add|ls|sync ---
# The deploy is the routing table (DEC-15); u/ records are a journal any publisher can write, so every id in one is a hint (DEC-58).
member_statuses="adding invited joining active pausing paused resuming inviting rotating renewing removing removed left"
member_verbs="add invite pause resume rotate renew rm purge adopt join leave sync"
member_cap=20
member_tenant="" member_minter=0 api_who=""
mc_worker="" mc_bucket="" mc_marker="" mc_marker_etag="" mc_settings="" mc_t2=0 mc_own=0
mb_name_ok() { [[ $1 =~ ^[a-z0-9-]{2,24}$ ]]; }
mb_suffix() { echo "${1##*-}"; }   # m-<name>-<8hex> -> <8hex>
mb_obj_name() { echo "share-${host_name//./-}-$1${2:+-r$2}"; }   # mb_obj_name <suffix> [rotation]: the tunnel and VPC Service name
mb_token_name() { echo "share $host_name $1"; }   # the member's user token, found by this name only (DEC-78)
mb_iso() { jq -rn --argjson t "$1" '$t | strftime("%Y-%m-%dT%H:%M:%SZ")'; }   # epoch -> ISO 8601 UTC
mb_epoch() { jq -rn --arg s "$1" 'try ($s | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch ""'; }   # ISO 8601 -> epoch, empty when unreadable
mb_dur() { # mb_dur <7d|12h|90d>: seconds; empty for anything else
  case $1 in *d) [[ ${1%d} =~ ^[0-9]+$ ]] && echo $(( ${1%d} * 86400 )) ;; *h) [[ ${1%h} =~ ^[0-9]+$ ]] && echo $(( ${1%h} * 3600 )) ;; esac
  return 0
}

member_context() { # member_context <verb>: the tenant, the admin token proven by a settings GET, the bucket from BUCKET, the marker, the scope probes; with
  # member_minter=1 the minter too. Every refusal here comes before any write (TASK-1c1); a missing admin token dies before any bucket or API call
  local verb=$1 missing="" b
  if [[ -n $member_tenant ]]; then
    hostname_ok "$member_tenant" || die "--tenant needs a hostname, not '$member_tenant'"
    [[ $member_tenant == "$(cfg hostname || true)" ]] || { host_name=$member_tenant backend="" r2on=1; }   # another tenant: this profile's own keys stay out of it
  fi
  [[ -n $host_name ]] || die_code member_no_tenant "share member $verb needs a tenant: pass --tenant <host> (this machine has no profile for one); nothing was changed" "$me member ls --tenant <host>"
  [[ $member_tenant == "" || $member_tenant == "$(cfg hostname || true)" ]] && mc_own=1
  admin_token_resolve required "share member $verb (the tenant admin's verb)"
  api_token="$CLOUDFLARE_API_TOKEN" api_who=admin
  r2_setup_zone
  mc_worker="share-${host_name//./-}"
  r2_api GET "/accounts/$acct/workers/scripts/$mc_worker/settings"
  case $cf_code in
    200) ;;
    401|403) die_code admin_token_not_admin "the token cannot read Worker $mc_worker's settings (HTTP $cf_code): only the tenant admin runs share member $verb; nothing was changed" "$me admin-token --cmd '<command>'" ;;
    404) die_code members_off "$host_name has no share Worker ($mc_worker): R2 and members are off; nothing was changed" "$me setup $host_name --r2 --bucket <bucket> --members" ;;
    *) die "reading Worker $mc_worker's settings answered HTTP $cf_code; nothing was changed" ;;
  esac
  mc_settings=$cf_body
  mc_bucket="$(jq -r --arg h "$host_name" '.result.bindings as $b | if ($b | any(.name == "HOST" and .text == $h)) then
    ([$b[] | select(.type == "r2_bucket" and .name == "BUCKET") | .bucket_name] | first // "") else "" end' <<<"$cf_body" 2>/dev/null || true)"
  [[ $mc_bucket =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || die "Worker $mc_worker is not share's tenant Worker for $host_name (no HOST or BUCKET binding); nothing was changed"
  admin_pair_set "$mc_bucket"   # the admin's own S3 pair: r2_creds refuses an admin token as a publisher (DEC-74)
  mc_marker_read
  [[ $mc_t2 == 1 ]] || die_code members_off "$host_name has members off (share.json has no members:true); nothing was changed" "$me setup $host_name --r2 --bucket $mc_bucket --members"
  for b in tunnels connectivity; do   # scope probes: each missing scope named, before any write
    if [[ $b == tunnels ]]; then r2_api GET "/accounts/$acct/cfd_tunnel?per_page=1"; else r2_api GET "/accounts/$acct/connectivity/directory/services?per_page=1"; fi
    case $cf_code in
      200) ;;
      401|403) if [[ $b == tunnels ]]; then missing="${missing:+$missing, }Cloudflare Tunnel Write"; else missing="${missing:+$missing, }Connectivity Directory Admin"; fi ;;
      *) die "probing the admin token's $b scope answered HTTP $cf_code; nothing was changed" ;;
    esac
  done
  [[ -z $missing ]] || die_code admin_token_scope "the admin token lacks $missing (account scope); add it, then rerun; nothing was changed" "$me admin-token --test"
  [[ $member_minter == 1 ]] || return 0
  minter_token_resolve
  minter_probe
}
mc_marker_read() { # the marker share.json: mc_marker, mc_marker_etag, mc_t2; it must name this host; cached as .health marker for state (TN-11)
  r2_call GET share.json || die "reading $r2_bucket/share.json needs the admin S3 pair; nothing was changed"
  case $cf_code in
    200) mc_marker=$cf_body mc_marker_etag=$r2_etag ;;
    404) die_code members_off "bucket $r2_bucket has no share.json: R2 is not on for $host_name; nothing was changed" "$me setup $host_name --r2 --bucket $r2_bucket" ;;
    *) die "reading $r2_bucket/share.json answered HTTP $cf_code; nothing was changed" ;;
  esac
  jq -e --arg h "$host_name" 'type == "object" and .v == 1 and .host == $h' <<<"$mc_marker" >/dev/null 2>&1 ||
    die "bucket $r2_bucket's share.json names another hostname; refused, nothing was changed"
  mc_t2=0; jq -e '.members == true' <<<"$mc_marker" >/dev/null 2>&1 && mc_t2=1
  [[ $mc_own == 0 ]] || marker_cache "$mc_t2"
  return 0
}
marker_cache() { # marker_cache 0|1: what the last read of share.json said about members, for state's tier (no network there)
  health_put marker "$(jq -nc --argjson m "$([[ $1 == 1 ]] && echo true || echo false)" --argjson t "$(date +%s)" '{members: $m, at: $t}')"
  profile_role
}
minter_probe() { # the minter's scopes before any write: API Tokens Read (a list) and Write (its own policy, by name); the token count against Cloudflare's 50 per user
  local g
  api_token="$SHARE_MINTER_TOKEN" api_who=minter
  r2_api GET "/user/tokens?per_page=50&page=1"
  case $cf_code in
    200) ;;
    401|403) api_token="$CLOUDFLARE_API_TOKEN" api_who=admin; die_code minter_token_scope "the minter token cannot list user tokens (HTTP $cf_code): it lacks API Tokens Read; nothing was changed" "$me minter-token --test" ;;
    *) die "listing the minter's tokens answered HTTP $cf_code; nothing was changed" ;;
  esac
  mt_total="$(jq -r '.result_info.total_count // 0' <<<"$cf_body")"
  r2_api GET /user/tokens/verify
  g="$(jq -r '.result.id // empty' <<<"$cf_body")"
  [[ $cf_code == 200 && $g =~ ^[A-Za-z0-9-]{1,64}$ ]] || die "the minter token did not verify (HTTP $cf_code); nothing was changed"
  r2_api GET "/user/tokens/$g"
  if [[ $cf_code != 200 ]] || ! jq -e 'any(.result.policies[]?.permission_groups[]?; .name == "API Tokens Write")' <<<"$cf_body" >/dev/null 2>&1; then
    api_token="$CLOUDFLARE_API_TOKEN" api_who=admin
    die_code minter_token_scope "the minter token lacks API Tokens Write, so it cannot mint member tokens; nothing was changed" "$me minter-token --test"
  fi
  api_token="$CLOUDFLARE_API_TOKEN" api_who=admin
}
as_minter() { api_token="$SHARE_MINTER_TOKEN" api_who=minter; "$@"; local rc=$?; api_token="$CLOUDFLARE_API_TOKEN" api_who=admin; return $rc; }

# --- the admin lease: lock/admin in the bucket (DEC-20, DEC-36, DEC-63) ---
lease_held=0 lease_etag="" lease_holder="" lease_verb="" lease_member=""
lease_cur="" lease_cur_etag="" lease_lm=""
lease_put() { # lease_put <step> [etag]: the body names verb, member and step; If-Match on the etag, else If-None-Match
  local f; f="$(mktemp "$root/.lease.XXXXXX")"
  jq -nc --arg h "$lease_holder" --arg v "$lease_verb" --arg m "$lease_member" --argjson s "$1" --argjson t "$(date +%s)" \
    '{v: 1, holder: $h, verb: $v, member: $m, step: $s, taken: $t}' >"$f"
  if [[ -n ${2:-} ]]; then r2_call PUT lock/admin "$f" -H "If-Match: \"$2\"" || true; else r2_call PUT lock/admin "$f" -H 'If-None-Match: *' || true; fi
  rm -f "$f"
}
lease_read() { # lease_cur (the body, empty when absent), lease_cur_etag, lease_lm (LastModified as an epoch); age is judged by LastModified only (CK-01)
  lease_cur="" lease_cur_etag="" lease_lm=""
  r2_call GET lock/admin || die "reading lock/admin needs the admin S3 pair"
  case $cf_code in
    404) return 0 ;;
    200) lease_cur=$cf_body lease_cur_etag=$r2_etag ;;
    *) die "reading lock/admin answered HTTP $cf_code; nothing was changed" ;;
  esac
  jq -e 'type == "object"' <<<"$lease_cur" >/dev/null 2>&1 || lease_cur='{}'   # a forged body is judged by its age alone
  r2_list lock/
  lease_lm="$(mb_epoch "$(awk -F'\t' '$1 == "lock/admin" {print $2; exit}' <<<"$r2_list_mods")")"
}
lease_live() { # lease_live: 0 while the lease read last is held by a live holder; same host with a dead pid, or LastModified + 900 s past, is stale
  local h pid
  h="$(jq -r '.holder // ""' <<<"$lease_cur" 2>/dev/null || true)"
  [[ $h =~ ^[A-Za-z0-9._-]{1,64}:[0-9]{1,10}:[0-9a-f]{8}$ ]] || return 1   # a forged or unreadable body is judged by its age alone
  if [[ ${h%%:*} == "$(this_host)" ]]; then
    pid="${h#*:}"; pid="${pid%%:*}"
    kill -0 "$pid" 2>/dev/null && [[ $(ps -o command= -p "$pid" 2>/dev/null) == *share* ]] || return 1
  fi
  [[ -n $lease_lm && $(( $(date +%s) - lease_lm )) -le 900 ]]
}
lease_jq_clean='{holder: (.holder | if type == "string" and test("^[A-Za-z0-9._-]{1,64}:[0-9]{1,10}:[0-9a-f]{8}$") then . else "(unreadable)" end),
  verb: (.verb | if type == "string" and test("^(add|sync|rm|purge|pause|resume|invite|rotate|renew|adopt|setup-members|no-members|setup-r2)$") then . else "?" end),
  member: (.member | if type == "string" and test("^(m-[a-z0-9-]{2,24}-[0-9a-f]{8}|-)$") then . else "?" end),
  step: (.step | if type == "number" and . >= 0 and . < 100 then floor else 0 end)}'   # lock/admin is member-writable: a forged body never steers a rerun line
lease_line() { # one display line for the lease read last: holder, verb, member, step, live or stale
  local h v m s
  IFS=$'\t' read -r h v m s < <(jq -r "$lease_jq_clean"' | [.holder, .verb, .member, (.step | tostring)] | @tsv' <<<"$lease_cur" 2>/dev/null) || true
  local n; n="$(sed 's/^m-//; s/-[0-9a-f]\{8\}$//; s/^-$//' <<<"$m")"
  if lease_live; then echo "$h ($v $m, step $s) (live)"
  elif [[ $v == \? || $v == setup-* || $v == no-members ]]; then echo "$h ($v $m, step $s) (stale since $(mb_iso "${lease_lm:-0}"))"
  else echo "$h ($v $m, step $s) (stale since $(mb_iso "${lease_lm:-0}"); rerun: share member $v${n:+ $n})"; fi
}
lease_take() { # lease_take <verb> <member>: waits up to SHARE_LEASE_WAIT (60) s for a live holder, takes a stale one over with If-Match (CC-10: one taker wins)
  local waited=0 wait="${SHARE_LEASE_WAIT:-60}" nap=1
  [[ ${SHARE_R2_DRY:-0} != 1 ]] || nap=0.2
  lease_holder="$(this_host | tr -cd 'A-Za-z0-9._-'):$$:$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" lease_verb=$1 lease_member=$2
  while :; do
    lease_read
    if [[ -z $lease_cur ]]; then
      lease_put 0
      case $cf_code in 200) break ;; 412) continue ;; *) die "writing lock/admin answered HTTP $cf_code; nothing was changed" ;; esac
    fi
    if ! lease_live; then
      local was; was="$(lease_line)"
      lease_put 0 "$lease_cur_etag"
      case $cf_code in
        200) echo "lease:      took over from $was"; break ;;
        412) continue ;;
        *) die "taking over lock/admin answered HTTP $cf_code; nothing was changed" ;;
      esac
    fi
    if [[ $(awk -v w="$waited" -v m="$wait" 'BEGIN {print (w >= m) ? 1 : 0}') == 1 ]]; then
      die_code lease_held "lease held by $(lease_line); waited ${wait}s; nothing was changed" "wait for it, then rerun the same share member command"
    fi
    sleep "$nap"; waited="$(awk -v w="$waited" -v n="$nap" 'BEGIN {print w + n}')"
  done
  lease_etag=$r2_etag lease_held=1
  trap release_locks EXIT
}
lease_renew() { # lease_renew <step>: before each Cloudflare step; If-Match on this holder's own last etag, so a holder that slept past a takeover dies here (DEC-63)
  [[ $lease_held == 1 ]] || return 0
  lease_put "$1" "$lease_etag"
  case $cf_code in
    200) lease_etag=$r2_etag ;;
    412) lease_held=0; local n; n="$(sed 's/^m-//; s/-[0-9a-f]\{8\}$//; s/^-$//' <<<"$lease_member")"
         die_code lease_lost "another admin verb took lock/admin over while this one held it (stale past 900 s); nothing more was changed" "rerun the same command${n:+ for $n}" ;;
    *) die "renewing lock/admin answered HTTP $cf_code; rerun the same verb" ;;
  esac
}
lease_release() { # only a lease whose body still names this holder is deleted
  [[ $lease_held == 1 ]] || return 0
  lease_held=0
  r2_call GET lock/admin || return 0
  [[ $cf_code == 200 && "$(jq -r '.holder // ""' <<<"$cf_body" 2>/dev/null)" == "$lease_holder" ]] || return 0
  r2_call DELETE lock/admin || true
}

# --- the registry: u/<member_id>.json, read and validated, written through member_can (DEC-29, DEC-41) ---
member_can() { # member_can <status|none> <verb> <admin|member> [machine|cloud]: 0 allowed, 1 refused, 2 busy (another verb's ...ing); the doc table of
  # "### Member status transitions" as a case table; a rerun from the verb's own ...ing is allowed
  local st=$1 verb=$2 actor=$3 mode=${4:-} from="" own=""
  case $verb in
    add) from="none invited"; own=adding ;;   # an adding or invited record of the name resumes (step 2)
    invite) from="invited joining left"; own=inviting ;;
    pause) from="active"; own=pausing ;;
    resume) from="paused"; own=resuming ;;
    rotate) from="active paused invited joining"; own=rotating ;;
    renew) from="invited active paused"; own=renewing ;;
    rm) from="adding invited joining active pausing paused resuming inviting rotating renewing left"; own=removing ;;
    purge) from="removed" ;;
    adopt) from="none" ;;
    join) from="invited"; own=joining ;;
    leave) from="active paused" ;;
    sync) from="active pausing resuming paused" ;;
    *) return 1 ;;
  esac
  case $verb in join|leave) [[ $actor == member ]] || return 1 ;; *) [[ $actor == admin ]] || return 1 ;; esac
  case $verb in pause|resume|rotate) [[ $mode != cloud ]] || return 1 ;; esac
  case " $from $own " in *" $st "*) return 0 ;; esac
  [[ $verb != sync && $verb != rm && $actor == admin ]] || return 1   # rm wins from every status it can; sync reports; the member never refuses busy, it just may not write
  case $st in adding|joining|pausing|resuming|inviting|rotating|renewing|removing) return 2 ;; esac
  return 1
}
mb_ing_verb() { case $1 in adding) echo add ;; joining) echo join ;; pausing) echo pause ;; resuming) echo resume ;; inviting) echo invite ;; rotating) echo rotate ;; renewing) echo renew ;; removing) echo rm ;; *) echo "" ;; esac; }
# shellcheck disable=SC2016 # a jq program: its $id is jq's
reg_jq_valid='def s: type == "string"; def clean: s and (explode | all(. >= 32 and . != 127));
  def st: s and (. as $x | ["adding","invited","joining","active","pausing","paused","resuming","inviting","rotating","renewing","removing","removed","left"] | index($x) != null);
  type == "object" and .v == 1 and (.member_id | s and test("^m-[a-z0-9-]{2,24}-[0-9a-f]{8}$")) and (.name | s and test("^[a-z0-9-]{2,24}$"))
  and ((.member_id | sub("-[0-9a-f]{8}$"; "")) == "m-" + .name) and ($id == "" or .member_id == $id)
  and (.mode == "machine" or .mode == "cloud") and (.status | st) and ((.prev_status // "active") | st)
  and ((.step // 0) | type == "number" and . >= 0 and . < 100 and floor == .) and ((.step_name // "") | s and test("^[a-z-]{0,24}$"))
  and ((.rotation // 0) | type == "number" and . >= 0 and . < 1000 and floor == .)
  and ((.tunnel_id // "") | s and test("^[A-Za-z0-9-]{0,64}$")) and ((.vpc_service_id // "") | s and test("^[A-Za-z0-9-]{0,64}$"))
  and ((.port // 8787) | type == "number" and . >= 1024 and . <= 65535)
  and ((.token // {}) | type == "object" and ((.id // "") | s and test("^[A-Za-z0-9-]{0,64}$")) and ((.expires_on // "") | s and test("^[0-9TZ:.-]{0,32}$")))
  and ((.invite // {}) | type == "object" and ((.hash // "") | s and test("^([0-9a-f]{64})?$")) and ((.expires // 0) | type == "number"))
  and ((.token_unreachable_until // "") | s and test("^[0-9TZ:.-]{0,32}$")) and ((.by // "") | clean)
  and ((.added // "") | s and test("^[0-9TZ:.-]{0,32}$")) and ((.updated // "") | s and test("^[0-9TZ:.-]{0,32}$")) and ((.joined // "") | s and test("^[0-9TZ:.-]{0,32}$"))'
reg_valid() { jq -e --arg id "${2:-}" "$reg_jq_valid" <<<"$1" >/dev/null 2>&1; }   # reg_valid <json> [member_id]
reg_rec="" reg_etag="" reg_id="" reg_refuse_code="" reg_refuse_msg=""
reg_get() { # reg_get <member_id>: reg_rec and reg_etag; 1 when absent; a record failing validation dies record_invalid (never trusted)
  reg_id=$1 reg_rec="" reg_etag=""
  r2_call GET "u/$1.json" || die "reading u/$1.json needs the admin S3 pair"
  case $cf_code in 404) return 1 ;; 200) ;; *) die "reading u/$1.json answered HTTP $cf_code; nothing more was changed" ;; esac
  reg_valid "$cf_body" "$1" || die_code record_invalid "u/$1.json fails validation (forged, or a newer share's); it was not used; nothing more was changed" "$me member ls"
  reg_rec=$cf_body reg_etag=$r2_etag
}
reg_all="" reg_bad=""
reg_list() { # every record: reg_all ("<member_id>\t<compact json>" per valid record), reg_bad (the keys that failed validation)
  local k id
  reg_all="" reg_bad=""
  r2_list u/
  while IFS= read -r k; do
    [[ $k =~ ^u/(m-[a-z0-9-]{2,24}-[0-9a-f]{8})\.json$ ]] || continue
    id=${BASH_REMATCH[1]}
    r2_call GET "$k" || die "reading $k needs the admin S3 pair"
    case $cf_code in 404) continue ;; 200) ;; *) die "reading $k answered HTTP $cf_code; nothing more was changed" ;; esac
    if reg_valid "$cf_body" "$id"; then reg_all+="$id"$'\t'"$(jq -c . <<<"$cf_body")"$'\n'; else reg_bad+="$k"$'\n'; fi
  done <<<"$r2_list_out"
  return 0
}
reg_put() { # reg_put <json> [etag]: If-Match on the etag, else If-None-Match; the answer in cf_code, the new etag in reg_etag
  local f; f="$(mktemp "$root/.reg.XXXXXX")"
  printf '%s\n' "$1" >"$f"
  if [[ -n ${2:-} ]]; then r2_call PUT "u/$reg_id.json" "$f" -H "If-Match: \"$2\"" || true; else r2_call PUT "u/$reg_id.json" "$f" -H 'If-None-Match: *' || true; fi
  rm -f "$f"
  [[ $cf_code != 200 ]] || { reg_etag=$r2_etag; reg_rec=$1; }
}
reg_status() { # reg_status <verb> <actor> <to> [step] [jq over the record]: one status write through member_can, If-Match; a 412 re-reads once and continues
  # only if member_can still allows the move (DEC-29). prev_status: written on entering an ...ing from active or paused, kept otherwise, cleared on
  # reaching active, paused, left or removed (DEC-41); step and step_name ride every ...ing write and go on a resting one (DEC-31)
  local verb=$1 actor=$2 to=$3 step=${4:-} extra=${5:-.} try cur mode rc new sname=""
  [[ -z $step ]] || sname="$(op_steps "member-$verb" | awk -v n="$step" '$1 == n {print $2; exit}')"
  [[ -z $step || -n $sname ]] || sname="$(op_steps "$verb" | awk -v n="$step" '$1 == n {print $2; exit}')"
  for try in 1 2; do
    cur="$(jq -r .status <<<"$reg_rec")"; mode="$(jq -r .mode <<<"$reg_rec")"
    rc=0; member_can "$cur" "$verb" "$actor" "$mode" || rc=$?
    if [[ $rc == 2 ]]; then
      local ov os ou; ov="$(mb_ing_verb "$cur")"; os="$(jq -r '.step // "?"' <<<"$reg_rec")"; ou="$(jq -r '.updated // "?"' <<<"$reg_rec")"
      die_code member_busy "$(jq -r .name <<<"$reg_rec") is mid-$ov (step $os) since $ou; finish it: share member $ov $(jq -r .name <<<"$reg_rec")" "share member $ov $(jq -r .name <<<"$reg_rec")"
    fi
    [[ $rc == 0 ]] || { [[ -z $reg_refuse_code ]] || die_code "$reg_refuse_code" "$reg_refuse_msg" "ask the tenant admin"
      die_code member_not_allowed "$(jq -r .name <<<"$reg_rec") is $cur; share member $verb does not run from there; nothing more was changed" "$me member ls"; }
    new="$(jq -c --arg to "$to" --arg cur "$cur" --arg s "$step" --arg sn "$sname" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg by "$(r2_by)" '
      .status = $to | .updated = $now | .by = $by
      | if ($to | endswith("ing")) then
          (if ($cur == "active" or $cur == "paused") and $cur != $to then .prev_status = $cur else . end)
          | (if $s == "" then . else .step = ($s | tonumber) | .step_name = $sn end)
        else del(.step, .step_name) | (if ($to == "active" or $to == "paused" or $to == "left" or $to == "removed") then del(.prev_status) else . end) end' <<<"$reg_rec" | jq -c "$extra")"
    reg_put "$new" "$reg_etag"
    case $cf_code in
      200) return 0 ;;
      412) [[ $try == 1 ]] || break
           reg_get "$reg_id" || die_code member_changed "u/$reg_id.json was deleted during share member $verb; nothing more was changed" "$me member ls" ;;
      *) die "writing u/$reg_id.json answered HTTP $cf_code; rerun the same verb" ;;
    esac
  done
  die_code member_changed "u/$reg_id.json changed twice during share member $verb; nothing more was changed" "$me member ls"
}
reg_step() { lease_renew "$3"; reg_status "$1" admin "$2" "$3"; op_step "$3"; }   # reg_step <verb> <ing status> <n>: the record, the lease and the journal name step n
member_new_id() { # member_new_id <name>: m-<name>-<8 hex>, refusing a suffix any record, u/purged.json, binding or account service already uses (DEC-60, FG-13)
  local name=$1 id sx used purged i
  r2_call GET u/purged.json || true
  purged=""; [[ $cf_code != 200 ]] || purged="$(jq -r '.ids[]? | select(type == "string")' <<<"$cf_body" 2>/dev/null || true)"
  used="$(printf '%s\n%s\n' "$(cut -f1 <<<"$reg_all")" "$purged" | sed -n 's/^m-.*-\([0-9a-f]\{8\}\)$/\1/p')"
  used+=$'\n'"$(jq -r '.result.bindings[]? | select(.type == "vpc_service") | .name | ltrimstr("M_")' <<<"$mc_settings" 2>/dev/null || true)"
  mb_services_list; used+=$'\n'"$(sed -n "s/^share-${host_name//./-}-\([0-9a-f]\{8\}\)\(-r[0-9]*\)\{0,1\}"$'\t'".*/\1/p" <<<"$ms_list")"
  for i in 1 2 3 4 5; do
    if [[ -n ${SHARE_TEST_MEMBER_IDS:-} && ${SHARE_R2_DRY:-0} == 1 ]]; then
      id="${SHARE_TEST_MEMBER_IDS%% *}"
      [[ $SHARE_TEST_MEMBER_IDS == "$id" ]] && SHARE_TEST_MEMBER_IDS="" || SHARE_TEST_MEMBER_IDS="${SHARE_TEST_MEMBER_IDS#* }"
      id="m-$name-${id##*-}"
    else
      id="m-$name-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    fi
    sx="$(mb_suffix "$id")"
    grep -qx "$sx" <<<"$used" || { echo "$id"; return 0; }
  done
  die "five member ids in a row collided with ids in use; nothing was changed; rerun"
}

# --- Cloudflare objects, each found by its deterministic name (invariant 8, DEC-58); a create is never retried (a rerun finds it) ---
ob_id="" ms_list=""
mb_services_list() { # ms_list: "<name>\t<service_id>\t<tunnel_id>\t<port>" per VPC Service on the account (paged: the list ignores ?name=, TASK-1a(a))
  local page=1 n
  ms_list=""
  while :; do
    r2_api GET "/accounts/$acct/connectivity/directory/services?per_page=50&page=$page"
    [[ $cf_code == 200 ]] || die "listing VPC Services answered HTTP $cf_code (the admin token needs Connectivity Directory Admin); nothing more was changed"
    ms_list+="$(jq -r '.result[]? | [.name, .service_id, (.host.network.tunnel_id // ""), ((.http_port // 0) | tostring)] | @tsv' <<<"$cf_body")"$'\n'
    n="$(jq '.result | length' <<<"$cf_body")"
    [[ $n -ge 50 ]] || break
    page=$((page + 1))
  done
  return 0
}
ob_tunnel_find() { # ob_tunnel_find <name>: ob_id, empty when no live tunnel has that name
  ob_id=""
  urlenc "$1"
  r2_api GET "/accounts/$acct/cfd_tunnel?name=$urlenc_out&is_deleted=false"
  [[ $cf_code == 200 ]] || die "finding tunnel $1 answered HTTP $cf_code; nothing more was changed"
  ob_id="$(jq -r --arg n "$1" '[.result[]? | select(.name == $n and .deleted_at == null) | .id] | first // empty' <<<"$cf_body")"
  [[ -z $ob_id || $ob_id =~ ^[A-Za-z0-9-]{1,64}$ ]] || die "tunnel $1 has an id this share cannot use; nothing more was changed"
}
ob_tunnel_ensure() { # ob_tunnel_ensure <name>: found, else created (config_src cloudflare); the config is only the 404 catch-all, no DNS
  ob_tunnel_find "$1"
  if [[ -z $ob_id ]]; then
    r2_api POST "/accounts/$acct/cfd_tunnel" "$(jq -nc --arg n "$1" '{name: $n, config_src: "cloudflare"}')"
    [[ $cf_code == 200 ]] || die "creating tunnel $1 answered HTTP $cf_code; rerun the same verb (it finds a tunnel that was made by its name)"
    ob_id="$(jq -r '.result.id // empty' <<<"$cf_body")"
    [[ $ob_id =~ ^[A-Za-z0-9-]{1,64}$ ]] || die "creating tunnel $1 returned no id; rerun the same verb"
  fi
  r2_api_retry PUT "/accounts/$acct/cfd_tunnel/$ob_id/configurations" '{"config":{"ingress":[{"service":"http_status:404"}]}}'
  [[ $cf_code == 200 ]] || die "setting tunnel $1's catch-all config answered HTTP $cf_code; rerun the same verb"
}
ob_tunnel_gone() { # ob_tunnel_gone <name>: its connections, then the tunnel; 404 is done
  ob_tunnel_find "$1"
  [[ -n $ob_id ]] || return 0
  r2_api_retry DELETE "/accounts/$acct/cfd_tunnel/$ob_id/connections"
  [[ $cf_code == 200 || $cf_code == 404 ]] || die "deleting tunnel $1's connections answered HTTP $cf_code; rerun the same verb"
  r2_api_retry DELETE "/accounts/$acct/cfd_tunnel/$ob_id"
  [[ $cf_code == 200 || $cf_code == 404 ]] || die "deleting tunnel $1 answered HTTP $cf_code; rerun the same verb"
}
ob_tunnel_hint() { # ob_tunnel_hint <id> <name>: 0 when a GET by the id answers the expected name (a record's id is a hint only, DEC-58)
  [[ $1 =~ ^[A-Za-z0-9-]{1,64}$ ]] || return 1
  r2_api GET "/accounts/$acct/cfd_tunnel/$1"
  [[ $cf_code == 200 ]] && jq -e --arg n "$2" '.result.name == $n and .result.deleted_at == null' <<<"$cf_body" >/dev/null 2>&1
}
ob_service_find() { # ob_service_find <name>: ob_id, ob_tunnel and ob_port of the VPC Service of that name
  local l; ob_id="" ob_tunnel="" ob_port=""
  mb_services_list
  l="$(awk -F'\t' -v n="$1" '$1 == n {print; exit}' <<<"$ms_list")"
  [[ -n $l ]] || return 0
  IFS=$'\t' read -r _ ob_id ob_tunnel ob_port <<<"$l"
  [[ $ob_id =~ ^[A-Za-z0-9-]{1,64}$ ]] || die "VPC Service $1 has an id this share cannot use; nothing more was changed"
}
ob_service_body() { jq -nc --arg n "$1" --arg t "$2" --argjson p "$3" '{type: "http", name: $n, host: {ipv4: "127.0.0.1", network: {tunnel_id: $t}}, http_port: $p}'; }
ob_service_ensure() { # ob_service_ensure <name> <tunnel_id> <port>: found (its port and tunnel put right with the whole body), else created
  ob_service_find "$1"
  if [[ -z $ob_id ]]; then
    r2_api POST "/accounts/$acct/connectivity/directory/services" "$(ob_service_body "$1" "$2" "$3")"
    [[ $cf_code == 200 ]] || die "creating VPC Service $1 answered HTTP $cf_code${cf_err:+ ($cf_err)}; rerun the same verb (it finds a service that was made by its name)"
    ob_id="$(jq -r '.result.service_id // empty' <<<"$cf_body")"
    [[ $ob_id =~ ^[A-Za-z0-9-]{1,64}$ ]] || die "creating VPC Service $1 returned no service_id; rerun the same verb"
  elif [[ $ob_tunnel != "$2" || $ob_port != "$3" ]]; then
    r2_api_retry PUT "/accounts/$acct/connectivity/directory/services/$ob_id" "$(ob_service_body "$1" "$2" "$3")"
    [[ $cf_code == 200 ]] || die "updating VPC Service $1 answered HTTP $cf_code; rerun the same verb"
  fi
}
ob_service_gone() { # ob_service_gone <name>: 404 5104 is done
  ob_service_find "$1"
  [[ -n $ob_id ]] || return 0
  r2_api_retry DELETE "/accounts/$acct/connectivity/directory/services/$ob_id"
  [[ $cf_code == 200 || ( $cf_code == 404 && $cf_err == 5104 ) ]] || die "deleting VPC Service $1 answered HTTP $cf_code; rerun the same verb"
}
tk_id="" tk_expires="" tk_value="" mt_total=0
ob_token_find() { # ob_token_find <name>: tk_id and tk_expires of the current minter's token of that name (DEC-78); empty when it holds none
  local page=1 l pages
  tk_id="" tk_expires=""
  while :; do
    as_minter r2_api GET "/user/tokens?per_page=50&page=$page"
    [[ $cf_code == 200 ]] || die "listing the minter's tokens answered HTTP $cf_code; nothing more was changed"
    mt_total="$(jq -r '.result_info.total_count // 0' <<<"$cf_body")"
    l="$(jq -r --arg n "$1" '[.result[]? | select(.name == $n)] | first // empty | [.id, (.expires_on // "")] | @tsv' <<<"$cf_body")"
    if [[ -n $l ]]; then IFS=$'\t' read -r tk_id tk_expires <<<"$l"; break; fi
    pages="$(jq -r '.result_info.total_pages // 1' <<<"$cf_body")"
    [[ $page -lt $pages ]] || break
    page=$((page + 1))
  done
  [[ -z $tk_id || $tk_id =~ ^[A-Za-z0-9-]{1,64}$ ]] || die "the minter's token $1 has an id this share cannot use; nothing more was changed"
}
ob_token_delete() { # ob_token_delete <id>: 404 is done
  as_minter r2_api_retry DELETE "/user/tokens/$1"
  [[ $cf_code == 200 || $cf_code == 404 ]] || die "deleting the member token answered HTTP $cf_code; rerun the same verb"
}
ob_token_mint() { # ob_token_mint <name> <expires_on>: Bucket Item Write on this bucket plus Zone Read; tk_id, and the value in tk_value only (never printed, never argv)
  local pg zr body
  [[ $mt_total -lt 50 ]] || die_code token_limit "the minting user holds $mt_total tokens; Cloudflare allows 50 per user; nothing more was changed" "use a dedicated Cloudflare user as the minter, or delete its unused tokens"
  as_minter r2_api GET /user/tokens/permission_groups
  [[ $cf_code == 200 ]] || die "reading the permission groups answered HTTP $cf_code; nothing more was changed"
  pg="$(jq -r '[.result[]? | select(.name == "Workers R2 Storage Bucket Item Write") | .id] | first // empty' <<<"$cf_body")"
  zr="$(jq -r '[.result[]? | select(.name == "Zone Read") | .id] | first // empty' <<<"$cf_body")"
  [[ -n $pg && -n $zr ]] || die "the minter sees no Workers R2 Storage Bucket Item Write or Zone Read permission group; nothing more was changed"
  body="$(jq -nc --arg n "$1" --arg e "$2" --arg b "com.cloudflare.edge.r2.bucket.${acct}_default_$r2_bucket" --arg z "com.cloudflare.api.account.zone.$zone_id" --arg pg "$pg" --arg zr "$zr" \
    '{name: $n, expires_on: $e, policies: [{effect: "allow", resources: {($b): "*"}, permission_groups: [{id: $pg}]}, {effect: "allow", resources: {($z): "*"}, permission_groups: [{id: $zr}]}]}')"
  as_minter r2_api POST /user/tokens "$body"
  [[ $cf_code == 200 ]] || die "minting the member token answered HTTP $cf_code; rerun the same verb (it finds a token that was made by its name)"
  tk_id="$(jq -r '.result.id // empty' <<<"$cf_body")" tk_expires=$2
  tk_value="$(jq -r '.result.value // empty' <<<"$cf_body")"; cf_body=""
  [[ $tk_id =~ ^[A-Za-z0-9-]{1,64}$ && $tk_value =~ ^[A-Za-z0-9_-]+$ ]] || { tk_value=""; die "minting the member token returned no id or value; rerun the same verb"; }
  mt_total=$((mt_total + 1))
}

# --- the invite: a 100-bit code, sealed with AES-256-CBC (PBKDF2, 200,000 rounds) then MACed with HMAC-SHA256 (DEC-14); keys and code never in argv ---
inv_code="" inv_hash=""
invite_code() { # inv_code: 20 characters of RFC 4648 base32 from /dev/urandom (SHARE_TEST_CODE in tests); inv_hash: the i/ object id
  if [[ -n ${SHARE_TEST_CODE:-} && ${SHARE_R2_DRY:-0} == 1 ]]; then inv_code=$SHARE_TEST_CODE   # a test seam only beside the dry one
  else inv_code="$(LC_ALL=C tr -dc 'A-Z2-7' </dev/urandom 2>/dev/null | head -c 20 || true)"; fi
  [[ $inv_code =~ ^[A-Z2-7]{20}$ ]] || die "could not draw an invite code; nothing more was changed"
  inv_hash="$(printf 'share-invite-id:%s' "$inv_code" | shasum -a 256 | cut -c1-64)"
}
hex_esc() { local h=$1 i o=""; for ((i = 0; i < ${#h}; i += 2)); do o+="\\x${h:i:2}"; done; printf '%s' "$o"; }   # hex -> printf escapes, in-shell
hmac_sha256() { # hmac_sha256 <key hex, 64 chars>: HMAC-SHA256 of stdin as hex; the key goes through builtins and pipes only
  local k="$1" i b x ip="" op="" inner
  while [[ ${#k} -lt 128 ]]; do k+="0"; done
  for ((i = 0; i < 128; i += 2)); do
    b=$((16#${k:i:2}))
    printf -v x '%02x' $((b ^ 0x36)); ip+="\\x$x"
    printf -v x '%02x' $((b ^ 0x5c)); op+="\\x$x"
  done
  # shellcheck disable=SC2059 # the format is the key's escapes, built above
  inner="$({ printf "$ip"; cat; } | shasum -a 256 | cut -c1-64)"
  # shellcheck disable=SC2059
  { printf "$op"; printf "$(hex_esc "$inner")"; } | shasum -a 256 | cut -c1-64
}
invite_mac_key() { printf 'share-invite-mac:%s' "$1" | shasum -a 256 | cut -c1-64; }
invite_seal() { # invite_seal <code>: the plaintext on stdin; prints "<sealed base64> <mac hex>"; the passphrase rides fd 3, never argv
  local sealed
  sealed="$(openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -md sha256 -salt -a -A -pass fd:3 3< <(printf 'share-invite-key:%s' "$1") 2>/dev/null)" || return 1
  [[ -n $sealed ]] || return 1
  printf '%s %s\n' "$sealed" "$(printf '%s' "$sealed" | hmac_sha256 "$(invite_mac_key "$1")")"
}
invite_open() { # invite_open <code> <sealed> <mac>: the plaintext on stdout; a MAC mismatch dies invite_tampered before any decrypt
  local want
  want="$(printf '%s' "$2" | hmac_sha256 "$(invite_mac_key "$1")")"
  [[ $3 =~ ^[0-9a-f]{64}$ && $want == "$3" ]] || die_code invite_tampered "this invite was altered; ask the admin for a new one" "ask the tenant admin for a new invite"
  printf '%s' "$2" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -md sha256 -a -A -pass fd:3 3< <(printf 'share-invite-key:%s' "$1") 2>/dev/null
}

# --- one deploy for a member verb: settings read under the lease (DEC-62), carry-forward plus this verb's delta only (invariant 2) ---
r2_carry_force=0
mb_deploy() { # mb_deploy <jq over the carried bindings>: skipped when the delta is already deployed; else one deploy and X-Share-Deploy 3x
  local team dataset pair
  r2_api GET "/accounts/$acct/workers/scripts/$mc_worker/settings"
  [[ $cf_code == 200 ]] || die "reading Worker $mc_worker's settings answered HTTP $cf_code; rerun the same verb"
  mc_settings=$cf_body
  pair="$(jq -r '[(.result.bindings[] | select(.name == "VERSION") | .text), (.result.bindings[] | select(.name == "SHA") | .text)] | join(" ")' <<<"$cf_body")"
  [[ $pair == "$WORKER_VERSION $WORKER_SHA" ]] || die_code worker_mismatch "Worker $mc_worker is $pair; this share ships $WORKER_VERSION $WORKER_SHA, and a member verb never changes the Worker's code; nothing more was changed" "$me setup $host_name --r2 --bucket $r2_bucket"
  r2_carry_read "$cf_body"
  r2_carry_force=1; r2_carry_fresh "/accounts/$acct/workers/scripts/$mc_worker/settings"; r2_carry_force=0
  r2_carry_services
  r2_carry="$(jq -c "$1 | sort_by(.name)" <<<"$r2_carry")"
  if [[ $r2_carry == "$r2_carry_dep" ]]; then echo "deploy:     $mc_worker already has it"; return 0; fi
  team="$(jq -r '[.result.bindings[] | select(.name == "TEAM") | .text] | first // ""' <<<"$mc_settings")"
  dataset="$(jq -r '[.result.bindings[] | select(.name == "HITS") | .dataset] | first // ""' <<<"$mc_settings")"
  r2_aliases="$(jq -r '[.result.bindings[] | select(.name == "ALIASES") | .text] | first // ""' <<<"$mc_settings")" r2_pass=1
  [[ $dataset =~ ^[a-z0-9_]+$ ]] || die "Worker $mc_worker has no analytics dataset binding this share can carry; nothing more was changed"
  r2_deploy "$mc_worker" "$team" "$dataset" 0
  mb_wait_deploy
  echo "deploy:     $mc_worker deployed ($(jq -r '[.[] | select(.type == "vpc_service")] | length' <<<"$r2_carry") member binding(s))"
}
mb_wait_deploy() { # three /healthz answers in a row naming this deploy's nonce within SHARE_R2_WAIT, else a die naming the rerun (Q-AVAIL-2)
  local wait="${SHARE_R2_WAIT:-300}" start=$SECONDS streak=0 poll=2
  [[ ${SHARE_R2_DRY:-0} != 1 ]] || poll=0
  while :; do
    r2_healthz
    if [[ $hz_code == 200 && $hz_deploy == "$r2_deploy_nonce" ]]; then streak=$((streak + 1)); [[ $streak -lt 3 ]] || return 0; else streak=0; fi
    [[ $((SECONDS - start)) -lt $wait ]] ||
      die "https://$host_name/healthz did not serve this deploy (X-Share-Deploy ${hz_deploy:-none}, this deploy is $r2_deploy_nonce) three times within ${wait}s; rerun the same verb"
    sleep "$poll"
  done
}

# --- member add (DEC-69, seq-member-add): the step table of "### Admin verb write orders" ---
op_steps_member_add() { printf '%s\n' "1 lease" "2 record" "3 token" "4 tunnel" "5 service" "6 deploy" "7 invite-hash" "8 invite" "9 invited"; }
member_add_guard() { # the name, cap and token-count refusals of member add (the caller's name, mmode, mset, want, rid, rst); run before the journal,
  # then again under the lease on a fresh read, so a second admin's add that won the lease first is seen (two records of a name, a 21st member)
  local mine n_mach n_bound
  reg_list
  mine="$(awk -F'\t' '{print $2}' <<<"$reg_all" | jq -rc --arg n "$name" 'select(.name == $n and .status != "removed") | [.member_id, .status, .mode] | @tsv' 2>/dev/null || true)"
  [[ $(grep -c . <<<"$mine") -le 1 ]] || die_code member_name_taken "two records hold the name $name; nothing was changed" "$me member ls"
  rid="" rst="" mmode=$want
  if [[ -n $mine ]]; then
    IFS=$'\t' read -r rid rst mmode <<<"$mine"
    [[ $mset == 0 || $want == "$mmode" ]] || die_code member_name_taken "$name is a $mmode member ($rid, $rst); a resumed add keeps its mode; nothing was changed" "$me member add $name --$mmode"
    case $rst in adding|invited) ;;
      *) die_code member_name_taken "$name is $rst ($rid); a name is reused only after share member rm; nothing was changed" "$me member ls" ;; esac
  fi
  if [[ $mmode == machine ]]; then   # the cap counts records and bindings, whichever is larger (a forged record cannot lower it)
    n_mach="$(awk -F'\t' '{print $2}' <<<"$reg_all" | jq -r --arg id "$rid" 'select(.mode == "machine" and .status != "removed" and .member_id != $id) | .member_id' 2>/dev/null | grep -c . || true)"
    n_bound="$(jq -r --arg s "M_${rid##*-}" '[.result.bindings[]? | select(.type == "vpc_service" and .name != $s)] | length' <<<"$mc_settings")"
    [[ $n_bound -gt $n_mach ]] && n_mach=$n_bound
    [[ $n_mach -lt $member_cap ]] || die_code member_cap "$host_name has $n_mach machine members, the cap of $member_cap; nothing was changed" "$me member ls"
  fi
  [[ $mt_total -lt 50 ]] || die_code token_limit "the minting user holds $mt_total tokens; Cloudflare allows 50 per user; nothing was changed" "use a dedicated Cloudflare user as the minter, or delete its unused tokens"
}
mb_settings_reread() { # mc_settings again, under the lease
  r2_api GET "/accounts/$acct/workers/scripts/$mc_worker/settings"
  [[ $cf_code == 200 ]] || die "reading Worker $mc_worker's settings under the lease answered HTTP $cf_code; rerun the same verb"
  mc_settings=$cf_body
}
cmd_member_add() {
  local name="" mmode=machine mset=0 port=8787 ittl=7d tttl=90d argv=("$@") isec tsec usage="usage: share member add <name> [--machine|--cloud] [--port P] [--invite-ttl 7d] [--token-ttl 90d] [--tenant <host>]"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --machine|--cloud) mmode="${1#--}" mset=1; shift ;;
      --port) port="${2:-}"; shift 2 || die "$usage" ;;
      --invite-ttl) ittl="${2:-}"; shift 2 || die "$usage" ;;
      --token-ttl) tttl="${2:-}"; shift 2 || die "$usage" ;;
      --tenant) member_tenant="${2:-}"; shift 2 || die "$usage" ;;
      -*) die "$usage" ;;
      *) [[ -z $name ]] || die "$usage"; name=$1; shift ;;
    esac
  done
  mb_name_ok "$name" || die_code member_name_bad "member name '$name' is not 2 to 24 of a-z, 0-9 and -; nothing was changed" "$me member add <name>"
  [[ $port =~ ^[0-9]{4,5}$ && $port -ge 1024 && $port -le 65535 ]] || die "--port needs a number from 1024 to 65535; nothing was changed"
  isec="$(mb_dur "$ittl")"
  [[ -n $isec && $isec -gt 0 && $isec -le 2592000 ]] || die_code invite_ttl_bad "--invite-ttl $ittl is not a duration of at most 30 days (the Worker reads an envelope further ahead as forged); nothing was changed" "$me member add $name --invite-ttl 7d"
  tsec="$(mb_dur "$tttl")"; [[ -n $tsec && $tsec -gt 0 ]] || die "--token-ttl needs a duration such as 90d; nothing was changed"
  member_minter=1; member_context add
  local rid="" rst="" want=$mmode
  member_add_guard
  [[ -z $rid ]] || echo "member:     resuming $name ($rid, $rst)"
  op_begin member-add member add ${argv[@]+"${argv[@]}"}
  op_step 1
  lease_take add "${rid:-$name}"
  mb_settings_reread; ( member_add_guard ) || { op_done; exit 1; }   # the refusals again on what the lease holder sees now
  member_add_guard
  # step 2: the record, If-None-Match; an adding or invited record of the name resumes with its member_id
  op_step 2
  if [[ -z $rid ]]; then
    rid="$(member_new_id "$name")"; reg_id=$rid
    local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    reg_put "$(jq -nc --arg id "$rid" --arg n "$name" --arg m "$mmode" --argjson p "$port" --arg now "$now" --arg by "$(r2_by)" \
      '{v: 1, member_id: $id, name: $n, mode: $m, status: "adding", step: 2, step_name: "record", rotation: 0, added: $now, updated: $now, by: $by}
        + (if $m == "machine" then {port: $p} else {} end)')"
    [[ $cf_code == 200 ]] || die "writing u/$rid.json answered HTTP $cf_code (412: another add of this id); rerun the same verb"
  else
    reg_get "$rid" || die_code member_changed "u/$rid.json went away during share member add; nothing more was changed" "$me member ls"
    reg_status add admin adding 2 "$([[ $mmode == machine ]] && echo ".port = $port" || echo .)"
  fi
  lease_member=$rid; lease_renew 2
  local sx; sx="$(mb_suffix "$rid")"
  echo "member:     $name is $rid ($mmode)"
  # step 3: any token of the name is deleted and re-minted: its secret was never sealed for a printed code
  reg_step add adding 3
  ob_token_find "$(mb_token_name "$rid")"
  [[ -z $tk_id ]] || ob_token_delete "$tk_id"
  ob_token_mint "$(mb_token_name "$rid")" "$(mb_iso $(( $(date +%s) + tsec )))"
  reg_status add admin adding 3 "$(jq -nc --arg i "$tk_id" --arg n "$(mb_token_name "$rid")" --arg e "$tk_expires" '{id: $i, name: $n, expires_on: $e}' | sed 's/^/.token = /')"
  echo "token:      minted $(mb_token_name "$rid") (expires $tk_expires)"
  local tid="" ctok="" sid=""
  if [[ $mmode == machine ]]; then
    # step 4: the tunnel, found by name; its config is only the catch-all; the connector token stays in memory
    reg_step add adding 4
    ob_tunnel_ensure "$(mb_obj_name "$sx")"; tid=$ob_id
    r2_api_retry GET "/accounts/$acct/cfd_tunnel/$tid/token"
    ctok="$(jq -r '.result // empty' <<<"$cf_body")"; cf_body=""
    [[ $cf_code == 200 && $ctok =~ ^[A-Za-z0-9+/=_.-]+$ ]] || { ctok=""; die "reading tunnel $(mb_obj_name "$sx")'s token answered HTTP $cf_code; rerun the same verb"; }
    reg_status add admin adding 4 ".tunnel_id = \"$tid\" | .tunnel_name = \"$(mb_obj_name "$sx")\""
    echo "tunnel:     $(mb_obj_name "$sx")"
    # step 5: the VPC Service to 127.0.0.1:<port> through that tunnel
    reg_step add adding 5
    port="$(jq -r '.port // 8787' <<<"$reg_rec")"
    ob_service_ensure "$(mb_obj_name "$sx")" "$tid" "$port"; sid=$ob_id
    reg_status add admin adding 5 ".vpc_service_id = \"$sid\""
    echo "service:    $(mb_obj_name "$sx") -> 127.0.0.1:$port"
    # step 6: the binding M_<8hex>, carried forward with every other one
    reg_step add adding 6
    mb_deploy "map(select(.name != \"M_$sx\")) + [{type: \"vpc_service\", name: \"M_$sx\", service_id: \"$sid\"}]"
  fi
  # step 7: the record notes the new invite before its i/ exists (DEC-23); a previous i/ named in the record goes
  reg_step add adding 7
  local old iexp
  old="$(jq -r '.invite.hash // ""' <<<"$reg_rec")"
  invite_code
  iexp=$(( $(date +%s) + isec ))
  reg_status add admin adding 7 ".invite = {hash: \"$inv_hash\", expires: $iexp}"
  if [[ -n $old ]]; then r2_call DELETE "i/$old" || true; [[ $cf_code == 20? || $cf_code == 404 ]] || die "deleting the previous invite i/$old answered HTTP $cf_code; rerun the same verb"; fi
  # step 8: the sealed envelope, If-None-Match
  reg_step add adding 8
  mb_invite_put "$rid" "$name" "$mmode" "$port" "$tid" "$ctok" "$iexp"
  ctok="" tk_value=""
  # step 9: invited; the code prints once
  op_step 9
  reg_status add admin invited
  lease_release
  op_done
  echo "invited:    $name until $(mb_iso "$iexp"); send this line to them once (it works once):"
  echo "share join $host_name $inv_code"
  inv_code=""
}
mb_invite_put() { # mb_invite_put <member_id> <name> <mode> <port> <tunnel_id> <connector token> <expires>: seal the bundle under inv_code, PUT i/<inv_hash>
  local f sealed mac out
  f="$(mktemp "$root/.invite.XXXXXX")"
  # the two tokens reach jq on stdin, never argv; the bundle reaches openssl on stdin
  out="$(printf '%s\n%s\n' "$tk_value" "$6" | jq -Rnc --arg h "$host_name" --arg b "$r2_bucket" --arg e "$r2_endpoint" --arg id "$1" --arg n "$2" --arg m "$3" \
    --argjson p "$4" --arg t "$5" --arg te "$tk_expires" --arg k "$tk_id" --arg mc "$(jq -r '.min_cli // ""' <<<"$mc_marker")" '[inputs] as $s
    | {v: 1, host: $h, bucket: $b, r2_endpoint: $e, member_id: $id, name: $n, mode: $m, publisher_token: $s[0], publisher_key_id: $k, token_expires_on: $te, min_cli: $mc}
      + (if $m == "machine" then {port: $p, tunnel_id: $t, connector_token: $s[1]} else {} end)' | invite_seal "$inv_code")" ||
    { rm -f "$f"; die "sealing the invite failed (openssl enc with -pbkdf2 is needed); rerun the same verb"; }
  read -r sealed mac <<<"$out"; out=""
  jq -nc --arg id "$1" --argjson x "$7" --arg s "$sealed" --arg mac "$mac" '{v: 1, member_id: $id, expires: $x, sealed: $s, mac: $mac}' >"$f"
  r2_call PUT "i/$inv_hash" "$f" -H 'If-None-Match: *' || true
  rm -f "$f"
  [[ $cf_code == 200 ]] || die "writing the invite i/$inv_hash answered HTTP $cf_code; rerun the same verb"
}

# --- member ls and member sync (TASK-1i) ---
ml_json=""
mb_report() { # the per-member report member ls prints and member sync acts on: ml_json, one object per record (and per invalid key), sorted by name
  local now paused binds id rec sx rot tname conns svc
  now="$(date +%s)"
  reg_list
  paused="$(jq -r '[.result.bindings[]? | select(.type == "plain_text" and .name == "PAUSED") | .text] | first // "[]"' <<<"$mc_settings")"
  binds="$(jq -c '[.result.bindings[]? | select(.type == "vpc_service") | {name, service_id}]' <<<"$mc_settings")"
  mb_services_list
  lease_read
  local lj=null; [[ -z $lease_cur ]] || lj="$(jq -c "$lease_jq_clean" <<<"$lease_cur")"
  ml_json="[]"
  while IFS=$'\t' read -r id rec; do
    [[ -n $id ]] || continue
    sx="$(mb_suffix "$id")" conns=0 svc=0 ob_id=""
    rot="$(jq -r '.rotation // 0' <<<"$rec")"; tname="$(mb_obj_name "$sx" "$([[ $rot -gt 0 ]] && echo "$rot")")"
    if [[ "$(jq -r .mode <<<"$rec")" == machine ]]; then
      ob_tunnel_find "$tname"
      if [[ -n $ob_id ]]; then
        r2_api GET "/accounts/$acct/cfd_tunnel/$ob_id/connections"
        [[ $cf_code != 200 ]] || conns="$(jq '.result | length' <<<"$cf_body")"   # connectors, never conns (TASK-1a(f))
      fi
      svc="$(awk -F'\t' -v p="share-${host_name//./-}-$sx" '$1 == p || index($1, p "-r") == 1 {n++} END {print n + 0}' <<<"$ms_list")"
    fi
    local ofn; ofn="$(op_steps "member-$(mb_ing_verb "$(jq -r .status <<<"$rec")")" | grep -c . || true)"; [[ $(jq -r .status <<<"$rec") != joining ]] || ofn="$(op_steps join | grep -c .)"
    ml_json="$(jq -c --argjson r "$rec" --arg sx "$sx" --argjson paused "$paused" --argjson b "$binds" --argjson now "$now" --argjson of "${ofn:-0}" \
      --argjson conns "$conns" --argjson svc "$svc" --arg tunnel "$([[ -n $ob_id ]] && echo "$tname")" --argjson lease "$lj" --arg live "$(lease_live && echo 1 || echo 0)" \
      --argjson lm "${lease_lm:-0}" --arg tu "$(jq -r '.token_unreachable_until // ""' <<<"$rec")" --argjson tue "$(mb_epoch "$(jq -r '.token_unreachable_until // ""' <<<"$rec")" | sed 's/^$/0/')" '
      ($b | any(.name == "M_" + $sx)) as $bound | ($paused | index($sx) != null) as $isp
      | ($r.status) as $st | ($st == "invited" and (($r.invite.expires // 0) < $now)) as $expired
      | ($lease != null and ($lease.member // "") == $r.member_id) as $mine
      | . + [{member_id: $r.member_id, name: $r.name, mode: $r.mode, status: $st, expired: $expired, step: ($r.step // null), of: (if $of > 0 then $of else null end), step_name: ($r.step_name // null),
          lease: (if $mine then {holder: $lease.holder, verb: $lease.verb, step: $lease.step, live: ($live == "1"), since: $lm} else null end),
          deploy: {bound: $bound, paused: $isp}, account: {tunnel: (if $tunnel == "" then null else $tunnel end), connectors: $conns, services: $svc},
          token_expires: ($r.token.expires_on // null), invite_expires: ($r.invite.expires // null), prev_status: ($r.prev_status // null),
          drift: ([
            (if $isp and $st == "active" then "deploy_paused_record_active" else empty end),
            (if $bound and ($st == "removed" or $st == "left") then "deploy_bound_record_removed" else empty end),
            (if ($isp | not) and $st == "paused" then "deploy_unpaused_record_paused" else empty end),
            (if ($bound | not) and $r.mode == "machine" and ($st == "active" or $st == "paused") then "deploy_unbound_record_live" else empty end),
            (if $conns > 1 then "extra_connector" else empty end),
            (if $tue > $now then "token_unreachable" else empty end)])}]' <<<"$ml_json")"
  done <<<"$reg_all"
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    ml_json="$(jq -c --arg k "$id" '. + [{member_id: ($k | ltrimstr("u/") | rtrimstr(".json")), name: "?", mode: null, status: "invalid", expired: false, step: null, step_name: null,
      lease: null, deploy: {bound: false, paused: false}, account: {tunnel: null, connectors: 0, services: 0}, token_expires: null, invite_expires: null, prev_status: null, drift: ["record_invalid"]}]' <<<"$ml_json")"
  done <<<"$reg_bad"
  ml_json="$(jq -c 'sort_by(.name)' <<<"$ml_json")"
}
mb_can_list() { # mb_can_list <status> <mode> <lease live 0|1> <...ing>: the verbs member_can allows the admin, plus finish for an ...ing whose lease is not live (DEC-53)
  local v out=""
  for v in $member_verbs; do member_can "$1" "$v" admin "$2" && out="${out:+$out }$v"; done
  [[ $4 != 1 || $3 == 1 ]] || out="${out:+$out }finish"
  printf '%s' "$out"
}
cmd_member_ls() {
  local json=0 a l o
  for a in "$@"; do case $a in --json) json=1 ;; *) die "usage: share member ls [--json] [--tenant <host>]" ;; esac; done
  member_context ls
  mb_report
  # can[]: through member_can, so the Share Bar never mirrors the table (DEC-53)
  o="[]"
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    local st md lv ing
    IFS=$'\t' read -r st md lv <<<"$(jq -r '[.status, (.mode // "machine"), (if .lease.live then "1" else "0" end)] | @tsv' <<<"$l")"
    ing=0; [[ $st == *ing ]] && ing=1
    o="$(jq -c --argjson x "$l" --arg c "$(mb_can_list "$st" "$md" "$lv" "$ing")" '. + [$x + {can: ($c | split(" ") | map(select(length > 0)))}]' <<<"$o")"
  done < <(jq -c '.[]' <<<"$ml_json")
  ml_json=$o
  [[ $mc_own == 0 ]] || health_put members "$(jq -c --argjson t "$(date +%s)" '{at: $t, list: [.[] | {member_id, suffix: (.member_id | split("-") | last), status, paused: .deploy.paused, connectors: .account.connectors}]}' <<<"$ml_json")"
  if [[ $json == 1 ]]; then jq -c . <<<"$ml_json"; return 0; fi
  [[ $ml_json != "[]" ]] || { echo "no members on $host_name"; return 0; }
  jq -r --argjson now "$(date +%s)" --arg host "$host_name" '.[] |
    "\(.name): \(if .expired then "expired" else .status end)"
      + (if .step != null and (.status | endswith("ing")) then ", step \(.step)\(if .of != null then " of \(.of)" else "" end) (\(.step_name // "?"))" else "" end)
      + (if .lease != null then ", lease held by \(.lease.holder)" + (if .lease.live then " (live)" elif .lease.verb == "?" then " (stale since \(.lease.since | strftime("%Y-%m-%dT%H:%M:%SZ")))" else " (stale since \(.lease.since | strftime("%Y-%m-%dT%H:%M:%SZ")); rerun: share member \(.lease.verb) \(.name))" end)
         elif (.status | endswith("ing")) and .status != "joining" then " (no lease; rerun: share member \(if .status == "adding" then "add" elif .status == "removing" then "rm" else (.status | rtrimstr("ing")) end) \(.name))" else "" end)
      + "\n    id=\(.member_id)  mode=\(.mode // "?")"
      + (if .mode == "machine" then "  \(if .account.connectors > 0 then "online" else "offline" end) (\(.account.connectors) connector(s))  bound=\(.deploy.bound)  paused=\(.deploy.paused)" else "" end)
      + (if .token_expires != null then "  token expires \(.token_expires)" else "" end)
      + (if .status == "invited" and .invite_expires != null then "  invite expires \(.invite_expires | strftime("%Y-%m-%dT%H:%M:%SZ"))" else "" end)
      + (if (.drift | length) > 0 then "\n    drift: \(.drift | join(" "))" + (if (.drift | index("extra_connector")) then " (extra connector: rotate now)" else "" end) else "" end)' <<<"$ml_json"
  [[ -z ${SHARE_MINTER_TOKEN:-} ]] || { as_minter r2_api GET "/user/tokens?per_page=1"; [[ $cf_code != 200 ]] || echo "token slots: $(( 50 - $(jq -r '.result_info.total_count // 0' <<<"$cf_body") )) of 50 free for the minting user"; }
  if [[ $mc_own == 1 && $mc_t2 == 1 && "$(cfg members || true)" != on ]]; then
    echo "drift: config_drift: share.json has members:true and $config lacks members=on; repair: $me setup $host_name --r2 --bucket $r2_bucket --members"
  fi
  return 0
}
op_steps_member_sync() { printf '%s\n' "1 lease" "2 records" "3 deploy" "4 sweep"; }
cmd_member_sync() { # deploy wins for admin-set state, only from active, pausing, resuming or paused (DEC-72); a paused record is never unpaused (DEC-75)
  local rebind=0 a l id st sx bound isp add_p="" add_b="" now
  for a in "$@"; do case $a in --rebind) rebind=1 ;; *) die "usage: share member sync [--rebind] [--tenant <host>]" ;; esac; done
  member_context sync
  op_begin member-sync member sync "$@"
  op_step 1
  lease_take sync "-"
  mb_report
  op_step 2
  while IFS=$'\t' read -r id st sx bound isp; do
    [[ -n $id ]] || continue
    case $st in
      active|pausing|resuming)
        if [[ $isp == true ]]; then reg_get "$id" && reg_status sync admin paused; echo "sync:       ${id} $st -> paused (the deploy pauses it)"
        elif [[ $st == pausing && $bound == true ]]; then reg_get "$id" && reg_status sync admin active; echo "sync:       ${id} pausing -> active (the deploy never paused it)"; fi ;;
      paused) [[ $isp == true ]] || { add_p="${add_p:+$add_p }$sx"; echo "sync:       ${id} paused, missing from PAUSED: paused again"; } ;;
      invited|joining|removing|removed|left) [[ $bound != true || $st == invited || $st == joining ]] || echo "sync:       ${id} is $st and still bound: reported, not changed (share member rm finishes it)"
        [[ $st != invited && $st != joining ]] || echo "sync:       ${id} is $st: reported, not changed" ;;
    esac
  done < <(jq -r '.[] | select(.status != "invalid") | [.member_id, .status, (.member_id | split("-") | last), (.deploy.bound | tostring), (.deploy.paused | tostring)] | @tsv' <<<"$ml_json")
  if [[ $rebind == 1 ]]; then   # account VPC Services are admin-only objects, so they are a trusted rebuild source; records marked paused restore PAUSED
    local n s rest
    while IFS=$'\t' read -r n s _ _; do
      [[ $n =~ ^share-${host_name//./-}-([0-9a-f]{8})(-r[0-9]+)?$ ]] || continue
      sx=${BASH_REMATCH[1]}
      rest="$(jq -r --arg sx "$sx" '[.[] | select(.member_id | endswith("-" + $sx))] | first // {} | .status // ""' <<<"$ml_json")"
      [[ $rest != removing && $rest != removed && $s =~ ^[A-Za-z0-9-]{1,64}$ ]] || continue
      jq -e --arg n "M_$sx" --arg s "$s" 'any(.result.bindings[]?; .name == $n and .service_id == $s)' <<<"$mc_settings" >/dev/null && continue
      add_b="$add_b $sx=$s"; echo "rebind:     M_$sx -> $n"
    done <<<"$ms_list"
    add_p="$add_p $(jq -r '[.[] | select(.status == "paused") | .member_id | split("-") | last] | join(" ")' <<<"$ml_json")"
  fi
  op_step 3
  local delta=". " b
  for b in $add_b; do delta="$delta | map(select(.name != \"M_${b%%=*}\")) + [{type: \"vpc_service\", name: \"M_${b%%=*}\", service_id: \"${b#*=}\"}]"; done
  if [[ -n ${add_p// /} ]]; then
    delta="$delta | (if any(.[]; .name == \"PAUSED\") then . else . + [{type: \"plain_text\", name: \"PAUSED\", text: \"[]\"}] end)
      | map(if .name == \"PAUSED\" then .text = ((.text | fromjson) + (\"$add_p\" | split(\" \") | map(select(length > 0))) | unique | tojson) else . end)"
  fi
  [[ $delta == ". " ]] || { lease_renew 3; mb_deploy "$delta"; }
  op_step 4   # expired invites and old tombstones of removed or purged origins
  now="$(date +%s)"
  r2_list i/
  while IFS= read -r a; do
    [[ $a =~ ^i/[0-9a-f]{64}$ ]] || continue
    r2_call GET "$a" || true
    [[ $cf_code == 200 ]] || continue
    l="$(jq -r '.expires // empty' <<<"$cf_body" 2>/dev/null || true)"
    [[ $l =~ ^[0-9]+$ && $l -lt $now ]] || continue
    r2_call DELETE "$a" || true; echo "sweep:      deleted the expired invite $a"
  done <<<"$r2_list_out"
  r2_list t/
  local cut; cut="$(r2_ago $((now - 2592000)))"
  while IFS=$'\t' read -r a l; do
    [[ $a =~ ^t/[0-9a-f]{6}$ && -n $l && ${l:0:19} < $cut ]] || continue
    r2_call GET "$a" || true; [[ $cf_code == 200 ]] || continue
    id="$(jq -r '.origin // ""' <<<"$cf_body" 2>/dev/null || true)"
    st="$(jq -r --arg id "$id" '[.[] | select(.member_id == $id) | .status] | first // "purged"' <<<"$ml_json")"
    [[ $st == removed || $st == purged ]] || continue
    r2_call DELETE "$a" || true; echo "sweep:      deleted the tombstone $a of $id ($st)"
  done <<<"$r2_list_mods"
  lease_release
  op_done
  echo "synced:     $host_name"
}

cmd_member() { # cmd_member <verb> ...: the admin verbs; every refusal of member_context comes before any write
  local verb="${1:-}" a; shift || true
  local args=()
  while [[ $# -gt 0 ]]; do   # --tenant anywhere after the verb
    if [[ $1 == --tenant ]]; then member_tenant="${2:-}"; [[ -n $member_tenant ]] || die "--tenant needs a hostname"; shift 2; else args+=("$1"); shift; fi
  done
  case $verb in
    add) cmd_member_add ${args[@]+"${args[@]}"} ;;
    ls) cmd_member_ls ${args[@]+"${args[@]}"} ;;
    sync) cmd_member_sync ${args[@]+"${args[@]}"} ;;
    rm|invite|rotate|renew|adopt|purge|pause|resume)   # later verbs: the admin context (and the minter on its paths, DEC-80), the record through member_can, then a plain refusal
      case $verb in rm|invite|rotate|renew|adopt) member_minter=1 ;; esac
      member_context "$verb"
      if [[ -n ${args[0]:-} ]] && mb_name_ok "${args[0]}"; then
        local rec rc=0
        reg_list
        rec="$(awk -F'\t' '{print $2}' <<<"$reg_all" | jq -c --arg n "${args[0]}" 'select(.name == $n and .status != "removed")' 2>/dev/null | head -1)"
        [[ -n $rec ]] || rec="$(awk -F'\t' '{print $2}' <<<"$reg_all" | jq -c --arg n "${args[0]}" 'select(.name == $n)' 2>/dev/null | head -1)"
        [[ -n $rec ]] || die_code member_unknown "no member named ${args[0]} on $host_name; nothing was changed" "$me member ls"
        reg_id="$(jq -r .member_id <<<"$rec")" reg_rec=$rec reg_etag=""
        member_can "$(jq -r .status <<<"$rec")" "$verb" admin "$(jq -r .mode <<<"$rec")" || rc=$?
        [[ $rc != 2 ]] || reg_status "$verb" admin "${verb}ing"   # the busy refusal, worded by reg_status
        [[ $rc == 0 ]] || die_code member_not_allowed "${args[0]} is $(jq -r .status <<<"$rec"); share member $verb does not run from there; nothing was changed" "$me member ls"
      fi
      die "share member $verb is not built in this version" ;;
    *) a="usage: share member add|ls|sync [args] [--tenant <host>]"; die "$a" ;;
  esac
}


# --- the tenant tier T1 to T2 and back (TASK-1d): T2 is config members=on OR marker members:true (DEC-33); every refusal reads the marker ---
op_steps_setup_members() { printf '%s\n' "1 lease" "2 deploy" "3 marker" "4 config" "5 release"; }
op_steps_no_members() { printf '%s\n' "1 lease" "2 deploy" "3 marker" "4 config" "5 release"; }
t2_refuse() { # t2_refuse <what> <next>: dies members_present while config members=on, the marker says members:true, or the deployed settings hold a vpc_service
  # binding (TN-12: a forged members:false never opens a refusal); needs the admin S3 pair or a publisher pair, and acct for the settings read
  local why=""
  [[ "$(cfg members || true)" != on ]] || why="config members=on"
  if [[ -z $why ]]; then
    r2_call GET share.json || die "$1 reads $host_name's share.json first to rule out members, and found no credential for it; set CLOUDFLARE_API_TOKEN; nothing was changed"
    case $cf_code in
      200) jq -e '.members == true' <<<"$cf_body" >/dev/null 2>&1 && why="share.json has members:true" ;;
      404) ;;
      *) die "$1 reads $host_name's share.json first to rule out members (HTTP $cf_code); nothing was changed" ;;
    esac
  fi
  if [[ -z $why && -n ${acct:-} && -n ${api_token:-} ]]; then
    r2_api GET "/accounts/$acct/workers/scripts/share-${host_name//./-}/settings"
    [[ $cf_code != 200 ]] || ! jq -e 'any(.result.bindings[]?; .type == "vpc_service")' <<<"$cf_body" >/dev/null 2>&1 || why="the deployed Worker holds a member binding"
  fi
  [[ -z $why ]] || die_code members_present "$host_name has members ($why); $1 is refused; nothing was changed" "$2"
}
cmd_setup_members() { # cmd_setup_members <bucket> <yes> --members|--no-members: TN-01's order; a rerun converges, each step skipped when in place
  local bucket=$1 yes=$2 flag=$3 verb=setup-members on=1 a pr=""
  [[ $flag == --members ]] || { verb=no-members on=0; }
  [[ "$(cfg bucket || true)" == "$bucket" ]] || die "$flag needs R2 on with bucket $bucket first: $me setup $host_name --r2 --bucket $bucket; nothing was changed"
  migrated_guard
  admin_token_resolve required "setup $flag (Workers Scripts Edit, Cloudflare Tunnel Write, Connectivity Directory Admin)"
  tenant_admin "$bucket"
  mc_worker="share-${host_name//./-}" mc_own=1
  r2_api GET "/accounts/$acct/workers/scripts/$mc_worker/settings"   # the admin proof and the refusals only: the deploy body is read again under the lease
  case $cf_code in
    200) ;;
    404) die "$host_name has no Worker; R2 is not on: $me setup $host_name --r2 --bucket $bucket; nothing was changed" ;;
    401|403) die_code admin_token_not_admin "the token cannot read Worker $mc_worker's settings (HTTP $cf_code); nothing was changed" "$me admin-token --cmd '<command>'" ;;
    *) die "reading Worker $mc_worker answered HTTP $cf_code; nothing was changed" ;;
  esac
  mc_settings=$cf_body
  pr="$(jq -r '[(.result.bindings[] | select(.name == "VERSION") | .text), (.result.bindings[] | select(.name == "SHA") | .text)] | join(" ")' <<<"$cf_body")"
  [[ $pr == "$WORKER_VERSION $WORKER_SHA" ]] || die_code worker_mismatch "Worker $mc_worker is $pr, not this share's $WORKER_VERSION $WORKER_SHA: rerun $me setup $host_name --r2 --bucket $bucket first; nothing was changed" "$me setup $host_name --r2 --bucket $bucket"
  pr=""
  r2_api GET "/accounts/$acct/cfd_tunnel?per_page=1"   # the scope probes, each missing scope named (TN-02)
  [[ $cf_code == 200 ]] || pr="Cloudflare Tunnel Write"
  r2_api GET "/accounts/$acct/connectivity/directory/services?per_page=1"   # the services list probe: every T2 deploy carries vpc_service entries
  [[ $cf_code == 200 ]] || pr="${pr:+$pr, }Connectivity Directory Admin"
  [[ -z $pr ]] || die_code admin_token_scope "the admin token lacks $pr (account scope), which members need; nothing was changed" "$me admin-token --test"
  mc_marker_read
  if [[ $on == 1 ]]; then
    local id; for id in $(rows | cut -f1); do   # every local row has its pointer, so no older publisher can draw its id
      r2_call GET "m/$id"
      [[ $cf_code == 200 ]] || die "local link $id has no pointer m/$id in $bucket (HTTP $cf_code); run $me prune, which writes it, then rerun; nothing was changed"
    done
    if [[ $mc_t2 == 0 && $yes == 0 ]]; then
      local warn="Members on: a share older than 0.10 still lists, adds and removes cloud links here, but never sees member links, and its orphan sweep is skipped"
      [[ -t 0 ]] || die "$warn; rerun with --yes to confirm; nothing was changed"
      read -rp "$warn. Turn members on for $host_name? [y/N] " a
      [[ $a == y* || $a == Y* ]] || die "aborted; nothing was changed"
    fi
  else
    reg_list
    a="$(awk -F'\t' '{print $2}' <<<"$reg_all" | jq -r 'select(.status != "removed") | "\(.name) (\(.status))"' 2>/dev/null | head -1)"
    [[ -z $a ]] || die_code members_present "member $a is not removed; remove every member first (share member rm); nothing was changed" "$me member ls"
    [[ -z $reg_bad ]] || die_code members_present "a record that fails validation ($(head -1 <<<"$reg_bad")) may be a member; nothing was changed" "$me member ls"
    a="$(jq -r '[.result.bindings[]? | select(.type == "vpc_service") | .name] | join(" ")' <<<"$mc_settings")"
    [[ -z $a ]] || die_code members_present "binding $a is still deployed; share member sync names whose it is; nothing was changed" "$me member ls"
  fi
  op_begin "$verb" setup "$host_name" --r2 --bucket "$bucket" "$flag" --yes
  op_step 1
  lease_take "$verb" "-"
  if [[ $on == 0 ]]; then   # under the lease, on a fresh read: an add that held the lease while the refusals ran is seen now
    reg_list; mb_settings_reread
    a="$(awk -F'\t' '{print $2}' <<<"$reg_all" | jq -r 'select(.status != "removed") | "\(.name) (\(.status))"' 2>/dev/null | head -1)"
    [[ -z $a && -z $reg_bad && -z "$(jq -r '[.result.bindings[]? | select(.type == "vpc_service") | .name] | join(" ")' <<<"$mc_settings")" ]] ||
      { op_done; die_code members_present "a member came in while --no-members waited for the lease (${a:-a binding or an unreadable record}); nothing was changed" "$me member ls"; }
  fi
  op_step 2; lease_renew 2
  if [[ $on == 1 ]]; then
    mb_deploy '(if any(.[]; .name == "MEMBERS") then . else . + [{type: "plain_text", name: "MEMBERS", text: "1"}] end)
      | (if any(.[]; .name == "PAUSED") then . else . + [{type: "plain_text", name: "PAUSED", text: "[]"}] end)'
  else
    mb_deploy 'map(select(.name != "MEMBERS" and .name != "PAUSED"))'
  fi
  op_step 3; lease_renew 3   # the marker, If-Match on the copy read above
  if [[ $mc_t2 != "$on" ]]; then
    local mf; mf="$(mktemp "$root/.marker.XXXXXX")"
    if [[ $on == 1 ]]; then jq -c --arg v "$SHARE_VERSION" '. + {members: true, min_cli: $v}' <<<"$mc_marker" >"$mf"
    else jq -c 'del(.members, .min_cli)' <<<"$mc_marker" >"$mf"; fi
    r2_call PUT share.json "$mf" -H "If-Match: \"$mc_marker_etag\"" || true
    rm -f "$mf"
    [[ $cf_code == 200 ]] || die "writing $bucket/share.json answered HTTP $cf_code (412: it changed since it was read); rerun the same setup"
    marker_cache "$on"
    echo "marker:     share.json $([[ $on == 1 ]] && echo "has members:true (min_cli $SHARE_VERSION)" || echo "has members off")"
  fi
  op_step 4
  if [[ $on == 1 ]]; then [[ "$(cfg members || true)" == on ]] || config_put members members=on
  else [[ -z "$(cfg members || true)" ]] || config_put members; fi
  [[ ${SHARE_R2_DRY:-0} != 1 ]] || echo "CONFIG members $([[ $on == 1 ]] && echo on || echo off)" >>"$root/r2-calls.log"
  op_step 5
  lease_release
  op_done
  if [[ $on == 1 ]]; then echo "ready:      members are on for https://$host_name/: $me member add <name>"
  else echo "ready:      members are off for https://$host_name/; R2 stays on"; fi
}


# --- join (TASK-1h, seq-join): redeem, keys and config, the record, the service, a probe, the final record write; resumed from the journal step (DEC-31) ---
op_steps_join() { printf '%s\n' "1 redeem" "2 keys" "3 record" "4 service" "5 probe" "6 active"; }
own_join_config="role member_id member_mode hostname bucket r2_endpoint port hosts tunnel_id r2_key_id token_expires"
wk_code="" wk_body=""
worker_call() { # worker_call GET|POST <path> [body]: one request to https://<host><path>, 30 s; wk_code and wk_body (SHARE_R2_DRY_WORKER answers under the dry seam)
  local wcmd=() out
  wk_code=000 wk_body=""
  if [[ ${SHARE_R2_DRY:-0} == 1 ]]; then
    [[ $tunnel == 0 && $host_name == *.test && -n ${SHARE_R2_DRY_WORKER:-} ]] || { echo "share: SHARE_R2_DRY=1 reaches the Worker only through SHARE_R2_DRY_WORKER, with SHARE_TUNNEL=0 and a .test hostname; the call was refused" >&2; return 0; }
    read -r -a wcmd <<<"$SHARE_R2_DRY_WORKER"
    printf 'WORKER %s %s\n' "$1" "$2" >>"$root/r2-calls.log"
    if [[ $1 == POST ]]; then out="$("${wcmd[@]}" --post "$2" "${3:-}" 2>/dev/null)" || true
    else out="$("${wcmd[@]}" ${worker_bind:+--bind "$worker_bind"} "$2" 2>/dev/null)" || true; fi
    out="$(awk '/^[0-9][0-9][0-9] \// {f = 1} f' <<<"$out")"   # the harness prints its own self-checks first
    wk_code="$(head -1 <<<"$out" | cut -d' ' -f1)"; wk_body="$(sed -n '2p' <<<"$out")"
    [[ $wk_code =~ ^[0-9]{3}$ ]] || wk_code=000
    return 0
  fi
  if [[ $1 == POST ]]; then out="$(printf '%s' "${3:-}" | curl -sS --max-time 30 -w '\n%{http_code}' -X POST --data-binary @- "https://$host_name$2" 2>/dev/null)" || true   # the body exactly, no newline: the Worker wants 64 hex
  else out="$(curl -sS --max-time 30 -w '\n%{http_code}' "https://$host_name$2" 2>/dev/null)" || true; fi
  wk_code="${out##*$'\n'}"; wk_body="${out%$'\n'*}"
  [[ $wk_code =~ ^[0-9]{3}$ ]] || wk_code=000
}
worker_bind=""
join_local_undo() { # a join that lost its record race keeps nothing here, except on a re-join, whose earlier keys and config stay (step 3, DEC-30)
  [[ $join_rejoin == 0 ]] || return 0
  token_forget; api_token_forget
  [[ ! -f $config ]] || to_trash "$config"
  rm -f "$health"; [[ -z $profile ]] || rmdir "$config_dir" 2>/dev/null || true
}
join_rejoin=0
cmd_join() { # cmd_join [<host> <code>]: the bare form resumes a died join from its journal step
  local jhost="${1:-}" code="${2:-}" start=1 bundle mid mmode jport tid env_body sealed mac jmin out
  [[ $# == 0 || $# == 2 ]] || die "usage: share [--profile <name>] join <host> <code>, or share join to resume a join that stopped"
  if [[ $# == 0 ]]; then   # the bare form: the journal names the step; the keys and config came from step 2
    op_begin join join
    [[ -n $op_prev_step ]] || { op_done; die "no join stopped part way on this profile; to join, run: $me join <host> <code>"; }
    if [[ $op_prev_step -lt 3 || $role != member ]]; then
      op_done; die_code invite_unavailable "the join stopped at step ${op_prev_step} (${op_prev_name}), before its keys were kept; the invite is spent; ask the admin: share member invite <your name>" "ask the admin: share member invite <your name>"
    fi
    start=$op_prev_step
    echo "join:       resuming at step $start ($op_prev_name)"
  else
    hostname_ok "$jhost" || die "usage: share [--profile <name>] join <host> <code>"
    [[ $code =~ ^[A-Z2-7]{20}$ ]] || die "the invite code is 20 characters of A-Z and 2-7; check what the admin sent"
    if [[ $role == member && $host_name == "$jhost" ]]; then join_rejoin=1   # a re-join after rotate or invite (DEC-30)
    elif [[ $role != none ]]; then
      die_code profile_not_empty "this profile is set up for ${host_name:-something else} ($role); join into a new one: share --profile <name> join $jhost <code>" "$me profiles"
    fi
    command -v security >/dev/null || die_code member_needs_keychain "members need the macOS Keychain (no security command here); nothing was changed" "join from a Mac"
    for out in jq curl openssl; do command -v "$out" >/dev/null || die "missing: $out"; done
    host_name=$jhost; inv_code=$code
    inv_hash="$(printf 'share-invite-id:%s' "$inv_code" | shasum -a 256 | cut -c1-64)"
    op_begin join join
    # step 1: redeem h, never the code (DEC-22); the claim then delete makes it single-use
    op_step 1
    worker_call POST /_share/redeem "$inv_hash"
    case $wk_code in
      200) ;;
      404) op_done; die_code invite_unknown_or_used "this invite was already used or never existed; ask the admin: share member rotate <your name> (share member invite <your name> for a cloud member)" "ask the admin: share member rotate <your name>" ;;
      410) op_done; die_code invite_expired "this invite expired; ask the admin: share member invite <your name>" "ask the admin: share member invite <your name>" ;;
      *) op_done; die_code invite_unavailable "the invite could not be released (it may be spent; the Worker answered $wk_code); ask the admin: share member invite <your name>" "ask the admin: share member invite <your name>" ;;
    esac
    # step 2: verify, unseal, every refusal, then the Keychain and the config
    op_step 2
    env_body=$wk_body; wk_body=""
    jq -e --arg h "$inv_hash" 'type == "object" and .v == 1 and (.sealed | type == "string") and (.mac | type == "string")' <<<"$env_body" >/dev/null 2>&1 ||
      { op_done; die_code invite_tampered "this invite was altered (the envelope is not one share seals); ask the admin for a new one" "ask the tenant admin for a new invite"; }
    sealed="$(jq -r .sealed <<<"$env_body")"; mac="$(jq -r .mac <<<"$env_body")"; env_body=""
    out="$(printf '%s' "$sealed" | hmac_sha256 "$(invite_mac_key "$inv_code")")"
    [[ $mac =~ ^[0-9a-f]{64}$ && $out == "$mac" ]] || { op_done; die_code invite_tampered "this invite was altered; ask the admin for a new one" "ask the tenant admin for a new invite"; }
    bundle="$(printf '%s' "$sealed" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -md sha256 -a -A -pass fd:3 3< <(printf 'share-invite-key:%s' "$inv_code") 2>/dev/null)" || bundle=""
    inv_code="" sealed=""
    jq -e --arg h "$jhost" 'type == "object" and .v == 1 and .host == $h and (.member_id | type == "string" and test("^m-[a-z0-9-]{2,24}-[0-9a-f]{8}$"))
      and (.mode == "machine" or .mode == "cloud") and (.bucket | type == "string" and test("^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"))
      and (.r2_endpoint | type == "string" and test("^https://[a-z0-9.-]+$")) and (.publisher_token | type == "string" and test("^[A-Za-z0-9_-]+$"))
      and (.publisher_key_id | type == "string" and test("^[A-Za-z0-9-]{1,64}$")) and (.token_expires_on | type == "string")
      and (.mode == "cloud" or ((.port | type == "number" and . >= 1024 and . <= 65535) and (.tunnel_id | type == "string" and test("^[A-Za-z0-9-]{1,64}$"))
        and (.connector_token | type == "string" and test("^[A-Za-z0-9+/=_.-]+$"))))' <<<"$bundle" >/dev/null 2>&1 ||
      { bundle=""; op_done; die_code invite_tampered "this invite does not open with this code, or holds a bundle share cannot use; ask the admin for a new one" "ask the tenant admin for a new invite"; }
    IFS=$'\t' read -r mid mmode jport tid jmin <<<"$(jq -r '[.member_id, .mode, ((.port // "") | tostring), (.tunnel_id // ""), (.min_cli // "")] | @tsv' <<<"$bundle")"
    if [[ $join_rejoin == 1 && $mid != "$(cfg member_id || true)" ]]; then   # the bundle names another member: nothing local is touched
      bundle=""; op_done; die_code member_changed "this invite is for $mid, and this profile is $(cfg member_id || true); nothing here was changed; join it into a new profile: share --profile <name> join $jhost <code>" "$me profiles"
    fi
    if [[ $jmin =~ ^[0-9]+(\.[0-9]+)*$ ]] && ver_lt "$SHARE_VERSION" "$jmin"; then
      bundle=""; op_done; die_code cli_below_min "$jhost needs share $jmin or later, and this is $SHARE_VERSION; upgrade share, then ask the admin: share member invite ${mid#m-}" "upgrade share"
    fi
    if [[ $mmode == machine ]]; then
      for out in caddy cloudflared; do command -v "$out" >/dev/null || { bundle=""; op_done; die "missing: $out (brew install $out); then ask the admin: share member invite $(sed 's/^m-//; s/-[0-9a-f]*$//' <<<"$mid") (the code is spent)"; }; done
      if { listening "$jport" && ! { [[ $join_rejoin == 1 && $jport == "$port" ]] && running; }; } || port_claimed "$jport"; then
        bundle=""; op_done
        die_code port_busy "port $jport, which the invite names, is busy here; ask the admin: share member invite $(sed 's/^m-//; s/-[0-9a-f]*$//' <<<"$mid") --port <free port>" "ask the admin: share member invite <your name> --port <free port>"
      fi
    fi
    # the keys go through stdin into the Keychain, replaced in place on a re-join; then the config, through config_put (DEC-34)
    api_token_store "$(jq -r .publisher_token <<<"$bundle")"
    [[ $mmode != machine ]] || token_store "$(jq -r .connector_token <<<"$bundle")" >/dev/null
    local cfgs=("role=member" "member_id=$mid" "member_mode=$mmode" "hostname=$jhost" "bucket=$(jq -r .bucket <<<"$bundle")" "r2_endpoint=$(jq -r .r2_endpoint <<<"$bundle")"
      "hosts=$(this_host)" "r2_key_id=$(jq -r .publisher_key_id <<<"$bundle")" "token_expires=$(jq -r .token_expires_on <<<"$bundle")")
    [[ $mmode != machine ]] || cfgs+=("port=$jport" "tunnel_id=$tid")
    bundle=""
    config_put "$own_join_config" "${cfgs[@]}"
    port="$(cfg port || echo 8787)"; [[ $port =~ ^[0-9]+$ ]] || port=8787; metrics_port=$((port + 1))
    hosts="$(cfg hosts)" r2on=1 backend=""
    [[ ${SHARE_R2_DRY:-0} != 1 ]] || echo "CONFIG member $mid" >>"$root/r2-calls.log"
    start=3
  fi
  mid="$(cfg member_id)"; mmode="$(cfg member_mode)"; reg_id=$mid
  # step 3: the record names this member and reads invited; joining (If-Match); a lost race keeps nothing here
  if [[ $start -le 3 ]]; then
    op_step 3
    if ! reg_get "$mid"; then join_local_undo; op_done; die_code member_changed "the admin changed this member during the join (its record is gone); nothing was kept here" "ask the tenant admin"; fi
    case "$(jq -r .status <<<"$reg_rec")" in
      invited) reg_status_join joining 3 ;;
      joining) ;;
      *) join_local_undo; op_done; die_code member_changed "the admin changed this member during the join (its record reads $(jq -r .status <<<"$reg_rec")); nothing was kept here" "ask the tenant admin" ;;
    esac
  fi
  # step 4: the service (machine): Caddy and cloudflared under launchd, started
  if [[ $start -le 4 && $mmode == machine ]]; then
    op_step 4
    mk_root; mkdir -p "$pub"
    lock_take index; write_caddyfile; lock_release index
    # SHARE_JOIN_SERVICE=0 (test seam): no login service; serve starts in the background, as the start verb does with no service installed
    if [[ ${SHARE_JOIN_SERVICE:-1} == 1 ]] && { [[ $(uname -s) == Darwin ]] || command -v systemctl >/dev/null; }; then svc_install; echo "service:    runs at login ($svc_label)"; fi
    running || cmd_start >/dev/null
  fi
  # step 5: a probe link through https://<host>/ answers 3x200
  if [[ $start -le 5 && $mmode == machine ]]; then
    op_step 5
    join_probe || die "a probe link did not answer through https://$host_name/ (the record stays joining); the admin can look with share member ls; rerun: $me join"
  fi
  # step 6: the status it held before rotate or invite, else active; joined; prev_status, invite and step go (DEC-30)
  op_step 6
  reg_get "$mid" || { op_done; die_code member_changed "the record of $mid is gone; nothing more was changed" "ask the tenant admin"; }
  if [[ "$(jq -r .status <<<"$reg_rec")" == joining ]]; then
    reg_status_join "$(jq -r '.prev_status // "active"' <<<"$reg_rec")" ""
  fi
  member_health_put
  op_done
  echo "joined as $mid"
}
reg_status_join() { # reg_status_join <to> <step>: the member's own record write: joining at step 3, the final status at step 6; a 412 at step 3 keeps nothing here
  local to=$1 st=$2 rc=0 extra=.
  [[ $to == joining ]] || extra='.joined = (now | strftime("%Y-%m-%dT%H:%M:%SZ")) | del(.invite)'
  reg_refuse_code=member_changed reg_refuse_msg="the admin changed this member during the join; nothing was kept here"   # the join refusal table (DEC-37)
  ( reg_status join member "$to" "$st" "$extra" ) || rc=$?
  if [[ $rc != 0 ]]; then
    if [[ $to == joining ]]; then join_local_undo; op_done; fi
    exit 1
  fi
  reg_get "$reg_id" || true
}
join_probe() { # one probe link (v:3) on this machine, fetched 3 times through the Worker, then removed
  local id nonce name exp i ok=0
  nonce="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"; name="share-join-probe-$nonce.txt"
  id="$(rand_id)" || return 1
  exp=$(( $(date +%s) + 900 ))
  r2_pointer_write "$id" "$name" text "$exp" "" "" "$(date +%F)"
  [[ $cf_code == 200 ]] || return 1
  lock_take index
  mkdir -p "$pub/$id"; printf 'share join probe %s\n' "$nonce" >"$pub/$id/$name"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$name" "$(date +%F)" "$exp" "" >>"$index"
  write_caddyfile; caddy_reload || true
  lock_release index
  worker_bind="M_$(mb_suffix "$(cfg member_id)")=127.0.0.1:$port"
  local also=200   # a paused member coming back (rotate or invite from paused, DEC-30): the Worker may answer its paused 503 before the binding
  [[ "$(jq -r '.prev_status // ""' <<<"$reg_rec")" != paused ]] || also=503
  for i in $(seq 1 "${SHARE_JOIN_PROBES:-20}"); do
    worker_call GET "/$id/$name"
    if [[ $wk_code == 200 || $wk_code == "$also" ]]; then ok=$((ok + 1)); [[ $ok -lt 3 ]] || break; else ok=0; [[ ${SHARE_R2_DRY:-0} == 1 ]] || sleep 2; fi
  done
  worker_bind=""
  ( cmd_rm "$id" ) >/dev/null 2>&1 || true   # a subshell: its die never ends the join; prune catches what it leaves
  [[ $ok -ge 3 ]]
}
member_add_check() { # a member's add reads its own record first: paused, left, removing or removed adds nothing (WM-01, DEC-16; cooperative)
  local mid st
  mid="$(cfg member_id)"; reg_id=$mid
  r2_token_check
  if ! reg_get "$mid"; then die "this machine's member record ($mid) is gone from $host_name; nothing was published; share leave --local cleans this profile"; fi
  member_health_put
  st="$(jq -r .status <<<"$reg_rec")"
  case $st in
    active|invited|joining|inviting|rotating|renewing) ;;
    paused|pausing) die "the admin of $host_name paused this member; nothing was published" ;;
    *) die "this member is $st on $host_name; nothing was published" ;;
  esac
}
member_health_put() { # the member's own record, as the last read saw it, for state.member (no network there)
  [[ -n $reg_rec ]] || return 0
  health_put member "$(jq -c --argjson t "$(date +%s)" '{at: $t, status, step: (.step // null), token_expires: (.token.expires_on // null)}' <<<"$reg_rec")"
}

cmd_skill() { # cmd_skill [--install]: the skill file that makes share agent-native
  local out="/dev/stdout" d=""
  if [[ ${1:-} == --install ]]; then
    d="${SHARE_SKILL_DIR:-$HOME/.claude/skills/share}"
    mkdir -p "$d"; out="$d/SKILL.md"
  fi
  cat >"$out" <<'EOF'
---
name: share
description: Publish a local file, folder, or running dev server at a public link on the user's own domain. Use when the user asks to share, publish, demo, or hand someone a link to something local ("share this file", "let them see my dev server", "publish these notes").
---

# share

Publish snapshots of local files/folders, or proxy a running `localhost` server, at `https://<host>/...`. The host is the user's own domain on Cloudflare; links live while the machine is awake. With `share setup --quick` no domain is needed: links get a random `*.trycloudflare.com` host that changes on every start.

## Before anything

Run `share state` first and read its JSON: `state` (`not_setup`, `stopped`, `serving`), `ready`, `serve`, `role`, `ops`, `token`, and `shares`. It never writes, prunes, or prompts. `share status` is the human view of the same facts; never parse its text. If `state` is `not_setup`, stop and tell the user: `share setup --quick` needs no account, or `share setup <hostname>` needs a browser login or `CLOUDFLARE_API_TOKEN`. Every profile: `share profiles --json`.

`role` is what kind of profile this is:

| `role` | Meaning |
|---|---|
| `none` | not set up |
| `quick` | a quick tunnel: a random `trycloudflare.com` URL, no domain |
| `origin` | a named tunnel on this machine; `tier` `t0` |
| `tenant_origin` | the origin of a tenant with R2 on (`bucket=`); `tier` `t1`, or `t2` with members |
| `r2_profile` | an R2 profile: a Worker serves the links; nothing runs here |
| `member` | a member of another person's tenant |
| `migrated` | this profile moved to another machine (`share migrate`); `state` reads `not_setup` and nothing serves here |

`serve` says why links are or are not up: `serve.phase` and `serve.reason`. `reason` is the serve exit code for `failed`, `ok` for `serving`, else the phase name. Trust it over any guess from the process list; never tail `serve.log` first.

| `serve.phase` | Meaning |
|---|---|
| `not_setup` | nothing to serve: run `share setup`, or the profile moved |
| `elsewhere` | set up, but this machine is not in `hosts=`; links work while a machine in `hosts=` serves; do not run `share start` here |
| `failed` | the login service is installed and the last serve ended with `serve.reason` (a code below); fix that, then `share start` |
| `stopped` | set up and not running; `share start` |
| `starting` | serve runs, the tunnel is still connecting (under 30 s); wait, then read `share state` again |
| `tunnel_down` | serve runs but the tunnel does not answer: links are down; `share stop`, then `share start` |
| `worker_down` | an r2 profile whose Worker does not answer `/healthz`; nothing local fixes it |
| `serving` | links are up |

Each `shares[]` row has `link_state`: `live`, `expired` (past its expiry, not yet pruned; do not hand the link out), `shadowed` (a cloud link holds the same id and wins), `gate_missing` (a gated link whose Access app is gone: the link is public; tell the user), or `revoked` (an admin revoked it; `reason` names who). Hand out a link only when its `link_state` is `live`.

`access_pending` counts Access apps waiting for deletion (run `share prune` with a token); `access_inflight` counts apps a running `add` is still working on (do nothing); `access_bad` counts hand-edited lines (tell the user).

`token` (when the profile uses one) is `{source, status, expires_on}`: `status` `missing`, `expired` or `invalid` means an add will fail (`share api-token`); `unchecked` means nothing verified it lately; `expiring` means within 14 days. `compat.status` `cli_below_min` means this share is too old for the tenant (upgrade it); `worker_older` means the Worker needs the admin's `share setup <host> --r2` rerun.

`ops` lists multi-step verbs that are running (`alive: true`) or died part way (`alive: false`). A dead op names `rerun` (and `rollback` when it has one); tell the user and ask before running either. Never run them through a shell; the `rerun_argv` array is the exact argument list after `share`.

## Errors

A refusal ends with `share: <message>` on stderr and exit 1. Set `SHARE_ERROR_JSON=1` to also get one last stderr line `{"error":{"code":...,"message":...,"next":...}}`; branch on `code`, never on the message text. `next` is the command that usually fixes it; a `next` marked destructive needs the user's yes first.

| `code` | Meaning |
|---|---|
| `not_in_hosts` | this machine is not in `hosts=`, so it does not serve this profile |
| `already_serving` | a server already runs for this profile |
| `no_tunnel_token` | the tunnel token is missing; rerun `share setup <hostname>` |
| `port_busy` | the share port is taken by another process or profile (`share profiles`) |
| `metrics_port_busy` | the tunnel metrics port (port + 1) is taken |
| `server_not_started` | the server did not answer within 10 s; `serve.log` says why |
| `profile_migrated` | this profile moved to another machine; its `next` (`teardown --yes`) is destructive: never run it without the user's yes |
| `op_running` | another run of the same multi-step verb is alive; wait, then read `share state` |
| `quick_has_named_tunnel` | `setup --quick` on a profile that has a named tunnel |
| `tenant_rollback` | `setup --r2` died after its config write; the message names the rollback |
| `config_value_bad` | a config value holds a line break, or is not one the key takes; nothing was written |
| `cloud_token_missing` | the menu lists cloud links only with a stored publisher token (`share api-token`) |
| `admin_token_missing` | an admin verb found neither `CLOUDFLARE_API_TOKEN` nor `admin_token_cmd` |
| `admin_token_cmd_failed` | `admin_token_cmd` exited non-zero or printed no token |
| `admin_token_not_admin` | the token cannot read the Worker settings: not an admin token |
| `minter_token_missing` | a member-token verb found neither `SHARE_MINTER_TOKEN` nor `minter_token_cmd` |
| `minter_token_cmd_failed` | `minter_token_cmd` exited non-zero or printed no token |
| `members_present` | a teardown, `migrate`, `--no-r2` or `--no-members` refused while the tenant has members (`share member ls`) |
| `config_key_unknown` | `share config` sets only `ttl` and `storage_default` |
| `ok` | `serve.reason` of a serving profile: nothing is wrong |
| `tunnel_down` | `serve.reason` while serve runs but the tunnel does not answer |
| `worker_down` | `serve.reason` of an r2 profile whose Worker does not answer |
| `token_missing` | `token.status`: no token resolves on this profile (`share api-token`) |
| `token_expired` | `token.status`: the stored token is past its expiry; every add fails (`share api-token`) |
| `token_invalid` | `token.status`: Cloudflare rejected the stored token (`share api-token`) |
| `cli_below_min` | `compat.status`: this share is older than the tenant requires; upgrade it |
| `worker_older` | `compat.status`: the Worker is older than this share ships; the admin reruns `share setup <host> --r2` |
| `stopped` | serve exit record: `share stop` ended serving |
| `cloudflared_died` | serve exit record: the tunnel process exited |
| `caddy_failed` | serve exit record: the web server failed to start or exited |
| `member_no_tenant` | an admin verb ran with no `--tenant` on a machine with no profile for one |
| `members_off` | the tenant has members off; the admin runs `share setup <host> --r2 --bucket <bucket> --members` |
| `admin_token_scope` | the admin token lacks a scope a member verb needs; the message names it |
| `minter_token_scope` | the minter token lacks API Tokens Read or Write |
| `token_limit` | the minting user holds 50 tokens (Cloudflare's limit per user); use a dedicated minter user |
| `member_name_bad` | a member name is not 2 to 24 of a-z, 0-9 and - |
| `member_name_taken` | a member of that name exists and is not removed |
| `member_cap` | the tenant has 20 machine members, the cap |
| `member_unknown` | no member of that name on the tenant |
| `member_busy` | the member is mid another verb; run the rerun the message names |
| `member_not_allowed` | the member's status does not allow this verb (`share member ls` shows `can`) |
| `member_changed` | the member record changed under this verb; nothing was kept |
| `record_invalid` | a `u/` record fails validation; it is never used |
| `lease_held` | another admin verb holds the tenant lease; wait, then rerun |
| `lease_lost` | another admin verb took the lease over; rerun the same verb |
| `worker_mismatch` | the deployed Worker is not this share's version; the admin reruns `share setup <host> --r2` |
| `invite_ttl_bad` | `--invite-ttl` is not a duration of at most 30 days |
| `config_drift` | drift: config `members=on` and the marker `members:true` disagree; rerun `setup --members` |
| `deploy_paused_record_active` | drift: the deploy pauses the member, its record reads active (`share member sync`) |
| `deploy_bound_record_removed` | drift: bound in the deploy, the record reads removed or left |
| `deploy_unpaused_record_paused` | drift: the record reads paused, the deploy does not pause it (`share member sync`) |
| `deploy_unbound_record_live` | drift: the record reads active or paused with no binding (`share member sync --rebind`) |
| `extra_connector` | drift: more than one connector on a member tunnel; rotate it |
| `token_unreachable` | the current minter cannot find the member's token; it lives until its expiry |
| `invite_unknown_or_used` | join: the invite was used or never existed; the admin runs `share member rotate <name>` (`invite` for a cloud member) |
| `invite_expired` | join: the invite expired; the admin runs `share member invite <name>` |
| `invite_unavailable` | join: the invite could not be released; the admin runs `share member invite <name>` |
| `invite_tampered` | join: the invite was altered; ask the admin for a new one |
| `member_needs_keychain` | join: members need the macOS Keychain |
| `profile_not_empty` | join: the profile is set up for something else; join into a new `--profile` |

## Commands

| Command | Effect |
|---|---|
| `share add <file\|dir>` | Snapshot copy; prints the link and copies it to the clipboard |
| `share add <port>` | Live proxy `https://<host>/<id>/` -> `127.0.0.1:<port>` (also `localhost:port`, `http://localhost:port`) |
| `share add ... --host <name>.<zone>` | Own hostname, e.g. `dev.example.com`; needed for apps that emit absolute asset paths, and for SPA deep links |
| `share add <dir> --no-index` | No generated file listing at the folder link |
| `share add ... --access email:<a>,<b>` / `--access domain:<d>` / `--access group:<name>` | A login gate (Cloudflare Access, one-time PIN by email): only those addresses, everyone at that domain, or the members of an Access rule group can open the link. The link prints once the edge enforces it (minutes on a first app). Named setup only, never quick mode |
| `share api-token [--cmd '<command>' \| --check]` | The Cloudflare API token `--access` needs, once per profile: with no argument it opens the prefilled token form and reads a hidden paste; `--cmd` points share at a command that prints a token you already have (`op read ...`); `--check` reruns the scope preflight |
| `share ls` / `share hits <id>` | List shares / request + unique-visitor counts |
| `share refresh <id>` | Re-copy a snapshot from its source (no-op for live shares) |
| `share rm <id>` | Unpublish; for `--host` shares also deletes the CNAME and tunnel rule |
| `share start` / `share stop` | Serving on or off |
| `share --profile <name> <command>` | Run any command against another setup (a second account or hostname); `share profiles` lists them. No flag is the default setup |
| `share setup <hostname> --backend r2 --bucket <name>` | An R2 profile: a Worker serves links from a private bucket, so they stay up while this machine is off, and several people publish to one hostname. Live shares, `--host`, `start`, and `stop` are refused there; `share rm <id>` unpublishes |
| `share config ttl\|storage_default [<value>\|--unset]` | The two defaults a person sets: the `add` expiry (`12h`, `7d`, `never`) and where `add` stores a link on a tenant with R2 on (`local` or `cloud`); with no value it prints the current one |
| `share admin-token --cmd '<command>'` / `--clear` / `--test [--json]` | The command that prints the admin token for `setup --r2`, `--no-r2` and `teardown --purge` (never the token itself); `--test` names what the token can do |
| `share minter-token --cmd '<command>'` / `--clear` / `--test [--json]` | The command that prints the minter token, which mints member tokens |

## Rules for agents

- Always surface the printed link to the user; never share something else "to test it".
- Live shares expose whatever answers on that port to anyone with the link. Ports below 1024 and share's own ports are refused; do not try to work around that.
- A shared folder gets a generated file listing unless `--no-index`; check for sensitive names first. Dotfiles and symlinks are never copied.
- A file whose name is 2-5 digits (e.g. `8080`) reads as a port; use `./8080` to share the file.
- Links die when the machine sleeps. If a link 404s or the visitor sees Cloudflare 530, read `share state`.
- In quick mode (`setup --quick`) the `trycloudflare.com` URL is new on every `share start` and every login-service restart: an old link is dead forever, always read the current one from `share state` or the `add` output. `--host` is refused in quick mode.
- `rm`/`hits`/`refresh` accept the pasted link as well as the bare id.
- A gated link (`--access`) needs the API token first; if `share add --access` prints a "needs a Cloudflare API token" block, run the `share api-token` command it names (or `--cmd` with a token the user already has) and rerun the add. `share rm` of a gated share needs the same token; `share state` counts Access apps waiting for deletion in `access_pending`.
EOF
  [[ -n $d ]] && echo "installed $out"
}

cmd_config() { # cmd_config <key> [<value> | --unset]: the two CLI defaults a person sets (G14); every write goes through config_put with the one key owned
  local key="${1:-}" val="${2:-}"
  case $key in
    ttl|storage_default) ;;
    "") die "usage: $me config ttl|storage_default [<value> | --unset]" ;;
    *) die_code config_key_unknown "$key is not a setting this verb writes; the settable keys are ttl and storage_default; nothing was written" "$me config ttl" ;;
  esac
  [[ $# -le 2 ]] || die "usage: $me config $key [<value> | --unset]"
  if [[ $# == 1 ]]; then cfg "$key" || true; return 0; fi   # no value: print it, nothing when unset
  [[ -f $config ]] || die "this profile has no config yet; run $me setup first"
  if [[ $val == --unset ]]; then config_put "$key"; echo "$key unset"; return 0; fi
  case $key in
    ttl)
      [[ $val == never || $val =~ ^[0-9]+[dh]?$ && ( $val == 0 || $val =~ [dh]$ ) ]] ||
        die_code config_value_bad "ttl '$val' is not a duration (use 12h, 7d, or never); nothing was written" "$me config ttl 7d" ;;
    storage_default)
      [[ $val == local || $val == cloud ]] || die_code config_value_bad "storage_default '$val' is not local or cloud; nothing was written" "$me config storage_default local"
      [[ -n "$(cfg bucket || true)" ]] || die_code config_value_bad "storage_default needs a bucket, and $host_name has none (R2 is off); nothing was written" "$me config storage_default --unset" ;;
  esac
  config_put "$key" "$key=$val"
  echo "$key=$val"
}

cmd_state_fn() { # the hidden test verb (unlisted, like r2-rows): one state owner at a time
  local v n i w a
  case ${1:-} in
    codes) printf '%s\n' "$code_table" | cut -d'|' -f1 ;;
    code) code_text "${2:-}" ;;
    die) shift; die_code "$@" ;;
    role) printf '%s %s\n' "$role" "${tier:--}" ;;
    serve) serve_state; printf '%s %s %s %s\n' "$serve_phase" "$serve_reason" "$serve_state_val" "$serve_ready_val" ;;
    link) list_rows state; printf '%s' "$list_out" | awk -F"$(printf '\037')" 'NF {print $1, $11, $12}' ;;
    pending) pending_state "${2:-}" ;;
    token) token_state; printf '%s %s %s\n' "${tok_source:--}" "${tok_status:--}" "${tok_expires:--}" ;;
    compat) compat_state; printf '%s|%s|%s\n' "${cmp_status:--}" "${cmp_worker:--}" "${cmp_min:--}" ;;
    ops) ops_json; echo ;;
    owner-live) if owner_live "${2:-0}" "${3:-}"; then echo true; else echo false; fi ;;
    op-run)   # op-run <verb> <n> [rerun args... [-- rollback args...]]: op_begin, n op_steps, op_done; SHARE_OP_PAUSE holds a step
      v="${2:-}" n="${3:-}"; [[ -n $v && $n =~ ^[0-9]+$ ]] || die "usage: share state-fn op-run <verb> <n> [args... [-- rollback...]]"
      shift 3
      if [[ $# -gt 0 ]]; then op_begin "$v" "$@"; else op_begin "$v" state-fn op-run "$v" "$n"; fi
      for ((i = 1; i <= n; i++)); do op_step "$i"; done
      op_done ;;
    config-put)   # config-put <writer|"owned keys"> key=value...: writes the config, so only under the test seam
      [[ ${SHARE_STATE_FN_WRITE:-} == 1 ]] || die "state-fn config-put writes the config; it runs only with SHARE_STATE_FN_WRITE=1"
      w="${2:-}"; shift 2 || die "usage: share state-fn config-put <writer> key=value..."
      case $w in
        write_config) w=$own_write_config ;; write_config_r2) w=$own_write_config_r2 ;;
        write_config_quick) w=$own_write_config_quick ;; tenant_config) w=$own_tenant_config ;;
      esac
      config_put "$w" "$@" ;;
    reg-step)   # reg-step <member_id> <verb> <to> [step]: one reg_status write under the admin context (TASK-1e's unit); the test seam writes the bucket
      [[ ${SHARE_STATE_FN_WRITE:-} == 1 ]] || die "state-fn reg-step writes a record; it runs only with SHARE_STATE_FN_WRITE=1"
      member_context reg-step; reg_get "${2:-}" || die_code member_unknown "no record ${2:-}" "$me member ls"
      reg_status "${3:-}" admin "${4:-}" "${5:-}"; jq -c '{status, prev_status, step, step_name}' <<<"$reg_rec" ;;
    obj)   # obj <tunnel-ensure|tunnel-find|tunnel-gone|tunnel-hint|service-ensure|service-find|service-gone|token-find|token-mint|token-delete> <args>: one object helper (TASK-1f1)
      [[ ${SHARE_STATE_FN_WRITE:-} == 1 ]] || die "state-fn obj may write Cloudflare objects; it runs only with SHARE_STATE_FN_WRITE=1"
      member_minter=1; member_context obj
      case ${2:-} in
        tunnel-ensure) ob_tunnel_ensure "$3"; echo "$ob_id" ;; tunnel-find) ob_tunnel_find "$3"; echo "${ob_id:--}" ;; tunnel-gone) ob_tunnel_gone "$3"; echo "done" ;;
        tunnel-hint) if ob_tunnel_hint "$3" "$4"; then echo used; else echo ignored; fi ;;
        service-ensure) ob_service_ensure "$3" "$4" "$5"; echo "$ob_id" ;; service-find) ob_service_find "$3"; echo "${ob_id:--}" ;; service-gone) ob_service_gone "$3"; echo "done" ;;
        token-find) ob_token_find "$3"; echo "${tk_id:--} ${tk_expires:--}" ;; token-mint) ob_token_mint "$3" "$4"; tk_value=""; echo "$tk_id" ;; token-delete) ob_token_delete "$3"; echo "done" ;;
        *) die "usage: share state-fn obj <op> <args>" ;;
      esac ;;
    invite-seal)   # invite-seal: the plaintext on stdin, the code from SHARE_TEST_CODE; prints "<hash> <sealed> <mac>"
      invite_code; printf '%s ' "$inv_hash"; invite_seal "$inv_code" || die "seal failed" ;;
    invite-open)   # invite-open <sealed> <mac>: the code from SHARE_TEST_CODE; the plaintext, or invite_tampered
      invite_code; invite_open "$inv_code" "${2:-}" "${3:-}" ;;
    hmac)   # hmac <key hex>: HMAC-SHA256 of stdin (the in-shell one), for the suite's cross-check with openssl
      hmac_sha256 "${2:-}" ;;
    member-can)   # member-can <status|none> <verb> <admin|member> [machine|cloud]: yes, no or busy (the case table of member_can)
      i=0; member_can "${2:-}" "${3:-}" "${4:-}" "${5:-}" || i=$?
      case $i in 0) echo yes ;; 2) echo busy ;; *) echo no ;; esac ;;
    member-can-all)   # every (status, verb, actor, mode) tuple, one "<status> <verb> <actor> <mode> <answer>" line each, in one process
      for v in none $member_statuses; do for n in $member_verbs; do for w in admin member; do for i in machine cloud; do
        a=0; member_can "$v" "$n" "$w" "$i" || a=$?
        case $a in 0) a=yes ;; 2) a=busy ;; *) a=no ;; esac
        echo "$v $n $w $i $a"
      done; done; done; done ;;
    *) die "usage: share state-fn codes|code|die|role|serve|link|pending|token|compat|ops|owner-live|op-run|config-put|member-can|member-can-all" ;;
  esac
}

case "${1:-status}" in
  setup) shift; cmd_setup "$@" ;;
  teardown) shift; cmd_teardown "$@" ;;
  service) cmd_service "${2:-}" ;;
  add) shift; cmd_add "$@" ;;
  import) shift; cmd_import "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  migrate-probe) cmd_migrate_probe ;;
  migrate-index) cmd_migrate_index ;;
  migrate-tunnel-id) cmd_migrate_tunnel_id ;;
  migrate-nonce) cmd_migrate_nonce ;;
  api-token) shift; cmd_api_token "$@" ;;
  config) shift; cmd_config "$@" ;;
  admin-token) shift; token_verb admin "$@" ;;
  minter-token) shift; token_verb minter "$@" ;;
  ls) cmd_prune listing; cmd_ls ;;
  skill) cmd_skill "${2:-}" ;;
  refresh) cmd_refresh "$(id_of "${2:-}")" ;;
  rm) cmd_rm "$(id_of "${2:-}")" ;;
  hits) cmd_hits "$(id_of "${2:-}")" ;;
  prune) cmd_prune ;;
  r2-call) shift; rc=0; r2_call "$@" || rc=$?; printf 'code=%s etag=%s\n' "$cf_code" "$r2_etag"; [[ -n $cf_body ]] && printf '%s\n' "$cf_body"; exit "$rc" ;;
  r2-api) shift; [[ ${SHARE_R2_DRY:-0} == 1 ]] || die "r2-api is a test verb of the dry seam (SHARE_R2_DRY=1)"; api_token="${CLOUDFLARE_API_TOKEN:-}"; [[ ${1:-} != --minter ]] || { shift; api_token="${SHARE_MINTER_TOKEN:-}" api_who=minter; }
    r2_api "$@"; printf 'code=%s err=%s\n' "$cf_code" "$cf_err"; [[ -z $cf_body ]] || printf '%s\n' "$cf_body" ;;
  worker-call) shift; [[ ${SHARE_R2_DRY:-0} == 1 ]] || die "worker-call is a test verb of the dry seam (SHARE_R2_DRY=1)"; if [[ ${1:-} == GET ]]; then worker_bind="${3:-}"; worker_call GET "${2:-}"; else worker_call "$@"; fi   # GET <path> [M_<hex>=127.0.0.1:<port>] | POST <path> <body>
    printf 'code=%s\n' "$wk_code"; [[ -z $wk_body ]] || printf '%s\n' "$wk_body" ;;
  r2-list) r2_list "${2:-}"; printf '%s' "$r2_list_out" ;;
  r2-put-tree) shift; r2_put_tree "$@" ;;
  r2-delete-prefix) shift; r2_delete_prefix "$@" ;;
  r2-rows) r2_snapshot; printf 'index=%s\n' "$index"; rows ;;
  r2-id) rand_id ;;
  r2-own) case ${2:-} in get|put|drop) f="r2_own_$2"; shift 2; "$f" "$@" ;; *) exit 1 ;; esac ;;
  worker-src) worker_js /dev/stdout ;;
  state-fn) shift; cmd_state_fn "$@" ;;
  member) shift; cmd_member "$@" ;;
  join) shift; cmd_join "$@" ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  state) cmd_state ;;
  profiles) shift; cmd_profiles "$@" ;;
  serve) cmd_serve ;;
  version) echo "$SHARE_VERSION" ;;
  -h|--help|help) sed -n '2,/^# Docs:/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) sed -n '2,/^# Docs:/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
